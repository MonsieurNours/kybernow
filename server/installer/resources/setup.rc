#include <winver.h>
1 ICON "kybernow.ico"
1 24 "setup.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Les Lignes Claires"
      VALUE "FileDescription", "Installation de KyberNow"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductName", "KyberNow"
      VALUE "ProductVersion", "0.1.0"
      VALUE "LegalCopyright", "Les Lignes Claires - AGPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
