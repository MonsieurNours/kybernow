# Réglages du relais pour docker compose : copiez ce fichier en .env.

# Le nom du relais. Le DNS doit donner ce nom ET *.ce-nom vers votre adresse publique.
RELAY_DOMAIN=relais.exemple.org

# Adresse de contact pour Let's Encrypt (avis d'expiration).
LEGO_EMAIL=vous@exemple.org

# D'abord le serveur de test de Let's Encrypt. Une fois le certificat de test
# obtenu, passez en production (voir README.md) :
# LEGO_SERVER=https://acme-v02.api.letsencrypt.org/directory
LEGO_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Après avoir lu les conditions de Let's Encrypt : https://letsencrypt.org/repository/
LEGO_ACCEPT_TOS=no

# Facultatif :
# RELAY_LISTEN=0.0.0.0:8443
# RELAY_METRICS=127.0.0.1:9464
# RUST_LOG=info
