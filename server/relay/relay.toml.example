# Réglages facultatifs du relais : copiez ce fichier en config/relay.toml.
# Les variables d'environnement KN_RELAY_* (docker-compose.yml) passent avant.

# domain = "relais.exemple.org"
# listen = "0.0.0.0:8443"
# Port public annoncé, si la box en publie un autre que le port d'écoute
# (liens /j/{code}, adresses https://<id>.<domaine>, sans port au 443) :
# public_port = 443
# Navigateur chiffré de bout en bout (docs/relais.md) : la zone dont le TLS
# passe tel quel jusqu'aux Stations (absente : station.<domaine> ; "" : coupé).
# tls_zone = "station.relais.exemple.org"
# cert = "/certs/certificates/relais.exemple.org.crt"
# key = "/certs/certificates/relais.exemple.org.key"
# banlist = "/config/banlist.txt"

# Avertissement dans le journal au-delà de ce débit relayé (0 : jamais).
# egress_alert_mbps = 400
# Plafond global des paquets relayés (0 : aucun plafond).
# global_cap_mbps = 0

# [metrics]
# listen = "127.0.0.1:9464"

# [limits]
# lookups_per_minute = 10
# lookups_per_hour = 60
# lookups_per_minute_subnet = 30
# lookups_per_minute_total = 600
# quic_per_ip = 16
# quic_handshakes_per_minute_per_ip = 60
# quic_total = 4096
# retry_above_per_second = 100
# tcp_per_ip = 32
# tcp_total = 4096
# stations_per_ip = 4
# stations_per_minute_per_ip = 20
# clients_per_station = 8
# clients_per_station_per_ip = 2
# client_idle_secs = 30
# flows_per_client = 4
# codes_per_station = 4
# header_timeout_secs = 10
# max_header_bytes = 16384

# Comptes KyberNow (docs/comptes.md, README.md « Comptes ») : coupés par défaut.
# La base et la clé vont dans un dossier en écriture (./data:/data dans
# docker-compose.yml) ; la clé est créée au premier démarrage.
# [accounts]
# enabled = true
# database = "/data/accounts.db"
# secret_key = "/data/secret.key"
# Adresse des pages dans les e-mails (par défaut https://<domaine>[:port public]) :
# public_url = "https://relais.exemple.org"
#
# Sans [accounts.smtp] : ni inscription, ni vérification, ni mot de passe
# oublié ; les comptes se créent avec `kybernow-relay accounts add`.
# [accounts.smtp]
# host = "smtp.exemple.org"
# port = 587
# starttls = true          # false : TLS dès la connexion (port 465)
# user = "relais@exemple.org"
# password_file = "/config/smtp_password"
# from = "KyberNow <comptes@exemple.org>"
