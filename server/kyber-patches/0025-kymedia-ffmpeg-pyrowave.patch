index 0000000..556e40c
--- /dev/null
+++ b/subprojects/packagefiles/ffmpeg/patches/0021-avcodec-pyrowave-d3d11-encoder.patch
@@ -0,0 +1,949 @@
+From: KyberNow
+Subject: [PATCH] avcodec: PyroWave encoder for D3D11 frames (libpyrowave)
+
+AV_CODEC_ID_PYROWAVE (as in HansKristian-Work/FFmpeg, branch pyrowave) and an
+encoder taking the D3D11 frames of a desktop capture without any CPU copy:
+GPU copy into a texture shared with a Vulkan device on the same adapter,
+shared D3D11 fence, pyrowave_encoder_encode_gpu_scaled(). What the three
+PyroWave encoders of KyberNow share (options, configuration packet "KNPW"
+version 1 or 2 with the HDR10 metadata, packetization) is in
+libavcodec/pyrowave_common.h. KyberNow, docs/pyrowave.md.
+---
+diff --git a/configure b/configure
+index fc991e099a..5b1030044e 100755
+--- a/configure
++++ b/configure
+@@ -265,6 +265,7 @@ External library support:
+   --enable-libopus         enable Opus de/encoding via libopus [no]
+   --enable-libplacebo      enable libplacebo library [no]
+   --enable-libpulse        enable Pulseaudio input via libpulse [no]
++  --enable-libpyrowave     enable PyroWave encoding of D3D11 frames via libpyrowave [no]
+   --enable-libqrencode     enable QR encode generation via libqrencode [no]
+   --enable-libquirc        enable QR decoding via libquirc [no]
+   --enable-librabbitmq     enable RabbitMQ library [no]
+@@ -2073,6 +2074,7 @@ EXTERNAL_LIBRARY_LIST="
+     libopus
+     libplacebo
+     libpulse
++    libpyrowave
+     libqrencode
+     libquirc
+     librabbitmq
+@@ -3803,6 +3805,7 @@ libopenmpt_demuxer_deps="libopenmpt"
+ libopus_decoder_deps="libopus"
+ libopus_encoder_deps="libopus"
+ libopus_encoder_select="audio_frame_queue"
++libpyrowave_encoder_deps="libpyrowave d3d11va"
+ librav1e_encoder_deps="librav1e"
+ librsvg_decoder_deps="librsvg"
+ libshine_encoder_deps="libshine"
+@@ -7834,6 +7837,8 @@ enabled amf &&
+     check_cpp_condition amf "AMF/core/Version.h" \
+         "(AMF_VERSION_MAJOR << 48 | AMF_VERSION_MINOR << 32 | AMF_VERSION_RELEASE << 16 | AMF_VERSION_BUILD_NUM) >= 0x0001000400240000"
+ 
++enabled libpyrowave && require_pkg_config libpyrowave pyrowave-shared "vulkan/vulkan.h pyrowave.h" pyrowave_get_api_version
++
+ # Funny iconv installations are not unusual, so check it after all flags have been set
+ if enabled libc_iconv; then
+     check_func_headers iconv.h iconv
