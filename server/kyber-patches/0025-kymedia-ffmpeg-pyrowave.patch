++        s->shared_width != frame->width || s->shared_height != frame->height) {
++        if (pw_vk_format(src_desc.Format) == VK_FORMAT_UNDEFINED) {
++            av_log(avctx, AV_LOG_ERROR, "Unsupported capture format (DXGI %d)\n", src_desc.Format);
++            return AVERROR(EINVAL);
++        }
++        if ((ret = pw_create_shared(avctx, src_desc.Format, frame->width, frame->height)) < 0)
++            return ret;
++    }
++
++    /* Copy on the graphics card, then signal the fence Vulkan waits on. */
++    D3D11_BOX box = { 0, 0, 0, frame->width, frame->height, 1 };
++    pw_lock(s);
++    ID3D11DeviceContext4_CopySubresourceRegion(s->context4, (ID3D11Resource *)s->shared, 0, 0, 0, 0,
++                                               (ID3D11Resource *)src, index, &box);
++    s->fence_value++;
++    ID3D11DeviceContext4_Signal(s->context4, s->fence, s->fence_value);
++    ID3D11DeviceContext4_Flush(s->context4);
++    pw_unlock(s);
++
++    pyrowave_gpu_external_reference ref = { s->image, VK_QUEUE_FAMILY_EXTERNAL };
++    pyrowave_gpu_sync_operation acquire = { &ref, 1, { pyrowave_sync_object_get_semaphore(s->sync), s->fence_value } };
++    /* Given back to D3D11 without a semaphore: packetize() below waits for
++     * the encode, so the copy of the next frame never overwrites a texture
++     * Vulkan still reads. */
++    pyrowave_gpu_sync_operation release = { &ref, 1, { VK_NULL_HANDLE, 0 } };
++
++    pyrowave_scaled_encode_info info = { 0 };
++    r = pyrowave_image_get_image_view(s->image, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_USAGE_SAMPLED_BIT, &info.view);
++    if (r != PYROWAVE_SUCCESS) {
++        av_log(avctx, AV_LOG_ERROR, "No view of the shared texture: %s\n", ff_pyrowave_result_name(r));
++        return AVERROR_EXTERNAL;
++    }
++    if (s->hdr) {
++        /* P010 from the capture: already PQ BT.2020 limited range YCbCr,
++         * scaled without conversion. */
++        info.input_color_space        = VK_COLOR_SPACE_HDR10_ST2084_EXT;
++        info.output_color_space       = VK_COLOR_SPACE_HDR10_ST2084_EXT;
++        info.intermediate_plane_format = VK_FORMAT_R16_UNORM;
++    } else {
++        info.input_color_space        = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
++        info.output_color_space       = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
++        info.intermediate_plane_format = VK_FORMAT_R8_UNORM;
++        info.ycbcr_range              = VK_SAMPLER_YCBCR_RANGE_ITU_FULL;
++    }
++    info.ycbcr_chroma_midpoint = 0.5f;
++
++    budget = ff_pyrowave_frame_budget(avctx, &s->pw);
++    pyrowave_rate_control rate = { budget };
++
++    r = pyrowave_encoder_encode_gpu_scaled(s->encoder, &acquire, &release, &info, &rate);
++    if (r != PYROWAVE_SUCCESS) {
++        av_log(avctx, AV_LOG_ERROR, "Encode failed: %s\n", ff_pyrowave_result_name(r));
++        return AVERROR_EXTERNAL;
++    }
++
++    if ((ret = ff_pyrowave_packetize(avctx, s->encoder, &s->bitstream, &s->bitstream_size, pkt)) < 0)
++        return ret;
++
++    pkt->pts = pkt->dts = frame->pts;
++    pkt->flags |= AV_PKT_FLAG_KEY;
++    *got_packet = 1;
++
++    if (!(s->frames++ % 600))
++        av_log(avctx, AV_LOG_VERBOSE, "Frame %"PRId64": %d bytes (budget %zu)\n",
++               s->frames, pkt->size, budget);
++    return 0;
++}
