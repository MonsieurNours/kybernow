++OBJS-$(CONFIG_LIBPYROWAVE_ENCODER)        += libpyrowave_enc.o
+ OBJS-$(CONFIG_LIBRAV1E_ENCODER)           += librav1e.o
+ OBJS-$(CONFIG_LIBRSVG_DECODER)            += librsvgdec.o
