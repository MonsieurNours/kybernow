diff --git a/subprojects/packagefiles/ffmpeg/patches/0021-avcodec-pyrowave-d3d11-encoder.patch b/subprojects/packagefiles/ffmpeg/patches/0021-avcodec-pyrowave-d3d11-encoder.patch
