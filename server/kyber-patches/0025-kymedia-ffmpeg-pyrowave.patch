++/*
++ * One source for the three PyroWave encoders of KyberNow: libpyrowave
++ * (D3D11 frames, Windows), libpyrowave_metal (VideoToolbox frames, Mac) and
++ * libpyrowave_vulkan (DMA-BUF frames, Linux). Options, encoded size, frame
++ * budget, the configuration packet ("KNPW") and, for the two Vulkan ones,
++ * the packetization: a fix made here is made for all of them.
++ *
++ * Configuration packet (extradata), KyberNow contract, little endian:
++ *   version 1 (16 bytes, every app):
++ *     0  "KNPW"
++ *     4  version u8 (1)
++ *     5  chroma u8 (0 = 4:2:0, 1 = 4:4:4)
++ *     6  colour u8 (0 = SDR BT.709, 1 = HDR10 BT.2020 PQ)
++ *     7  range u8 (0 = full, 1 = limited)
++ *     8  width u32, 12 height u32
++ *   version 2 (48 bytes, header_version=2, apps that ask for it): the same
++ *   first 16 bytes with version 2, then the HDR10 static metadata of the
++ *   capture:
++ *     16 flags u8 (bit 0: mastering display below, bit 1: content light
++ *        level below; a field without its bit is 0 and means nothing)
++ *     17 3 bytes, 0
++ *     20 red x, red y, green x, green y, blue x, blue y, white x, white y:
++ *        u16 each, CIE 1931, units of 0.00002 (as HEVC SEI 137, but red
++ *        first)
++ *     36 max luminance u32, 40 min luminance u32: units of 0.0001 cd/m2
++ *     44 MaxCLL u16, 46 MaxFALL u16: cd/m2
++ * Each packet is a whole frame: the PyroWave sequence header followed by
++ * every coded block, as pyrowave_encoder_packetize() writes them end to
++ * end; always a key frame.
++ */
++
++#ifndef AVCODEC_PYROWAVE_COMMON_H
++#define AVCODEC_PYROWAVE_COMMON_H
++
++#include <limits.h>
++#include <stddef.h>
++#include <stdint.h>
++#include <string.h>
++
++#include "libavutil/attributes.h"
++#include "libavutil/frame.h"
++#include "libavutil/intreadwrite.h"
++#include "libavutil/log.h"
++#include "libavutil/mastering_display_metadata.h"
++#include "libavutil/mathematics.h"
++#include "libavutil/mem.h"
++#include "libavutil/opt.h"
++#include "avcodec.h"
++#include "encode.h"
++
++#define FF_PYROWAVE_HEADER_V1_SIZE 16
++#define FF_PYROWAVE_HEADER_V2_SIZE 48
++#define FF_PYROWAVE_HDR_MASTERING  1
++#define FF_PYROWAVE_HDR_LIGHT      2
++
++/* Options of every PyroWave encoder, right after the AVClass pointer of
++ * its context, as `FFPyroWaveOptions pw;`. */
++typedef struct FFPyroWaveOptions {
++    int chroma444;
++    int out_width, out_height;
++    int packet_size;
++    int fps;
++    int gpu_priority;
++    int header_version;
++} FFPyroWaveOptions;
++
++#define FF_PYROWAVE_OPTIONS(ctx)                                                                        \
++    { "chroma444",    "Encode 4:4:4 (SDR only)", offsetof(ctx, pw.chroma444),                           \
++      AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_ENCODING_PARAM },     \
++    { "out_width",    "Encoded width (scaled on the GPU), 0: input", offsetof(ctx, pw.out_width),       \
++      AV_OPT_TYPE_INT, { .i64 = 0 }, 0, 16384, AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_ENCODING_PARAM },  \
++    { "out_height",   "Encoded height, 0: input", offsetof(ctx, pw.out_height),                         \
++      AV_OPT_TYPE_INT, { .i64 = 0 }, 0, 16384, AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_ENCODING_PARAM },  \
++    { "packet_size",  "Ignored: one packet per frame (kept for older callers)",                         \
++      offsetof(ctx, pw.packet_size), AV_OPT_TYPE_INT, { .i64 = 1152 }, 256, 65535,                      \
++      AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_ENCODING_PARAM },                                           \
++    { "fps",          "Frames per second for the frame budget, 0: framerate", offsetof(ctx, pw.fps),    \
++      AV_OPT_TYPE_INT, { .i64 = 0 }, 0, 1000, AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_ENCODING_PARAM },   \
++    { "gpu_priority", "GPU queue priority: 0 medium, 1 high, 2 realtime (Vulkan; Metal has none)",      \
++      offsetof(ctx, pw.gpu_priority), AV_OPT_TYPE_INT, { .i64 = 1 }, 0, 2,                              \
++      AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_ENCODING_PARAM },                                           \
++    { "header_version", "KNPW configuration packet: 1 (16 bytes, every app) or 2 (HDR10 metadata)",     \
++      offsetof(ctx, pw.header_version), AV_OPT_TYPE_INT, { .i64 = 1 }, 1, 2,                            \
++      AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_ENCODING_PARAM }
++
++/* HDR10 static metadata of the configuration packet, version 2. */
++typedef struct FFPyroWaveHdr {
++    int flags;              /* FF_PYROWAVE_HDR_MASTERING, FF_PYROWAVE_HDR_LIGHT */
++    uint16_t primaries[3][2]; /* red, green, blue x y, 0.00002 */
++    uint16_t white[2];
++    uint32_t max_luminance; /* 0.0001 cd/m2 */
++    uint32_t min_luminance;
++    uint16_t max_cll, max_fall;
++} FFPyroWaveHdr;
++
++static av_unused uint32_t ff_pyrowave_fixed(AVRational q, int64_t scale, uint32_t max)
++{
++    int64_t v;
++    if (q.den <= 0 || q.num < 0)
++        return 0;
++    v = av_rescale(q.num, scale, q.den);
++    return v > max ? max : (uint32_t)v;
++}
++
++/* The metadata the capture gave the encoder (txproto and libavconv copy the
++ * capture's frame side data into decoded_side_data before opening it). */
++static av_unused void ff_pyrowave_hdr_from_ctx(const AVCodecContext *avctx, FFPyroWaveHdr *m)
++{
++    const AVFrameSideData *sd;
++
++    memset(m, 0, sizeof(*m));
++    sd = av_frame_side_data_get(avctx->decoded_side_data, avctx->nb_decoded_side_data,
++                                AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
++    if (sd) {
++        const AVMasteringDisplayMetadata *mdm = (const AVMasteringDisplayMetadata *)sd->data;
++        if (mdm->has_primaries && mdm->has_luminance) {
++            m->flags |= FF_PYROWAVE_HDR_MASTERING;
++            for (int i = 0; i < 3; i++)
++                for (int j = 0; j < 2; j++)
++                    m->primaries[i][j] = ff_pyrowave_fixed(mdm->display_primaries[i][j], 50000, 50000);
++            m->white[0] = ff_pyrowave_fixed(mdm->white_point[0], 50000, 50000);
++            m->white[1] = ff_pyrowave_fixed(mdm->white_point[1], 50000, 50000);
++            m->max_luminance = ff_pyrowave_fixed(mdm->max_luminance, 10000, UINT32_MAX);
++            m->min_luminance = ff_pyrowave_fixed(mdm->min_luminance, 10000, UINT32_MAX);
++        }
++    }
++    sd = av_frame_side_data_get(avctx->decoded_side_data, avctx->nb_decoded_side_data,
++                                AV_FRAME_DATA_CONTENT_LIGHT_LEVEL);
++    if (sd) {
++        const AVContentLightMetadata *cll = (const AVContentLightMetadata *)sd->data;
++        m->flags |= FF_PYROWAVE_HDR_LIGHT;
++        m->max_cll  = cll->MaxCLL > 65535 ? 65535 : cll->MaxCLL;
++        m->max_fall = cll->MaxFALL > 65535 ? 65535 : cll->MaxFALL;
++    }
++}
++
++/* Writes the configuration packet (FF_PYROWAVE_HEADER_V1_SIZE or _V2_SIZE
++ * bytes, by `version`). `m`: version 2 only, NULL for none. */
++static av_unused int ff_pyrowave_write_header(uint8_t *h, int version, int chroma444, int hdr,
++                                              int width, int height, const FFPyroWaveHdr *m)
++{
++    const int size = version >= 2 ? FF_PYROWAVE_HEADER_V2_SIZE : FF_PYROWAVE_HEADER_V1_SIZE;
++
++    memset(h, 0, size);
++    memcpy(h, "KNPW", 4);
++    h[4] = version >= 2 ? 2 : 1;
++    h[5] = chroma444 && !hdr ? 1 : 0;
++    h[6] = hdr ? 1 : 0;
++    h[7] = hdr ? 1 : 0; /* HDR10 from the capture: limited range */
++    AV_WL32(h + 8, width);
++    AV_WL32(h + 12, height);
++    if (version >= 2 && m) {
++        h[16] = m->flags & (FF_PYROWAVE_HDR_MASTERING | FF_PYROWAVE_HDR_LIGHT);
++        for (int i = 0; i < 3; i++) {
++            AV_WL16(h + 20 + 4 * i, m->primaries[i][0]);
++            AV_WL16(h + 22 + 4 * i, m->primaries[i][1]);
++        }
++        AV_WL16(h + 32, m->white[0]);
++        AV_WL16(h + 34, m->white[1]);
++        AV_WL32(h + 36, m->max_luminance);
++        AV_WL32(h + 40, m->min_luminance);
++        AV_WL16(h + 44, m->max_cll);
++        AV_WL16(h + 46, m->max_fall);
++    }
++    return size;
++}
++
++/* The global header the sinks send as the stream's configuration packet:
++ * version 1 unless the caller asked for 2 (an app that reads it), with the
++ * capture's HDR10 metadata in HDR. */
++static av_unused int ff_pyrowave_set_extradata(AVCodecContext *avctx, const FFPyroWaveOptions *o,
++                                               int hdr, int width, int height)
++{
++    FFPyroWaveHdr m;
++    const int size = o->header_version >= 2 ? FF_PYROWAVE_HEADER_V2_SIZE : FF_PYROWAVE_HEADER_V1_SIZE;
++
++    av_freep(&avctx->extradata);
++    avctx->extradata = av_mallocz(size + AV_INPUT_BUFFER_PADDING_SIZE);
++    if (!avctx->extradata)
++        return AVERROR(ENOMEM);
++    if (hdr)
++        ff_pyrowave_hdr_from_ctx(avctx, &m);
++    else
++        memset(&m, 0, sizeof(m));
++    avctx->extradata_size = ff_pyrowave_write_header(avctx->extradata, o->header_version, o->chroma444,
++                                                     hdr, width, height, &m);
++    if (hdr && o->header_version >= 2)
++        av_log(avctx, AV_LOG_VERBOSE, "KNPW version 2: %s%s\n",
++               m.flags & FF_PYROWAVE_HDR_MASTERING ? "mastering display" : "no mastering display",
++               m.flags & FF_PYROWAVE_HDR_LIGHT ? ", content light level" : "");
++    return 0;
++}
++
++/* The encoded size (out_width, out_height, or the input's), checked:
++ * 4:4:4 in SDR only (the HDR10 capture is P010, 4:2:0), an even size in
++ * 4:2:0. */
++static av_unused int ff_pyrowave_size(AVCodecContext *avctx, FFPyroWaveOptions *o, int hdr,
++                                      int *width, int *height)
++{
++    *width  = o->out_width  > 0 ? o->out_width  : avctx->width;
++    *height = o->out_height > 0 ? o->out_height : avctx->height;
++    if (o->chroma444 && hdr) {
++        av_log(avctx, AV_LOG_WARNING, "4:4:4 refused with HDR10 (P010 capture): 4:2:0\n");
++        o->chroma444 = 0;
++    }
++    if (!o->chroma444 && ((*width | *height) & 1)) {
++        av_log(avctx, AV_LOG_ERROR, "4:2:0 needs an even size, not %dx%d\n", *width, *height);
++        return AVERROR(EINVAL);
++    }
++    return 0;
++}
++
++/* Bytes for one frame: bitrate / 8 / fps, a multiple of 4. */
++static av_unused size_t ff_pyrowave_frame_budget(const AVCodecContext *avctx, const FFPyroWaveOptions *o)
++{
++    AVRational fps = avctx->framerate;
++    int64_t size;
++
++    if (o->fps > 0)
++        fps = (AVRational){ o->fps, 1 };
++    else if (fps.num <= 0 || fps.den <= 0)
++        fps = (AVRational){ 60, 1 };
++    size = av_rescale_rnd(avctx->bit_rate > 0 ? avctx->bit_rate : 200000000, fps.den,
++                          (int64_t)fps.num * 8, AV_ROUND_DOWN);
++    size &= ~(int64_t)3;
++    return FFMAX(size, 4096);
++}
++
++#ifdef PYROWAVE_API_VERSION_MAJOR
++/* The Vulkan library (pyrowave.h): libpyrowave and libpyrowave_vulkan. */
++
++static av_unused const char *ff_pyrowave_result_name(pyrowave_result r)
++{
++    switch (r) {
++    case PYROWAVE_SUCCESS:                         return "success";
++    case PYROWAVE_TIMEOUT:                         return "timeout";
++    case PYROWAVE_ERROR_INVALID_ARGUMENT:          return "invalid argument";
++    case PYROWAVE_ERROR_OUT_OF_HOST_MEMORY:        return "out of host memory";
++    case PYROWAVE_ERROR_OUT_OF_DEVICE_MEMORY:      return "out of device memory";
++    case PYROWAVE_ERROR_NO_VULKAN:                 return "no Vulkan";
++    case PYROWAVE_ERROR_NOT_IMPLEMENTED:           return "not implemented";
++    case PYROWAVE_ERROR_UNSUPPORTED_EXTERNAL_HANDLE: return "unsupported external handle";
++    case PYROWAVE_ERROR_FAILED_EXTERNAL_HANDLE:    return "failed external handle";
++    default:                                       return "generic error";
++    }
++}
++
++static av_unused int ff_pyrowave_check_api(AVCodecContext *avctx, uint32_t *major, uint32_t *minor,
++                                           uint32_t *patch)
++{
++    pyrowave_get_api_version(major, minor, patch);
++    if (*major != PYROWAVE_API_VERSION_MAJOR) {
++        av_log(avctx, AV_LOG_ERROR, "PyroWave API %u.%u.%u, %d.x expected\n",
++               *major, *minor, *patch, PYROWAVE_API_VERSION_MAJOR);
++        return AVERROR_EXTERNAL;
++    }
++    return 0;
++}
++
++/* Upper bound of the PyroWave sequence header written before the blocks. */
++#define FF_PYROWAVE_SEQUENCE_HEADER_MAX 256
++
++/*
++ * The encoded frame, once the encode is done, in `pkt`.
++ *
++ * pyrowave_encoder_packetize() ignores the size it is given (only an assert
++ * checks it, gone in a release build), and a block larger than the packet
++ * boundary makes a packet of its own, larger than the boundary: a buffer of
++ * n packets of the boundary could overflow (KYB-01). The frame is the
++ * sequence header followed by the coded blocks, all inside the encoded
++ * bitstream: it never takes more than that bitstream plus the header. It is
++ * put together in `*buf` (kept between frames), in a single packet: the
++ * blocks are written end to end whatever the boundary, so one call with a
++ * boundary no frame reaches gives the contract's frame at once (no packet
++ * count to compute, no moves).
++ */
++static av_unused int ff_pyrowave_packetize(AVCodecContext *avctx, pyrowave_encoder encoder,
++                                           uint8_t **buf, unsigned int *buf_size, AVPacket *pkt)
++{
++    const void *bitstream, *meta;
++    size_t bitstream_size = 0, meta_size = 0, count = 1, capacity;
