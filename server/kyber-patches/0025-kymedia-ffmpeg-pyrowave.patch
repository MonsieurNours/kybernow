+index 12a8265025..a96b44aff0 100644
+--- a/libavcodec/Makefile
++++ b/libavcodec/Makefile
+@@ -1202,6 +1202,7 @@ OBJS-$(CONFIG_LIBOPUS_DECODER)            += libopusdec.o libopus.o     \
+                                              vorbis_data.o
+ OBJS-$(CONFIG_LIBOPUS_ENCODER)            += libopusenc.o libopus.o     \
