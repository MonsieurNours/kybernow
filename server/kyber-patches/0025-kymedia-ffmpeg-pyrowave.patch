+diff --git a/libavcodec/allcodecs.c b/libavcodec/allcodecs.c
+index 695214f..0673c5e 100644
+--- a/libavcodec/allcodecs.c
++++ b/libavcodec/allcodecs.c
+@@ -812,6 +812,7 @@ extern const FFCodec ff_libopencore_amrwb_decoder;
+ extern const FFCodec ff_libopenjpeg_encoder;
+ extern const FFCodec ff_libopus_encoder;
+ extern const FFCodec ff_libopus_decoder;
++extern const FFCodec ff_libpyrowave_encoder;
+ extern const FFCodec ff_librav1e_encoder;
+ extern const FFCodec ff_librsvg_decoder;
+ extern const FFCodec ff_libshine_encoder;
+diff --git a/libavcodec/codec_desc.c b/libavcodec/codec_desc.c
+index a9f21f8..a36b02d 100644
+--- a/libavcodec/codec_desc.c
++++ b/libavcodec/codec_desc.c
+@@ -2009,6 +2009,13 @@ static const AVCodecDescriptor codec_descriptors[] = {
+                      AV_CODEC_PROP_LOSSLESS,
+         .mime_types= MT("image/jxs"),
+     },
++    {
++        .id        = AV_CODEC_ID_PYROWAVE,
++        .type      = AVMEDIA_TYPE_VIDEO,
++        .name      = "pyrowave",
++        .long_name = NULL_IF_CONFIG_SMALL("PyroWave"),
++        .props     = AV_CODEC_PROP_INTRA_ONLY | AV_CODEC_PROP_LOSSY,
++    },
+ 
+     /* various PCM "codecs" */
+     {
+diff --git a/libavcodec/codec_id.h b/libavcodec/codec_id.h
+index 6529f0a..4902bc0 100644
+--- a/libavcodec/codec_id.h
++++ b/libavcodec/codec_id.h
+@@ -332,6 +332,7 @@ enum AVCodecID {
+     AV_CODEC_ID_APV,
+     AV_CODEC_ID_PRORES_RAW,
+     AV_CODEC_ID_JPEGXS,
++    AV_CODEC_ID_PYROWAVE,
+ 
+     /* various PCM "codecs" */
+     AV_CODEC_ID_FIRST_AUDIO = 0x10000,     ///< A dummy id pointing at the start of audio codecs
+diff --git a/libavcodec/libpyrowave_enc.c b/libavcodec/libpyrowave_enc.c
+new file mode 100644
+index 0000000..801c184
+--- /dev/null
++++ b/libavcodec/libpyrowave_enc.c
+@@ -0,0 +1,603 @@
++/*
++ * PyroWave encoder for D3D11 frames (KyberNow).
++ *
++ * This file is part of FFmpeg.
++ *
++ * FFmpeg is free software; you can redistribute it and/or
++ * modify it under the terms of the GNU Lesser General Public
++ * License as published by the Free Software Foundation; either
++ * version 2.1 of the License, or (at your option) any later version.
++ *
++ * FFmpeg is distributed in the hope that it will be useful,
++ * but WITHOUT ANY WARRANTY; without even the implied warranty of
++ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
++ * Lesser General Public License for more details.
++ *
++ * You should have received a copy of the GNU Lesser General Public
++ * License along with FFmpeg; if not, write to the Free Software
++ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
++ */
++
++/*
++ * PyroWave (https://github.com/Themaister/pyrowave) is an intra-only wavelet
++ * codec running in Vulkan compute. This encoder takes the D3D11 frames of a
++ * desktop capture as they are, without any CPU copy: each frame is copied on
++ * the graphics card into a texture shared with a Vulkan device opened on the
++ * same adapter (LUID), a shared D3D11 fence orders the copy before the
++ * encode, and pyrowave_encoder_encode_gpu_scaled() converts RGB(A) to YCbCr
++ * (or takes P010 as is) and scales it down if asked.
++ *
++ * Input: BGRA (SDR, encoded BT.709 full range) or P010 (HDR10 from the
++ * capture: PQ, BT.2020, limited range, kept as is).
++ *
++ * Extradata (16 bytes, KyberNow contract, docs/pyrowave.md):
++ *   "KNPW" | version u8 = 1 | chroma u8 (0 = 4:2:0, 1 = 4:4:4) |
++ *   colour u8 (0 = SDR BT.709, 1 = HDR10 BT.2020 PQ) |
++ *   range u8 (0 = full, 1 = limited) | width u32 LE | height u32 LE.
++ * Each packet is a whole frame, the concatenation of the packets of
++ * pyrowave_encoder_packetize() for the packet_size boundary, always a key
++ * frame.
++ */
++
++#define COBJMACROS
++#include <initguid.h>
++#include <windows.h>
++#include <d3d11_4.h>
++#include <dxgi1_2.h>
++
++#include <vulkan/vulkan.h>
++#include <pyrowave.h>
++
++#include "libavutil/avassert.h"
++#include "libavutil/hwcontext.h"
++#include "libavutil/hwcontext_d3d11va.h"
++#include "libavutil/intreadwrite.h"
++#include "libavutil/mem.h"
++#include "libavutil/opt.h"
++#include "libavutil/pixdesc.h"
++#include "avcodec.h"
++#include "codec_internal.h"
++#include "encode.h"
++#include "hwconfig.h"
++
++#define KNPW_HEADER_SIZE 16
++
++typedef struct PyroWaveD3D11Context {
++    const AVClass *class;
++
++    /* Options */
++    int chroma444;
++    int out_width, out_height;
++    int packet_size;
++    int fps;
++    int gpu_priority;
++
++    /* D3D11 side (the capture's device) */
++    AVBufferRef *frames_ref;
++    AVD3D11VADeviceContext *d3d;
++    ID3D11Device5 *device5;
++    ID3D11DeviceContext4 *context4;
++    ID3D11Fence *fence;
++    uint64_t fence_value;
++    ID3D11Texture2D *shared;
++    DXGI_FORMAT shared_format;
++    int shared_width, shared_height;
++
++    /* Vulkan side */
++    pyrowave_device device;
++    pyrowave_sync_object sync;
++    pyrowave_image image;
++    pyrowave_encoder encoder;
++    int width, height;
++    int hdr;
++
++    pyrowave_packet *packets;
++    size_t nb_packets_alloc;
++    int64_t frames;
++} PyroWaveD3D11Context;
++
++static const char *pw_result_name(pyrowave_result r)
++{
++    switch (r) {
++    case PYROWAVE_SUCCESS:                         return "success";
++    case PYROWAVE_TIMEOUT:                         return "timeout";
++    case PYROWAVE_ERROR_INVALID_ARGUMENT:          return "invalid argument";
++    case PYROWAVE_ERROR_OUT_OF_HOST_MEMORY:        return "out of host memory";
++    case PYROWAVE_ERROR_OUT_OF_DEVICE_MEMORY:      return "out of device memory";
++    case PYROWAVE_ERROR_NO_VULKAN:                 return "no Vulkan";
++    case PYROWAVE_ERROR_NOT_IMPLEMENTED:           return "not implemented";
++    case PYROWAVE_ERROR_UNSUPPORTED_EXTERNAL_HANDLE: return "unsupported external handle";
++    case PYROWAVE_ERROR_FAILED_EXTERNAL_HANDLE:    return "failed external handle";
++    default:                                       return "generic error";
++    }
++}
++
++static VkFormat pw_vk_format(DXGI_FORMAT format)
++{
++    switch (format) {
++    case DXGI_FORMAT_B8G8R8A8_UNORM:      return VK_FORMAT_B8G8R8A8_UNORM;
++    case DXGI_FORMAT_R8G8B8A8_UNORM:      return VK_FORMAT_R8G8B8A8_UNORM;
++    case DXGI_FORMAT_R10G10B10A2_UNORM:   return VK_FORMAT_A2B10G10R10_UNORM_PACK32;
++    case DXGI_FORMAT_P010:                return VK_FORMAT_G16_B16R16_2PLANE_420_UNORM;
++    default:                              return VK_FORMAT_UNDEFINED;
++    }
++}
++
++static void pw_lock(PyroWaveD3D11Context *s)
++{
++    s->d3d->lock(s->d3d->lock_ctx);
++}
++
++static void pw_unlock(PyroWaveD3D11Context *s)
++{
++    s->d3d->unlock(s->d3d->lock_ctx);
++}
++
++static void pw_release_shared(PyroWaveD3D11Context *s)
++{
++    if (s->image) {
++        pyrowave_image_destroy(s->image);
++        s->image = NULL;
++    }
++    if (s->shared) {
++        ID3D11Texture2D_Release(s->shared);
++        s->shared = NULL;
++    }
++    s->shared_width = s->shared_height = 0;
++}
++
++/* The texture the capture is copied into, shared with Vulkan by an NT handle
++ * (pyrowave_image_create takes the handle over). */
++static int pw_create_shared(AVCodecContext *avctx, DXGI_FORMAT format, int width, int height)
++{
++    PyroWaveD3D11Context *s = avctx->priv_data;
++    D3D11_TEXTURE2D_DESC desc = { 0 };
++    IDXGIResource1 *res = NULL;
++    HANDLE handle = NULL;
++    HRESULT hr;
++    pyrowave_result r;
++
++    pw_release_shared(s);
++
++    desc.Width            = width;
++    desc.Height           = height;
++    desc.MipLevels        = 1;
++    desc.ArraySize        = 1;
++    desc.Format           = format;
++    desc.SampleDesc.Count = 1;
++    desc.Usage            = D3D11_USAGE_DEFAULT;
++    desc.BindFlags        = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
++    desc.MiscFlags        = D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_NTHANDLE;
++
++    hr = ID3D11Device5_CreateTexture2D(s->device5, &desc, NULL, &s->shared);
++    if (FAILED(hr)) {
++        /* Some drivers refuse a render target in P010. */
++        desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
++        hr = ID3D11Device5_CreateTexture2D(s->device5, &desc, NULL, &s->shared);
++    }
++    if (FAILED(hr)) {
++        av_log(avctx, AV_LOG_ERROR, "Cannot create the shared texture (%dx%d, DXGI format %d): 0x%lx\n",
++               width, height, format, (long)hr);
++        return AVERROR_EXTERNAL;
++    }
++
++    hr = ID3D11Texture2D_QueryInterface(s->shared, &IID_IDXGIResource1, (void **)&res);
++    if (SUCCEEDED(hr)) {
++        hr = IDXGIResource1_CreateSharedHandle(res, NULL, GENERIC_ALL, NULL, &handle);
++        IDXGIResource1_Release(res);
++    }
++    if (FAILED(hr)) {
++        av_log(avctx, AV_LOG_ERROR, "Cannot share the texture: 0x%lx\n", (long)hr);
++        pw_release_shared(s);
++        return AVERROR_EXTERNAL;
++    }
++
++    VkImageCreateInfo info = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
++    info.imageType     = VK_IMAGE_TYPE_2D;
++    info.extent.width  = width;
++    info.extent.height = height;
++    info.extent.depth  = 1;
++    info.mipLevels     = 1;
++    info.arrayLayers   = 1;
++    /* MUTABLE: plane views of P010, UNORM views of the colour formats. */
++    info.flags         = VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
++    info.usage         = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
++                         VK_IMAGE_USAGE_TRANSFER_DST_BIT;
++    info.format        = pw_vk_format(format);
++    info.samples       = VK_SAMPLE_COUNT_1_BIT;
++    info.sharingMode   = VK_SHARING_MODE_EXCLUSIVE;
++    info.tiling        = VK_IMAGE_TILING_OPTIMAL;
++
++    pyrowave_image_create_info create = { 0 };
++    create.device            = s->device;
++    create.external_handle   = (pyrowave_os_handle)handle;
++    create.handle_type       = VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D11_TEXTURE_BIT;
++    create.image_create_info = &info;
++
++    r = pyrowave_image_create(&create, &s->image);
++    if (r != PYROWAVE_SUCCESS) {
++        av_log(avctx, AV_LOG_ERROR, "Vulkan cannot import the shared texture: %s\n", pw_result_name(r));
++        s->image = NULL;
++        pw_release_shared(s);
++        return AVERROR_EXTERNAL;
++    }
++
++    s->shared_format = format;
++    s->shared_width  = width;
++    s->shared_height = height;
++    av_log(avctx, AV_LOG_VERBOSE, "Shared texture %dx%d (DXGI format %d) imported in Vulkan\n",
++           width, height, format);
++    return 0;
++}
++
++static void pw_set_extradata(AVCodecContext *avctx)
++{
++    PyroWaveD3D11Context *s = avctx->priv_data;
++    uint8_t *h = avctx->extradata;
++
++    memcpy(h, "KNPW", 4);
++    h[4] = 1;
++    h[5] = s->chroma444 && !s->hdr ? 1 : 0;
++    h[6] = s->hdr ? 1 : 0;
++    h[7] = s->hdr ? 1 : 0;
++    AV_WL32(h + 8, s->width);
++    AV_WL32(h + 12, s->height);
++}
++
++static av_cold int pw_close(AVCodecContext *avctx)
++{
++    PyroWaveD3D11Context *s = avctx->priv_data;
++
++    if (s->encoder)
++        pyrowave_encoder_destroy(s->encoder);
++    s->encoder = NULL;
++    pw_release_shared(s);
++    if (s->sync)
++        pyrowave_sync_object_destroy(s->sync);
++    s->sync = NULL;
++    if (s->device)
++        pyrowave_device_destroy(s->device);
++    s->device = NULL;
++    if (s->fence)
++        ID3D11Fence_Release(s->fence);
++    s->fence = NULL;
++    if (s->context4)
++        ID3D11DeviceContext4_Release(s->context4);
++    s->context4 = NULL;
++    if (s->device5)
++        ID3D11Device5_Release(s->device5);
++    s->device5 = NULL;
++    av_buffer_unref(&s->frames_ref);
++    av_freep(&s->packets);
++    s->nb_packets_alloc = 0;
++    return 0;
++}
++
++static av_cold int pw_init(AVCodecContext *avctx)
++{
++    PyroWaveD3D11Context *s = avctx->priv_data;
++    AVHWFramesContext *hwfc;
++    IDXGIDevice *dxgi_device = NULL;
++    IDXGIAdapter *adapter = NULL;
++    DXGI_ADAPTER_DESC adapter_desc;
++    HANDLE fence_handle = NULL;
++    HRESULT hr;
++    pyrowave_result r;
++    VkQueueGlobalPriority priority;
++    uint32_t major, minor, patch;
++
++    if (!avctx->hw_frames_ctx) {
++        av_log(avctx, AV_LOG_ERROR, "PyroWave takes D3D11 frames only (no hw_frames_ctx)\n");
++        return AVERROR(EINVAL);
++    }
++    hwfc = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
++    if (hwfc->format != AV_PIX_FMT_D3D11 ||
++        (hwfc->sw_format != AV_PIX_FMT_BGRA && hwfc->sw_format != AV_PIX_FMT_P010)) {
++        av_log(avctx, AV_LOG_ERROR, "PyroWave takes D3D11 frames in BGRA or P010, not %s\n",
++               av_get_pix_fmt_name(hwfc->sw_format));
++        return AVERROR(EINVAL);
++    }
++    s->frames_ref = av_buffer_ref(avctx->hw_frames_ctx);
++    if (!s->frames_ref)
++        return AVERROR(ENOMEM);
++    s->d3d = hwfc->device_ctx->hwctx;
++    s->hdr = hwfc->sw_format == AV_PIX_FMT_P010;
++
++    s->width  = s->out_width  > 0 ? s->out_width  : avctx->width;
++    s->height = s->out_height > 0 ? s->out_height : avctx->height;
++    /* 4:4:4 in SDR only: the HDR10 capture is P010 (4:2:0). */
++    if (s->chroma444 && s->hdr) {
++        av_log(avctx, AV_LOG_WARNING, "4:4:4 refused with HDR10 (P010 capture): 4:2:0\n");
++        s->chroma444 = 0;
++    }
++    if (!s->chroma444 && ((s->width | s->height) & 1)) {
++        av_log(avctx, AV_LOG_ERROR, "4:2:0 needs an even size, not %dx%d\n", s->width, s->height);
++        return AVERROR(EINVAL);
++    }
++
++    pyrowave_get_api_version(&major, &minor, &patch);
++    if (major != PYROWAVE_API_VERSION_MAJOR) {
++        av_log(avctx, AV_LOG_ERROR, "PyroWave API %u.%u.%u, %d.x expected\n",
++               major, minor, patch, PYROWAVE_API_VERSION_MAJOR);
++        return AVERROR_EXTERNAL;
++    }
++
++    hr = ID3D11Device_QueryInterface(s->d3d->device, &IID_ID3D11Device5, (void **)&s->device5);
++    if (SUCCEEDED(hr))
++        hr = ID3D11DeviceContext_QueryInterface(s->d3d->device_context, &IID_ID3D11DeviceContext4,
++                                                (void **)&s->context4);
++    if (FAILED(hr)) {
++        av_log(avctx, AV_LOG_ERROR, "D3D11.4 (shared fences) unavailable: 0x%lx\n", (long)hr);
++        return AVERROR_EXTERNAL;
++    }
++
++    /* The Vulkan device of the same adapter. */
++    hr = ID3D11Device_QueryInterface(s->d3d->device, &IID_IDXGIDevice, (void **)&dxgi_device);
++    if (SUCCEEDED(hr)) {
++        hr = IDXGIDevice_GetAdapter(dxgi_device, &adapter);
++        IDXGIDevice_Release(dxgi_device);
++    }
++    if (SUCCEEDED(hr)) {
++        hr = IDXGIAdapter_GetDesc(adapter, &adapter_desc);
++        IDXGIAdapter_Release(adapter);
++    }
++    if (FAILED(hr)) {
++        av_log(avctx, AV_LOG_ERROR, "Cannot read the adapter of the capture: 0x%lx\n", (long)hr);
++        return AVERROR_EXTERNAL;
++    }
++
++    switch (s->gpu_priority) {
++    case 0:  priority = VK_QUEUE_GLOBAL_PRIORITY_MEDIUM;   break;
++    case 2:  priority = VK_QUEUE_GLOBAL_PRIORITY_REALTIME; break;
++    default: priority = VK_QUEUE_GLOBAL_PRIORITY_HIGH;     break;
++    }
++    av_assert0(sizeof(adapter_desc.AdapterLuid) == sizeof(pyrowave_luid));
++    r = pyrowave_create_device_by_compat(0, 0, NULL, NULL, (const pyrowave_luid *)&adapter_desc.AdapterLuid,
++                                         priority, &s->device);
++    if (r != PYROWAVE_SUCCESS) {
++        av_log(avctx, AV_LOG_ERROR, "No suitable Vulkan 1.3 device on this adapter: %s\n", pw_result_name(r));
++        s->device = NULL;
++        return AVERROR_EXTERNAL;
++    }
++    if (!pyrowave_device_confirm_interop_support(s->device)) {
++        av_log(avctx, AV_LOG_ERROR, "The Vulkan device cannot import D3D11 textures and fences\n");
++        return AVERROR_EXTERNAL;
++    }
++    av_log(avctx, AV_LOG_INFO, "PyroWave %u.%u.%u on %ls, queue priority %d (got %d)\n",
++           major, minor, patch, adapter_desc.Description, priority,
++           pyrowave_device_get_global_priority(s->device));
++
++    /* The fence D3D11 signals after its copy, Vulkan waits on. */
++    hr = ID3D11Device5_CreateFence(s->device5, 0, D3D11_FENCE_FLAG_SHARED, &IID_ID3D11Fence, (void **)&s->fence);
++    if (SUCCEEDED(hr))
++        hr = ID3D11Fence_CreateSharedHandle(s->fence, NULL, GENERIC_ALL, NULL, &fence_handle);
++    if (FAILED(hr)) {
++        av_log(avctx, AV_LOG_ERROR, "Cannot create the shared fence: 0x%lx\n", (long)hr);
++        return AVERROR_EXTERNAL;
++    }
++    pyrowave_sync_object_create_info sync_info = { 0 };
++    sync_info.device          = s->device;
++    sync_info.external_handle = (pyrowave_os_handle)fence_handle;
++    sync_info.handle_type     = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_D3D12_FENCE_BIT;
++    sync_info.semaphore_type  = VK_SEMAPHORE_TYPE_TIMELINE;
++    r = pyrowave_sync_object_create(&sync_info, &s->sync);
++    if (r != PYROWAVE_SUCCESS) {
++        av_log(avctx, AV_LOG_ERROR, "Vulkan cannot import the shared fence: %s\n", pw_result_name(r));
++        s->sync = NULL;
++        return AVERROR_EXTERNAL;
++    }
++
++    pyrowave_encoder_create_info enc_info = { 0 };
++    enc_info.device = s->device;
++    enc_info.width  = s->width;
++    enc_info.height = s->height;
++    enc_info.chroma = s->chroma444 ? PYROWAVE_CHROMA_SUBSAMPLING_444 : PYROWAVE_CHROMA_SUBSAMPLING_420;
++    r = pyrowave_encoder_create(&enc_info, &s->encoder);
++    if (r != PYROWAVE_SUCCESS) {
++        av_log(avctx, AV_LOG_ERROR, "Cannot create the encoder (%dx%d): %s\n",
++               s->width, s->height, pw_result_name(r));
++        s->encoder = NULL;
++        return AVERROR_EXTERNAL;
++    }
++
++    /* Global header: the sinks send it as the stream's config packet. */
++    avctx->extradata = av_mallocz(KNPW_HEADER_SIZE + AV_INPUT_BUFFER_PADDING_SIZE);
++    if (!avctx->extradata)
++        return AVERROR(ENOMEM);
++    avctx->extradata_size = KNPW_HEADER_SIZE;
++    pw_set_extradata(avctx);
++
++    avctx->color_range = s->hdr ? AVCOL_RANGE_MPEG : AVCOL_RANGE_JPEG;
++    av_log(avctx, AV_LOG_INFO, "PyroWave encoder %dx%d %s, %s, input %dx%d %s, packets of %d bytes\n",
++           s->width, s->height, s->chroma444 ? "4:4:4" : "4:2:0",
++           s->hdr ? "HDR10 (PQ, BT.2020, limited)" : "SDR (BT.709, full)",
++           avctx->width, avctx->height, av_get_pix_fmt_name(hwfc->sw_format), s->packet_size);
++    return 0;
++}
