+
+/// Opus quality preset (`[kyavserver] audio_quality`).
+#[derive(Clone, Copy, Debug, Default, Deserialize, PartialEq)]
+#[serde(rename_all = "lowercase")]
+pub(crate) enum AudioQuality {
+    /// 128 kbit/s whatever the channel count (Kyber's historical value).
+    Standard,
+    /// 256 kbit/s in stereo, 96 kbit/s per channel beyond.
+    #[default]
+    Hd,
+    /// The most libopus accepts: 510 kbit/s in stereo, 256 kbit/s per channel beyond.
+    Studio,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct AudioBitrate {
+    pub quality: AudioQuality,
+    /// Explicit bitrate, wins over the preset.
+    pub bitrate: Option<u32>,
+}
+
+/// Opus bitrate (bits/s) for `channels` captured channels, clamped to what
+/// libopus accepts: 6 kbit/s to 510 kbit/s up to stereo, 256 kbit/s per
+/// channel in multichannel.
+pub(crate) fn opus_bitrate(channels: i32, audio: AudioBitrate) -> i64 {
+    let channels = i64::from(channels.max(1));
+    let max = if channels <= 2 { 510_000 } else { channels * 256_000 };
+    let preset = match audio.quality {
+        AudioQuality::Standard => 128_000,
+        AudioQuality::Hd => (channels * 96_000).max(256_000),
+        AudioQuality::Studio => max,
+    };
+    audio.bitrate.map_or(preset, i64::from).clamp(6_000, max)
 }
