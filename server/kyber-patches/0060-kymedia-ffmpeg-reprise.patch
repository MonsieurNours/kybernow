+From: KyberNow
+Subject: [PATCH] avcodec: repair a receiver's loss without a keyframe (NVENC, VideoToolbox)
+
+ref_recovery keeps the references a repair needs. ref_recover asks that
+the next frame depend only on frames up to a pts (the last one a receiver
+decoded): NVENC invalidates the newer frames when that one is still in
+the DPB (4 frames at least), else predicts from the newest long-term
+reference up to it (2 kept, one marked every ref_ltr_ms), else encodes an
+IDR. VideoToolbox acknowledges the long-term references up to it and asks
+for an LTR refresh, else a keyframe. ref_method and ref_bound tell the
+caller how, and the newest pts the frame may depend on. KyberNow,
+docs/reprise-apres-perte.md.
+---
+diff --git a/libavcodec/nvenc.c b/libavcodec/nvenc.c
+index d67166a..c3aca9e 100644
+--- a/libavcodec/nvenc.c
++++ b/libavcodec/nvenc.c
+@@ -680,6 +680,10 @@ static int nvenc_check_capabilities(AVCodecContext *avctx)
+ 
+     ctx->support_dyn_bitrate = nvenc_check_cap(avctx, NV_ENC_CAPS_SUPPORT_DYN_BITRATE_CHANGE);
+ 
++    /* KyberNow: what a repair without a keyframe can use (ref_recovery). */
++    ctx->ref_rfi = nvenc_check_cap(avctx, NV_ENC_CAPS_SUPPORT_REF_PIC_INVALIDATION) > 0;
++    ctx->ref_ltr = FFMIN(FFMAX(nvenc_check_cap(avctx, NV_ENC_CAPS_NUM_MAX_LTR_FRAMES), 0), NVENC_REF_LTR);
++
+ #ifdef NVENC_HAVE_MVHEVC
+     ctx->multiview_supported = nvenc_check_cap(avctx, NV_ENC_CAPS_SUPPORT_MVHEVC_ENCODE) > 0;
+     if(ctx->profile == NV_ENC_HEVC_PROFILE_MULTIVIEW_MAIN && !ctx->multiview_supported) {
+@@ -1268,6 +1272,38 @@ static av_cold int nvenc_setup_rate_control(AVCodecContext *avctx)
+     return 0;
+ }
+ 
++/* KyberNow: the references a repair without a keyframe needs (ref_recovery):
++ * a DPB of 4 frames at least, so that an invalidation finds an older frame
++ * (ultra low latency keeps only 1 by default), and long-term references,
++ * which exclude B-frames. False when the device has neither. */
++static av_cold int nvenc_ref_setup(AVCodecContext *avctx)
++{
++    NvencContext *ctx = avctx->priv_data;
++    int i;
++
++    for (i = 0; i < NVENC_REF_FRAMES; i++)
++        ctx->ref_sent[i] = AV_NOPTS_VALUE;
++    for (i = 0; i < NVENC_REF_LTR; i++)
++        ctx->ref_slot[i] = AV_NOPTS_VALUE;
++    ctx->ref_marked_at = AV_NOPTS_VALUE;
++    ctx->ref_method = NVENC_REF_NONE;
++    ctx->ref_bound = AV_NOPTS_VALUE;
++
++    if (!ctx->ref_recovery)
++        return 0;
++    if (ctx->encode_config.frameIntervalP > 1)
++        ctx->ref_ltr = 0;
++    if (!ctx->ref_rfi && !ctx->ref_ltr) {
++        av_log(avctx, AV_LOG_WARNING, "No invalidation nor long-term reference: losses are repaired by IDR\n");
++        ctx->ref_recovery = 0;
++        return 0;
++    }
++    ctx->ref_dpb = FFMAX(ctx->dpb_size, 4);
++    av_log(avctx, AV_LOG_VERBOSE, "Repairs without keyframe: DPB %d, invalidation %s, %d long-term references\n",
++           ctx->ref_dpb, ctx->ref_rfi ? "yes" : "no", ctx->ref_ltr);
++    return 1;
++}
++
+ static av_cold int nvenc_setup_h264_config(AVCodecContext *avctx)
+ {
+     NvencContext *ctx                      = avctx->priv_data;
+@@ -1329,6 +1365,16 @@ static av_cold int nvenc_setup_h264_config(AVCodecContext *avctx)
+         h264->maxNumRefFrames = ctx->dpb_size;
+     }
+ 
++    /* KyberNow: references kept for a repair without a keyframe. */
++    if (nvenc_ref_setup(avctx)) {
++        h264->maxNumRefFrames = ctx->ref_dpb;
++        if (ctx->ref_ltr > 0) {
++            h264->enableLTR    = 1;
++            h264->ltrTrustMode = 0;
++            h264->ltrNumFrames = ctx->ref_ltr;
++        }
++    }
++
+     h264->idrPeriod = cc->gopLength;
+ 
+     if (IS_CBR(cc->rcParams.rateControlMode)) {
+@@ -1533,6 +1579,16 @@ static av_cold int nvenc_setup_hevc_config(AVCodecContext *avctx)
+         hevc->maxNumRefFramesInDPB = ctx->dpb_size;
+     }
+ 
++    /* KyberNow: references kept for a repair without a keyframe. */
++    if (nvenc_ref_setup(avctx)) {
++        hevc->maxNumRefFramesInDPB = ctx->ref_dpb;
++        if (ctx->ref_ltr > 0) {
++            hevc->enableLTR    = 1;
++            hevc->ltrTrustMode = 0;
++            hevc->ltrNumFrames = ctx->ref_ltr;
++        }
++    }
++
+     hevc->idrPeriod = cc->gopLength;
+ 
+     if (IS_CBR(cc->rcParams.rateControlMode)) {
+@@ -2603,6 +2659,158 @@ static void nvenc_fill_time_code(AVCodecContext *avctx, const AVFrame *frame, NV
+ }
+ #endif
