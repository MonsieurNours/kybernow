++/* KyberNow: an IDR (asked for or chosen by the encoder) ends every reference
++ * before it. */
++static void nvenc_ref_forget_before(NvencContext *ctx, int64_t pts)
++{
++    int i;
++
++    for (i = 0; i < NVENC_REF_FRAMES; i++)
++        if (ctx->ref_sent[i] != AV_NOPTS_VALUE && ctx->ref_sent[i] < pts)
++            ctx->ref_sent[i] = AV_NOPTS_VALUE;
++    for (i = 0; i < NVENC_REF_LTR; i++)
++        if (ctx->ref_slot[i] != AV_NOPTS_VALUE && ctx->ref_slot[i] < pts)
++            ctx->ref_slot[i] = AV_NOPTS_VALUE;
++}
++
++/* KyberNow: repair asked for (ref_recover) and long-term marks, for the frame
++ * about to be encoded. The frame may only depend on frames up to the pts
++ * asked for, the last one the receiver decoded:
++ *  - invalidation of the newer frames, when that one is still in the DPB;
++ *  - else, prediction from the newest long-term reference up to it;
++ *  - else, an IDR.
++ * The frames past the bound are forgotten: never a reference again. */
++static void nvenc_ref_before_frame(AVCodecContext *avctx, const AVFrame *frame,
++                                   NV_ENC_PIC_PARAMS *params, int *mark, int *use)
++{
++    NvencContext *ctx = avctx->priv_data;
++    NV_ENCODE_API_FUNCTION_LIST *p_nvenc = &ctx->nvenc_dload_funcs.nvenc_funcs;
++    int64_t bound = ctx->ref_recover;
++    int i;
++
++    *mark = -1;
++    *use = 0;
++    ctx->ref_recover = AV_NOPTS_VALUE;
++    if (!ctx->ref_recovery)
++        return;
++
++    if (bound != AV_NOPTS_VALUE) {
++        int method = NVENC_REF_KEYFRAME, newer = 0, slot = -1;
++        /* The newest frame sent up to the bound: the caller may name the
++         * first frame lost minus one rather than the last one received. */
++        int64_t kept = AV_NOPTS_VALUE;
++
++        for (i = 0; i < NVENC_REF_FRAMES; i++) {
++            if (ctx->ref_sent[i] == AV_NOPTS_VALUE)
++                continue;
++            if (ctx->ref_sent[i] > bound)
++                newer++;
++            else if (kept == AV_NOPTS_VALUE || ctx->ref_sent[i] > kept)
++                kept = ctx->ref_sent[i];
++        }
++        ctx->ref_bound = AV_NOPTS_VALUE;
++
++        if (params->encodePicFlags & NV_ENC_PIC_FLAG_FORCEIDR) {
++            /* An IDR on its way repairs everything. */
++        } else if (ctx->ref_rfi && kept != AV_NOPTS_VALUE && newer < ctx->ref_dpb) {
++            method = NVENC_REF_INVALIDATION;
++            for (i = 0; i < NVENC_REF_FRAMES; i++) {
++                NVENCSTATUS st;
++                if (ctx->ref_sent[i] == AV_NOPTS_VALUE || ctx->ref_sent[i] <= bound)
++                    continue;
++                st = p_nvenc->nvEncInvalidateRefFrames(ctx->nvencoder, ctx->ref_sent[i]);
++                if (st != NV_ENC_SUCCESS) {
++                    nvenc_print_error(avctx, st, "InvalidateRefFrames failed");
++                    method = NVENC_REF_KEYFRAME;
++                    break;
++                }
++            }
++            if (method == NVENC_REF_INVALIDATION)
++                ctx->ref_bound = kept;
++        }
++        if (method == NVENC_REF_KEYFRAME && !(params->encodePicFlags & NV_ENC_PIC_FLAG_FORCEIDR)) {
++            for (i = 0; i < ctx->ref_ltr; i++)
++                if (ctx->ref_slot[i] != AV_NOPTS_VALUE && ctx->ref_slot[i] <= bound &&
++                    (slot < 0 || ctx->ref_slot[i] > ctx->ref_slot[slot]))
++                    slot = i;
++            if (slot >= 0) {
++                method = NVENC_REF_LONG_TERM;
++                *use = 1 << slot;
++                ctx->ref_bound = ctx->ref_slot[slot];
++                /* The short-term frames past the bound, when the device
++                 * can: never a reference again (errors do not matter, the
++                 * frame only uses the long-term one). */
++                if (ctx->ref_rfi)
++                    for (i = 0; i < NVENC_REF_FRAMES; i++)
++                        if (ctx->ref_sent[i] != AV_NOPTS_VALUE && ctx->ref_sent[i] > bound)
++                            p_nvenc->nvEncInvalidateRefFrames(ctx->nvencoder, ctx->ref_sent[i]);
++            }
++        }
++
++        if (method == NVENC_REF_KEYFRAME) {
++            params->encodePicFlags |= NV_ENC_PIC_FLAG_FORCEIDR;
++        } else {
++            for (i = 0; i < NVENC_REF_FRAMES; i++)
++                if (ctx->ref_sent[i] != AV_NOPTS_VALUE && ctx->ref_sent[i] > bound)
++                    ctx->ref_sent[i] = AV_NOPTS_VALUE;
++            for (i = 0; i < NVENC_REF_LTR; i++)
++                if (ctx->ref_slot[i] != AV_NOPTS_VALUE && ctx->ref_slot[i] > bound)
++                    ctx->ref_slot[i] = AV_NOPTS_VALUE;
++        }
++        ctx->ref_method = method;
++        av_log(avctx, AV_LOG_VERBOSE, "Repair up to %"PRId64" at %"PRId64": %s\n", bound, frame->pts,
++               method == NVENC_REF_INVALIDATION ? "invalidation" :
++               method == NVENC_REF_LONG_TERM ? "long-term reference" : "IDR");
++    }
++
++    if (params->encodePicFlags & NV_ENC_PIC_FLAG_FORCEIDR) {
++        for (i = 0; i < NVENC_REF_FRAMES; i++)
++            ctx->ref_sent[i] = AV_NOPTS_VALUE;
++        for (i = 0; i < NVENC_REF_LTR; i++)
++            ctx->ref_slot[i] = AV_NOPTS_VALUE;
++    }
++
++    /* A long-term mark every ref_ltr_ms (an IDR at once), in turn over the
++     * slots, never on the repairing frame itself. */
++    if (ctx->ref_ltr > 0 && !*use &&
++        (ctx->ref_marked_at == AV_NOPTS_VALUE || (params->encodePicFlags & NV_ENC_PIC_FLAG_FORCEIDR) ||
++         frame->pts - ctx->ref_marked_at >=
++             av_rescale_q(ctx->ref_ltr_ms, (AVRational){ 1, 1000 }, avctx->time_base) ||
++         frame->pts < ctx->ref_marked_at)) {
++        *mark = ctx->ref_slot_next;
++        ctx->ref_slot[*mark] = frame->pts;
++        ctx->ref_slot_next = (ctx->ref_slot_next + 1) % ctx->ref_ltr;
++        ctx->ref_marked_at = frame->pts;
++    }
++
++    ctx->ref_sent[ctx->ref_sent_next] = frame->pts;
++    ctx->ref_sent_next = (ctx->ref_sent_next + 1) % NVENC_REF_FRAMES;
++}
++
++static void nvenc_ref_pic_params(AVCodecContext *avctx, const AVFrame *frame,
++                                 NV_ENC_PIC_PARAMS *params)
++{
++    int mark, use;
++
++    nvenc_ref_before_frame(avctx, frame, params, &mark, &use);
++    switch (avctx->codec->id) {
++    case AV_CODEC_ID_H264:
++        params->codecPicParams.h264PicParams.ltrMarkFrame = mark >= 0;
++        params->codecPicParams.h264PicParams.ltrMarkFrameIdx = FFMAX(mark, 0);
++        params->codecPicParams.h264PicParams.ltrUseFrames = use != 0;
++        params->codecPicParams.h264PicParams.ltrUseFrameBitmap = use;
++        break;
++    case AV_CODEC_ID_HEVC:
++        params->codecPicParams.hevcPicParams.ltrMarkFrame = mark >= 0;
++        params->codecPicParams.hevcPicParams.ltrMarkFrameIdx = FFMAX(mark, 0);
++        params->codecPicParams.hevcPicParams.ltrUseFrames = use != 0;
++        params->codecPicParams.hevcPicParams.ltrUseFrameBitmap = use;
++        break;
++    default:
++        break;
++    }
++}
++
