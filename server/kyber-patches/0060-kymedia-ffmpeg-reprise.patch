++    if (ctx->ref_recovery && (pkt->flags & AV_PKT_FLAG_KEY))
++        nvenc_ref_forget_before(ctx, pkt->pts);
++
+     res = nvenc_retrieve_frame_data(avctx, &lock_params, pkt);
+     if (res < 0)
+         goto error2;
+@@ -3311,6 +3523,11 @@ static int nvenc_send_frame(AVCodecContext *avctx, const AVFrame *frame)
+     if (res < 0)
+         return res;
+ 
