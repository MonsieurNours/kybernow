+                                             NV_ENC_PIC_PARAMS *params,
+                                             NV_ENC_SEI_PAYLOAD *sei_data,
+@@ -2866,6 +3074,10 @@ static int process_output_surface(AVCodecContext *avctx, AVPacket *pkt, NvencSur
+     if (res < 0)
