diff --git a/kyavservice/src/pyrowave.rs b/kyavservice/src/pyrowave.rs
new file mode 100644
index 0000000..4854f70
--- /dev/null
+++ b/kyavservice/src/pyrowave.rs
@@ -0,0 +1,100 @@
+// KyberNow (0025): PyroWave (docs/pyrowave.md). The client asks for it only
+// when the Station announces it (KyberNow Admin, `GET /api/stream/info`); the
+// Station encodes it only when `[kyavserver] pyrowave` allows it (true by
+// default) and on Windows, where the FFmpeg encoder `libpyrowave` takes the
+// D3D11 frames of the capture (BGRA, or P010 in HDR10) without a CPU copy.
+// kycontroller already put the client's fallback codec in its place
+// otherwise; checked again here (H.264), the client learns it from the
+// stream's codec packet. What both engines share is here.
+
+use kyavservice_types::{VideoCodec, VideoScale};
+
+use crate::config::GpuPriority;
+
+/// FFmpeg encoder of the PyroWave patch (packagefiles/ffmpeg).
+pub(crate) const ENCODER: &str = "libpyrowave";
+
+/// The codec the Station encodes, and why PyroWave was turned down.
+pub(crate) fn resolve(codec: VideoCodec, enabled: bool, windows: bool) -> (VideoCodec, Option<String>) {
+    if codec != VideoCodec::PyroWave {
+        return (codec, None);
+    }
+    let reason = if !windows {
+        "PyroWave refused: Windows Station only"
+    } else if !enabled {
+        "PyroWave refused: [kyavserver] pyrowave = false"
+    } else {
+        return (codec, None);
+    };
+    (VideoCodec::H264, Some(format!("{reason}: H264 instead")))
+}
+
+/// Options of the `libpyrowave` encoder: bitrate (the frame budget is
+/// bitrate / 8 / fps), 4:4:4 (SDR only), a guest's own image scaled down on
+/// the graphics card by PyroWave itself, its capped rate, and the Vulkan
+/// queue priority (`gpu_priority`).
+pub(crate) fn options(
+    bitrate: u32,
+    yuv444: bool,
+    scale: Option<VideoScale>,
+    max_fps: Option<u32>,
+    gpu_priority: GpuPriority,
+) -> Vec<(&'static str, String)> {
+    let mut options = vec![
+        ("b", bitrate.to_string()),
+        ("chroma444", u8::from(yuv444).to_string()),
+        ("gpu_priority", gpu_priority.capture_option().to_string()),
+    ];
+    if let Some(VideoScale { width, height }) = scale {
+        options.push(("out_width", width.to_string()));
+        options.push(("out_height", height.to_string()));
+    }
+    if let Some(fps) = max_fps {
+        options.push(("fps", fps.to_string()));
+    }
+    options
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn other_codecs_are_kept() {
+        for codec in [VideoCodec::H264, VideoCodec::HEVC, VideoCodec::AV1] {
+            assert_eq!(resolve(codec.clone(), false, false), (codec, None));
+        }
+    }
+
+    #[test]
+    fn pyrowave_on_a_windows_station_that_offers_it() {
+        assert_eq!(resolve(VideoCodec::PyroWave, true, true), (VideoCodec::PyroWave, None));
+    }
+
+    #[test]
+    fn pyrowave_turned_down_falls_back_to_h264() {
+        let (codec, reason) = resolve(VideoCodec::PyroWave, false, true);
+        assert_eq!(codec, VideoCodec::H264);
+        assert!(reason.unwrap().contains("pyrowave = false"));
+        let (codec, reason) = resolve(VideoCodec::PyroWave, true, false);
+        assert_eq!(codec, VideoCodec::H264);
+        assert!(reason.unwrap().contains("Windows"));
+    }
+
+    #[test]
+    fn encoder_options() {
+        let options = options(
+            200_000_000,
+            false,
+            Some(VideoScale { width: 1280, height: 720 }),
+            Some(30),
+            GpuPriority::High,
+        );
+        let get = |key| options.iter().find(|(k, _)| *k == key).map(|(_, v)| v.as_str());
+        assert_eq!(get("b"), Some("200000000"));
+        assert_eq!(get("chroma444"), Some("0"));
+        assert_eq!((get("out_width"), get("out_height")), (Some("1280"), Some("720")));
+        assert_eq!(get("fps"), Some("30"));
+        assert_eq!(get("gpu_priority"), Some("1"));
+    }
+}
