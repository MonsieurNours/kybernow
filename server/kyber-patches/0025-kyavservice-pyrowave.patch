+/// KyberNow (0025): PyroWave (docs/pyrowave.md), whatever the configured
+/// encoder: the `libpyrowave` encoder takes the D3D11 capture as is (BGRA,
+/// or P010 in HDR10) and scales a guest's own image down itself.
+fn create_pyrowave(
+    ctx: &Txproto,
+    config: &VideoConfig,
+    video_source: &txproto_rs::Handle,
+) -> Result<txproto_rs::Handle> {
+    let mut options: Vec<DictionaryEntry> = crate::pyrowave::options(
+        config.bitrate,
+        config.yuv444,
+        config.scale,
+        config.max_fps,
+        config.gpu_priority,
+    )
+    .into_iter()
+    .map(|(key, value)| (key, value.as_str()).into())
+    .collect();
+    options.push(("flags", "+global_header").into());
+
+    print_options("pyrowave", &options);
+    let options = Dictionary::from_entries(&options)?;
+    let init_opts = Dictionary::from_entries(&[("fifo_size", 1).into()])?;
+
+    let enc_name = crate::pyrowave::ENCODER;
+    let encoder_config = txproto_rs::EncoderConfig {
+        enc_name,
+        options: Some(options),
+        init_opts: Some(init_opts),
+        ..Default::default()
+    };
+
+    info!("Create encoder {enc_name}");
+    let encoder = ctx.create_encoder(encoder_config)?;
+    ctx.link(video_source, &encoder, 0)?;
+
+    Ok(encoder)
+}
