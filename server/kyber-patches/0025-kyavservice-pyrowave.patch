new file mode 100644
index 0000000..3c86ed3
--- /dev/null
+++ b/kyavservice/src/pyrowave.rs
@@ -0,0 +1,177 @@
+// KyberNow (0025): PyroWave (docs/pyrowave.md). The client asks for it only
+// when the Station announces it (KyberNow Admin, `GET /api/stream/info`); the
+// Station encodes it only when `[kyavserver] pyrowave` allows it (true by
+// default) and with an engine that has a PyroWave encoder on this system,
+// which takes the frames of the capture without a CPU copy. kycontroller
+// already put the client's fallback codec in its place otherwise; checked
+// again here, with the same fallback, the client learns it from the
+// stream's codec packet. What both engines and the three Stations share is
+// here: server/macos/kyber-patches/0017 and server/linux/kyber-patches/0011
+// only add what their capture needs.
+
+use kyavservice_types::{VideoCodec, VideoScale};
+
+use crate::config::{Backend, GpuPriority};
+
+/// FFmpeg encoder of the PyroWave patches (packagefiles/ffmpeg): the D3D11
+/// frames of Windows (`libpyrowave`), the VideoToolbox frames of
+/// ScreenCaptureKit on a Mac (`libpyrowave_metal`, Mac 0016), the DMA-BUF
+/// frames of PipeWire on Linux (`libpyrowave_vulkan`, Linux 0010). Same
+/// options, same packets.
+pub(crate) const ENCODER: &str = if cfg!(target_os = "macos") {
+    "libpyrowave_metal"
+} else if cfg!(target_os = "linux") {
+    "libpyrowave_vulkan"
+} else {
+    "libpyrowave"
+};
+
+/// Whether `engine` encodes PyroWave on this Station: both engines on
+/// Windows, txproto on a Mac (ScreenCaptureKit), libavconv on Linux
+/// (PipeWire). kycontroller applies the same rule (0025-kycontroller).
+pub(crate) fn engine_encodes(engine: Backend) -> bool {
+    match engine {
+        Backend::Txproto => cfg!(any(target_os = "windows", target_os = "macos")),
+        Backend::Libavconv => cfg!(any(target_os = "windows", target_os = "linux")),
+    }
+}
+
+/// The codec the Station encodes, and why PyroWave was turned down: the
+/// client's fallback then (H.264 without one), as kycontroller does.
+pub(crate) fn resolve(
+    codec: VideoCodec,
+    fallback: Option<VideoCodec>,
+    enabled: bool,
+    engine: Backend,
+) -> (VideoCodec, Option<String>) {
+    if codec != VideoCodec::PyroWave {
+        return (codec, None);
+    }
+    let reason = if !engine_encodes(engine) {
+        format!("PyroWave refused: no PyroWave encoder in the {engine:?} engine on this system")
+    } else if !enabled {
+        "PyroWave refused: [kyavserver] pyrowave = false".to_string()
+    } else {
+        return (codec, None);
+    };
+    let fallback = fallback.filter(|c| *c != VideoCodec::PyroWave).unwrap_or(VideoCodec::H264);
+    let message = format!("{reason}: {fallback:?} instead");
+    (fallback, Some(message))
+}
+
+/// Options of the PyroWave encoder: bitrate (the frame budget is
+/// bitrate / 8 / fps), 4:4:4 (SDR only), a guest's own image scaled down on
+/// the graphics card by PyroWave itself, its capped rate, the GPU queue
+/// priority (`gpu_priority`, Vulkan) and the configuration packet the
+/// client reads (`header_version`: 2 only when it said so, 0.11.8 or
+/// newer; an older app reads only the 16 bytes of version 1).
+pub(crate) fn options(
+    bitrate: u32,
+    yuv444: bool,
+    scale: Option<VideoScale>,
+    max_fps: Option<u32>,
+    gpu_priority: GpuPriority,
+    header: u8,
+) -> Vec<(&'static str, String)> {
+    let mut options = vec![
+        ("b", bitrate.to_string()),
+        ("chroma444", u8::from(yuv444).to_string()),
+        ("gpu_priority", gpu_priority.capture_option().to_string()),
+    ];
+    if let Some(VideoScale { width, height }) = scale {
+        options.push(("out_width", width.to_string()));
+        options.push(("out_height", height.to_string()));
+    }
+    if let Some(fps) = max_fps {
+        options.push(("fps", fps.to_string()));
+    }
+    if header >= 2 {
+        options.push(("header_version", "2".to_string()));
+    }
+    options
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn other_codecs_are_kept() {
+        for codec in [VideoCodec::H264, VideoCodec::HEVC, VideoCodec::AV1] {
+            assert_eq!(resolve(codec.clone(), None, false, Backend::Txproto), (codec, None));
+        }
+    }
+
+    #[test]
+    fn the_encoder_and_engines_of_this_station() {
+        let expected = if cfg!(target_os = "macos") {
+            "libpyrowave_metal"
+        } else if cfg!(target_os = "linux") {
+            "libpyrowave_vulkan"
+        } else {
+            "libpyrowave"
+        };
+        assert_eq!(ENCODER, expected);
+        assert_eq!(engine_encodes(Backend::Txproto), cfg!(any(windows, target_os = "macos")));
+        assert_eq!(engine_encodes(Backend::Libavconv), cfg!(any(windows, target_os = "linux")));
+    }
+
+    #[test]
+    fn pyrowave_where_the_engine_encodes_it() {
+        for engine in [Backend::Txproto, Backend::Libavconv] {
+            let (codec, reason) = resolve(VideoCodec::PyroWave, Some(VideoCodec::HEVC), true, engine);
+            if engine_encodes(engine) {
+                assert_eq!((codec, reason), (VideoCodec::PyroWave, None));
+            } else {
+                // KYB-31: the client's fallback, not H.264.
+                assert_eq!(codec, VideoCodec::HEVC);
+                assert!(reason.unwrap().contains("no PyroWave encoder"));
+            }
+        }
+    }
+
+    #[test]
+    fn pyrowave_turned_down_falls_back_to_the_clients_codec() {
+        let engine = if cfg!(target_os = "linux") { Backend::Libavconv } else { Backend::Txproto };
+        let (codec, reason) = resolve(VideoCodec::PyroWave, Some(VideoCodec::HEVC), false, engine);
+        assert_eq!(codec, VideoCodec::HEVC);
+        assert!(reason.unwrap().contains("pyrowave = false"));
+        let (codec, _) = resolve(VideoCodec::PyroWave, None, false, engine);
+        assert_eq!(codec, VideoCodec::H264);
+        let (codec, _) = resolve(VideoCodec::PyroWave, Some(VideoCodec::PyroWave), false, engine);
+        assert_eq!(codec, VideoCodec::H264);
+    }
+
+    #[test]
+    fn encoder_options() {
+        let options = options(
+            200_000_000,
+            false,
+            Some(VideoScale { width: 1280, height: 720 }),
+            Some(30),
+            GpuPriority::High,
+            1,
+        );
+        let get = |key| options.iter().find(|(k, _)| *k == key).map(|(_, v)| v.as_str());
+        assert_eq!(get("b"), Some("200000000"));
+        assert_eq!(get("chroma444"), Some("0"));
+        assert_eq!((get("out_width"), get("out_height")), (Some("1280"), Some("720")));
+        assert_eq!(get("fps"), Some("30"));
+        assert_eq!(get("gpu_priority"), Some("1"));
+        assert_eq!(get("header_version"), None);
+    }
+
+    #[test]
+    fn the_version_2_header_only_when_the_client_reads_it() {
+        let header = |version| {
+            options(1, false, None, None, GpuPriority::High, version)
+                .into_iter()
+                .find(|(k, _)| *k == "header_version")
+                .map(|(_, v)| v)
+        };
+        assert_eq!(header(0), None);
+        assert_eq!(header(1), None);
+        assert_eq!(header(2).as_deref(), Some("2"));
+        assert_eq!(header(3).as_deref(), Some("2"));
+    }
+}
