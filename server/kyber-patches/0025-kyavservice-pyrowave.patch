+/// KyberNow (0025): AV_CODEC_ID_PYROWAVE comes from the FFmpeg patch of the
+/// Windows build; known by its name, so that FFmpeg without it still builds.
+fn is_pyrowave(codec_id: sys::AVCodecID) -> bool {
+    // Not in libavconv-sys' bindings; libavcodec is linked already.
+    unsafe extern "C" {
+        fn avcodec_get_name(id: sys::AVCodecID) -> *const std::ffi::c_char;
+    }
+    // SAFETY: avcodec_get_name() always returns a static C string.
+    let name = unsafe { std::ffi::CStr::from_ptr(avcodec_get_name(codec_id)) };
+    name.to_bytes() == b"pyrowave"
+}
