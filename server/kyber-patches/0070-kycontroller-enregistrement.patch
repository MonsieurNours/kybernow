+
+    #[test]
+    fn writes_a_file_that_ends_well() {
+        let video = VideoConfig::from_annexb(VideoFormat::Hevc, &annexb(&[&hevc_vps(), &hevc_sps(), &hevc_pps()])).unwrap();
+        let audio = AudioConfig::from_opus_head(&opus_head(2)).unwrap();
+        let mut w = Mp4Writer::new(Cursor::new(Vec::new()), video, Some(&audio)).unwrap();
+        let start = 5_000_000u64;
+        // Sound before the first image: dropped.
+        w.write_audio(start - 20_000, &[0xf8, 1]).unwrap();
+        // A delta frame before the first keyframe: dropped.
+        w.write_video(start - 10_000, false, &annexb(&[&[0x02, 0x01, 7]])).unwrap();
+        for i in 0..150u64 {
+            let key = i % 60 == 0;
+            let nal: &[u8] = if key { &[0x26, 0x01, 1, 2, 3] } else { &[0x02, 0x01, 4] };
+            w.write_video(start + i * 16_667, key, &annexb(&[nal])).unwrap();
+            w.write_audio(start + i * 16_667, &[0xf8, 2, 3]).unwrap();
+        }
+        let duration = w.duration_us();
+        assert!(duration > 2_000_000, "{duration}");
+        let data = w.finish().unwrap().into_inner();
+        let boxes = top_boxes(&data);
+        let kinds: Vec<_> = boxes.iter().map(|(k, _)| k.as_str()).collect();
+        assert_eq!(&kinds[..2], &["ftyp", "moov"]);
+        assert_eq!(kinds.last(), Some(&"mfra"));
+        assert!(kinds.iter().filter(|k| **k == "moof").count() >= 2);
+        // mfro's size matches mfra's.
+        let (_, mfra) = boxes.last().unwrap();
+        let tail = u32::from_be_bytes(data[data.len() - 4..].try_into().unwrap()) as usize;
+        assert_eq!(tail, *mfra);
+        // The duration (ms) is written in mehd.
+        let at = data.windows(4).position(|w| w == b"mehd").unwrap() + 8;
+        let ms = u64::from_be_bytes(data[at..at + 8].try_into().unwrap());
+        assert!((2400..=2600).contains(&ms), "{ms}");
+    }
+
+    #[test]
+    fn sound_of_a_still_screen_is_written() {
+        let video = VideoConfig::from_annexb(VideoFormat::H264, &annexb(&[&h264_sps(), &h264_pps()])).unwrap();
+        let audio = AudioConfig::from_opus_head(&opus_head(2)).unwrap();
+        let mut w = Mp4Writer::new(Cursor::new(Vec::new()), video, Some(&audio)).unwrap();
+        w.write_video(0, true, &annexb(&[&[0x65, 1]])).unwrap();
+        let header = w.len();
+        // Three seconds of sound (20 ms packets), no other image.
+        for i in 0..150u64 {
+            w.write_audio(i * 20_000, &[0xf8, 1, 2]).unwrap();
+        }
+        assert!(w.len() > header, "the sound waits for an image");
+        let data = w.finish().unwrap().into_inner();
+        let moofs = top_boxes(&data).into_iter().filter(|(k, _)| k == "moof").count();
+        assert!(moofs >= 3, "{moofs}");
+    }
+
+    #[test]
+    fn damaged_sps_is_refused() {
+        // profile 100, then ue() fields of 32 bits: chroma, depths…
+        let mut sps = vec![0x67, 100, 0, 40];
+        sps.extend_from_slice(&[0x80]); // seq_parameter_set_id = 0
+        sps.extend_from_slice(&[0x00, 0x00, 0x00, 0x00, 0x01, 0xff, 0xff, 0xff, 0xff]);
+        assert!(parse_h264_sps(&sps).is_none());
+        let mut short = h264_sps();
+        short.truncate(6);
+        assert!(parse_h264_sps(&short).is_none());
+    }
+
+    #[test]
+    fn video_only_file() {
+        let video = VideoConfig::from_annexb(VideoFormat::H264, &annexb(&[&h264_sps(), &h264_pps()])).unwrap();
+        let mut w = Mp4Writer::new(Cursor::new(Vec::new()), video, None).unwrap();
+        w.write_video(0, true, &annexb(&[&[0x65, 1]])).unwrap();
+        w.write_video(16_667, false, &annexb(&[&[0x41, 1]])).unwrap();
+        // Sound without a sound track: ignored.
+        w.write_audio(0, &[0xf8]).unwrap();
+        let data = w.finish().unwrap().into_inner();
+        let kinds: Vec<_> = top_boxes(&data).into_iter().map(|(k, _)| k).collect();
+        assert_eq!(kinds, ["ftyp", "moov", "moof", "mdat", "mfra"]);
+    }
+
+    /// Splits an Annex B stream into access units (a new one at each first
+    /// slice of a picture; parameter sets and SEI go with the next one).
+    fn access_units(format: VideoFormat, data: &[u8]) -> Vec<(bool, Vec<u8>)> {
+        let mut units: Vec<(bool, Vec<u8>)> = Vec::new();
+        let mut prefix: Vec<u8> = Vec::new();
+        for nal in annexb_nals(data) {
+            let t = nal_type(format, nal);
+            let (vcl, key, first) = match format {
+                VideoFormat::H264 => (matches!(t, 1 | 5), t == 5, nal.get(1).is_some_and(|b| b & 0x80 != 0)),
+                VideoFormat::Hevc => (t < 32, (16..=21).contains(&t), nal.get(2).is_some_and(|b| b & 0x80 != 0)),
+            };
+            let mut chunk = vec![0, 0, 0, 1];
+            chunk.extend_from_slice(nal);
+            if !vcl {
+                prefix.extend_from_slice(&chunk);
+            } else if first || units.is_empty() {
+                let mut au = std::mem::take(&mut prefix);
+                au.extend_from_slice(&chunk);
+                units.push((key, au));
+            } else {
+                units.last_mut().unwrap().1.extend_from_slice(&chunk);
+            }
+        }
+        units
+    }
+
+    /// Packets of an Ogg stream.
+    fn ogg_packets(data: &[u8]) -> Vec<Vec<u8>> {
+        let mut out = Vec::new();
+        let mut current = Vec::new();
+        let mut i = 0;
+        while i + 27 <= data.len() && &data[i..i + 4] == b"OggS" {
+            let segments = data[i + 26] as usize;
+            let table = &data[i + 27..i + 27 + segments];
+            let mut at = i + 27 + segments;
+            for &len in table {
+                current.extend_from_slice(&data[at..at + len as usize]);
+                at += len as usize;
+                if len < 255 {
+                    out.push(std::mem::take(&mut current));
+                }
+            }
+            i = at;
+        }
+        out
+    }
+
+    /// Writes real encoder streams into `$KN_MP4_VECTORS/*.mp4`, for ffprobe.
+    /// `KN_MP4_VECTORS=… cargo test -p kycontroller real_streams -- --ignored`
+    #[test]
+    #[ignore]
+    fn real_streams() {
+        let dir = std::path::PathBuf::from(std::env::var("KN_MP4_VECTORS").unwrap());
+        let opus = ogg_packets(&std::fs::read(dir.join("opus.ogg")).unwrap());
+        for (name, format) in [("h264.h264", VideoFormat::H264), ("hevc.h265", VideoFormat::Hevc), ("hevc10.h265", VideoFormat::Hevc)] {
+            let data = std::fs::read(dir.join(name)).unwrap();
+            let units = access_units(format, &data);
+            let config = VideoConfig::from_param_sets(format, param_sets_in(format, &units[0].1)).unwrap();
+            let audio = AudioConfig::from_opus_head(&opus[0]).unwrap();
+            let file = std::fs::File::create(dir.join(format!("{name}.mp4"))).unwrap();
+            let mut w = Mp4Writer::new(file, config, Some(&audio)).unwrap();
+            let start = 7_000_000u64;
+            let mut audio_at = start;
+            let mut packets = opus[2..].iter();
+            for (i, (key, au)) in units.iter().enumerate() {
+                let pts = start + i as u64 * 1_000_000 / 60;
+                w.write_video(pts, *key, au).unwrap();
+                while audio_at <= pts {
+                    let Some(p) = packets.next() else { break };
+                    w.write_audio(audio_at, p).unwrap();
+                    audio_at += opus_duration(p) as u64 * 1_000_000 / 48_000;
+                }
+            }
+            w.finish().unwrap();
+        }
+    }
+}
