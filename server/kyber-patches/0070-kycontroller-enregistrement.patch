+// Start, follow, stop
+// ===========================================================================
+
+/// The host's main display: the first image of a session without share
+/// that streams.
+async fn host_display(ctrl: &Controller) -> Option<u32> {
+    let services: Vec<_> = ctrl
+        .sessions
+        .lock()
+        .unwrap()
+        .values()
+        .filter(|s| s.share.is_none() && s.session.as_ref().is_some_and(|s| s.data_plane.is_some()))
+        .map(|s| s.services.clone())
+        .collect();
+    for services in services {
+        let services = services.lock().await;
+        if let Some(sub) = services.video_subscriptions.first() {
+            return Some(sub.key().display_id());
+        }
+    }
+    None
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum Refusal {
+    /// Nobody is in a session on this computer (or only guests).
+    NoSession,
+    /// The session's image is in AV1 or PyroWave.
+    Codec,
+    /// The folder could not be made.
+    Folder,
+    /// Less than `MIN_FREE` free in the folder (Admin's `disk_full`).
+    #[serde(rename = "disk_full")]
+    Disk,
+}
+
+#[derive(Serialize)]
+struct RefusalBody {
+    code: Refusal,
+}
+
+fn refuse(code: Refusal) -> HttpResponse {
+    HttpResponse::Conflict().json(RefusalBody { code })
+}
+
+fn video_source(
+    manager: &crate::avservices_manager::AVServicesManager,
+    key: &VideoStreamKey,
+) -> Option<kydup::VideoSource> {
+    let dup = manager.video_streams.get(key)?.dup.clone()?;
+    let idr = manager.idr_sender(key.clone());
+    let idr2 = manager.idr_sender(key.clone());
+    Some(kydup::VideoSource::new(dup, idr, idr2))
+}
+
+fn attach_audio(
+    manager: &crate::avservices_manager::AVServicesManager,
+    tx: &SyncSender<Msg>,
+    shared: &Arc<Shared>,
+) -> Option<(Task, Arc<AtomicBool>)> {
+    let dup = manager.audio_streams.get(&AudioStreamKey::Shared)?.dup.clone()?;
+    let ended = Arc::new(AtomicBool::new(false));
+    let send = ProtocolSend::new(RecordingSend {
+        tx: tx.clone(),
+        audio: true,
+        shared: Arc::clone(shared),
+        ended: Some(Arc::clone(&ended)),
+        lost: false,
+    });
+    Some((dup.add_recording_output(send), ended))
+}
+
+async fn start(ctrl: &web::Data<Controller>, dir: PathBuf, base: String) -> Result<RecordingState, Refusal> {
+    // The place is taken before the first await: two `POST`s at once (a
+    // double click, two devices) make one recorder.
+    let Some(starting) = Starting::take() else {
+        return Ok(state());
+    };
+    let display = host_display(ctrl).await.ok_or(Refusal::NoSession)?;
+    std::fs::create_dir_all(&dir).map_err(|e| {
+        warn!("Recording: folder {}: {e}", dir.display());
+        Refusal::Folder
+    })?;
+    if free_space(&dir).is_some_and(|free| free < MIN_FREE) {
+        warn!("Recording: less than {} MB free in {}", MIN_FREE >> 20, dir.display());
+        return Err(Refusal::Disk);
+    }
+
+    let manager = ctrl.av_services_manager.lock().await;
+    let key = manager.current_host_key(display).ok_or(Refusal::NoSession)?;
+    let stream = manager.video_streams.get(&key).ok_or(Refusal::NoSession)?;
+    if !matches!(ImageCodec::from(&stream.config.codec), ImageCodec::H264 | ImageCodec::Hevc) {
+        return Err(Refusal::Codec);
+    }
+    let source = video_source(&manager, &key).ok_or(Refusal::NoSession)?;
+
+    let shared = Arc::new(Shared::default());
+    let (tx, rx) = sync_channel(QUEUE);
+    let writer = Writer {
+        dir: dir.clone(),
+        base,
+        shared: Arc::clone(&shared),
+        format: None,
+        video: None,
+        audio: None,
+        file: None,
+        part: 0,
+        waiting: Vec::new(),
+        waiting_since: None,
+        need_key: true,
+        last_video: None,
+        audio_offset: None,
+        audio_frozen: false,
+    };
+    let writer = std::thread::Builder::new()
+        .name("kn-recording".into())
+        .spawn(move || writer.run(rx))
+        .map_err(|_| Refusal::Folder)?;
+
+    let (source_tx, source_rx) = watch::channel(Some(source));
+    let video_send = ProtocolSend::new(RecordingSend {
+        tx: tx.clone(),
+        audio: false,
+        shared: Arc::clone(&shared),
+        ended: None,
+        lost: false,
+    });
+    let video_task = kydup::spawn_recording_video_output(video_send, source_rx);
+    let audio_task = attach_audio(&manager, &tx, &shared);
+    drop(manager);
+
+    let started_at_ms = now_ms();
+    info!("Recording started on display {display} ({key:?})");
+    let stop_asked = with_recorder(|r| {
+        r.active = Some(Active {
+            started_at_ms,
+            display,
+            dir,
+            key,
+            source: source_tx,
+            video_task,
+            audio_task,
+            supervisor: None,
+            tx,
+            writer: Some(writer),
+            shared,
+        });
+        r.starting = false;
+        r.stop_asked.take()
+    });
+    drop(starting);
+    if let Some(reason) = stop_asked {
+        stop(reason).await;
+        return Ok(state());
+    }
+    let ctrl = ctrl.clone();
+    let supervisor = Task::spawn(async move { supervise(ctrl).await });
+    with_recorder(|r| {
+        if let Some(a) = r.active.as_mut() {
+            a.supervisor = Some(supervisor);
+        }
+    });
+    Ok(state())
+}
+
+/// Stops the recording, if one runs: the files are closed once this returns.
+async fn stop(reason: EndReason) {
+    let Some(mut active) = with_recorder(|r| {
+        if r.active.is_none() && r.starting {
+            // Ends as soon as it is installed.
+            r.stop_asked = Some(reason);
+        }
+        r.active.take()
+    }) else {
+        return;
+    };
+    let reason = active.shared.failed.lock().unwrap().unwrap_or(reason);
+    // The outputs first: nothing more reaches the queue.
+    drop(active.video_task);
+    drop(active.audio_task.take());
+    drop(active.source);
+    let _ = active.tx.try_send(Msg::Stop);
+    drop(active.tx);
+    if let Some(writer) = active.writer.take() {
+        let _ = tokio::task::spawn_blocking(move || writer.join()).await;
+    }
+    info!("Recording ended ({reason:?})");
+    with_recorder(|r| {
+        r.last_end = Some(LastEnd {
+            reason,
+            at_ms: now_ms(),
+        })
+    });
+    // Dropped last: this may be the supervisor itself.
+    drop(active.supervisor.take());
+}
+
+/// Once a second: follows the host's image, asks for the keyframes, picks
+/// the sound up again, and ends the recording with the host's session.
+async fn supervise(ctrl: web::Data<Controller>) {
+    let mut gone_since: Option<Instant> = None;
+    let mut last_key = Instant::now();
+    let mut last_free = Instant::now();
+    let mut tick = tokio::time::interval(Duration::from_secs(1));
+    tick.tick().await;
+    loop {
+        tick.tick().await;
+        if with_recorder(|r| r.active.as_ref().is_some_and(|a| a.shared.failed.lock().unwrap().is_some())) {
+            tokio::spawn(stop(EndReason::Write));
+            return;
+        }
+        let Some((display, key, dir)) =
+            with_recorder(|r| r.active.as_ref().map(|a| (a.display, a.key.clone(), a.dir.clone())))
+        else {
+            return;
+        };
+        if last_free.elapsed() >= FREE_EVERY {
+            last_free = Instant::now();
+            let free = tokio::task::spawn_blocking(move || free_space(&dir)).await.ok().flatten();
+            if free.is_some_and(|free| free < MIN_FREE) {
+                warn!("Recording: less than {} MB free, stopping", MIN_FREE >> 20);
+                tokio::spawn(stop(EndReason::Write));
+                return;
+            }
+        }
+        let host = host_display(&ctrl).await;
+        let manager = ctrl.av_services_manager.lock().await;
+        let current = host.and_then(|_| manager.current_host_key(display));
+        let Some(current) = current else {
+            drop(manager);
+            if gone_since.get_or_insert_with(Instant::now).elapsed() >= HOST_GONE_AFTER {
+                tokio::spawn(stop(EndReason::Ended));
+                return;
+            }
+            continue;
+        };
+        gone_since = None;
+        if current != key {
+            // A new host image (another format): the recording moves to it.
+            if let Some(stream) = manager.video_streams.get(&current)
+                && !matches!(ImageCodec::from(&stream.config.codec), ImageCodec::H264 | ImageCodec::Hevc)
+            {
+                drop(manager);
+                tokio::spawn(stop(EndReason::Codec));
+                return;
+            }
+            if let Some(source) = video_source(&manager, &current) {
+                info!("Recording follows the host's new image ({current:?})");
+                with_recorder(|r| {
+                    if let Some(a) = r.active.as_mut() {
+                        let _ = a.source.send(Some(source));
+                        a.key = current.clone();
+                    }
+                });
+                last_key = Instant::now();
+            }
+        } else if last_key.elapsed() >= KEYFRAME_EVERY
+            || with_recorder(|r| r.active.as_ref().is_some_and(|a| a.shared.want_key.swap(false, Ordering::Relaxed)))
+        {
+            (manager.idr_sender(current.clone()))();
+            last_key = Instant::now();
+        }
+        // The sound came back (or came) after the recording started.
+        let need_audio = with_recorder(|r| {
+            r.active
+                .as_ref()
+                .is_some_and(|a| a.audio_task.as_ref().is_none_or(|(_, ended)| ended.load(Ordering::Relaxed)))
+        });
+        if need_audio {
+            let handles = with_recorder(|r| r.active.as_ref().map(|a| (a.tx.clone(), Arc::clone(&a.shared))));
+            if let Some((tx, shared)) = handles
+                && let Some(audio) = attach_audio(&manager, &tx, &shared)
+            {
+                with_recorder(|r| {
+                    if let Some(a) = r.active.as_mut() {
+                        a.audio_task = Some(audio);
+                    }
+                });
+            }
+        }
+    }
+}
+
+/// Free bytes for this process on the disk of `dir`; `None` if unknown
+/// (the recording then goes on: only writing can stop it).
+#[cfg(windows)]
+fn free_space(dir: &Path) -> Option<u64> {
+    use std::os::windows::ffi::OsStrExt;
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn GetDiskFreeSpaceExW(dir: *const u16, free: *mut u64, total: *mut u64, total_free: *mut u64) -> i32;
+    }
+    let wide: Vec<u16> = dir.as_os_str().encode_wide().chain(std::iter::once(0)).collect();
+    let mut free = 0u64;
+    // SAFETY: a NUL-terminated path; the other outputs may be null.
+    let ok = unsafe { GetDiskFreeSpaceExW(wide.as_ptr(), &mut free, std::ptr::null_mut(), std::ptr::null_mut()) };
+    (ok != 0).then_some(free)
+}
+
+/// Free bytes on the disk of `dir` (`df -Pk`, the same on macOS and Linux);
+/// `None` if unknown.
+#[cfg(not(windows))]
+fn free_space(dir: &Path) -> Option<u64> {
+    let out = std::process::Command::new("df").arg("-Pk").arg(dir).output().ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    df_available(&String::from_utf8_lossy(&out.stdout))
+}
+
+/// The available kilobytes of `df -Pk`'s second line, in bytes.
+#[cfg_attr(windows, allow(dead_code))]
+fn df_available(out: &str) -> Option<u64> {
+    let line = out.lines().nth(1)?;
+    let kb: u64 = line.split_whitespace().nth(3)?.parse().ok()?;
+    kb.checked_mul(1024)
+}
+
+/// Stops a recording when the controller quits: the file is closed.
+pub(crate) async fn shutdown() {
+    stop(EndReason::Ended).await;
+}
