+
+    /// A writer without a folder: what reaches the file is only read back.
+    fn writer() -> Writer {
+        Writer {
+            dir: std::env::temp_dir(),
+            base: String::new(),
+            shared: Arc::new(Shared::default()),
+            format: Some(VideoFormat::H264),
+            video: None,
+            audio: None,
+            file: None,
+            part: 0,
+            waiting: Vec::new(),
+            waiting_since: None,
+            need_key: false,
+            last_video: None,
+            audio_offset: None,
+            audio_frozen: false,
+        }
+    }
+
+    fn media(pts: u64, key: bool) -> AVPacket {
+        AVPacket::Media(kymux::types::MediaPacket {
+            header: kymux::types::MediaPacketHeader {
+                pts,
+                is_key: key,
+                is_config: false,
+                size: 6,
+            },
+            payload: bytes::Bytes::from_static(&[0, 0, 0, 1, 0x41, 1]),
+        })
+    }
+
+    #[test]
+    fn a_loss_waits_for_the_next_keyframe() {
+        let mut w = writer();
+        w.video(media(0, true), Instant::now(), false);
+        assert!(!w.need_key);
+        // Queued before the loss: still written.
+        w.video(media(1, false), Instant::now(), false);
+        assert!(!w.need_key);
+        // The first packet after the loss: from here, a keyframe first.
+        w.video(media(2, false), Instant::now(), true);
+        assert!(w.need_key);
+        w.video(media(3, false), Instant::now(), false);
+        assert!(w.need_key);
+        w.video(media(4, true), Instant::now(), false);
+        assert!(!w.need_key);
+    }
+
+    #[test]
+    fn formats() {
+        assert_eq!(video_format(u32::from_be_bytes(*b"h264")), Some(VideoFormat::H264));
+        assert_eq!(video_format(u32::from_be_bytes(*b"h265")), Some(VideoFormat::Hevc));
+        assert_eq!(video_format(u32::from_be_bytes(*b"av1 ")), None);
+        assert_eq!(video_format(u32::from_be_bytes(*b"pwv1")), None);
+    }
+}
