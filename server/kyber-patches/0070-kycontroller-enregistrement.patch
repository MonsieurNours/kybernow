+
+    #[test]
+    fn opus_durations() {
+        // CELT 20 ms, one frame.
+        assert_eq!(opus_duration(&[0b1111_1000]), 960);
+        // CELT 10 ms, one frame.
+        assert_eq!(opus_duration(&[0b1111_0000]), 480);
+        // SILK 20 ms, two frames.
+        assert_eq!(opus_duration(&[0b0000_1001]), 1920);
+        // Code 3, three 2.5 ms frames.
