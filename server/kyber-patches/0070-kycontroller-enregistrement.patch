+#[derive(Deserialize)]
+struct RecordingRequest {
+    record: bool,
+    /// The folder (made if missing). Required to start.
+    dir: Option<String>,
+    /// The file's name without `.mp4`; `KyberNow <date> <time>` by default
+    /// (local time is Admin's: it names it).
+    name: Option<String>,
+}
+
+/// Keeps a name safe as a file name on every system.
+fn safe_name(name: &str) -> Option<String> {
+    let cleaned: String = name
+        .chars()
+        .map(|c| if c.is_control() || "/\\:*?\"<>|".contains(c) { '-' } else { c })
+        .collect();
+    let cleaned = cleaned.trim().trim_matches('.').trim().to_string();
+    (!cleaned.is_empty() && cleaned.len() <= 120).then_some(cleaned)
+}
+
+/// `GET /kybernow/recording`: the recording's state.
+#[get("/recording")]
+pub(crate) async fn get_recording(req: HttpRequest) -> HttpResponse {
+    if let Some(refusal) = crate::kybernow::admin_refusal(&req) {
+        return refusal;
+    }
+    HttpResponse::Ok().json(state())
+}
+
+/// `POST /kybernow/recording`: `{"record": true, "dir": …, "name": …}`
+/// starts, `{"record": false}` stops. Answers the state, or 409 with
+/// `{"code"}` (`no_session`, `codec`, `folder`, `disk_full`).
+#[post("/recording")]
+pub(crate) async fn post_recording(
+    ctrl: web::Data<Controller>,
+    req: HttpRequest,
+    body: web::Bytes,
+) -> HttpResponse {
+    let request: RecordingRequest = match crate::kybernow::admin_request(&req, &body) {
+        Ok(request) => request,
+        Err(refusal) => return refusal,
+    };
+    if !request.record {
+        stop(EndReason::Stopped).await;
+        return HttpResponse::Ok().json(state());
+    }
+    let Some(dir) = request.dir.filter(|d| !d.trim().is_empty()) else {
+        return HttpResponse::BadRequest().finish();
+    };
+    let base = match request.name.as_deref().map(safe_name) {
+        Some(Some(name)) => name,
+        Some(None) => return HttpResponse::BadRequest().finish(),
+        None => {
+            let now = time::OffsetDateTime::now_utc();
+            format!(
+                "KyberNow {:04}-{:02}-{:02} {:02}-{:02}-{:02}",
+                now.year(),
+                now.month() as u8,
+                now.day(),
+                now.hour(),
+                now.minute(),
+                now.second()
+            )
+        }
+    };
+    match start(&ctrl, PathBuf::from(dir), base).await {
+        Ok(state) => HttpResponse::Ok().json(state),
+        Err(code) => refuse(code),
+    }
+}
