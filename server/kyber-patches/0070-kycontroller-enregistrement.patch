+
+    #[test]
+    fn reads_opus_head() {
+        let a = AudioConfig::from_opus_head(&opus_head(2)).unwrap();
+        assert_eq!((a.channels, a.pre_skip, a.family), (2, 312, 0));
+        let mut six = b"OpusHead".to_vec();
+        six.extend_from_slice(&[1, 6, 0, 0, 0x80, 0xbb, 0, 0, 0, 0, 1, 4, 2, 0, 4, 1, 2, 3, 5]);
+        let a = AudioConfig::from_opus_head(&six).unwrap();
+        assert_eq!((a.channels, a.streams, a.coupled, a.mapping.len()), (6, 4, 2, 6));
+        assert!(AudioConfig::from_opus_head(b"OpusTags").is_none());
