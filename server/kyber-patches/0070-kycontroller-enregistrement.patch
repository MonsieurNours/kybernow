index 0000000..154be66
--- /dev/null
+++ b/kycontroller/src/recording.rs
@@ -0,0 +1,1028 @@
+// KyberNow: recording the host's session into an MP4 (patch 0070).
+//
+// KyberNow Admin asks (`POST /kybernow/recording`, its own token, from this
+// computer only): the controller then reads the host's image of the
+// session's main display and the shared sound, exactly as a share guest
+// does (patch 0020): never holding them back, falling back to the next
+// keyframe when it falls behind. A thread of its own writes them into a
+// fragmented MP4 (`mp4.rs`), never encoded again. Nothing is asked of the
+// encoder but a keyframe when the recording starts or falls behind, and one
+// every `KEYFRAME_EVERY`, so the file can be sought.
+//
+// The recording follows the host's image when it changes (a profile chosen
+// in session): a new format or new parameter sets go on in a new file
+// (`… (2).mp4`). It ends when Admin stops it, when the host's session
+// ends, when writing fails or the disk is nearly full (`MIN_FREE`), or with
+// the encoder's format (AV1 and PyroWave are not recorded).
+
+use std::fs::File;
+use std::io::BufWriter;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::mpsc::{Receiver, SyncSender, TrySendError, sync_channel};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use actix_web::{HttpRequest, HttpResponse, get, post, web};
+use async_trait::async_trait;
+use kymux::types::{AVPacket, ProtocolError, ProtocolSend, ProtocolSendDriver};
+use log::{info, warn};
+use serde::{Deserialize, Serialize};
+use tokio::sync::watch;
+
+use crate::avservices_manager::{AudioStreamKey, VideoStreamKey};
+use crate::controller::Controller;
+use crate::guest_image::ImageCodec;
+use crate::kydup;
+use crate::mp4::{AudioConfig, Mp4Writer, VideoConfig, VideoFormat};
+use crate::utils::Task;
+
+/// A keyframe this often, so a player can seek in the file.
+const KEYFRAME_EVERY: Duration = Duration::from_secs(10);
+/// How long the host's image may be missing before the recording ends.
+const HOST_GONE_AFTER: Duration = Duration::from_secs(3);
+/// Packets waiting for the writer; past that, the writer is behind and the
+/// image goes back to its next keyframe.
+const QUEUE: usize = 2048;
+/// How long the first image waits for the sound's header before the file
+/// is made (without sound if it does not come).
+const AUDIO_WAIT: Duration = Duration::from_millis(1500);
+/// Free space under which the recording ends (as a write failure: Admin,
+/// which stops at 2 GB, tells it as a full disk). Admin's own check is the
+/// first one; this one holds when Admin does not watch.
+const MIN_FREE: u64 = 1 << 30;
+/// How often the free space is read.
+const FREE_EVERY: Duration = Duration::from_secs(10);
+
+// ===========================================================================
+// State
+// ===========================================================================
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum EndReason {
+    /// Admin stopped it.
+    Stopped,
+    /// The host's session ended.
+    Ended,
+    /// Writing failed: disk full, folder gone.
+    Write,
+    /// The image's format is not recorded (AV1, PyroWave).
+    Codec,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub(crate) struct LastEnd {
+    reason: EndReason,
+    at_ms: u64,
+}
+
+#[derive(Debug, Clone, Default, Serialize)]
+pub(crate) struct RecordingState {
+    active: bool,
+    /// Unix time, ms: the elapsed time the apps show.
+    started_at_ms: Option<u64>,
+    display: Option<u32>,
+    /// The files of this recording, the one being written last.
+    files: Vec<String>,
+    bytes: u64,
+    last_end: Option<LastEnd>,
+}
+
+/// What the writer thread shares with the rest.
+#[derive(Default)]
+struct Shared {
+    files: Mutex<Vec<PathBuf>>,
+    bytes: AtomicU64,
+    /// Set by the writer when it stopped by itself (error or format).
+    failed: Mutex<Option<EndReason>>,
+    /// The writer fell behind (an image was lost): the supervisor asks for
+    /// a keyframe at once (intra refresh makes none).
+    want_key: AtomicBool,
+}
+
+struct Active {
+    started_at_ms: u64,
+    display: u32,
+    /// The folder written to (its free space is watched).
+    dir: PathBuf,
+    key: VideoStreamKey,
+    source: watch::Sender<Option<kydup::VideoSource>>,
+    video_task: Task,
+    audio_task: Option<(Task, Arc<AtomicBool>)>,
+    supervisor: Option<Task>,
+    tx: SyncSender<Msg>,
+    writer: Option<std::thread::JoinHandle<()>>,
+    shared: Arc<Shared>,
+}
+
+#[derive(Default)]
+struct Recorder {
+    active: Option<Active>,
+    last_end: Option<LastEnd>,
+    /// A start is under way (between its check and its `active`): a second
+    /// `POST` meanwhile does not start a second recorder.
+    starting: bool,
+    /// A stop came while starting: the new recording ends at once.
+    stop_asked: Option<EndReason>,
+}
+
+/// Holds the start's place in the recorder until it is installed or fails.
+struct Starting;
+
+impl Starting {
+    /// Takes the place, unless a recording runs or starts already.
+    fn take() -> Option<Self> {
+        with_recorder(|r| {
+            if r.active.is_some() || r.starting {
+                return None;
+            }
+            r.starting = true;
+            r.stop_asked = None;
+            Some(Starting)
+        })
+    }
+}
+
+impl Drop for Starting {
+    fn drop(&mut self) {
+        with_recorder(|r| r.starting = false);
+    }
+}
+
+static RECORDER: Mutex<Option<Recorder>> = Mutex::new(None);
+
+fn with_recorder<T>(f: impl FnOnce(&mut Recorder) -> T) -> T {
+    let mut guard = RECORDER.lock().unwrap();
+    f(guard.get_or_insert_with(Recorder::default))
+}
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_millis() as u64)
+}
+
+fn state() -> RecordingState {
+    with_recorder(|r| match &r.active {
+        Some(a) => RecordingState {
+            active: true,
+            started_at_ms: Some(a.started_at_ms),
+            display: Some(a.display),
+            files: a
+                .shared
+                .files
+                .lock()
+                .unwrap()
+                .iter()
+                .filter_map(|p| Some(p.file_name()?.to_string_lossy().into_owned()))
+                .collect(),
+            bytes: a.shared.bytes.load(Ordering::Relaxed),
+            last_end: r.last_end.clone(),
+        },
+        None => RecordingState {
+            last_end: r.last_end.clone(),
+            ..Default::default()
+        },
+    })
+}
+
+// ===========================================================================
+// Packets to the writer
+// ===========================================================================
+
+enum Msg {
+    /// An image packet; `true` when packets were lost just before it.
+    Video(AVPacket, Instant, bool),
+    Audio(AVPacket, Instant),
+    Stop,
+}
+
+/// An output of the host's image or sound, into the writer's queue: it
+/// never waits (a full queue loses the packet, and the image goes back to
+/// its next keyframe).
+struct RecordingSend {
+    tx: SyncSender<Msg>,
+    audio: bool,
+    shared: Arc<Shared>,
+    /// Set when this output ends (its stream ended).
+    ended: Option<Arc<AtomicBool>>,
+    /// Image packets were lost (queue full): the next one that gets in
+    /// carries it, so the writer waits for a keyframe from there, and not
+    /// from a packet queued before the loss.
+    lost: bool,
+}
+
+#[async_trait]
+impl ProtocolSendDriver for RecordingSend {
+    type Packet = AVPacket;
+
+    async fn send(&mut self, packet: AVPacket) -> Result<(), ProtocolError> {
+        let msg = if self.audio {
+            Msg::Audio(packet, Instant::now())
+        } else {
+            Msg::Video(packet, Instant::now(), self.lost)
+        };
+        match self.tx.try_send(msg) {
+            Ok(()) => {
+                if !self.audio {
+                    self.lost = false;
+                }
+                Ok(())
+            }
+            Err(TrySendError::Full(_)) => {
+                if !self.audio {
+                    self.lost = true;
+                    self.shared.want_key.store(true, Ordering::Relaxed);
+                }
+                Ok(())
+            }
+            Err(TrySendError::Disconnected(_)) => Err(ProtocolError::new("recording writer gone")),
+        }
+    }
+}
+
+impl Drop for RecordingSend {
+    fn drop(&mut self) {
+        if let Some(ended) = &self.ended {
+            ended.store(true, Ordering::Relaxed);
+        }
+    }
+}
+
+// ===========================================================================
+// Writer thread
+// ===========================================================================
+
+fn video_format(codec: u32) -> Option<VideoFormat> {
+    match &codec.to_be_bytes() {
+        b"h264" => Some(VideoFormat::H264),
+        b"h265" => Some(VideoFormat::Hevc),
+        _ => None,
+    }
+}
+
+/// `KyberNow 2026-11-26 14-32-05.mp4`, then `… (2).mp4` for the next parts;
+/// never over an existing file.
+fn file_path(dir: &Path, base: &str, part: u32) -> PathBuf {
+    let mut n = part;
+    loop {
+        let name = if n <= 1 { format!("{base}.mp4") } else { format!("{base} ({n}).mp4") };
+        let path = dir.join(name);
+        if !path.exists() {
+            return path;
+        }
+        n += 1;
+    }
+}
+
+struct Writer {
+    dir: PathBuf,
+    base: String,
+    shared: Arc<Shared>,
+    format: Option<VideoFormat>,
+    video: Option<VideoConfig>,
+    audio: Option<AudioConfig>,
+    file: Option<Mp4Writer<BufWriter<File>>>,
+    part: u32,
+    /// A keyframe waiting for the sound's header, with what came after it.
+    waiting: Vec<(u64, bool, bytes::Bytes)>,
+    waiting_since: Option<Instant>,
+    /// Waiting for a keyframe (start, a new part, after falling behind).
+    need_key: bool,
+    /// Last image: its pts and when it came, to check the sound's clock.
+    last_video: Option<(u64, Instant)>,
+    /// Added to the sound's pts when its clock is not the image's.
+    audio_offset: Option<i128>,
+    /// The sound changed (channel count) in this file: what follows is not
+    /// written under the old header; the next file has it.
+    audio_frozen: bool,
+}
+
+impl Writer {
+    fn fail(&self, reason: EndReason) {
+        self.shared.failed.lock().unwrap().get_or_insert(reason);
+    }
+
+    fn close(&mut self) {
+        if let Some(file) = self.file.take() {
+            match file.finish() {
+                Ok(_) => {}
+                Err(e) => {
+                    warn!("Recording: could not close the file: {e}");
+                    self.fail(EndReason::Write);
+                }
+            }
+        }
+    }
+
+    fn open(&mut self) -> bool {
+        let Some(video) = self.video.clone() else {
+            return false;
+        };
+        self.part += 1;
+        let path = file_path(&self.dir, &self.base, self.part);
+        let file = File::create(&path).and_then(|f| Mp4Writer::new(BufWriter::with_capacity(1 << 20, f), video, self.audio.as_ref()));
+        match file {
+            Ok(w) => {
+                info!("Recording into {}", path.display());
+                self.shared.files.lock().unwrap().push(path);
+                self.file = Some(w);
+                self.audio_frozen = false;
+                true
+            }
+            Err(e) => {
+                warn!("Recording: could not create {}: {e}", path.display());
+                self.fail(EndReason::Write);
+                false
+            }
+        }
+    }
+
+    fn write_frame(&mut self, pts: u64, key: bool, data: &[u8]) {
+        if let Some(file) = self.file.as_mut() {
+            let before = file.len();
+            if let Err(e) = file.write_video(pts, key, data) {
+                warn!("Recording: write failed: {e}");
+                self.fail(EndReason::Write);
+                return;
+            }
+            let after = file.len();
+            self.shared.bytes.fetch_add(after - before, Ordering::Relaxed);
+        }
+    }
+
+    fn video(&mut self, packet: AVPacket, at: Instant, after_loss: bool) {
+        if after_loss {
+            // Packets were lost just before this one: what follows cannot
+            // be decoded until the next keyframe.
+            self.need_key = true;
+        }
+        match packet {
+            AVPacket::Codec(c) => {
+                let Some(format) = video_format(c.header.codec) else {
+                    let name = String::from_utf8_lossy(&c.header.codec.to_be_bytes()).into_owned();
+                    warn!("Recording: image in {name}, not recorded");
+                    self.fail(EndReason::Codec);
+                    return;
+                };
+                if self.format != Some(format) {
+                    self.close();
+                    self.format = Some(format);
+                    self.video = None;
+                    self.need_key = true;
+                }
+            }
+            AVPacket::Media(m) if m.header.is_config => {
+                let Some(format) = self.format else { return };
+                self.take_config(format, &m.payload);
+            }
+            AVPacket::Media(m) => {
+                let Some(format) = self.format else { return };
+                // In-band parameter sets on a keyframe count as a config.
+                if m.header.is_key {
+                    let in_band = crate::mp4::param_sets_in(format, &m.payload);
+                    if !in_band.is_empty() {
+                        self.take_config_sets(format, in_band);
+                    }
+                }
+                if self.need_key && !m.header.is_key {
+                    return;
+                }
+                self.need_key = false;
+                self.last_video = Some((m.header.pts, at));
+                if self.file.is_none() {
+                    if self.video.is_none() {
+                        return;
+                    }
+                    // The first image waits a little for the sound's header.
+                    let since = *self.waiting_since.get_or_insert(at);
+                    self.waiting.push((m.header.pts, m.header.is_key, m.payload));
+                    if self.audio.is_none() && at.duration_since(since) < AUDIO_WAIT {
+                        return;
+                    }
+                    self.start_file();
+                    return;
+                }
+                self.write_frame(m.header.pts, m.header.is_key, &m.payload);
+            }
+            AVPacket::Hole(_) => {}
+        }
+    }
+
+    fn take_config(&mut self, format: VideoFormat, payload: &[u8]) {
+        self.take_config_sets(format, crate::mp4::param_sets_in(format, payload));
+    }
+
+    fn take_config_sets(&mut self, format: VideoFormat, sets: Vec<Vec<u8>>) {
+        if self.video.as_ref().is_some_and(|v| v.param_sets == sets) {
+            return;
+        }
+        let Some(config) = VideoConfig::from_param_sets(format, sets) else {
+            warn!("Recording: parameter sets not understood");
+            return;
+        };
+        if self.file.is_some() {
+            // Another size or format: the recording goes on in a new file.
+            info!("Recording: new parameter sets ({} × {}), next file", config.width, config.height);
+            self.close();
+            self.need_key = true;
+        }
+        self.video = Some(config);
+    }
+
+    fn start_file(&mut self) {
+        let waiting = std::mem::take(&mut self.waiting);
+        self.waiting_since = None;
+        if !self.open() {
+            return;
+        }
+        for (pts, key, data) in waiting {
+            self.write_frame(pts, key, &data);
+        }
+    }
+
+    fn audio(&mut self, packet: AVPacket, at: Instant) {
+        match packet {
+            AVPacket::Media(m) if m.header.is_config => {
+                if let Some(config) = AudioConfig::from_opus_head(&m.payload) {
+                    if self.file.is_none() {
+                        self.audio = Some(config);
+                    } else if self.audio.as_ref() != Some(&config) {
+                        // Another channel count: the sound stops in this
+                        // file (its header is the old one), the next one
+                        // has it.
+                        warn!("Recording: the sound changed, ignored until the next file");
+                        self.audio = Some(config);
+                        self.audio_frozen = true;
+                    }
+                }
+            }
+            AVPacket::Media(m) => {
+                let Some(file) = self.file.as_mut() else { return };
+                if !file.has_audio() || self.audio_frozen {
+                    return;
+                }
+                let offset = *self.audio_offset.get_or_insert_with(|| {
+                    // Image and sound normally share the capture clock; if
+                    // not, the sound is placed by when it came.
+                    let Some((vpts, vat)) = self.last_video else { return 0 };
+                    let expected = vpts as i128 + at.saturating_duration_since(vat).as_micros() as i128;
+                    let gap = expected - m.header.pts as i128;
+                    if gap.abs() > 2_000_000 {
+                        warn!("Recording: the sound's clock is not the image's ({} ms apart): placed by arrival", gap / 1000);
+                        gap
+                    } else {
+                        0
+                    }
+                });
+                let pts = (m.header.pts as i128 + offset).max(0) as u64;
+                let before = file.len();
+                if let Err(e) = file.write_audio(pts, &m.payload) {
+                    warn!("Recording: write failed: {e}");
+                    self.fail(EndReason::Write);
+                    return;
+                }
+                let after = file.len();
+                self.shared.bytes.fetch_add(after - before, Ordering::Relaxed);
+            }
+            _ => {}
+        }
+    }
+
+    fn run(mut self, rx: Receiver<Msg>) {
+        loop {
+            let msg = match rx.recv_timeout(Duration::from_millis(500)) {
+                Ok(m) => m,
+                Err(std::sync::mpsc::RecvTimeoutError::Timeout) => {
+                    // No image for a while (a still screen sends none):
+                    // a file waiting for sound starts anyway.
+                    if self.file.is_none()
+                        && self.waiting_since.is_some_and(|s| s.elapsed() >= AUDIO_WAIT)
+                    {
+                        self.start_file();
+                    }
+                    continue;
+                }
+                Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => break,
+            };
+            match msg {
+                Msg::Video(p, at, after_loss) => self.video(p, at, after_loss),
+                Msg::Audio(p, at) => self.audio(p, at),
+                Msg::Stop => break,
+            }
+            if self.shared.failed.lock().unwrap().is_some() {
+                break;
+            }
+        }
+        if self.file.is_none() && !self.waiting.is_empty() {
+            self.start_file();
+        }
+        self.close();
+    }
+}
+
