diff --git a/kycontroller/src/mp4.rs b/kycontroller/src/mp4.rs
new file mode 100644
index 0000000..f499f1d
--- /dev/null
+++ b/kycontroller/src/mp4.rs
@@ -0,0 +1,1233 @@
+// KyberNow: a fragmented MP4 writer for session recordings (patch 0070).
+//
+// The packets are the encoder's own: H.264 or HEVC in Annex B (start codes),
+// no B-frames, and Opus. They are written as they come, never decoded nor
+// encoded again: an init segment (`ftyp`, `moov`), then one fragment
+// (`moof`, `mdat`) about every second, flushed as it is written, so a file
+// cut short (power loss, crash) plays up to its last fragment. Closing it
+// writes the total duration (`mehd`) and an index of the fragments
+// (`mfra`), for players that seek through it.
+//
+// Parameter sets go into the sample entry (`avcC`, `hvcC`) and are taken out
+// of the samples, as `avc1` and `hvc1` want (QuickTime plays nothing else).
+
+use std::io::{self, Seek, SeekFrom, Write};
+
+/// Video timescale (ticks a second).
+pub(crate) const VIDEO_TIMESCALE: u32 = 90_000;
+/// Opus always runs at 48 kHz in MP4.
+pub(crate) const AUDIO_TIMESCALE: u32 = 48_000;
+
+const VIDEO_TRACK: u32 = 1;
+const AUDIO_TRACK: u32 = 2;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum VideoFormat {
+    H264,
+    Hevc,
+}
+
+/// What a video track is made of: its parameter sets (NAL units without
+/// start codes) and what was read from them.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct VideoConfig {
+    pub format: VideoFormat,
+    pub width: u32,
+    pub height: u32,
+    /// H.264: SPS, PPS. HEVC: VPS, SPS, PPS. In stream order.
+    pub param_sets: Vec<Vec<u8>>,
+    sample_entry: Vec<u8>,
+}
+
+/// `OpusHead`, as the encoder sends it in its config packet.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct AudioConfig {
+    pub channels: u8,
+    pub pre_skip: u16,
+    pub input_rate: u32,
+    pub gain: i16,
+    pub family: u8,
+    pub streams: u8,
+    pub coupled: u8,
+    pub mapping: Vec<u8>,
+}
+
+// ===========================================================================
+// Annex B and parameter sets
+// ===========================================================================
+
+/// The NAL units of an Annex B buffer, without their start codes.
+pub(crate) fn annexb_nals(data: &[u8]) -> Vec<&[u8]> {
+    let mut nals = Vec::new();
+    let mut i = 0;
+    let mut start: Option<usize> = None;
+    while i + 2 < data.len() {
+        if data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1 {
+            if let Some(s) = start {
+                // A 4-byte start code leaves its leading zero behind.
+                let mut end = i;
+                while end > s && data[end - 1] == 0 {
+                    end -= 1;
+                }
+                if end > s {
+                    nals.push(&data[s..end]);
+                }
+            }
+            i += 3;
+            start = Some(i);
+        } else {
+            i += 1;
+        }
+    }
+    match start {
+        Some(s) if s < data.len() => nals.push(&data[s..]),
+        None if !data.is_empty() => nals.push(data),
+        _ => {}
+    }
+    nals
+}
+
+fn nal_type(format: VideoFormat, nal: &[u8]) -> u8 {
+    match format {
+        VideoFormat::H264 => nal.first().map_or(0, |b| b & 0x1f),
+        VideoFormat::Hevc => nal.first().map_or(0, |b| (b >> 1) & 0x3f),
+    }
+}
+
+/// Parameter sets and access unit delimiters: they stay out of the samples.
+fn is_out_of_band(format: VideoFormat, nal: &[u8]) -> bool {
+    let t = nal_type(format, nal);
+    match format {
+        VideoFormat::H264 => matches!(t, 7 | 8 | 9),
+        VideoFormat::Hevc => matches!(t, 32..=35),
+    }
+}
+
+/// An Annex B access unit as an MP4 sample: 4-byte lengths, without its
+/// parameter sets. `None` when nothing is left.
+pub(crate) fn sample_from_annexb(format: VideoFormat, data: &[u8]) -> Option<Vec<u8>> {
+    let mut out = Vec::with_capacity(data.len() + 16);
+    for nal in annexb_nals(data) {
+        if is_out_of_band(format, nal) {
+            continue;
+        }
+        out.extend_from_slice(&(nal.len() as u32).to_be_bytes());
+        out.extend_from_slice(nal);
+    }
+    (!out.is_empty()).then_some(out)
+}
+
+/// The parameter sets an access unit carries in band, in stream order.
+pub(crate) fn param_sets_in(format: VideoFormat, data: &[u8]) -> Vec<Vec<u8>> {
+    annexb_nals(data)
+        .into_iter()
+        .filter(|nal| {
+            let t = nal_type(format, nal);
+            match format {
+                VideoFormat::H264 => matches!(t, 7 | 8),
+                VideoFormat::Hevc => matches!(t, 32..=34),
+            }
+        })
+        .map(<[u8]>::to_vec)
+        .collect()
+}
+
+/// Bit reader over an RBSP (emulation prevention bytes taken out).
+struct Bits {
+    data: Vec<u8>,
+    pos: usize,
+}
+
+impl Bits {
+    fn new(nal_payload: &[u8]) -> Self {
+        let mut data = Vec::with_capacity(nal_payload.len());
+        let mut zeros = 0;
+        for &b in nal_payload {
+            if zeros >= 2 && b == 3 {
+                zeros = 0;
+                continue;
+            }
+            zeros = if b == 0 { zeros + 1 } else { 0 };
+            data.push(b);
+        }
+        Self { data, pos: 0 }
+    }
+
+    fn bit(&mut self) -> Option<u32> {
+        let byte = *self.data.get(self.pos / 8)?;
+        let bit = (byte >> (7 - (self.pos % 8))) & 1;
+        self.pos += 1;
+        Some(bit as u32)
+    }
+
+    fn bits(&mut self, n: u32) -> Option<u32> {
+        let mut v = 0u32;
+        for _ in 0..n {
+            v = (v << 1) | self.bit()?;
+        }
+        Some(v)
+    }
+
+    fn skip(&mut self, n: usize) -> Option<()> {
+        self.pos += n;
+        (self.pos <= self.data.len() * 8).then_some(())
+    }
+
+    fn ue(&mut self) -> Option<u32> {
+        let mut zeros = 0;
+        while self.bit()? == 0 {
+            zeros += 1;
+            if zeros > 31 {
+                return None;
+            }
+        }
+        Some((1u32 << zeros) - 1 + self.bits(zeros)?)
+    }
+
+    fn se(&mut self) -> Option<i32> {
+        let v = self.ue()?;
+        Some(if v % 2 == 1 { v.div_ceil(2) as i32 } else { -((v / 2) as i32) })
+    }
+}
+
+struct H264Sps {
+    profile: u8,
+    compat: u8,
+    level: u8,
+    chroma: u32,
+    depth_luma: u32,
+    depth_chroma: u32,
+    width: u32,
+    height: u32,
+}
+
+fn parse_h264_sps(sps: &[u8]) -> Option<H264Sps> {
+    let mut b = Bits::new(sps.get(1..)?);
+    let profile = b.bits(8)? as u8;
+    let compat = b.bits(8)? as u8;
+    let level = b.bits(8)? as u8;
+    b.ue()?; // seq_parameter_set_id
+    let (mut chroma, mut depth_luma, mut depth_chroma) = (1, 8, 8);
+    if matches!(profile, 100 | 110 | 122 | 244 | 44 | 83 | 86 | 118 | 128 | 138 | 139 | 134 | 135) {
+        chroma = b.ue()?;
+        if chroma == 3 {
+            b.bit()?; // separate_colour_plane_flag
+        }
+        depth_luma = b.ue()?.checked_add(8)?;
+        depth_chroma = b.ue()?.checked_add(8)?;
+        b.bit()?; // qpprime_y_zero_transform_bypass_flag
+        if b.bit()? == 1 {
+            let lists = if chroma == 3 { 12 } else { 8 };
+            for i in 0..lists {
+                if b.bit()? == 1 {
+                    let size = if i < 6 { 16 } else { 64 };
+                    let (mut last, mut next) = (8i32, 8i32);
+                    for _ in 0..size {
+                        if next != 0 {
+                            next = (last + b.se()? + 256) % 256;
+                        }
+                        last = if next == 0 { last } else { next };
+                    }
+                }
+            }
+        }
+    }
+    b.ue()?; // log2_max_frame_num_minus4
+    match b.ue()? {
+        0 => {
+            b.ue()?;
+        }
+        1 => {
+            b.bit()?;
+            b.se()?;
+            b.se()?;
+            for _ in 0..b.ue()? {
+                b.se()?;
+            }
+        }
+        _ => {}
+    }
+    b.ue()?; // max_num_ref_frames
+    b.bit()?; // gaps_in_frame_num_value_allowed_flag
+    // A damaged SPS (values up to 2^32) is refused, never an overflow.
+    let width_mbs = b.ue()?.checked_add(1)?;
+    let height_units = b.ue()?.checked_add(1)?;
+    let frame_mbs_only = b.bit()?;
+    if frame_mbs_only == 0 {
+        b.bit()?;
+    }
+    b.bit()?; // direct_8x8_inference_flag
+    let (mut left, mut right, mut top, mut bottom) = (0, 0, 0, 0);
+    if b.bit()? == 1 {
+        left = b.ue()?;
+        right = b.ue()?;
+        top = b.ue()?;
+        bottom = b.ue()?;
+    }
+    let crop_x: u32 = if chroma == 1 || chroma == 2 { 2 } else { 1 };
+    let crop_y = (if chroma == 1 { 2 } else { 1 }) * (2 - frame_mbs_only);
+    let width = width_mbs
+        .checked_mul(16)?
+        .checked_sub(crop_x.checked_mul(left.checked_add(right)?)?)?;
+    let height = ((2 - frame_mbs_only) * 16)
+        .checked_mul(height_units)?
+        .checked_sub(crop_y.checked_mul(top.checked_add(bottom)?)?)?;
+    Some(H264Sps {
+        profile,
+        compat,
+        level,
+        chroma,
+        depth_luma,
+        depth_chroma,
+        width,
+        height,
+    })
+}
+
+struct HevcSps {
+    /// general_profile_space … general_level_idc, as `hvcC` copies them.
+    ptl: [u8; 12],
+    sub_layers: u32,
+    temporal_id_nested: u32,
+    chroma: u32,
+    depth_luma: u32,
+    depth_chroma: u32,
+    width: u32,
+    height: u32,
+}
+
+fn parse_hevc_sps(sps: &[u8]) -> Option<HevcSps> {
+    let mut b = Bits::new(sps.get(2..)?);
+    b.bits(4)?; // sps_video_parameter_set_id
+    let max_sub_layers_minus1 = b.bits(3)?;
+    let temporal_id_nested = b.bit()?;
+    let mut ptl = [0u8; 12];
+    for byte in ptl.iter_mut() {
+        *byte = b.bits(8)? as u8;
+    }
+    let mut profile_present = [false; 8];
+    let mut level_present = [false; 8];
+    for i in 0..max_sub_layers_minus1 as usize {
+        profile_present[i] = b.bit()? == 1;
+        level_present[i] = b.bit()? == 1;
+    }
+    if max_sub_layers_minus1 > 0 {
+        for _ in max_sub_layers_minus1..8 {
+            b.bits(2)?;
+        }
+    }
+    for i in 0..max_sub_layers_minus1 as usize {
+        if profile_present[i] {
+            b.skip(88)?;
+        }
+        if level_present[i] {
+            b.skip(8)?;
+        }
+    }
+    b.ue()?; // sps_seq_parameter_set_id
+    let chroma = b.ue()?;
+    if chroma == 3 {
+        b.bit()?;
+    }
+    let pic_width = b.ue()?;
+    let pic_height = b.ue()?;
+    let (mut left, mut right, mut top, mut bottom) = (0, 0, 0, 0);
+    if b.bit()? == 1 {
+        left = b.ue()?;
+        right = b.ue()?;
+        top = b.ue()?;
+        bottom = b.ue()?;
+    }
+    let depth_luma = b.ue()?.checked_add(8)?;
+    let depth_chroma = b.ue()?.checked_add(8)?;
+    let sub_w: u32 = if chroma == 1 || chroma == 2 { 2 } else { 1 };
+    let sub_h: u32 = if chroma == 1 { 2 } else { 1 };
+    Some(HevcSps {
+        ptl,
+        sub_layers: max_sub_layers_minus1 + 1,
+        temporal_id_nested,
+        chroma,
+        depth_luma,
+        depth_chroma,
+        width: pic_width.checked_sub(sub_w.checked_mul(left.checked_add(right)?)?)?,
+        height: pic_height.checked_sub(sub_h.checked_mul(top.checked_add(bottom)?)?)?,
+    })
+}
+
+impl VideoConfig {
+    /// From the parameter sets of a config packet (Annex B). `None` when one
+    /// is missing or cannot be read.
+    pub(crate) fn from_annexb(format: VideoFormat, data: &[u8]) -> Option<Self> {
+        Self::from_param_sets(format, param_sets_in(format, data))
+    }
+
+    pub(crate) fn from_param_sets(format: VideoFormat, param_sets: Vec<Vec<u8>>) -> Option<Self> {
+        let of = |t: u8| -> Vec<&Vec<u8>> {
+            param_sets
+                .iter()
+                .filter(|n| nal_type(format, n) == t)
+                .collect()
+        };
+        let (width, height, config_box) = match format {
+            VideoFormat::H264 => {
+                let (sps, pps) = (of(7), of(8));
+                let first = sps.first()?;
+                if pps.is_empty() {
+                    return None;
+                }
+                let info = parse_h264_sps(first)?;
+                let mut c = vec![1, info.profile, info.compat, info.level, 0xff];
+                c.push(0xe0 | sps.len() as u8);
+                for s in &sps {
+                    c.extend_from_slice(&(s.len() as u16).to_be_bytes());
+                    c.extend_from_slice(s);
+                }
+                c.push(pps.len() as u8);
+                for p in &pps {
+                    c.extend_from_slice(&(p.len() as u16).to_be_bytes());
+                    c.extend_from_slice(p);
+                }
+                if matches!(info.profile, 100 | 110 | 122 | 144 | 244) {
+                    c.push(0xfc | info.chroma as u8 & 3);
+                    c.push(0xf8 | (info.depth_luma - 8) as u8 & 7);
+                    c.push(0xf8 | (info.depth_chroma - 8) as u8 & 7);
+                    c.push(0);
+                }
+                (info.width, info.height, mp4_box(b"avcC", &c))
+            }
+            VideoFormat::Hevc => {
+                let (vps, sps, pps) = (of(32), of(33), of(34));
+                if vps.is_empty() || pps.is_empty() {
+                    return None;
+                }
+                let info = parse_hevc_sps(sps.first()?)?;
+                let mut c = vec![1];
+                c.extend_from_slice(&info.ptl[..1]);
+                c.extend_from_slice(&info.ptl[1..5]); // compatibility flags
+                c.extend_from_slice(&info.ptl[5..11]); // constraint flags
+                c.push(info.ptl[11]); // level
+                c.extend_from_slice(&0xf000u16.to_be_bytes());
+                c.push(0xfc);
+                c.push(0xfc | info.chroma as u8 & 3);
+                c.push(0xf8 | (info.depth_luma - 8) as u8 & 7);
+                c.push(0xf8 | (info.depth_chroma - 8) as u8 & 7);
+                c.extend_from_slice(&0u16.to_be_bytes());
+                c.push(((info.sub_layers as u8 & 7) << 3) | ((info.temporal_id_nested as u8) << 2) | 3);
+                c.push(3);
+                for (t, list) in [(32u8, &vps), (33, &sps), (34, &pps)] {
+                    c.push(0x80 | t);
+                    c.extend_from_slice(&(list.len() as u16).to_be_bytes());
+                    for n in list.iter() {
+                        c.extend_from_slice(&(n.len() as u16).to_be_bytes());
+                        c.extend_from_slice(n);
+                    }
+                }
+                (info.width, info.height, mp4_box(b"hvcC", &c))
+            }
+        };
+        if width == 0 || height == 0 || width > 16384 || height > 16384 {
+            return None;
+        }
+        let mut entry = Vec::new();
+        entry.extend_from_slice(&[0; 6]);
+        entry.extend_from_slice(&1u16.to_be_bytes()); // data_reference_index
+        entry.extend_from_slice(&[0; 16]);
+        entry.extend_from_slice(&(width as u16).to_be_bytes());
+        entry.extend_from_slice(&(height as u16).to_be_bytes());
+        entry.extend_from_slice(&0x0048_0000u32.to_be_bytes());
+        entry.extend_from_slice(&0x0048_0000u32.to_be_bytes());
+        entry.extend_from_slice(&[0; 4]);
+        entry.extend_from_slice(&1u16.to_be_bytes()); // frame_count
+        let mut name = [0u8; 32];
+        let label = b"KyberNow";
+        name[0] = label.len() as u8;
+        name[1..=label.len()].copy_from_slice(label);
+        entry.extend_from_slice(&name);
+        entry.extend_from_slice(&0x0018u16.to_be_bytes());
+        entry.extend_from_slice(&0xffffu16.to_be_bytes());
+        entry.extend_from_slice(&config_box);
+        let kind = match format {
+            VideoFormat::H264 => b"avc1",
+            VideoFormat::Hevc => b"hvc1",
+        };
+        Some(Self {
+            format,
+            width,
+            height,
+            param_sets,
+            sample_entry: mp4_box(kind, &entry),
+        })
+    }
+}
+
+impl AudioConfig {
+    pub(crate) fn from_opus_head(data: &[u8]) -> Option<Self> {
+        if data.len() < 19 || &data[..8] != b"OpusHead" {
+            return None;
+        }
+        let channels = data[9];
+        let family = data[18];
+        if channels == 0 {
+            return None;
+        }
+        let (streams, coupled, mapping) = if family == 0 {
+            (1, u8::from(channels > 1), Vec::new())
+        } else {
+            let mapping = data.get(21..21 + channels as usize)?.to_vec();
+            (data[19], data[20], mapping)
+        };
+        Some(Self {
+            channels,
+            pre_skip: u16::from_le_bytes([data[10], data[11]]),
+            input_rate: u32::from_le_bytes([data[12], data[13], data[14], data[15]]),
+            gain: i16::from_le_bytes([data[16], data[17]]),
+            family,
+            streams,
+            coupled,
+            mapping,
+        })
+    }
+
+    fn sample_entry(&self) -> Vec<u8> {
+        let mut dops = vec![0, self.channels];
+        dops.extend_from_slice(&self.pre_skip.to_be_bytes());
+        dops.extend_from_slice(&self.input_rate.to_be_bytes());
+        dops.extend_from_slice(&self.gain.to_be_bytes());
+        dops.push(self.family);
+        if self.family != 0 {
+            dops.push(self.streams);
+            dops.push(self.coupled);
+            dops.extend_from_slice(&self.mapping);
+        }
+        let mut entry = Vec::new();
+        entry.extend_from_slice(&[0; 6]);
+        entry.extend_from_slice(&1u16.to_be_bytes());
+        entry.extend_from_slice(&[0; 8]);
+        entry.extend_from_slice(&(self.channels as u16).to_be_bytes());
+        entry.extend_from_slice(&16u16.to_be_bytes());
+        entry.extend_from_slice(&[0; 4]);
+        entry.extend_from_slice(&(AUDIO_TIMESCALE << 16).to_be_bytes());
+        entry.extend_from_slice(&mp4_box(b"dOps", &dops));
+        mp4_box(b"Opus", &entry)
+    }
+}
+
+/// How long an Opus packet plays, in 48 kHz samples (its first stream's TOC;
+/// RFC 6716 § 3.1). 0 when it cannot be read.
+pub(crate) fn opus_duration(packet: &[u8]) -> u32 {
+    let Some(&toc) = packet.first() else {
+        return 0;
+    };
+    let config = toc >> 3;
+    // In 1/400 s, so 2.5 ms is 1.
+    let frame = match config {
+        0..=11 => [4, 8, 16, 24][(config % 4) as usize],
+        12..=15 => [4, 8][(config % 2) as usize],
+        _ => [1, 2, 4, 8][(config % 4) as usize],
+    };
+    let frames = match toc & 3 {
+        0 => 1,
+        1 | 2 => 2,
+        _ => packet.get(1).map_or(0, |b| (b & 0x3f) as u32),
+    };
+    frame * frames * 120
+}
+
+// ===========================================================================
+// Boxes
+// ===========================================================================
+
+fn mp4_box(kind: &[u8; 4], payload: &[u8]) -> Vec<u8> {
+    let mut b = Vec::with_capacity(payload.len() + 8);
+    b.extend_from_slice(&((payload.len() + 8) as u32).to_be_bytes());
+    b.extend_from_slice(kind);
+    b.extend_from_slice(payload);
+    b
+}
+
+fn full_box(kind: &[u8; 4], version: u8, flags: u32, payload: &[u8]) -> Vec<u8> {
+    let mut p = Vec::with_capacity(payload.len() + 4);
+    p.push(version);
+    p.extend_from_slice(&flags.to_be_bytes()[1..]);
+    p.extend_from_slice(payload);
+    mp4_box(kind, &p)
+}
+
+fn concat(parts: &[&[u8]]) -> Vec<u8> {
+    parts.concat()
+}
+
+const MATRIX: [u32; 9] = [0x0001_0000, 0, 0, 0, 0x0001_0000, 0, 0, 0, 0x4000_0000];
+
+fn matrix() -> Vec<u8> {
+    MATRIX.iter().flat_map(|v| v.to_be_bytes()).collect()
+}
+
+fn mvhd() -> Vec<u8> {
+    let mut p = Vec::new();
+    p.extend_from_slice(&[0; 8]); // creation, modification
+    p.extend_from_slice(&1000u32.to_be_bytes());
+    p.extend_from_slice(&0u32.to_be_bytes());
+    p.extend_from_slice(&0x0001_0000u32.to_be_bytes());
+    p.extend_from_slice(&0x0100u16.to_be_bytes());
+    p.extend_from_slice(&[0; 10]);
+    p.extend_from_slice(&matrix());
+    p.extend_from_slice(&[0; 24]);
+    p.extend_from_slice(&(AUDIO_TRACK + 1).to_be_bytes());
+    full_box(b"mvhd", 0, 0, &p)
+}
+
+fn trak(track: u32, timescale: u32, handler: &[u8; 4], entry: &[u8], size: Option<(u32, u32)>) -> Vec<u8> {
+    let mut t = Vec::new();
+    t.extend_from_slice(&[0; 8]);
+    t.extend_from_slice(&track.to_be_bytes());
+    t.extend_from_slice(&[0; 4]);
+    t.extend_from_slice(&0u32.to_be_bytes()); // duration
+    t.extend_from_slice(&[0; 8]);
+    t.extend_from_slice(&0u16.to_be_bytes()); // layer
+    t.extend_from_slice(&0u16.to_be_bytes()); // alternate group
+    t.extend_from_slice(&(if size.is_none() { 0x0100u16 } else { 0 }).to_be_bytes());
+    t.extend_from_slice(&[0; 2]);
+    t.extend_from_slice(&matrix());
+    let (w, h) = size.unwrap_or((0, 0));
+    t.extend_from_slice(&(w << 16).to_be_bytes());
+    t.extend_from_slice(&(h << 16).to_be_bytes());
+    let tkhd = full_box(b"tkhd", 0, 3, &t);
+
+    let mut m = Vec::new();
+    m.extend_from_slice(&[0; 8]);
+    m.extend_from_slice(&timescale.to_be_bytes());
+    m.extend_from_slice(&0u32.to_be_bytes());
+    m.extend_from_slice(&0x55c4u16.to_be_bytes()); // "und"
+    m.extend_from_slice(&[0; 2]);
+    let mdhd = full_box(b"mdhd", 0, 0, &m);
+
+    let mut h = vec![0; 4];
+    h.extend_from_slice(handler);
+    h.extend_from_slice(&[0; 12]);
+    h.extend_from_slice(if size.is_some() { b"KyberNow video\0" } else { b"KyberNow sound\0" });
+    let hdlr = full_box(b"hdlr", 0, 0, &h);
+
+    let media_header = if size.is_some() {
+        full_box(b"vmhd", 0, 1, &[0; 8])
+    } else {
+        full_box(b"smhd", 0, 0, &[0; 4])
+    };
+    let dref = full_box(b"dref", 0, 0, &concat(&[&1u32.to_be_bytes(), &full_box(b"url ", 0, 1, &[])]));
+    let dinf = mp4_box(b"dinf", &dref);
+    let stsd = full_box(b"stsd", 0, 0, &concat(&[&1u32.to_be_bytes(), entry]));
+    let empty = 0u32.to_be_bytes();
+    let stbl = mp4_box(
+        b"stbl",
+        &concat(&[
+            &stsd,
+            &full_box(b"stts", 0, 0, &empty),
+            &full_box(b"stsc", 0, 0, &empty),
+            &full_box(b"stsz", 0, 0, &[0; 8]),
+            &full_box(b"stco", 0, 0, &empty),
+        ]),
+    );
+    let minf = mp4_box(b"minf", &concat(&[&media_header, &dinf, &stbl]));
+    let mdia = mp4_box(b"mdia", &concat(&[&mdhd, &hdlr, &minf]));
+    mp4_box(b"trak", &concat(&[&tkhd, &mdia]))
+}
+
+fn trex(track: u32) -> Vec<u8> {
+    let mut p = Vec::new();
+    p.extend_from_slice(&track.to_be_bytes());
+    p.extend_from_slice(&1u32.to_be_bytes());
+    p.extend_from_slice(&[0; 12]);
+    full_box(b"trex", 0, 0, &p)
+}
+
+// ===========================================================================
+// Writer
+// ===========================================================================
+
+/// A sample waiting for the next one (its duration is the gap to it).
+struct Pending {
+    data: Vec<u8>,
+    /// In the track's timescale, from the file's start.
+    time: u64,
+    sync: bool,
+}
+
+struct Sample {
+    data: Vec<u8>,
+    duration: u32,
+    sync: bool,
+}
+
+struct Track {
+    /// Decode time of the first sample not yet in a fragment.
+    next_time: u64,
+    pending: Option<Pending>,
+    ready: Vec<Sample>,
+    last_duration: u32,
+}
+
+impl Track {
+    fn new(default_duration: u32) -> Self {
+        Self {
+            next_time: 0,
+            pending: None,
+            ready: Vec::new(),
+            last_duration: default_duration,
+        }
+    }
+
+    fn ready_time(&self) -> u64 {
+        self.ready.iter().map(|s| s.duration as u64).sum()
+    }
+}
+
+/// A fragment's place, for the index written at the end.
+struct FragmentRef {
+    video_time: u64,
+    moof_offset: u64,
+}
+
+/// A fragmented MP4 being written. Video times are microseconds of the
+/// encoder's clock; the first video sample is the file's zero.
+pub(crate) struct Mp4Writer<W: Write + Seek> {
+    out: W,
+    written: u64,
+    video: VideoConfig,
+    vtrack: Track,
+    atrack: Option<Track>,
+    sequence: u32,
+    origin_us: Option<u64>,
+    mehd_offset: u64,
+    fragments: Vec<FragmentRef>,
+    /// Video ticks after which the pending samples make a fragment.
+    fragment_ticks: u64,
+}
+
+impl<W: Write + Seek> Mp4Writer<W> {
+    pub(crate) fn new(mut out: W, video: VideoConfig, audio: Option<&AudioConfig>) -> io::Result<Self> {
+        let brand: &[u8; 4] = match video.format {
+            VideoFormat::H264 => b"avc1",
+            VideoFormat::Hevc => b"hvc1",
+        };
+        let ftyp = mp4_box(b"ftyp", &concat(&[b"isom", &0x200u32.to_be_bytes(), b"isom", b"iso6", b"mp41", brand]));
+        let mut traks = trak(VIDEO_TRACK, VIDEO_TIMESCALE, b"vide", &video.sample_entry, Some((video.width, video.height)));
+        if let Some(a) = audio {
+            traks.extend_from_slice(&trak(AUDIO_TRACK, AUDIO_TIMESCALE, b"soun", &a.sample_entry(), None));
+        }
+        let mehd = full_box(b"mehd", 1, 0, &[0; 8]);
+        let mut mvex = mehd.clone();
+        mvex.extend_from_slice(&trex(VIDEO_TRACK));
+        if audio.is_some() {
+            mvex.extend_from_slice(&trex(AUDIO_TRACK));
+        }
+        let mvex = mp4_box(b"mvex", &mvex);
+        let moov_payload = concat(&[&mvhd(), &traks, &mvex]);
+        let moov = mp4_box(b"moov", &moov_payload);
+        // mehd's 64-bit duration: its own header is 12 bytes from its start.
+        let mehd_offset = ftyp.len() as u64 + 8 + (mvhd().len() + traks.len()) as u64 + 8 + 12;
+        out.write_all(&ftyp)?;
+        out.write_all(&moov)?;
+        out.flush()?;
+        Ok(Self {
+            written: (ftyp.len() + moov.len()) as u64,
+            out,
+            video,
+            vtrack: Track::new(VIDEO_TIMESCALE / 60),
+            atrack: audio.map(|_| Track::new(960)),
+            sequence: 0,
+            origin_us: None,
+            mehd_offset,
+            fragments: Vec::new(),
+            fragment_ticks: VIDEO_TIMESCALE as u64,
+        })
+    }
+
+    pub(crate) fn has_audio(&self) -> bool {
+        self.atrack.is_some()
+    }
+
+    /// Bytes written so far.
+    pub(crate) fn len(&self) -> u64 {
+        self.written
+    }
+
+    fn ticks(us: u64, timescale: u32) -> u64 {
+        (us as u128 * timescale as u128 / 1_000_000) as u64
+    }
+
+    /// An access unit (Annex B), `pts` in microseconds. The first one must be
+    /// a keyframe; anything before it is dropped.
+    pub(crate) fn write_video(&mut self, pts_us: u64, key: bool, annexb: &[u8]) -> io::Result<()> {
+        let origin = match self.origin_us {
+            Some(o) => o,
+            None if key => {
+                self.origin_us = Some(pts_us);
+                pts_us
+            }
+            None => return Ok(()),
+        };
+        let Some(data) = sample_from_annexb(self.video.format, annexb) else {
+            return Ok(());
+        };
+        let time = Self::ticks(pts_us.saturating_sub(origin), VIDEO_TIMESCALE);
+        if let Some(prev) = self.vtrack.pending.take() {
+            // Never backwards, never zero: a repeated pts gets a tick.
+            let duration = time.saturating_sub(prev.time).clamp(1, u32::MAX as u64) as u32;
+            self.vtrack.last_duration = duration;
+            self.vtrack.ready.push(Sample {
+                data: prev.data,
+                duration,
+                sync: prev.sync,
+            });
+        }
+        let time = time.max(self.vtrack.next_time + self.vtrack.ready_time());
+        self.vtrack.pending = Some(Pending { data, time, sync: key });
+        if self.vtrack.ready_time() >= self.fragment_ticks {
+            self.flush_fragment()?;
+        }
+        Ok(())
+    }
+
+    /// An Opus packet, `pts` in microseconds of the same clock as the video.
+    /// Sound before the first image is dropped; a gap in the sound (lost
+    /// packets) stretches the sample before it, so what follows stays in
+    /// time with the image.
+    pub(crate) fn write_audio(&mut self, pts_us: u64, packet: &[u8]) -> io::Result<()> {
+        let (Some(origin), Some(track)) = (self.origin_us, self.atrack.as_mut()) else {
+            return Ok(());
+        };
+        if pts_us < origin || packet.is_empty() {
+            return Ok(());
+        }
+        let time = Self::ticks(pts_us - origin, AUDIO_TIMESCALE);
+        let duration = match opus_duration(packet) {
+            0 => track.last_duration,
+            d => d,
+        };
+        if let Some(prev) = track.pending.take() {
+            let expected = prev.time + track.last_duration as u64;
+            // 40 ms of silence or more: kept as a longer sample.
+            let stretched = if time > expected + 1920 { time - prev.time } else { track.last_duration as u64 };
+            track.ready.push(Sample {
+                data: prev.data,
+                duration: stretched.min(u32::MAX as u64) as u32,
+                sync: true,
+            });
+        } else if track.ready.is_empty() && track.next_time == 0 {
+            track.next_time = time;
+        }
+        let start = track.next_time + track.ready_time();
+        track.last_duration = duration;
+        track.pending = Some(Pending {
+            data: packet.to_vec(),
+            time: start.max(time.min(start + AUDIO_TIMESCALE as u64)),
+            sync: true,
+        });
+        // A still screen sends no image: the sound is written on its own
+        // once a second, so the file holds it up to its last second (and
+        // the size shown goes on growing).
+        if track.ready_time() >= AUDIO_TIMESCALE as u64 {
+            self.flush_fragment()?;
+        }
+        Ok(())
+    }
+
+    fn traf(track_id: u32, base: u64, samples: &[Sample], data_offset: u32, with_flags: bool) -> Vec<u8> {
+        let tfhd = full_box(b"tfhd", 0, 0x02_0000, &track_id.to_be_bytes());
+        let tfdt = full_box(b"tfdt", 1, 0, &base.to_be_bytes());
+        let mut flags = 0x000001 | 0x000100 | 0x000200;
+        if with_flags {
+            flags |= 0x000400;
+        }
+        let mut r = Vec::new();
+        r.extend_from_slice(&(samples.len() as u32).to_be_bytes());
+        r.extend_from_slice(&data_offset.to_be_bytes());
+        for s in samples {
+            r.extend_from_slice(&s.duration.to_be_bytes());
+            r.extend_from_slice(&(s.data.len() as u32).to_be_bytes());
+            if with_flags {
+                let f: u32 = if s.sync { 0x0200_0000 } else { 0x0101_0000 };
+                r.extend_from_slice(&f.to_be_bytes());
+            }
+        }
+        let trun = full_box(b"trun", 0, flags, &r);
+        mp4_box(b"traf", &concat(&[&tfhd, &tfdt, &trun]))
+    }
+
+    /// Writes the samples whose duration is known as one fragment.
+    fn flush_fragment(&mut self) -> io::Result<()> {
+        let video = std::mem::take(&mut self.vtrack.ready);
+        let audio = self.atrack.as_mut().map(|t| std::mem::take(&mut t.ready)).unwrap_or_default();
+        if video.is_empty() && audio.is_empty() {
+            return Ok(());
+        }
+        self.sequence += 1;
+        let vbytes: usize = video.iter().map(|s| s.data.len()).sum();
+        let abytes: usize = audio.iter().map(|s| s.data.len()).sum();
+        let vbase = self.vtrack.next_time;
+        let abase = self.atrack.as_ref().map_or(0, |t| t.next_time);
+        // Built twice: the data offsets depend on the moof's own size.
+        let build = |voff: u32, aoff: u32| {
+            let mut trafs = Vec::new();
+            if !video.is_empty() {
+                trafs.extend_from_slice(&Self::traf(VIDEO_TRACK, vbase, &video, voff, true));
+            }
+            if !audio.is_empty() {
+                trafs.extend_from_slice(&Self::traf(AUDIO_TRACK, abase, &audio, aoff, false));
+            }
+            let mfhd = full_box(b"mfhd", 0, 0, &self.sequence.to_be_bytes());
+            mp4_box(b"moof", &concat(&[&mfhd, &trafs]))
+        };
+        let size = build(0, 0).len() as u32;
+        let moof = build(size + 8, size + 8 + vbytes as u32);
+        let mut mdat = Vec::with_capacity(8 + vbytes + abytes);
+        mdat.extend_from_slice(&((8 + vbytes + abytes) as u32).to_be_bytes());
+        mdat.extend_from_slice(b"mdat");
+        for s in video.iter().chain(audio.iter()) {
+            mdat.extend_from_slice(&s.data);
+        }
+        if video.first().is_some_and(|s| s.sync) {
+            self.fragments.push(FragmentRef {
+                video_time: vbase,
+                moof_offset: self.written,
+            });
+        }
+        self.out.write_all(&moof)?;
+        self.out.write_all(&mdat)?;
+        self.out.flush()?;
+        self.written += (moof.len() + mdat.len()) as u64;
+        self.vtrack.next_time += video.iter().map(|s| s.duration as u64).sum::<u64>();
+        if let Some(t) = self.atrack.as_mut() {
+            t.next_time += audio.iter().map(|s| s.duration as u64).sum::<u64>();
+        }
+        Ok(())
+    }
+
+    /// The video time written so far, in microseconds.
+    pub(crate) fn duration_us(&self) -> u64 {
+        let ticks = self.vtrack.next_time + self.vtrack.ready_time();
+        ticks * 1_000_000 / VIDEO_TIMESCALE as u64
+    }
+
+    /// Writes what is left, the duration and the index, and hands the output
+    /// back.
+    pub(crate) fn finish(mut self) -> io::Result<W> {
+        if let Some(p) = self.vtrack.pending.take() {
+            let duration = self.vtrack.last_duration;
+            self.vtrack.ready.push(Sample { data: p.data, duration, sync: p.sync });
+        }
+        if let Some(t) = self.atrack.as_mut()
+            && let Some(p) = t.pending.take()
+        {
+            let duration = t.last_duration;
+            t.ready.push(Sample { data: p.data, duration, sync: true });
+        }
+        self.flush_fragment()?;
+
+        // mfra: where each fragment starting on a keyframe is.
+        let mut entries = Vec::new();
+        entries.extend_from_slice(&VIDEO_TRACK.to_be_bytes());
+        entries.extend_from_slice(&0u32.to_be_bytes()); // 1-byte traf/trun/sample numbers
+        entries.extend_from_slice(&(self.fragments.len() as u32).to_be_bytes());
+        for f in &self.fragments {
+            entries.extend_from_slice(&f.video_time.to_be_bytes());
+            entries.extend_from_slice(&f.moof_offset.to_be_bytes());
+            entries.extend_from_slice(&[1, 1, 1]);
+        }
+        let tfra = full_box(b"tfra", 1, 0, &entries);
+        let mfro_size = 16u32;
+        let mfra_size = 8 + tfra.len() as u32 + mfro_size;
+        let mfro = full_box(b"mfro", 0, 0, &mfra_size.to_be_bytes());
+        let mfra = mp4_box(b"mfra", &concat(&[&tfra, &mfro]));
+        self.out.write_all(&mfra)?;
+
+        // The total duration, in the movie's timescale (ms).
+        let total_ms = self.duration_us() / 1000;
+        self.out.seek(SeekFrom::Start(self.mehd_offset))?;
+        self.out.write_all(&total_ms.to_be_bytes())?;
+        self.out.seek(SeekFrom::End(0))?;
+        self.out.flush()?;
+        Ok(self.out)
+    }
+}
