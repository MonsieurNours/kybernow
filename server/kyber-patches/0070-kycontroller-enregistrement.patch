+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn safe_names() {
+        assert_eq!(safe_name("KyberNow 2026-11-26 14-32-05").as_deref(), Some("KyberNow 2026-11-26 14-32-05"));
+        assert_eq!(safe_name("a/b:c").as_deref(), Some("a-b-c"));
+        assert_eq!(safe_name(" .. "), None);
+        assert_eq!(safe_name(""), None);
+    }
+
+    #[test]
+    fn parts_never_overwrite() {
+        let dir = std::env::temp_dir().join(format!("kn-rec-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let first = file_path(&dir, "x", 1);
+        assert_eq!(first.file_name().unwrap(), "x.mp4");
+        std::fs::write(&first, b"").unwrap();
+        assert_eq!(file_path(&dir, "x", 1).file_name().unwrap(), "x (2).mp4");
+        assert_eq!(file_path(&dir, "x", 3).file_name().unwrap(), "x (3).mp4");
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn reads_df() {
+        let out = "Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/disk3s1 1953000 13000 161000 8% /\n";
+        assert_eq!(df_available(out), Some(161_000 * 1024));
+        assert_eq!(df_available("Filesystem\n"), None);
+        assert_eq!(df_available(""), None);
+    }
+
+    #[cfg(not(windows))]
+    #[test]
+    fn free_space_of_the_temp_dir() {
+        assert!(free_space(&std::env::temp_dir()).is_some_and(|f| f > 0));
+    }
+
+    #[test]
+    fn one_start_at_a_time() {
