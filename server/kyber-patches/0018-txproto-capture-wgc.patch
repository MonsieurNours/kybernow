+/* ------------------------------------------------------------------------
+ * KyberNow (0018): secondary displays captured through Windows Graphics
+ * Capture.
+ *
+ * Desktop duplication of the SudoVDA (IddCx) displays created after the
+ * first one returns a texture where the picture sits at the display's
+ * desktop position (the rest is black), while DWM composes them correctly.
+ * Windows Graphics Capture (WGC) captures what DWM composes, but refuses a
+ * SYSTEM process such as kyavserver. KyberNow Admin therefore runs one
+ * capture agent per secondary display of a multi-display session, with the
+ * signed-in user's account (`kyber-admin display-agent wgc-capture`). Each
+ * agent copies the frames into a ring of shared D3D11 textures on the
+ * display's adapter; this code opens that ring and copies the newest frame
+ * into the usual texture pool, on the GPU. No ring (single-display session,
+ * nobody signed in, agent failure): desktop duplication as before.
+ *
+ * Shared objects for output "\\.\DISPLAY6" (id "DISPLAY6"), in the session
+ * namespace:
+ *   KyberNowWGC_DISPLAY6               file mapping, KnWgcHeader
+ *   KyberNowWGC_DISPLAY6_frame         auto-reset event, set on each frame
+ *   KyberNowWGC_DISPLAY6_<gen>_<slot>  shared texture (NT handle, keyed
+ *                                       mutex, key 0), BGRA 8 bits
+ * Same layout as server/admin/src/display/wgc_shared.rs.
+ *
+ * The pointer is left out of the WGC picture; it is read with
+ * GetCursorInfo() and sent through the same cursor sink as with desktop
+ * duplication.
+ * ------------------------------------------------------------------------ */
+
+typedef struct KnWgcHeader {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t state;
+    uint32_t generation;
+    uint32_t width;
+    uint32_t height;
+    uint32_t format;
+    uint32_t slots;
+    uint32_t luid_low;
+    int32_t luid_high;
+    uint32_t refresh;
+    uint32_t latest_slot;
+    uint64_t frame_counter;
+    int64_t frame_time;
+    int64_t publish_time;
+    int64_t heartbeat_time;
+    uint32_t producer_pid;
+    uint32_t border_required;
+} KnWgcHeader;
+
+_Static_assert(offsetof(KnWgcHeader, frame_counter) == 48, "KnWgcHeader layout");
+_Static_assert(sizeof(KnWgcHeader) == 88, "KnWgcHeader size");
+
+#define KN_WGC_MAGIC 0x47574E4Bu /* "KNWG" */
+#define KN_WGC_VERSION 1
+#define KN_WGC_SLOTS 3
+#define KN_WGC_STATE_RUNNING 1
+/* No heartbeat from the agent for this long: back to desktop duplication. */
+#define KN_WGC_STALE_100NS (3LL * 10000000LL)
+/* Capture latency is logged over this period. */
+#define KN_LATENCY_PERIOD_US (5LL * 1000000LL)
+
+/* {a04bfb29-08ef-43d6-a49c-a9bdbdcbe686} */
+static const GUID kn_iid_d3d11_device1 = {
+    0xa04bfb29, 0x08ef, 0x43d6, { 0xa4, 0x9c, 0xa9, 0xbd, 0xbd, 0xcb, 0xe6, 0x86 }
+};
+/* {9d8e1289-d7b3-465f-8126-250e349af85d} */
+static const GUID kn_iid_dxgi_keyed_mutex = {
+    0x9d8e1289, 0xd7b3, 0x465f, { 0x81, 0x26, 0x25, 0x0e, 0x34, 0x9a, 0xf8, 0x5d }
+};
+
+typedef struct KnWgc {
+    char id[64];
+    HANDLE mapping;
+    volatile KnWgcHeader *header;
+    HANDLE event;
+
+    uint32_t generation; /* of the opened textures, 0 = none */
+    ID3D11Texture2D *textures[KN_WGC_SLOTS];
+    IDXGIKeyedMutex *mutexes[KN_WGC_SLOTS];
+    uint64_t last_counter;
+    int open_failures; /* texture opening failures, logged once */
+
+    /* Pointer read with GetCursorInfo() */
+    HCURSOR cursor;
+    int cursor_visible;
+    POINT cursor_position;
+    POINT cursor_hotspot;
+} KnWgc;
+
+/* QueryPerformanceCounter clock in 100 ns units (WGC SystemRelativeTime). */
+static int64_t kn_now_100ns(void)
+{
+    LARGE_INTEGER count, freq;
+    QueryPerformanceCounter(&count);
+    QueryPerformanceFrequency(&freq);
+    if (freq.QuadPart <= 0)
+        return 0;
+    return (int64_t)((double)count.QuadPart * 10000000.0 / (double)freq.QuadPart);
+}
+
+/* Capture latency (frame time to copy), logged every KN_LATENCY_PERIOD_US. */
+typedef struct KnLatency {
+    int64_t start;
+    int count;
+    double sum_ms;
+    double max_ms;
+} KnLatency;
+
+static void kn_latency_add(IOSysEntry *entry, KnLatency *l, const char *method, double ms)
+{
+    int64_t now = av_gettime_relative();
+    if (!l->start)
+        l->start = now;
+    if (ms >= 0 && ms < 10000) {
+        l->count++;
+        l->sum_ms += ms;
+        if (ms > l->max_ms)
+            l->max_ms = ms;
+    }
+    if (now - l->start >= KN_LATENCY_PERIOD_US) {
+        if (l->count)
+            sp_log(entry, SP_LOG_INFO, "Capture latency (%s): %d frame(s), average %.2f ms, max %.2f ms\n",
+                   method, l->count, l->sum_ms / l->count, l->max_ms);
+        l->start = now;
+        l->count = 0;
+        l->sum_ms = 0;
+        l->max_ms = 0;
+    }
+}
+
+static FARPROC kn_user32_proc(const char *name)
+{
+    HMODULE user32 = GetModuleHandleW(L"user32.dll");
+    return user32 ? GetProcAddress(user32, name) : NULL;
+}
+
+/* Pointer coordinates in physical pixels, like the desktop coordinates of
+ * the outputs: this thread becomes per-monitor-v2 DPI aware. */
+static void kn_thread_dpi_aware(void)
+{
+    typedef HANDLE (WINAPI *set_thread_t)(HANDLE);
+    set_thread_t set_thread = (set_thread_t)(void *)kn_user32_proc("SetThreadDpiAwarenessContext");
+    if (set_thread)
+        set_thread((HANDLE)(intptr_t)-4 /* DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2 */);
+}
+
+/* "\\.\DISPLAY6" -> "DISPLAY6" */
+static void kn_screen_id(const char *name, char *out, size_t size)
+{
+    size_t n = 0;
+    while (*name == '\\' || *name == '.')
+        name++;
+    for (; *name && n + 1 < size; name++)
+        if ((*name >= 'A' && *name <= 'Z') || (*name >= 'a' && *name <= 'z') || (*name >= '0' && *name <= '9'))
+            out[n++] = *name;
+    out[n] = 0;
+}
+
+static void kn_wgc_release_textures(KnWgc *w)
+{
+    for (int i = 0; i < KN_WGC_SLOTS; i++) {
+        if (w->mutexes[i])
+            IDXGIKeyedMutex_Release(w->mutexes[i]);
+        if (w->textures[i])
+            ID3D11Texture2D_Release(w->textures[i]);
+        w->mutexes[i] = NULL;
+        w->textures[i] = NULL;
+    }
+    w->generation = 0;
+}
+
+static void kn_wgc_close(DxgiCapture *priv)
+{
+    KnWgc *w = priv->wgc;
+    if (!w)
+        return;
+    kn_wgc_release_textures(w);
+    if (w->header)
+        UnmapViewOfFile((LPCVOID)w->header);
+    if (w->mapping)
+        CloseHandle(w->mapping);
+    if (w->event)
+        CloseHandle(w->event);
+    av_freep(&priv->wgc);
+}
+
+static int kn_wgc_open_textures(IOSysEntry *entry, KnWgc *w, DxgiCtx *ctx, uint32_t generation)
+{
+    ID3D11Device1 *device1 = NULL;
+    HRESULT hr;
+
+    kn_wgc_release_textures(w);
+    hr = ID3D11Device_QueryInterface(ctx->d3d11_device, &kn_iid_d3d11_device1, (void **)&device1);
+    if (FAILED(hr)) {
+        sp_log(entry, SP_LOG_WARN, "WGC: ID3D11Device1 unavailable: 0x%lX\n", hr);
+        return AVERROR_EXTERNAL;
+    }
+    for (int i = 0; i < KN_WGC_SLOTS; i++) {
+        char name[128];
+        WCHAR wname[128];
+        snprintf(name, sizeof(name), "KyberNowWGC_%s_%u_%d", w->id, generation, i);
+        MultiByteToWideChar(CP_ACP, 0, name, -1, wname, 128);
+        hr = ID3D11Device1_OpenSharedResourceByName(device1, wname,
+                                                    DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE,
+                                                    &IID_ID3D11Texture2D,
+                                                    (void **)&w->textures[i]);
+        if (SUCCEEDED(hr))
+            hr = ID3D11Texture2D_QueryInterface(w->textures[i], &kn_iid_dxgi_keyed_mutex,
+                                                (void **)&w->mutexes[i]);
+        if (FAILED(hr)) {
+            if (!w->open_failures++)
+                sp_log(entry, SP_LOG_WARN, "WGC: cannot open shared texture %s: 0x%lX\n", name, hr);
+            ID3D11Device1_Release(device1);
+            kn_wgc_release_textures(w);
+            return AVERROR_EXTERNAL;
+        }
+    }
+    ID3D11Device1_Release(device1);
+    w->generation = generation;
+    return 0;
+}
+
+/* Opens the WGC ring of this output, if KyberNow Admin started one. */
+static int kn_wgc_open(IOSysEntry *entry, DxgiCapture *priv, DxgiCtx *ctx)
+{
+    char id[64], name[128];
+    DXGI_ADAPTER_DESC1 adapter_desc;
+    KnWgc *w;
+
+    kn_screen_id(sp_class_get_name(entry), id, sizeof(id));
+    snprintf(name, sizeof(name), "KyberNowWGC_%s", id);
+
+    /* A secondary display (not at (0, 0)) may have a capture agent still
+     * starting: it is looked for during 1.5 s. The main display, never
+     * captured through WGC, is not kept waiting. */
+    const int secondary = entry->x || entry->y;
+    const int64_t looked_at = av_gettime_relative();
+    const int64_t deadline = looked_at + (secondary ? 1500000 : 0);
+    if (secondary)
+        sp_log(entry, SP_LOG_INFO, "WGC: looking for the capture agent of %s\n", id);
+    HANDLE mapping;
+    while (!(mapping = OpenFileMappingA(FILE_MAP_READ, FALSE, name)) &&
+           av_gettime_relative() < deadline && !atomic_load(&priv->quit))
+        av_usleep(100000);
+    if (!mapping) {
+        /* No WGC for this output. Worth a line for a secondary display. */
+        if (secondary)
+            sp_log(entry, SP_LOG_INFO, "WGC: no capture agent for %s (%lu): desktop duplication\n", id, GetLastError());
+        return AVERROR(ENOENT);
+    }
+
+    w = av_mallocz(sizeof(*w));
+    if (!w) {
+        CloseHandle(mapping);
+        return AVERROR(ENOMEM);
+    }
+    priv->wgc = w;
+    snprintf(w->id, sizeof(w->id), "%s", id);
+    w->mapping = mapping;
+    w->header = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, sizeof(KnWgcHeader));
+    if (!w->header) {
+        sp_log(entry, SP_LOG_WARN, "WGC: cannot map %s: %lu\n", name, GetLastError());
+        goto fail;
+    }
+    if (w->header->magic != KN_WGC_MAGIC || w->header->version != KN_WGC_VERSION ||
+        w->header->slots != KN_WGC_SLOTS) {
+        sp_log(entry, SP_LOG_WARN, "WGC: unexpected shared header in %s\n", name);
+        goto fail;
+    }
+    while ((w->header->state != KN_WGC_STATE_RUNNING ||
+            kn_now_100ns() - w->header->heartbeat_time > KN_WGC_STALE_100NS) &&
+           av_gettime_relative() < deadline && !atomic_load(&priv->quit))
+        av_usleep(50000);
+    if (w->header->state != KN_WGC_STATE_RUNNING ||
+        kn_now_100ns() - w->header->heartbeat_time > KN_WGC_STALE_100NS) {
+        sp_log(entry, SP_LOG_WARN, "WGC: capture agent for %s is not running (state %u): desktop duplication\n",
+               id, w->header->state);
+        goto fail;
+    }
+    if (FAILED(IDXGIAdapter1_GetDesc1(ctx->dxgi_adapter, &adapter_desc)) ||
+        adapter_desc.AdapterLuid.LowPart != w->header->luid_low ||
+        adapter_desc.AdapterLuid.HighPart != w->header->luid_high) {
+        sp_log(entry, SP_LOG_WARN, "WGC: capture of %s runs on another adapter\n", id);
+        goto fail;
+    }
+    snprintf(name, sizeof(name), "KyberNowWGC_%s_frame", id);
+    w->event = OpenEventA(SYNCHRONIZE, FALSE, name);
+    if (!w->event) {
+        sp_log(entry, SP_LOG_WARN, "WGC: cannot open %s: %lu\n", name, GetLastError());
+        goto fail;
+    }
+
+    sp_log(entry, SP_LOG_INFO, "WGC: capture through Windows Graphics Capture (agent %lu found after %d ms, "
+           "%ux%u, frames published so far %llu, yellow border %s)\n",
+           (unsigned long)w->header->producer_pid, (int)((av_gettime_relative() - looked_at) / 1000),
+           w->header->width, w->header->height, (unsigned long long)w->header->frame_counter,
+           w->header->border_required ? "required by Windows" : "off");
+    return 0;
+
+fail:
+    kn_wgc_close(priv);
+    return AVERROR_EXTERNAL;
+}
+
+/* Pointer shape of `cursor` in the DXGI layout (COLOR, MASKED_COLOR or
+ * MONOCHROME with tightly packed rows, as dxgi_cursor.c expects). */
+static int kn_cursor_shape(HCURSOR cursor, DXGI_OUTDUPL_POINTER_SHAPE_INFO *info,
+                           uint8_t **data, uint32_t *size)
+{
+    ICONINFO icon;
+    BITMAP bm;
+    HDC dc;
+    int ret = AVERROR_EXTERNAL;
+
+    *data = NULL;
+    *size = 0;
+    if (!GetIconInfo(cursor, &icon))
+        return AVERROR_EXTERNAL;
+    dc = CreateCompatibleDC(NULL);
+    if (!dc)
+        goto end;
+
+    memset(info, 0, sizeof(*info));
+    info->HotSpot.x = icon.xHotspot;
+    info->HotSpot.y = icon.yHotspot;
+
+    if (icon.hbmColor && GetObjectW(icon.hbmColor, sizeof(bm), &bm)) {
+        const int w = bm.bmWidth, h = bm.bmHeight;
+        struct { BITMAPINFOHEADER h; RGBQUAD c[2]; } bi;
+        uint32_t *pixels = av_malloc((size_t)w * h * 4);
+        if (!pixels)
+            goto end;
+
+        memset(&bi, 0, sizeof(bi));
+        bi.h.biSize = sizeof(bi.h);
+        bi.h.biWidth = w;
+        bi.h.biHeight = -h;
+        bi.h.biPlanes = 1;
+        bi.h.biBitCount = 32;
+        bi.h.biCompression = BI_RGB;
+        if (GetDIBits(dc, icon.hbmColor, 0, h, pixels, (BITMAPINFO *)&bi, DIB_RGB_COLORS) != h) {
+            av_free(pixels);
+            goto end;
+        }
+
+        int has_alpha = 0;
+        for (int i = 0; i < w * h; i++)
+            has_alpha |= (pixels[i] >> 24) != 0;
+
+        if (has_alpha) {
+            info->Type = DXGI_OUTDUPL_POINTER_SHAPE_TYPE_COLOR;
+        } else {
+            /* Old-style colour cursor: alpha from the AND mask (0 = opaque, 0xFF = XOR). */
+            const int pitch = ((w + 31) / 32) * 4;
+            uint8_t *mask = av_mallocz((size_t)pitch * h);
+            memset(&bi, 0, sizeof(bi));
+            bi.h.biSize = sizeof(bi.h);
+            bi.h.biWidth = w;
+            bi.h.biHeight = -h;
+            bi.h.biPlanes = 1;
+            bi.h.biBitCount = 1;
+            bi.h.biCompression = BI_RGB;
+            if (mask && icon.hbmMask && GetDIBits(dc, icon.hbmMask, 0, h, mask, (BITMAPINFO *)&bi, DIB_RGB_COLORS) == h) {
+                for (int y = 0; y < h; y++)
+                    for (int x = 0; x < w; x++) {
+                        const int bit = (mask[y * pitch + x / 8] >> (7 - x % 8)) & 1;
+                        pixels[y * w + x] = (pixels[y * w + x] & 0x00FFFFFF) | (bit ? 0xFF000000u : 0);
+                    }
+            }
+            av_free(mask);
+            info->Type = DXGI_OUTDUPL_POINTER_SHAPE_TYPE_MASKED_COLOR;
+        }
+        info->Width = w;
+        info->Height = h;
+        info->Pitch = w * 4;
+        *data = (uint8_t *)pixels;
+        *size = (uint32_t)w * h * 4;
+        ret = 0;
+    } else if (icon.hbmMask && GetObjectW(icon.hbmMask, sizeof(bm), &bm)) {
+        /* Monochrome: AND mask then XOR mask, one bit per pixel. */
+        const int w = bm.bmWidth, h2 = bm.bmHeight;
+        const int pitch = ((w + 31) / 32) * 4, packed = (w + 7) / 8;
+        struct { BITMAPINFOHEADER h; RGBQUAD c[2]; } bi;
+        uint8_t *dib = av_mallocz((size_t)pitch * h2);
+        uint8_t *bits = av_mallocz((size_t)packed * h2);
+        if (!dib || !bits) {
+            av_free(dib);
+            av_free(bits);
+            goto end;
+        }
+        memset(&bi, 0, sizeof(bi));
+        bi.h.biSize = sizeof(bi.h);
+        bi.h.biWidth = w;
+        bi.h.biHeight = -h2;
+        bi.h.biPlanes = 1;
+        bi.h.biBitCount = 1;
+        bi.h.biCompression = BI_RGB;
+        if (GetDIBits(dc, icon.hbmMask, 0, h2, dib, (BITMAPINFO *)&bi, DIB_RGB_COLORS) != h2) {
+            av_free(dib);
+            av_free(bits);
+            goto end;
+        }
+        for (int y = 0; y < h2; y++)
+            memcpy(bits + (size_t)y * packed, dib + (size_t)y * pitch, packed);
+        av_free(dib);
+        info->Type = DXGI_OUTDUPL_POINTER_SHAPE_TYPE_MONOCHROME;
+        info->Width = w;
+        info->Height = h2;
+        info->Pitch = packed;
+        *data = bits;
+        *size = (uint32_t)packed * h2;
+        ret = 0;
+    }
+
+end:
+    if (dc)
+        DeleteDC(dc);
+    if (icon.hbmColor)
+        DeleteObject(icon.hbmColor);
+    if (icon.hbmMask)
+        DeleteObject(icon.hbmMask);
+    return ret;
+}
+
+/* Reads the Windows pointer and forwards it when it is on this output. */
+static void kn_wgc_poll_cursor(IOSysEntry *entry, DxgiCapture *priv, KnWgc *w)
+{
+    CURSORINFO ci = { .cbSize = sizeof(ci) };
+    if (!priv->cursor_sink || !GetCursorInfo(&ci))
+        return;
+
+    const int inside = ci.ptScreenPos.x >= entry->x && ci.ptScreenPos.x < entry->x + entry->width &&
+                       ci.ptScreenPos.y >= entry->y && ci.ptScreenPos.y < entry->y + entry->height;
+    const int visible = (ci.flags & CURSOR_SHOWING) && inside;
+    POINT none = { 0, 0 };
+
+    if (!visible) {
+        if (w->cursor_visible)
+            sp_dxgi_cursor_handler_send_shape(priv->cursor_sink, 0, none, NULL, NULL, 0);
+        w->cursor_visible = 0;
+        return;
+    }
+
+    DXGI_OUTDUPL_POINTER_SHAPE_INFO info;
+    uint8_t *data = NULL;
+    uint32_t size = 0;
+    const int new_shape = ci.hCursor != w->cursor;
+    if (new_shape && kn_cursor_shape(ci.hCursor, &info, &data, &size) == 0) {
+        w->cursor_hotspot = info.HotSpot;
+        w->cursor = ci.hCursor;
+    }
+
+    POINT position = {
+        ci.ptScreenPos.x - entry->x - w->cursor_hotspot.x,
+        ci.ptScreenPos.y - entry->y - w->cursor_hotspot.y,
+    };
+    if (data || !w->cursor_visible || position.x != w->cursor_position.x ||
+        position.y != w->cursor_position.y)
+        sp_dxgi_cursor_handler_send_shape(priv->cursor_sink, 1, position, data ? &info : NULL, data, size);
+
+    av_free(data);
+    w->cursor_visible = 1;
+    w->cursor_position = position;
+}
+
+/* Capture loop for an output with a WGC ring. Returns 0 on stop, an error
