+/* KyberNow (0029): pointer shape of the frame, read again with the size
+ * DXGI asks for when the buffer was too small. */
+static void read_frame_shape(DxgiCursorHandler *ctx,
+                             IDXGIOutputDuplication *output_duplication,
+                             UINT size, DxgiCursor *dxgi_cursor)
+{
+    HRESULT hr = E_FAIL;
+
+    for (int tries = 0; tries < 2 && size; tries++) {
+        UINT required_size = 0;
+        uint8_t *data = av_mallocz(size);
+        if (!data)
+            return;
+
+        hr = IDXGIOutputDuplication_GetFramePointerShape(
+            output_duplication,
+            size,
+            data,
+            &required_size,
+            &dxgi_cursor->shape_info);
+        if (SUCCEEDED(hr)) {
+            dxgi_cursor->data = data;
+            dxgi_cursor->size = size;
+            return;
+        }
+        av_free(data);
+        if (hr != DXGI_ERROR_MORE_DATA || required_size <= size)
+            break;
+        size = required_size;
+    }
+
+    /* Keep position and visibility; the shape watch of the capture
+     * (iosys_dxgi.c) reads it from Windows. */
+    sp_log(ctx, SP_LOG_DEBUG, "GetFramePointerShape() failed: 0x%lX\n", hr);
 }
 
