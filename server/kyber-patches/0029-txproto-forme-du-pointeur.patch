+
+/* KyberNow (0029): shape watch of desktop duplication. Desktop duplication
+ * does not always report a new pointer shape (shape changed under a still
+ * mouse, shape that could not be read, update lost): the pointer stayed as
+ * it was until the next change. Every KN_CURSOR_WATCH_US, the Windows
+ * pointer (GetCursorInfo) is compared with the one of the last shape sent;
+ * when it is still different at the next check, its shape is read from
+ * Windows (kn_cursor_shape()) and sent, position and visibility unchanged. */
+static void kn_cursor_seen(DxgiCapture *priv)
+{
+    CURSORINFO ci = { .cbSize = sizeof(ci) };
+    if (GetCursorInfo(&ci) && ci.hCursor) {
+        priv->kn_cursor_sent = ci.hCursor;
+        priv->kn_cursor_odd = NULL;
+    }
+}
+
+static void kn_cursor_watch(IOSysEntry *entry, DxgiCapture *priv)
+{
+    const int64_t now = av_gettime_relative();
+    if (!priv->cursor_sink || now < priv->kn_cursor_check)
+        return;
+    priv->kn_cursor_check = now + KN_CURSOR_WATCH_US;
+
+    CURSORINFO ci = { .cbSize = sizeof(ci) };
+    if (!GetCursorInfo(&ci) || !(ci.flags & CURSOR_SHOWING) || !ci.hCursor ||
+        ci.hCursor == priv->kn_cursor_sent) {
+        priv->kn_cursor_odd = NULL;
+        return;
+    }
+    /* First time seen: desktop duplication may still report it. */
+    if (ci.hCursor != priv->kn_cursor_odd) {
+        priv->kn_cursor_odd = ci.hCursor;
+        return;
+    }
+
+    DXGI_OUTDUPL_POINTER_SHAPE_INFO info;
+    uint8_t *data = NULL;
+    uint32_t size = 0;
+    if (kn_cursor_shape(ci.hCursor, &info, &data, &size) < 0)
+        return; /* read again at the next check */
+    sp_log(entry, SP_LOG_DEBUG, "Pointer shape changed without desktop duplication reporting it: read from Windows\n");
+    if (sp_dxgi_cursor_handler_set_shape(priv->cursor_sink, &info, data, size) >= 0) {
+        priv->kn_cursor_sent = ci.hCursor;
+        priv->kn_cursor_odd = NULL;
+    }
+    av_free(data);
 }
 
