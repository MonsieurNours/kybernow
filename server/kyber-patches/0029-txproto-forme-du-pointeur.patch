+int sp_dxgi_cursor_handler_set_shape(DxgiCursorHandler *ctx,
+                                     const DXGI_OUTDUPL_POINTER_SHAPE_INFO *shape_info,
+                                     const uint8_t *data, uint32_t size)
+{
+    if (!shape_info || !data || !size)
+        return AVERROR(EINVAL);
+
+    AVBufferRef *ref = dxgi_cursor_alloc();
+    if (!ref)
+        return AVERROR(ENOMEM);
+
+    DxgiCursor *dxgi_cursor = (DxgiCursor *)ref->data;
+    dxgi_cursor->data = av_malloc(size);
+    if (!dxgi_cursor->data) {
+        av_buffer_unref(&ref);
+        return AVERROR(ENOMEM);
+    }
+    memcpy(dxgi_cursor->data, data, size);
+    dxgi_cursor->size = size;
+    dxgi_cursor->shape_info = *shape_info;
+
+    cursor_push(ctx, ref);
+
+    av_buffer_unref(&ref);
+
+    return 0;
+}
