+/* KyberNow (0029): queues an update, numbered (see handle_cursor()). The
+ * queue used to drop the newest update when full, shape included: the
+ * oldest one now makes room, and what it carries that the new one does not
+ * (position, shape) moves into the new one with its own number. */
+static void cursor_push(DxgiCursorHandler *ctx, AVBufferRef *ref)
+{
+    DxgiCursor *cursor = (DxgiCursor *)ref->data;
+    const uint64_t seq = atomic_fetch_add(&ctx->next_seq, 1) + 1;
+
+    cursor->pos_seq = cursor->has_position ? seq : 0;
+    cursor->shape_seq = cursor->data ? seq : 0;
+
+    int err = sp_bufferref_fifo_push(ctx->fifo, ref);
+    for (int tries = 0; err < 0 && tries < 4; tries++) {
+        AVBufferRef *oldest = sp_bufferref_fifo_pop(ctx->fifo);
+        if (oldest) {
+            DxgiCursor *old = (DxgiCursor *)oldest->data;
+            if (!cursor->pos_seq && old->pos_seq) {
+                cursor->visible = old->visible;
+                cursor->position = old->position;
+                cursor->pos_seq = old->pos_seq;
+            }
+            if (!cursor->shape_seq && old->shape_seq && old->data) {
+                cursor->data = old->data;
+                cursor->size = old->size;
+                cursor->shape_info = old->shape_info;
+                cursor->shape_seq = old->shape_seq;
+                old->data = NULL;
+            }
+            av_buffer_unref(&oldest);
+        }
+        err = sp_bufferref_fifo_push(ctx->fifo, ref);
+    }
+    if (err < 0)
+        sp_log(ctx, SP_LOG_WARN, "Cursor queue full, update dropped\n");
+    SetEvent(ctx->fifo_event);
+}
