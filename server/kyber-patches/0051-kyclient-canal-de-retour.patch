+/// KyberNow (0051): the feedback channel's summary, once per `interval`.
+pub(crate) fn start_feedback_poller(
+    reader: kyproto::FeedbackClientReader,
+    metrics: MetricsProducer,
+    interval: Duration,
+) -> runtime::Task {
+    runtime::Task::spawn(async move {
+        let mut interval = runtime::interval(interval);
+        loop {
+            interval.tick().await;
+            let s = reader.snapshot();
+            let beat = s.beat.as_ref();
+            let metric = Metric::Feedback(FeedbackStats {
+                received: s.received,
+                lost: s.lost,
+                late: s.late,
+                reorder_us: s.reorder_us,
+                wait_us: s.wait_us,
+                frames: s.frames,
+                lost_frames: s.lost_frames,
+                repair_pm: beat.map(|b| b.repair_pm),
+                repair_ratio_pm: beat.map(|b| b.repair_ratio_pm),
+                loss_p95_pm: beat.map(|b| b.loss_p95_pm),
+                station_rtt_us: beat.map(|b| b.rtt_us),
+                audio_redundancy: beat.is_some_and(|b| b.audio_redundancy),
+            });
+            if !send_metric(&metrics, metric) {
+                break;
+            }
+        }
+    })
+}
