+/* KyberNow (0060): fifo_pop() that waits for an item at most `timeout_us`
+ * (< 0: without limit, 0: not at all) and returns early when fifo_wake() is
+ * called: 0 with the item (NULL for an end of stream or a flush), or
+ * AVERROR(EAGAIN) with none. For an encoder that has something to do while
+ * no image comes (encode.c: the last image again, for a repair). */
+int RENAME(fifo_pop_timed)(AVBufferRef *src, TYPE **dst, int64_t timeout_us)
+{
+    int ret = 0;
+
+    *dst = NULL;
+    if (!src)
+        return 0;
+
+    SNAME *ctx = (SNAME *)src->data;
+    pthread_mutex_lock(&ctx->lock);
+
+    if (!ctx->num_queued && !ctx->woken && timeout_us) {
+        if (timeout_us < 0) {
+            while (!ctx->num_queued && !ctx->woken)
+                pthread_cond_wait(&ctx->cond_in, &ctx->lock);
+        } else {
+            /* pthread_cond_timedwait() reads the wall clock (CLOCK_REALTIME),
+             * as av_gettime() does. */
+            const int64_t until = av_gettime() + timeout_us;
+            struct timespec ts = { until / 1000000, (until % 1000000) * 1000 };
+            while (!ctx->num_queued && !ctx->woken)
+                if (pthread_cond_timedwait(&ctx->cond_in, &ctx->lock, &ts) == ETIMEDOUT)
+                    break;
+        }
+    }
+    ctx->woken = 0;
+
+    if (!ctx->num_queued) {
+        ret = AVERROR(EAGAIN);
+        goto unlock;
+    }
+
+    *dst = ctx->queued[0];
+    ctx->num_queued--;
+    memmove(&ctx->queued[0], &ctx->queued[1], ctx->num_queued*sizeof(TYPE *));
+
+    if (ctx->max_queued > 0)
+        pthread_cond_signal(&ctx->cond_out);
+
+unlock:
+    pthread_mutex_unlock(&ctx->lock);
+    return ret;
+}
+
+/* KyberNow (0060): ends a wait of fifo_pop_timed() (or the next one) with
+ * AVERROR(EAGAIN). */
+void RENAME(fifo_wake)(AVBufferRef *src)
+{
+    if (!src)
+        return;
+    SNAME *ctx = (SNAME *)src->data;
+    pthread_mutex_lock(&ctx->lock);
+    ctx->woken = 1;
+    pthread_cond_broadcast(&ctx->cond_in);
+    pthread_mutex_unlock(&ctx->lock);
+}
+
 TYPE *RENAME(fifo_pop)(AVBufferRef *src)
 {
     TYPE *ret;
