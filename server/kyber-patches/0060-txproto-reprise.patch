+/* KyberNow (0060): a repair or a keyframe is asked for: unless an image
+ * comes within kn_repeat_us, the last one is encoded again (still screen).
+ * Control thread. */
+static void kn_repeat_arm(EncodingContext *ctx)
+{
+    int_fast64_t none = 0;
+    if (!ctx->kn_repeat_us || !ctx->codec || ctx->codec->type != AVMEDIA_TYPE_VIDEO)
+        return;
+    atomic_compare_exchange_strong(&ctx->kn_repeat_due, &none,
+                                   av_gettime_relative() + ctx->kn_repeat_us);
+    sp_frame_fifo_wake(ctx->src_frames);
+}
+
+/* KyberNow (0060): the last image given to the encoder, again, with a pts
+ * as much newer as the time since it went in (the capture's clock), its
+ * timing dropped (it was not captured now). NULL without one. */
+static AVFrame *kn_repeat_frame(EncodingContext *ctx)
+{
+    AVFrame *frame;
+    int64_t elapsed;
+
+    if (!ctx->kn_last || !ctx->kn_last->buf[0])
+        return NULL;
+    frame = av_frame_clone(ctx->kn_last);
+    if (!frame)
+        return NULL;
+    elapsed = av_gettime_relative() - ctx->kn_last_at;
+    if (frame->opaque_ref) {
+        FormatExtraData *fe = (FormatExtraData *)frame->opaque_ref->data;
+        elapsed = av_rescale_q(elapsed, AV_TIME_BASE_Q, fe->time_base);
+    }
+    frame->pts += FFMAX(elapsed, 1);
+    frame->pict_type = AV_PICTURE_TYPE_NONE;
+    av_frame_remove_side_data(frame, KN_FRAME_DATA_TIMING);
+    return frame;
+}
+
+/* KyberNow (0060): the next image of a video encoder, from the capture, or
+ * the last one again when a repair is due and none came; NULL for the end
+ * of the stream (or a flush), as sp_frame_fifo_pop(). */
+static AVFrame *kn_next_video_frame(EncodingContext *ctx)
+{
+    for (;;) {
+        AVFrame *frame = NULL;
+        int64_t due = atomic_load(&ctx->kn_repeat_due), wait = -1;
+
+        if (due)
+            wait = FFMAX(due - av_gettime_relative(), 0);
