+        due = atomic_load(&ctx->kn_repeat_due);
+        if (due && av_gettime_relative() >= due) {
+            atomic_store(&ctx->kn_repeat_due, 0);
+            if ((frame = kn_repeat_frame(ctx))) {
+                sp_log(ctx, SP_LOG_VERBOSE, "No image since %.0f ms: the last one again\n",
+                       (av_gettime_relative() - ctx->kn_last_at) / 1000.0);
+                return frame;
+            }
+        }
+    }
+}
