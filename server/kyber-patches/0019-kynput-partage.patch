+        let state = ServerPipelineState::new(InputRights::ALL);
+
+        let key = |pressed| KeyboardKey {
+            scancode: 10,
+            pressed,
+        };
+        let button = |pressed| MouseButton {
+            button: MouseButtonType::Left,
+            pressed,
+        };
+        assert!(passes(&state, &key(true).to_packet(InputTarget::Host)));
+        assert!(passes(&state, &button(true).to_packet(InputTarget::Host)));
+        assert!(passes(&state, &plug(0)));
+
+        // Releases first, then the gamepad leaves the computer.
+        let mut expected = vec![
+            key(false).to_packet(InputTarget::Host),
+            button(false).to_packet(InputTarget::Host),
