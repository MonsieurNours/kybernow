+/// KyberNow (0060): `/recover` from a share guest: on the images it gets
+/// (its own, or the host's: a repair without a keyframe costs the others
+/// next to nothing, and the encoder falls back to a keyframe by itself).
+pub(crate) async fn guest_recover(ctrl: &Controller, uid: &Uuid, last_pts: u64) {
+    let Ok(services) = ctrl.session_services(uid) else {
+        return;
+    };
+    let keys: Vec<VideoStreamKey> = services
+        .lock()
+        .await
+        .guest_outputs
+        .iter()
+        .filter_map(|output| output.current.clone())
+        .collect();
+    let manager = ctrl.av_services_manager.lock().await;
+    for key in &keys {
+        if let Some(stream) = manager.video_streams.get(key)
+            && let Err(err) = stream.avservice.video_recover(last_pts)
+        {
+            warn!("Session {uid}: repair on {key:?} failed: {err:?}");
+        }
+    }
+}
