+/// KyberNow (0060): `/recover` from a share guest (and the repairs of its
+/// feedback channel, patch 0061), on the images it gets. Most encoders
+/// (H.264, AMF, QSV, x264, VideoToolbox) answer a repair with a keyframe:
+/// on the host's image, a guest that keeps losing would force one per
+/// image on the host. So, as its keyframes: at most one repair per
+/// `FORCE_IDR_MIN_INTERVAL` for the session; on its own image at once; on
+/// the host's, spaced with the guests' keyframes (one every 2 s at most for
+/// all of them, [`KeyframeSpacing`](guest_image::KeyframeSpacing): one put
+/// off becomes a keyframe then) and a sign of lag. `single`: only for a
+/// guest with one image (as for the host).
+pub(crate) async fn guest_recover(ctrl: &Controller, uid: &Uuid, last_pts: u64, single: bool) {
+    let now = Instant::now();
+    let recent = ctrl
+        .with_session(uid, |s| {
+            let recent = s
+                .last_force_idr
+                .is_some_and(|last| now.saturating_duration_since(last) < crate::FORCE_IDR_MIN_INTERVAL);
+            if !recent {
+                s.last_force_idr = Some(now);
+            }
+            Ok(recent)
+        })
+        .unwrap_or(true);
+    if recent {
+        debug!("Session {uid}: repair ignored, one less than {:?} ago", crate::FORCE_IDR_MIN_INTERVAL);
+        return;
+    }
+    let Ok(services) = ctrl.session_services(uid) else {
+        return;
+    };
+    let keys: Vec<VideoStreamKey> = services
+        .lock()
+        .await
+        .guest_outputs
+        .iter()
+        .filter_map(|output| output.current.clone())
+        .collect();
+    if single && keys.len() != 1 {
+        return;
+    }
+    let mut on_host = false;
+    for key in &keys {
+        let mut manager = ctrl.av_services_manager.lock().await;
+        let delay = if matches!(key, VideoStreamKey::Shared { .. }) {
+            on_host = true;
+            match manager.guest_keyframe_delay(key, now) {
+                Some(delay) => delay,
+                None => {
+                    debug!("Session {uid}: keyframe on {key:?} already on its way");
+                    continue;
+                }
+            }
+        } else {
+            Duration::ZERO
+        };
+        if !delay.is_zero() {
+            // Too soon after the last one on the host's image: a keyframe,
+            // put off (it serves the guests asking meanwhile).
+            let idr = manager.idr_sender(key.clone());
+            tokio::spawn(async move {
+                tokio::time::sleep(delay).await;
+                idr();
+            });
+            continue;
+        }
+        if let Some(stream) = manager.video_streams.get(key)
+            && let Err(err) = stream.avservice.video_recover(last_pts)
+        {
+            warn!("Session {uid}: repair on {key:?} failed: {err:?}");
+        }
+    }
+    if on_host && lag_sign(ctrl, uid, LagSign::KeyframeRequest) {
+        info!("Session {uid}: repairs asked again and again, image lowered");
+        relocate(ctrl, *uid, Relocation::Lag).await;
+    }
+}
