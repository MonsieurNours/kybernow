+/// KyberNow (0060): body of `POST /recover`.
+#[derive(Deserialize)]
+pub(crate) struct Recover {
+    /// The pts of the last image the client decoded (its kymux packet).
+    last_pts: u64,
+}
+
+/// KyberNow (0060): the client decoded up to `last_pts` and lost what
+/// followed (packets lost beyond FEC). The next image of this session's
+/// video streams depends on nothing newer: without a keyframe when the
+/// encoder can (HEVC on NVENC and VideoToolbox), else a keyframe. The
+/// repairing image carries a SEI naming the newest image it depends on, for
+/// the client to resume on it. A client keeps `/force_idr` for anything
+/// else (a decoder that failed, a request that brought nothing).
+#[post("/recover")]
+pub(crate) async fn recover(
+    ctrl: web::Data<Controller>,
+    request: web::Json<Recover>,
+    user: Identity,
+) -> HttpResponse {
+    let Ok(uid) = user.uid() else {
+        return HttpResponse::Unauthorized().finish();
+    };
+    if repair(&ctrl, &uid, request.last_pts, false).await {
+        HttpResponse::Ok().finish()
+    } else {
+        HttpResponse::Forbidden().finish()
+    }
+}
+
+/// KyberNow (0060): repairs session `uid`'s video streams after a loss
+/// that followed `last_pts` (`/recover`, and the feedback channel's losses
+/// with patch 0061). `single`: only a session with one video stream (the
+/// pts of a loss belong to one stream; a session with several displays
+/// keeps the application's requests). False: no such session.
+pub(crate) async fn repair(ctrl: &Controller, uid: &uuid::Uuid, last_pts: u64, single: bool) -> bool {
+    let services = match ctrl.with_session(uid, |s| Ok(s.services.clone())) {
+        Ok(s) => s,
+        Err(err) => {
+            warn!("Session not found: {err}");
+            return false;
+        }
+    };
+
+    if kybernow::is_guest(ctrl, uid) {
+        drop(services);
+        debug!("Repair up to {last_pts} for a share guest");
+        kybernow::guest_recover(ctrl, uid, last_pts, single).await;
+        return true;
+    }
+
+    let mut services = services.lock().await;
+    let streams = services.video_subscriptions.len().max(services.video.len());
+    if single && streams != 1 {
+        return true;
+    }
+    debug!("Repair up to {last_pts}");
+    to_video_streams(ctrl, &mut services, StreamRequest::Recover(last_pts)).await;
+    true
+}
