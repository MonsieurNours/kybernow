+/* Position only: an empty bitmap tells the consumer to keep the last shape. */
+static int send_cursor_position(DxgiCursorHandler *ctx)
+{
+    uint8_t buffer[33];
+
+    AV_WB32(buffer, ctx->identifier);
+    buffer[4] = 1;
+    AV_WB32(buffer + 5, ctx->cursor.x + ctx->cursor.xhot);
+    AV_WB32(buffer + 9, ctx->cursor.y + ctx->cursor.yhot);
+    AV_WB32(buffer + 13, ctx->cursor.xhot);
+    AV_WB32(buffer + 17, ctx->cursor.yhot);
+    AV_WB32(buffer + 21, ctx->cursor.width);
+    AV_WB32(buffer + 25, ctx->cursor.height);
+    AV_WB32(buffer + 29, 0);
+
+    int err = write_to_pipe(ctx, buffer, sizeof(buffer));
+    ctx->moved = 0;
+    ctx->move_deadline = 0;
+    ctx->last_sent = av_gettime_relative();
+    return err;
+}
+
+/* A move is sent now, or once MOVE_INTERVAL_US has passed since the last send. */
+static int handle_move(DxgiCursorHandler *ctx)
+{
+    if (!ctx->moved || !ctx->visible || !ctx->sent_visible)
+        return 0;
+    int64_t due = ctx->last_sent + MOVE_INTERVAL_US;
+    if (av_gettime_relative() >= due)
+        return send_cursor_position(ctx);
+    if (!ctx->move_deadline)
+        ctx->move_deadline = due;
+    return 0;
+}
