diff --git a/kycontroller/src/guest_image.rs b/kycontroller/src/guest_image.rs
new file mode 100644
index 0000000..4328727
--- /dev/null
+++ b/kycontroller/src/guest_image.rs
@@ -0,0 +1,1288 @@
+// KyberNow: KyberNow Share, a guest's own image (patch 0020). The decisions
+// only, without Kyber's state, so that they can be tested anywhere: which
+// image a guest gets (`choose`), how many images beside the host's the
+// encoder can make (`image_budget`), and when a guest is falling behind
+// (`LagMeter`).
+//
+// The host always comes first: a guest's image is never above the host's
+// (size, rate, bitrate, 4:4:4), and nothing a guest does changes the host's
+// image. A guest that can follow the host's image shares it; the others get
+// an image of their own, encoded for them from the same display, always in
+// 4:2:0; guests asking for the same image share it.
+
+use std::collections::VecDeque;
+use std::time::{Duration, Instant};
+
+use kyavservice_types::{VideoCodec, VideoScale};
+
+use crate::auth::ShareQuality;
+
+/// Refresh rate assumed for a display whose rate Windows does not give.
+const ASSUMED_REFRESH: u32 = 60;
+
+/// A guest asking for the host's image that cannot read it (format, 4:4:4)
+/// gets a copy at the host's size, at most this rate: a second full-rate
+/// encoding of a 160 Hz display would weigh on the host's.
+const HOST_COPY_MAX_FPS: u32 = 60;
+
+/// A video format, as a registry key (`VideoCodec` is neither `Eq` nor
+/// `Hash`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(crate) enum ImageCodec {
+    H264,
+    Hevc,
+    Av1,
+}
+
+impl ImageCodec {
+    pub(crate) fn name(self) -> &'static str {
+        match self {
+            Self::H264 => "h264",
+            Self::Hevc => "hevc",
+            Self::Av1 => "av1",
+        }
+    }
+}
+
+impl From<&VideoCodec> for ImageCodec {
+    fn from(codec: &VideoCodec) -> Self {
+        match codec {
+            VideoCodec::H264 => Self::H264,
+            VideoCodec::HEVC => Self::Hevc,
+            VideoCodec::AV1 => Self::Av1,
+        }
+    }
+}
+
+impl From<ImageCodec> for VideoCodec {
+    fn from(codec: ImageCodec) -> Self {
+        match codec {
+            ImageCodec::H264 => Self::H264,
+            ImageCodec::Hevc => Self::HEVC,
+            ImageCodec::Av1 => Self::AV1,
+        }
+    }
+}
+
+/// A size and a rate; `fps` 0 when unknown (taken as 60 Hz).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(crate) struct Mode {
+    pub(crate) width: u32,
+    pub(crate) height: u32,
+    pub(crate) fps: u32,
+}
+
+impl Mode {
+    fn refresh(self) -> u32 {
+        if self.fps == 0 {
+            ASSUMED_REFRESH
+        } else {
+            self.fps
+        }
+    }
+
+    /// Pixels per second: how heavy an image is.
+    pub(crate) fn weight(self) -> u64 {
+        u64::from(self.width) * u64::from(self.height) * u64::from(self.refresh())
+    }
+
+    /// Whether `self` (never above `reference`) is all of it.
+    fn covers(self, reference: Mode) -> bool {
+        self.width == reference.width
+            && self.height == reference.height
+            && self.refresh() >= reference.refresh()
+    }
+}
+
+/// A guest's own image: its key in the registry (`VideoStreamKey::Guest`).
+/// Guests asking for the same image share it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(crate) struct GuestImage {
+    pub(crate) width: u32,
+    pub(crate) height: u32,
+    /// 0: the display's own rate, unknown.
+    pub(crate) fps: u32,
+    pub(crate) codec: ImageCodec,
+}
+
+impl GuestImage {
+    fn new(mode: Mode, codec: ImageCodec) -> Self {
+        Self {
+            width: mode.width,
+            height: mode.height,
+            fps: mode.fps,
+            codec,
+        }
+    }
+
+    pub(crate) fn mode(self) -> Mode {
+        Mode {
+            width: self.width,
+            height: self.height,
+            fps: self.fps,
+        }
+    }
+
+    /// The size asked of kyavserver: only when scaled down from `screen`.
+    pub(crate) fn scale(self, screen: Mode) -> Option<VideoScale> {
+        ((self.width, self.height) != (screen.width, screen.height)).then_some(VideoScale {
+            width: self.width,
+            height: self.height,
+        })
+    }
+
+    /// The rate asked of kyavserver: only when below `screen`'s (or when
+    /// that one is unknown).
+    pub(crate) fn max_fps(self, screen: Mode) -> Option<u32> {
+        (self.fps != 0 && (screen.fps == 0 || self.fps < screen.fps)).then_some(self.fps)
+    }
+}
+
+/// The frame of a preset (long side, short side, rate); `None` for the
+/// host's image, the display as it is.
+fn frame(quality: ShareQuality) -> Option<(u32, u32, u32)> {
+    match quality {
+        ShareQuality::Host => None,
+        ShareQuality::P2160 => Some((3840, 2160, 60)),
+        ShareQuality::P1080 => Some((1920, 1080, 60)),
+        ShareQuality::P720 => Some((1280, 720, 30)),
+    }
+}
+
+fn rank(quality: ShareQuality) -> u8 {
+    match quality {
+        ShareQuality::Host => 0,
+        ShareQuality::P2160 => 1,
+        ShareQuality::P1080 => 2,
+        ShareQuality::P720 => 3,
+    }
+}
+
+/// `quality` lowered by `steps` notches (host → 2160p60 → 1080p60 → 720p30).
+pub(crate) fn lowered(quality: ShareQuality, steps: u8) -> ShareQuality {
+    match rank(quality).saturating_add(steps) {
+        0 => ShareQuality::Host,
+        1 => ShareQuality::P2160,
+        2 => ShareQuality::P1080,
+        _ => ShareQuality::P720,
+    }
+}
+
+/// How many notches `quality` can go down.
+pub(crate) fn max_steps(quality: ShareQuality) -> u8 {
+    3 - rank(quality)
+}
+
+/// Bitrate ceiling of a preset's image (bits per second); the host's image
+/// has none but the host's own bitrate.
+fn preset_cap(quality: ShareQuality, codec: ImageCodec) -> Option<u32> {
+    match (quality, codec) {
+        (ShareQuality::Host, _) => None,
+        // 4K at 60 Hz: four times 1080p's pixels for a little over three times
+        // its bitrate (HEVC, AV1); some more for H.264, which compresses less.
+        (ShareQuality::P2160, ImageCodec::H264) => Some(50_000_000),
+        (ShareQuality::P2160, _) => Some(40_000_000),
+        (ShareQuality::P1080, ImageCodec::H264) => Some(16_000_000),
+        (ShareQuality::P1080, _) => Some(12_000_000),
+        (ShareQuality::P720, _) => Some(6_000_000),
+    }
+}
