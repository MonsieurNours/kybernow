+/// The share supervisor: a guest's lag episodes (a keyframe to catch up,
+/// a notch down when they repeat), its keyframe when it joins the host's
+/// image (spaced), and the guest images that never sent anything (given
+/// up, their guests moved elsewhere).
+pub(crate) async fn run_share_supervisor(
+    weak: std::sync::Weak<Controller>,
+    mut signals: tokio::sync::mpsc::UnboundedReceiver<ShareSignal>,
+    mut cancel_rx: watch::Receiver<bool>,
+) {
+    let settle = Settle::default();
+    loop {
+        let signal = tokio::select! {
+            _ = cancel_rx.changed() => break,
+            signal = signals.recv() => match signal {
+                Some(signal) => signal,
+                None => break,
+            },
+        };
+        let Some(ctrl) = weak.upgrade() else {
+            break;
+        };
+        match signal {
+            ShareSignal::Episode { uid, key } => {
+                keyframe_for_guest(&ctrl, &uid, &key).await;
+                if lag_sign(&ctrl, &uid, LagSign::Episode) {
+                    info!("Session {uid}: behind on {key:?} again, image lowered");
+                    tokio::spawn(async move {
+                        relocate(&ctrl, uid, Relocation::Lag).await;
+                    });
+                }
+            }
+            ShareSignal::Keyframe { uid, key } => {
+                keyframe_for_guest(&ctrl, &uid, &key).await;
+            }
+            ShareSignal::Screens => {
+                let settled = settle.arm();
+                tokio::spawn(async move {
+                    if settled.await {
+                        screens_changed(&ctrl).await;
+                    }
+                });
+            }
+            ShareSignal::Stalled { key } => {
+                tokio::spawn(async move {
+                    if !ctrl
+                        .av_services_manager
+                        .lock()
+                        .await
+                        .set_aside_stalled(&key)
+                    {
+                        return;
+                    }
+                    warn!("Guest image {key:?} sent nothing: given up, its slot set aside");
+                    let display_id = key.display_id();
+                    let guests: Vec<Uuid> = ctrl
+                        .sessions
+                        .lock()
+                        .unwrap()
+                        .values()
+                        .filter(|s| s.share.as_ref().is_some_and(|sh| sh.display == display_id))
+                        .map(|s| s.uid)
+                        .collect();
+                    for uid in guests {
+                        relocate(&ctrl, uid, Relocation::Stalled(key.clone())).await;
+                    }
+                });
+            }
+        }
+    }
+}
