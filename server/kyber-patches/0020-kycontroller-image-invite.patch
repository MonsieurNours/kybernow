+        let at = |s: u64| t0 + Duration::from_secs(s);
+        let mut meter = LagMeter::default();
+        assert!(!meter.record(LagSign::Episode, at(0)));
+        assert!(meter.record(LagSign::Episode, at(9)));
+        // Counted again from zero.
+        assert!(!meter.record(LagSign::Episode, at(10)));
+        // Too far apart.
+        assert!(!meter.record(LagSign::Episode, at(21)));
+
+        let mut meter = LagMeter::default();
+        assert!(!meter.record(LagSign::KeyframeRequest, at(0)));
+        assert!(!meter.record(LagSign::KeyframeRequest, at(4)));
+        assert!(!meter.record(LagSign::Episode, at(5)));
+        assert!(meter.record(LagSign::KeyframeRequest, at(8)));
+
+        let mut meter = LagMeter::default();
+        assert!(!meter.record(LagSign::KeyframeRequest, at(0)));
+        assert!(!meter.record(LagSign::KeyframeRequest, at(6)));
+        assert!(!meter.record(LagSign::KeyframeRequest, at(11)));
