+/// KyberNow: the image a share guest asks for (`kn_quality`, patch 0020).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+pub enum ShareQuality {
+    /// As the host: the host's image (the display as it is).
+    #[default]
+    #[serde(rename = "host")]
+    Host,
+    /// 4K (2160p) at 60 Hz at most.
+    #[serde(rename = "2160p60")]
+    P2160,
+    /// 1080p at 60 Hz at most.
+    #[serde(rename = "1080p60")]
+    P1080,
+    /// 720p at 30 Hz at most.
+    #[serde(rename = "720p30")]
+    P720,
+}
+
+impl ShareQuality {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Host => "host",
+            Self::P2160 => "2160p60",
+            Self::P1080 => "1080p60",
+            Self::P720 => "720p30",
+        }
+    }
+
+    pub fn parse(name: &str) -> Option<Self> {
+        [Self::Host, Self::P2160, Self::P1080, Self::P720]
+            .into_iter()
+            .find(|quality| quality.name() == name)
+    }
+}
+
