+/// What the guest's device reads: the format and 4:4:4 of its start
+/// request.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Reader {
+    pub(crate) codec: ImageCodec,
+    pub(crate) yuv444: bool,
+}
