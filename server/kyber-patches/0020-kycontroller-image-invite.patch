+    /// KyberNow: a closure asking for a keyframe on `key`, for kydup.
+    pub(crate) fn idr_sender(
+        &self,
+        key: VideoStreamKey,
+    ) -> impl Fn() + Send + Sync + 'static + use<> {
+        let idr_tx = self.idr_tx.clone();
+        move || {
+            if let Err(e) = idr_tx.try_send(key.clone()) {
+                warn!("IDR request dropped for {key:?}: {e}");
+            }
+        }
+    }
