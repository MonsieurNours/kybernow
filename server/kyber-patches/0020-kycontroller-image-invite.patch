+/// Why a guest gets the image it gets (`/kybernow/sessions`, and the guest's
+/// notice through KyberNow Admin).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Reason {
+    /// What it asked for.
+    Asked,
+    /// Below what it asked for: the host's image is smaller or slower.
+    Capped,
+    /// The computer cannot make one more image: the closest one open.
+    Limit,
+    /// Lowered because the guest fell behind.
+    Lag,
+}
+
+impl Reason {
+    pub(crate) fn name(self) -> &'static str {
+        match self {
+            Self::Asked => "asked",
+            Self::Capped => "capped",
+            Self::Limit => "limit",
+            Self::Lag => "lag",
+        }
+    }
+}
+
+/// How many images the encoder can make beside the host's.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct ImageBudget {
+    /// Guest images while a host is in session.
+    pub(crate) with_host: usize,
+    /// Whether kyavserver can scale the display down and lower its rate;
+    /// without, a guest image can only be a copy of the display as it is.
+    pub(crate) can_scale: bool,
+}
+
+impl ImageBudget {
+    /// One more without a host in session (a share from the computer
+    /// itself): the host's encoder is free.
+    pub(crate) fn limit(self, host_session: bool) -> usize {
+        self.with_host + usize::from(!host_session)
+    }
+}
+
+/// The only place that knows what each capture engine and encoder can do
+/// (`[kyavserver] backend` and `encoder`, `[kycontroller]
+/// share_extra_images`). NVENC and AMF: two images beside the host's; Quick
+/// Sync: one; x264 (the processor): none. The libavconv engine can neither
+/// scale nor lower the rate yet: no image of its own beside the host's, and
+/// only copies of the display without a host.
+pub(crate) fn image_budget(
+    backend: Option<&str>,
+    encoder: Option<&str>,
+    forced: Option<usize>,
+) -> ImageBudget {
+    let libavconv = backend.is_some_and(|b| b.eq_ignore_ascii_case("libavconv"));
+    let with_host = forced.unwrap_or_else(|| {
+        if libavconv {
+            return 0;
+        }
+        match encoder.map(str::to_ascii_lowercase).as_deref() {
+            // kyavserver's default on Windows.
+            None | Some("nvenc") | Some("amf") => 2,
+            Some("qsv") => 1,
+            Some("x264") => 0,
+            Some(_) => 1,
+        }
+    });
+    ImageBudget {
+        with_host,
+        can_scale: !libavconv,
+    }
+}
