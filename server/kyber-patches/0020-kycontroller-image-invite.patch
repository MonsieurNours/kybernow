+/// `POST /kybernow/quality` (patch 0020): a guest's new quality, for its
+/// sessions (their image chosen again and moved; sound and inputs
+/// untouched) and its next logins. Back to its full quality: a guest
+/// lowered for lagging starts over.
+#[post("/quality")]
+pub(crate) async fn post_quality(
+    ctrl: web::Data<Controller>,
+    req: HttpRequest,
+    body: web::Bytes,
+) -> HttpResponse {
+    let QualityRequest { user, quality } = match admin_request(&req, &body) {
+        Ok(request) => request,
+        Err(refusal) => return refusal,
+    };
+
+    // Recorded first, as roles are (see `post_role`).
+    ctrl.share_memory
+        .lock()
+        .unwrap()
+        .remember_quality(&user, quality, 0);
+
+    let updated: Vec<Uuid> = ctrl
+        .sessions
+        .lock()
+        .unwrap()
+        .values_mut()
+        .filter(|s| s.username == user)
+        .filter_map(|s| {
+            let share = s.share.as_mut()?;
+            share.quality = quality;
+            s.guest_image.steps = 0;
+            Some(s.uid)
+        })
+        .collect();
+    info!(
+        "\"{user}\" now asks for {}: {} sessions",
+        quality.name(),
+        updated.len()
+    );
+
+    for uid in &updated {
+        relocate(&ctrl, *uid, Relocation::Quality).await;
+    }
+
+    HttpResponse::Ok().json(serde_json::json!({ "sessions": updated.len() }))
+}
