+// ===========================================================================
+// KyberNow: a KyberNow Share guest's outputs
+// ===========================================================================
+
+/// KyberNow: the image a guest's video output reads: its kydup, what to run
+/// once subscribed (a keyframe request on that image), and what to run when
+/// the guest falls behind on it (a lag episode, and a keyframe).
+#[derive(Clone)]
+pub struct VideoSource {
+    dup: KydupVideo,
+    on_subscribed: Arc<dyn Fn() + Send + Sync>,
+    on_overflow: Arc<dyn Fn() + Send + Sync>,
+}
+
+impl VideoSource {
+    pub fn new(
+        dup: KydupVideo,
+        on_subscribed: impl Fn() + Send + Sync + 'static,
+        on_overflow: impl Fn() + Send + Sync + 'static,
+    ) -> Self {
+        Self {
+            dup,
+            on_subscribed: Arc::new(on_subscribed),
+            on_overflow: Arc::new(on_overflow),
+        }
+    }
+}
+
+/// KyberNow: a guest's video output. It keeps its client endpoint and
+/// reads the image `source` names: `None` waits for one; a new value moves
+/// it (it leaves the old image, subscribes to the new one, asks for a
+/// keyframe, and sends that image's headers before its keyframe).
+///
+/// It never holds the image back: one half reads the broadcast without
+/// waiting into a queue of its own, bounded in age
+/// ([`GUEST_QUEUE_MAX_AGE`]); the other half sends it. A guest falling
+/// behind loses its queue and waits for the next keyframe (`on_overflow`).
+pub fn spawn_guest_video_output(
+    endpoint: VideoServerEndpoint,
+    source: watch::Receiver<Option<VideoSource>>,
+) -> Task {
+    Task::spawn(async move {
+        let send = match ready_with_timeout(endpoint).await {
+            Ok(s) => s,
+            Err(e) => {
+                error!("Kydup guest video output ready failed: {e}");
+                return;
+            }
+        };
+        run_guest_video(send, source).await;
+    })
+}
+
