+    /// The host's image of its display came (back) or changed: a guest
+    /// waiting for it, on an older generation, or that would follow it
+    /// now, goes to it.
+    HostImage,
+    /// Its image sent nothing: given up.
+    Stalled(VideoStreamKey),
+    /// Its display changed size or rate: an image of its own no longer
+    /// fits (deformed, or above the host's); chosen again for the new
+    /// mode.
+    Screen,
+}
+
+/// The display as it is: Kyber's size, Windows' refresh rate.
+pub(crate) fn screen_mode(ctrl: &Controller, display_id: u32) -> Mode {
+    let displays = ctrl.displays.lock().unwrap();
+    let Some(display) = displays.iter().find(|d| d.id == display_id) else {
+        return Mode {
+            width: 0,
+            height: 0,
+            fps: 0,
+        };
+    };
+    Mode {
+        width: u32::try_from(display.width).unwrap_or(0),
+        height: u32::try_from(display.height).unwrap_or(0),
+        fps: crate::avservices_manager::refresh_rate(&displays, display_id),
+    }
+}
+
+/// A host is in session: the share comes from its session. Without, it
+/// comes from the computer itself (one image more for the guests).
+fn host_in_session(ctrl: &Controller) -> bool {
+    ctrl.sessions
+        .lock()
+        .unwrap()
+        .values()
+        .any(|s| s.share.is_none())
+}
+
+fn guest_ask(ctrl: &Controller, uid: &Uuid, request: &GuestRequest) -> crate::error::Result<Ask> {
+    ctrl.with_session(uid, |s| {
+        Ok(Ask {
+            quality: s
+                .share
+                .as_ref()
+                .map_or(ShareQuality::Host, |share| share.quality),
+            steps: s.guest_image.steps,
+            reader: Reader {
+                codec: request.codec,
+                yuv444: request.yuv444,
+            },
+            bitrate: request.bitrate,
+        })
+    })
+}
+
+/// What `choose` needs besides the registry: the display, whether a host
+/// is in session, what the encoder can do.
+#[derive(Clone, Copy, Debug)]
+struct Context {
+    screen: Mode,
+    host_session: bool,
+    budget: guest_image::ImageBudget,
+}
+
+impl Context {
+    fn of(ctrl: &Controller, display_id: u32) -> Self {
+        Self {
+            screen: screen_mode(ctrl, display_id),
+            host_session: host_in_session(ctrl),
+            budget: ctrl.config.share_images(),
+        }
+    }
+}
+
+/// How `decide` counts the guest image slots.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Slots {
+    /// As they are.
+    Count,
+    /// The display changed mode: its images made from the old one are on
+    /// their way out (all their guests move), they do not count.
+    Remade,
+    /// None left: only an image already open, or the host's.
+    Full,
+}
+
+/// `choose` with the registry's state. `current`: the image the guest
+/// reads now, whose slot is free if the guest is alone on it. An image
+/// given up (it sent nothing) is not opened again while its slot is set
+/// aside: the closest image open instead, as beyond the budget (`Limit`).
+fn decide(
+    context: &Context,
+    manager: &AVServicesManager,
+    display_id: u32,
+    ask: &Ask,
+    current: Option<&VideoStreamKey>,
+    slots: Slots,
+) -> std::result::Result<(Choice, Option<HostImage>), guest_image::Refused> {
+    let screen = context.screen;
+    let host = manager.host_image(display_id, screen);
+    let open = manager.open_guest_images(display_id, screen);
+    let leaving = current.filter(|key| {
+        matches!(key, VideoStreamKey::Guest { .. })
+            && manager
+                .video_streams
+                .get(key)
+                .is_some_and(|stream| stream.client_count == 1)
+    });
+    let used = match slots {
+        Slots::Count => manager.guest_slots_used(leaving, None),
+        Slots::Remade => manager.guest_slots_used(leaving, Some((display_id, screen))),
+        Slots::Full => usize::MAX,
+    };
+    let situation = Situation {
+        host,
+        host_session: context.host_session,
+        screen,
+        open: &open,
+        used,
+        budget: context.budget,
+    };
+    let choice = guest_image::choose(&situation, ask)?;
+    if let Placement::Open { image, .. } = choice.placement
+        && manager.is_set_aside_now(display_id, &image)
+    {
+        let full = Situation {
+            used: usize::MAX,
+            ..situation
+        };
+        return guest_image::choose(&full, ask).map(|choice| (choice, host));
+    }
+    Ok((choice, host))
+}
+
+/// The registry key of a placement (`None` while waiting); a guest image
+/// is made from the display in its mode `screen`.
+fn placement_key(
+    manager: &AVServicesManager,
+    display_id: u32,
+    screen: Mode,
+    placement: Placement,
+) -> Option<VideoStreamKey> {
+    match placement {
+        Placement::FollowHost => manager.current_host_key(display_id),
+        Placement::Wait => None,
+        Placement::Join(image) | Placement::Open { image, .. } => Some(VideoStreamKey::Guest {
+            display_id,
+            image,
+            screen,
+        }),
+    }
+}
+
+/// Subscribes a guest to its placement: joins the host's image or a guest
+/// image, or opens one. `None` while it waits.
+async fn acquire_placement(
+    ctrl: &Controller,
+    manager: &mut AVServicesManager,
+    display_id: u32,
+    screen: Mode,
+    placement: Placement,
+    request: &GuestRequest,
+) -> crate::error::Result<Option<(VideoAcquisition, VideoStreamKey)>> {
+    let Some(key) = placement_key(manager, display_id, screen, placement) else {
+        return match placement {
+            Placement::Wait => Ok(None),
+            // The host's image went in between: none to follow.
+            _ => Err(Error::ShareNoImage),
+        };
+    };
+    let acquisition = match placement {
+        // A guest image given up still running (guests that could not
+        // move): never joined again.
+        Placement::Open { .. } if manager.video_streams.contains_key(&key) => {
+            warn!("Guest image {key:?} given up: not joined");
+            return Err(Error::ShareNoImage);
+        }
+        Placement::Open {
+            image,
+            bitrate,
+            ceiling,
+            cap,
+        } => {
+            let config = VideoStreamConfig {
+                bitrate,
+                codec: image.codec.into(),
+                // Always 4:2:0 (kyavserver scales to NV12).
+                yuv444: false,
+                intra_refresh: request.intra_refresh,
+                pixel_rate: image.mode().weight(),
+            };
+            let topology = VideoTopology::Guest {
+                display_id,
+                image,
+                screen,
+            };
+            let acquisition = manager
+                .acquire_video_as(ctrl, topology, config, false, true)
+                .await?;
+            if let Some(stream) = manager.video_streams.get_mut(&key) {
+                stream.ceiling = ceiling;
+                stream.cap = cap;
+            }
+            acquisition
+        }
+        _ => manager.join_video(&key).ok_or(Error::ShareNoImage)?,
+    };
+    Ok(Some((acquisition, key)))
+}
+
+/// What a guest output reads on `key`: a keyframe once subscribed, a lag
+/// episode to the supervisor when it falls behind.
+fn video_source(
+    manager: &AVServicesManager,
+    uid: Uuid,
+    key: &VideoStreamKey,
+    acquisition: &VideoAcquisition,
+) -> crate::error::Result<kydup::VideoSource> {
+    let dup = acquisition.dup.clone().ok_or(Error::ShareNoImage)?;
+    let signals = manager.share_signals();
+    let lagging = key.clone();
+    Ok(kydup::VideoSource::new(
+        dup,
+        subscribe_keyframe(manager, uid, key),
+        move || {
+            let _ = signals.send(ShareSignal::Episode {
+                uid,
+                key: lagging.clone(),
+            });
+        },
+    ))
+}
+
+/// The keyframe a guest output asks for once subscribed to `key`: right
+/// away on a guest image; on the host's image, through the share
+/// supervisor, spaced with every keyframe its guests ask for there
+/// ([`keyframe_for_guest`]): guests going back and forth to the host's
+/// image (their quality changed again and again) never force the host's
+/// encoder more often than that.
+fn subscribe_keyframe(
+    manager: &AVServicesManager,
+    uid: Uuid,
+    key: &VideoStreamKey,
+) -> impl Fn() + Send + Sync + 'static + use<> {
+    let idr = manager.idr_sender(key.clone());
+    let signals = manager.share_signals();
+    let key = key.clone();
+    move || {
+        if matches!(key, VideoStreamKey::Shared { .. }) {
+            let _ = signals.send(ShareSignal::Keyframe {
+                uid,
+                key: key.clone(),
+            });
+        } else {
+            idr();
+        }
+    }
+}
+
+/// A guest's video output on `display_id` (multi-client mode): its image
+/// chosen, its output started on it (or waiting for the host's).
+pub(crate) async fn start_guest_video(
+    ctrl: &Controller,
+    manager: &mut AVServicesManager,
+    uid: Uuid,
+    display_id: u32,
+    request: GuestRequest,
+    endpoint: kymux::types::VideoServerEndpoint,
+) -> crate::error::Result<(Option<VideoSubscription>, GuestOutput, Task)> {
+    let ask = guest_ask(ctrl, &uid, &request)?;
+    let context = Context::of(ctrl, display_id);
+    let (choice, _) =
+        decide(&context, manager, display_id, &ask, None, Slots::Count).map_err(|_| {
+            warn!(
+                "Session {uid}: no image of display {display_id} its device reads ({:?})",
+                ask.reader
+            );
+            Error::ShareNoImage
+        })?;
+    let acquired = acquire_placement(
+        ctrl,
+        manager,
+        display_id,
+        context.screen,
+        choice.placement,
+        &request,
+    )
+    .await?;
+    let (subscription, source, current) = match acquired {
+        Some((acquisition, key)) => {
+            let source = video_source(manager, uid, &key, &acquisition)?;
+            (Some(acquisition.subscription), Some(source), Some(key))
+        }
+        None => (None, None, None),
+    };
+    info!(
+        "Session {uid}: {:?} on display {display_id}: {:?} ({})",
+        ask.quality,
+        current,
+        choice.reason.name()
+    );
+    ctrl.with_session(&uid, |s| {
+        s.guest_image.meter.restart(Instant::now());
+        Ok(())
+    })?;
+    let (tx, rx) = watch::channel(source);
+    let output = GuestOutput {
+        display_id,
+        request,
+        source: tx,
+        current,
+        reason: choice.reason,
+        screen: context.screen,
+    };
+    Ok((
+        subscription,
+        output,
+        kydup::spawn_guest_video_output(endpoint, rx),
+    ))
+}
+
+/// Whether `current` already is `placement`.
+fn already_there(
+    manager: &AVServicesManager,
+    display_id: u32,
+    screen: Mode,
+    placement: Placement,
+    current: Option<&VideoStreamKey>,
+) -> bool {
+    placement_key(manager, display_id, screen, placement).as_ref() == current
+}
+
+/// Whether the guest must leave `current` whatever it asks: an older
+/// generation of the host's image (closed once its guests left), or an
+/// image of its own made from the display in another mode.
+fn must_leave(context: &Context, manager: &AVServicesManager, current: &VideoStreamKey) -> bool {
+    match current {
+        VideoStreamKey::Guest { screen, .. } => {
+            context.screen.width != 0 && context.screen.height != 0 && *screen != context.screen
+        }
+        key => manager.is_retired_host_key(key),
+    }
+}
+
+/// When nothing it asks for can be had: no image (it waits).
+const NO_IMAGE: Choice = Choice {
+    placement: Placement::Wait,
+    reason: Reason::Limit,
+};
+
+/// How heavy the image `current` is (the host's: the display).
+fn current_weight(context: &Context, current: &VideoStreamKey) -> u64 {
+    match current {
+        VideoStreamKey::Guest { image, .. } => image.mode().weight(),
+        _ => context.screen.weight(),
+    }
+}
+
+/// The new placement of one output, or `None` to stay; with the notches
+/// lowered for `Lag`.
+fn plan(
+    context: &Context,
+    manager: &AVServicesManager,
+    output: &GuestOutput,
+    mut ask: Ask,
+    why: &Relocation,
+) -> Option<(Choice, u8)> {
+    let display_id = output.display_id;
+    let current = output.current.as_ref();
+    // An image it must leave: the best it can have, or no image at all
+    // (never stays on it).
+    if current.is_some_and(|key| must_leave(context, manager, key)) {
+        let slots = if *why == Relocation::Screen {
+            Slots::Remade
+        } else {
+            Slots::Count
+        };
+        let choice = decide(context, manager, display_id, &ask, current, slots)
+            .map_or(NO_IMAGE, |(choice, _)| choice);
+        return Some((choice, ask.steps));
+    }
+    match why {
+        Relocation::Quality | Relocation::Started | Relocation::Stalled(_) => {
+            if let Relocation::Stalled(key) = why
+                && current != Some(key)
+            {
+                return None;
+            }
+            let (choice, _) =
+                decide(context, manager, display_id, &ask, current, Slots::Count).ok()?;
+            Some((choice, ask.steps))
+        }
+        Relocation::Screen => {
+            // Chosen for another mode (the host's image, or waiting: the
+            // choice may change with the display's size or rate).
+            if output.screen == context.screen
+                || context.screen.width == 0
+                || context.screen.height == 0
+            {
+                return None;
+            }
+            let (choice, _) =
+                decide(context, manager, display_id, &ask, current, Slots::Remade).ok()?;
+            Some((choice, ask.steps))
+        }
+        Relocation::HostImage => {
+            let (choice, _) =
+                decide(context, manager, display_id, &ask, current, Slots::Count).ok()?;
+            let waiting = current.is_none() && choice.placement != Placement::Wait;
+            let retired = current.is_some_and(|key| manager.is_retired_host_key(key));
+            let follows = choice.placement == Placement::FollowHost;
+            (waiting || retired || follows).then_some((choice, ask.steps))
+        }
+        Relocation::Lag => {
+            // Waiting: nothing to lighten.
+            let weight = current_weight(context, current?);
+            for steps in ask.steps + 1..=guest_image::max_steps(ask.quality) {
+                ask.steps = steps;
+                let Ok((choice, host)) =
+                    decide(context, manager, display_id, &ask, current, Slots::Count)
+                else {
+                    continue;
+                };
+                let lighter = choice.placement.weight(host.as_ref());
+                if choice.placement != Placement::Wait && lighter < weight {
+                    // Lowered for lagging, even when the budget picked it.
+                    let choice = Choice {
+                        reason: Reason::Lag,
+                        ..choice
+                    };
+                    return Some((choice, steps));
+                }
+            }
+            None
+        }
+    }
+}
+
+/// Chooses again the image of each of a guest's outputs, and moves those
+/// that change: subscribed to the new image, the output follows it (the
+/// guest gets its headers and a keyframe), the old subscription released.
+/// Sound and inputs are not touched. Returns how many moved.
+pub(crate) async fn relocate(ctrl: &Controller, uid: Uuid, why: Relocation) -> usize {
+    let Ok(services) = ctrl.session_services(&uid) else {
+        return 0;
+    };
+    let mut services = services.lock().await;
+    if services.guest_outputs.is_empty() {
+        return 0;
+    }
+    let mut manager = ctrl.av_services_manager.lock().await;
+    let mut released = Vec::new();
+    let mut moved = 0;
+
+    for index in 0..services.guest_outputs.len() {
+        let output = &services.guest_outputs[index];
+        let (display_id, request) = (output.display_id, output.request);
+        let Ok(ask) = guest_ask(ctrl, &uid, &request) else {
+            break;
+        };
+        let context = Context::of(ctrl, display_id);
+        let Some((mut choice, steps)) = plan(&context, &manager, output, ask, &why) else {
+            continue;
+        };
+        let current = output.current.clone();
+        let screen = context.screen;
+        if already_there(
+            &manager,
+            display_id,
+            screen,
+            choice.placement,
+            current.as_ref(),
+        ) {
+            let output = &mut services.guest_outputs[index];
+            output.reason = choice.reason;
+            output.screen = screen;
+            continue;
+        }
+        let leaving = current
+            .as_ref()
+            .is_some_and(|key| must_leave(&context, &manager, key));
+
+        let acquired = match acquire_placement(
+            ctrl,
+            &mut manager,
+            display_id,
+            screen,
+            choice.placement,
+            &request,
+        )
+        .await
+        {
+            Ok(acquired) => acquired,
+            Err(err) if leaving => {
+                // Its image must go all the same: the closest image open
+                // (or the host's, if it reads it), else no image.
+                warn!("Session {uid}: image of display {display_id} not opened: {err}");
+                let closest = decide(&context, &manager, display_id, &ask, None, Slots::Full)
+                    .map_or(NO_IMAGE, |(closest, _)| closest);
+                match acquire_placement(
+                    ctrl,
+                    &mut manager,
+                    display_id,
+                    screen,
+                    closest.placement,
+                    &request,
+                )
+                .await
+                {
+                    Ok(acquired) => {
+                        choice = closest;
+                        acquired
+                    }
+                    Err(_) => {
+                        choice = NO_IMAGE;
+                        None
+                    }
+                }
+            }
+            Err(err) => {
+                warn!("Session {uid}: image of display {display_id} not moved: {err}");
+                continue;
+            }
+        };
+        let (source, key, subscription) = match acquired {
+            Some((acquisition, key)) => {
+                // Failing, the new subscription drops (and is undone).
+                let Ok(source) = video_source(&manager, uid, &key, &acquisition) else {
+                    continue;
+                };
+                (Some(source), Some(key), Some(acquisition.subscription))
+            }
+            None => (None, None, None),
+        };
+        // The old subscription goes out first (both may be on the same
+        // key), released once the new ones are all taken.
+        if let Some(old) = &current
+            && let Some(at) = services
+                .video_subscriptions
+                .iter()
+                .position(|sub| sub.key() == old)
+        {
+            released.push(services.video_subscriptions.remove(at));
+        }
+        services.video_subscriptions.extend(subscription);
+        info!(
+            "Session {uid}: image of display {display_id} {current:?} → {key:?} ({why:?}, {})",
+            choice.reason.name()
+        );
+        let output = &mut services.guest_outputs[index];
+        output.source.send_replace(source);
+        output.current = key;
+        output.reason = choice.reason;
+        output.screen = screen;
+        moved += 1;
+
+        let _ = ctrl.with_session(&uid, |s| {
+            s.guest_image.meter.restart(Instant::now());
+            if s.guest_image.steps != steps {
+                s.guest_image.steps = steps;
+                if let Some(share) = &s.share {
+                    ctrl.share_memory.lock().unwrap().remember_quality(
+                        &s.username,
+                        share.quality,
+                        steps,
+                    );
+                }
+            }
+            Ok(())
+        });
+    }
+
+    // An image one output leaves and another joins is not stopped between.
+    let cleanup = manager.release_all(released, None);
+    drop(manager);
+    drop(services);
+    cleanup.run_detached();
+    moved
+}
+
+/// After a host started its image of `displays`: guest images within its
+/// bitrate, and the guests waiting for it, on an older generation, or that
+/// would follow it now, moved to it.
+pub(crate) async fn after_host_start(ctrl: Arc<Controller>, displays: Vec<u32>) {
+    {
+        let mut manager = ctrl.av_services_manager.lock().await;
+        for display_id in &displays {
+            manager.cap_guest_images(*display_id);
+        }
+    }
+    let guests: Vec<Uuid> = ctrl
+        .sessions
+        .lock()
+        .unwrap()
+        .values()
+        .filter(|s| {
+            s.share
+                .as_ref()
+                .is_some_and(|share| displays.contains(&share.display))
+        })
+        .map(|s| s.uid)
+        .collect();
+    for uid in guests {
+        relocate(&ctrl, uid, Relocation::HostImage).await;
+    }
+    // The older generations go in any case: their guests are elsewhere,
+    // or waiting when they read nothing else.
+    let mut manager = ctrl.av_services_manager.lock().await;
+    for display_id in &displays {
+        manager
+            .close_retired_host_images(*display_id)
+            .run_detached();
+    }
+}
+
+/// After Kyber's display list was announced again (and settled): the
+/// guests whose display changed size or rate get an image chosen for the
+/// new mode; images made from the old one close as their last guest
+/// leaves. The host's image follows the display itself (kyavserver).
+pub(crate) async fn screens_changed(ctrl: &Controller) {
+    let guests: Vec<Uuid> = ctrl
+        .sessions
+        .lock()
+        .unwrap()
+        .values()
+        .filter(|s| s.share.is_some())
+        .map(|s| s.uid)
+        .collect();
+    for uid in guests {
+        relocate(ctrl, uid, Relocation::Screen).await;
+    }
+}
+
+/// Bursts of announcements, settled: [`Settle::arm`] for each one, only the
+/// last one's wait ends `true`, `SCREEN_SETTLE` after it.
+#[derive(Clone, Default)]
+struct Settle {
+    latest: Arc<std::sync::atomic::AtomicU64>,
+}
+
+impl Settle {
+    fn arm(&self) -> impl std::future::Future<Output = bool> + Send + 'static + use<> {
+        use std::sync::atomic::Ordering;
+        let this = self.latest.fetch_add(1, Ordering::SeqCst) + 1;
+        let latest = Arc::clone(&self.latest);
+        async move {
+            tokio::time::sleep(SCREEN_SETTLE).await;
+            latest.load(Ordering::SeqCst) == this
+        }
+    }
+}
+
+/// Records a sign of lag; `true` when the guest should go a notch down.
+fn lag_sign(ctrl: &Controller, uid: &Uuid, sign: LagSign) -> bool {
+    ctrl.with_session(uid, |s| {
+        Ok(s.share.is_some() && s.guest_image.meter.record(sign, Instant::now()))
+    })
+    .unwrap_or(false)
+}
+
+/// A keyframe for a guest on `key`: right away on an image of its own; on
+/// the host's image, one every 2 s at most for all its guests together
+/// ([`guest_image::KeyframeSpacing`]): one asked too soon is put off, not
+/// dropped (its guest waits for it), and serves the ones asked meanwhile.
+async fn keyframe_for_guest(ctrl: &Controller, uid: &Uuid, key: &VideoStreamKey) {
+    let (delay, idr) = {
+        let mut manager = ctrl.av_services_manager.lock().await;
+        let delay = if matches!(key, VideoStreamKey::Shared { .. }) {
+            match manager.guest_keyframe_delay(key, Instant::now()) {
+                Some(delay) => delay,
+                None => {
+                    debug!("Session {uid}: keyframe on {key:?} already on its way");
+                    return;
+                }
+            }
+        } else {
+            Duration::ZERO
+        };
+        (delay, manager.idr_sender(key.clone()))
+    };
+    if delay.is_zero() {
+        idr();
+    } else {
+        tokio::spawn(async move {
+            tokio::time::sleep(delay).await;
+            idr();
+        });
+    }
+}
+
+/// `/force_idr` from a share guest (past the 150 ms rule): a keyframe on
+/// each image it reads (spaced on the host's), and a sign of lag.
+pub(crate) async fn guest_force_idr(ctrl: Arc<Controller>, uid: Uuid) {
+    let Ok(services) = ctrl.session_services(&uid) else {
+        return;
+    };
+    let keys: Vec<VideoStreamKey> = services
+        .lock()
+        .await
