+/// The images around a guest, as the registry sees them.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Situation<'a> {
+    /// The host's image of this display, if it runs.
+    pub(crate) host: Option<HostImage>,
+    /// A host is in session (sharing from its session). Without, the share
+    /// comes from the computer itself.
+    pub(crate) host_session: bool,
+    /// The display as it is.
+    pub(crate) screen: Mode,
+    /// Guest images open on this display (set aside ones left out).
+    pub(crate) open: &'a [GuestImage],
+    /// Guest images open on every display, slots set aside included, the
+    /// one this guest leaves (when it is alone on it) left out.
+    pub(crate) used: usize,
+    pub(crate) budget: ImageBudget,
+}
+
+/// What a guest asks for.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Ask {
+    pub(crate) quality: ShareQuality,
+    /// Notches lowered because it fell behind.
+    pub(crate) steps: u8,
+    pub(crate) reader: Reader,
+    /// Its bitrate.
+    pub(crate) bitrate: u32,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Placement {
+    /// The host's image.
+    FollowHost,
+    /// Nothing yet: the host is in session and its image will come back
+    /// (it restarts it); the guest is attached to it then.
+    Wait,
+    /// A guest image already open.
+    Join(GuestImage),
+    /// A new guest image, at `bitrate`; `ceiling`: the most it may use
+    /// when the host's bitrate allows (its preset's `cap` and the guest's
+    /// bitrate).
+    Open {
+        image: GuestImage,
+        bitrate: u32,
+        ceiling: u32,
+        cap: u32,
+    },
+}
+
+impl Placement {
+    /// How heavy it is; 0 while waiting.
+    pub(crate) fn weight(self, host: Option<&HostImage>) -> u64 {
+        match self {
+            Self::FollowHost => host.map_or(0, |h| h.mode.weight()),
+            Self::Wait => 0,
+            Self::Join(image) | Self::Open { image, .. } => image.mode().weight(),
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Choice {
+    pub(crate) placement: Placement,
+    pub(crate) reason: Reason,
+}
+
+/// No image this guest can read: refused (409).
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct Refused;
+
+fn even(value: u32) -> u32 {
+    (value & !1).max(2)
+}
+
+/// `reference` fitted in a `box_width` × `box_height` frame, proportions
+/// kept, even; never above `reference`.
+fn fit(reference: Mode, box_width: u32, box_height: u32) -> (u32, u32) {
+    let (w, h) = (reference.width, reference.height);
+    if w == 0 || h == 0 {
+        return (box_width, box_height);
+    }
+    if w <= box_width && h <= box_height {
+        return (w, h);
+    }
+    let (w64, h64) = (u64::from(w), u64::from(h));
+    let (bw, bh) = (u64::from(box_width), u64::from(box_height));
+    let (width, height) = if bw * h64 <= bh * w64 {
+        (bw, h64 * bw / w64)
+    } else {
+        (w64 * bh / h64, bh)
+    };
+    (even(width as u32), even(height as u32))
+}
+
+/// The image of `quality` against `reference` (the host's image, or the
+/// display without one): the preset's frame (turned like the display),
+/// never above `reference`; `Capped` when `reference` makes it smaller or
+/// slower than the preset.
+fn target(quality: ShareQuality, reference: Mode) -> (Mode, Reason) {
+    let Some((long, short, fps)) = frame(quality) else {
+        return (reference, Reason::Asked);
+    };
+    let (box_width, box_height) = if reference.height > reference.width {
+        (short, long)
+    } else {
+        (long, short)
+    };
+    let (width, height) = fit(reference, box_width, box_height);
+    let rate = fps.min(reference.refresh());
+    let capped = rate < fps || (width < box_width && height < box_height);
+    let mode = Mode {
+        width,
+        height,
+        fps: rate,
+    };
+    (
+        mode,
+        if capped {
+            Reason::Capped
+        } else {
+            Reason::Asked
+        },
+    )
+}
+
+/// The image a guest gets:
+/// - with the host's image: the host's when the guest's image would be all
+///   of it and the device reads its format (and its 4:4:4); otherwise an
+///   image of its own, in the device's format, in 4:2:0 (the host's size at
+///   60 Hz at most for "as the host");
+/// - without it, while a host is in session: wait for it when the guest
+///   would follow it, an image of its own otherwise;
+/// - without a host (a share from the computer): an image of its own, "as
+///   the host" being the display as it is.
+///
+/// An image of its own is joined when open, opened while the budget
+/// allows; beyond, the closest open image the guest reads, lighter (or
+/// else the lightest one), with `Limit`. None: `Refused`.
+pub(crate) fn choose(s: &Situation, ask: &Ask) -> Result<Choice, Refused> {
+    let quality = lowered(ask.quality, ask.steps);
+    let reference = s.host.map_or(s.screen, |h| h.mode);
+    let (mut mode, mut reason) = target(quality, reference);
+    if quality != ask.quality {
+        reason = Reason::Lag;
+    }
+    // Bitrate ceiling: the preset's, unless the image is the display as is.
+    let mut capped_by = quality;
+    if !s.budget.can_scale && mode != reference {
+        mode = reference;
+        reason = Reason::Limit;
+        capped_by = ShareQuality::Host;
+    }
+
+    match &s.host {
+        Some(host) => {
+            let reads_host = ask.reader.reads(host);
+            if mode.covers(reference) && reads_host {
+                return Ok(Choice {
+                    placement: Placement::FollowHost,
+                    reason,
+                });
+            }
+            if quality == ShareQuality::Host
+                && s.budget.can_scale
+                && mode.refresh() > HOST_COPY_MAX_FPS
+            {
+                mode.fps = HOST_COPY_MAX_FPS;
+                if reason == Reason::Asked {
+                    reason = Reason::Capped;
+                }
+            }
+            place(s, ask, mode, reason, capped_by, reads_host)
+        }
+        None if s.host_session && mode.covers(reference) => Ok(Choice {
+            placement: Placement::Wait,
+            reason,
+        }),
+        None => place(s, ask, mode, reason, capped_by, false),
+    }
+}
+
+/// An image of the guest's own: joined, opened, or the closest one open.
+fn place(
+    s: &Situation,
+    ask: &Ask,
+    mode: Mode,
+    reason: Reason,
+    capped_by: ShareQuality,
+    reads_host: bool,
+) -> Result<Choice, Refused> {
+    let image = GuestImage::new(mode, ask.reader.codec);
+    if s.open.contains(&image) {
+        return Ok(Choice {
+            placement: Placement::Join(image),
+            reason,
+        });
+    }
+
+    if s.used < s.budget.limit(s.host_session) {
+        let cap = preset_cap(capped_by, image.codec).unwrap_or(u32::MAX);
+        let ceiling = cap.min(ask.bitrate);
+        let bitrate = s.host.map_or(ceiling, |h| ceiling.min(h.bitrate));
+        return Ok(Choice {
+            placement: Placement::Open {
+                image,
+                bitrate,
+                ceiling,
+                cap,
+            },
+            reason,
+        });
+    }
+
+    let candidates: Vec<(u64, Placement)> = s
+        .open
+        .iter()
+        .filter(|open| open.codec == ask.reader.codec)
+        .map(|open| (open.mode().weight(), Placement::Join(*open)))
+        .chain(
+            s.host
+                .filter(|_| reads_host)
+                .map(|h| (h.mode.weight(), Placement::FollowHost)),
+        )
+        .collect();
+    let wanted = mode.weight();
+    let lighter = candidates
+        .iter()
+        .filter(|(weight, _)| *weight <= wanted)
+        .max_by_key(|(weight, _)| *weight);
+    let (_, placement) = lighter
+        .or_else(|| candidates.iter().min_by_key(|(weight, _)| *weight))
+        .ok_or(Refused)?;
+    Ok(Choice {
+        placement: *placement,
+        reason: Reason::Limit,
+    })
+}
+
+/// On the host's image, one keyframe every this long at most for all its
+/// guests together: the host comes first.
+pub(crate) const HOST_KEYFRAME_SPACING: Duration = Duration::from_secs(2);
+
+/// The keyframes the guests of one host image ask for: one every
+/// [`HOST_KEYFRAME_SPACING`] at most, whoever asks. One asked too soon is
+/// put off (never dropped: its guest waits for it); while one is put off,
+/// the next ones wait for it too.
+#[derive(Debug, Default)]
+pub(crate) struct KeyframeSpacing {
+    /// When the last one was (or will be) forced.
+    last: Option<Instant>,
+}
+
+impl KeyframeSpacing {
+    /// In how long to force the keyframe asked `now`; `None` when one is
+    /// already put off (it serves this request too).
+    pub(crate) fn next(&mut self, now: Instant) -> Option<Duration> {
+        let at = match self.last {
+            Some(last) if last > now => return None,
+            Some(last) => (last + HOST_KEYFRAME_SPACING).max(now),
+            None => now,
+        };
+        self.last = Some(at);
+        Some(at - now)
+    }
+}
+
+/// The window in which a guest's signs of lag are counted.
+const LAG_WINDOW: Duration = Duration::from_secs(10);
+/// Lag episodes (its output on an image overflowed) in `LAG_WINDOW` that
+/// lower a guest's image.
+const LAG_EPISODES: usize = 2;
+/// Keyframe requests in `LAG_WINDOW` that lower a guest's image.
+const LAG_KEYFRAMES: usize = 3;
+/// After a guest gets an image, its signs are not counted for this long:
+/// it is catching up with it.
+const LAG_GRACE: Duration = Duration::from_secs(3);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum LagSign {
+    /// Its output on an image overflowed (kydup).
+    Episode,
+    /// It asked for a keyframe (`/force_idr`).
+    KeyframeRequest,
+}
+
+/// A guest's signs of lag: two episodes or three keyframe requests within
+/// ten seconds lower its image a notch.
+#[derive(Debug, Default)]
+pub(crate) struct LagMeter {
+    episodes: VecDeque<Instant>,
+    keyframes: VecDeque<Instant>,
+    quiet_until: Option<Instant>,
+}
+
+impl LagMeter {
+    /// The guest got an image: start over, after a grace period.
+    pub(crate) fn restart(&mut self, now: Instant) {
+        self.episodes.clear();
+        self.keyframes.clear();
+        self.quiet_until = Some(now + LAG_GRACE);
+    }
+
+    /// Records a sign; `true` when the guest should go a notch down (the
+    /// count then starts over).
+    pub(crate) fn record(&mut self, sign: LagSign, now: Instant) -> bool {
+        if self.quiet_until.is_some_and(|until| now < until) {
+            return false;
+        }
+        match sign {
+            LagSign::Episode => self.episodes.push_back(now),
+            LagSign::KeyframeRequest => self.keyframes.push_back(now),
+        }
+        for signs in [&mut self.episodes, &mut self.keyframes] {
+            while signs
+                .front()
+                .is_some_and(|at| now.saturating_duration_since(*at) > LAG_WINDOW)
+            {
+                signs.pop_front();
+            }
+        }
+        let lagging = self.episodes.len() >= LAG_EPISODES || self.keyframes.len() >= LAG_KEYFRAMES;
+        if lagging {
+            self.episodes.clear();
+            self.keyframes.clear();
+        }
+        lagging
+    }
+}
