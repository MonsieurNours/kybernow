+struct GuestQueue {
+    packets: std::sync::Mutex<VecDeque<(tokio::time::Instant, AVPacket)>>,
+    notify: Notify,
+}
+
+impl GuestQueue {
+    /// `false` (nothing queued) when the guest is too far behind: its
+    /// oldest packet waits for longer than [`GUEST_QUEUE_MAX_AGE`].
+    fn push(&self, packet: AVPacket) -> bool {
+        let now = tokio::time::Instant::now();
+        {
+            let mut packets = self.packets.lock().unwrap();
+            let stale = packets
+                .front()
+                .is_some_and(|(at, _)| now.saturating_duration_since(*at) > GUEST_QUEUE_MAX_AGE);
+            if stale || packets.len() >= GUEST_QUEUE_MAX_LEN {
+                return false;
+            }
+            packets.push_back((now, packet));
+        }
+        self.notify.notify_one();
+        true
+    }
+
+    fn clear(&self) {
+        self.packets.lock().unwrap().clear();
+    }
+
+    async fn pop(&self) -> AVPacket {
+        loop {
+            if let Some((_, packet)) = self.packets.lock().unwrap().pop_front() {
+                return packet;
+            }
+            // `notify_one` keeps a permit when nobody waits: a push between
+            // the check and this await is not missed.
+            self.notify.notified().await;
+        }
+    }
+}
+
+/// KyberNow: sends what the reader queued, until the client is gone.
+async fn send_guest_queue(
+    mut send: ProtocolSend<AVPacket>,
+    queue: &GuestQueue,
+) -> Result<(), ProtocolError> {
+    loop {
+        let packet = queue.pop().await;
+        send.send(packet).await?;
+    }
+}
+
+async fn run_guest_video(
+    send: ProtocolSend<AVPacket>,
+    source: watch::Receiver<Option<VideoSource>>,
+) {
+    let queue = GuestQueue::default();
+    tokio::select! {
+        () = read_guest_video(source, &queue) => {}
+        res = send_guest_queue(send, &queue) => {
+            if let Err(e) = res {
+                debug!("Kydup guest video output send error: {e}");
+            }
+        }
+    }
+}
+
+/// KyberNow: what ends the reading of one image.
+enum GuestRead {
+    /// Another image (or none) to read.
+    Moved,
+    /// The output is dropped (its `watch` sender is gone).
+    Closed,
+}
+
+/// KyberNow: reads the image `source` names into `queue`, from its next
+/// keyframe on, following each move.
+async fn read_guest_video(mut source: watch::Receiver<Option<VideoSource>>, queue: &GuestQueue) {
+    loop {
+        let current = source.borrow_and_update().clone();
+        // Nothing of the previous image goes out once it is left.
+        queue.clear();
+        let read = match current {
+            None => match source.changed().await {
+                Ok(()) => GuestRead::Moved,
+                Err(_) => GuestRead::Closed,
+            },
+            Some(current) => read_guest_image(&current, &mut source, queue).await,
+        };
+        if matches!(read, GuestRead::Closed) {
+            return;
+        }
+    }
+}
+
+async fn read_guest_image(
+    current: &VideoSource,
+    source: &mut watch::Receiver<Option<VideoSource>>,
+    queue: &GuestQueue,
+) -> GuestRead {
+    let mut rx = GatedReceiver::new(current.dup.tx.subscribe(), Arc::clone(&current.dup.notify));
+    (current.on_subscribed)();
+    let mut synced = false;
+    loop {
+        let msg = tokio::select! {
+            biased;
+            changed = source.changed() => {
+                return if changed.is_ok() { GuestRead::Moved } else { GuestRead::Closed };
+            }
+            msg = rx.recv() => msg,
+        };
+        match msg {
+            Ok(AVBroadcast::Data(packet, headers)) => {
+                if !synced {
+                    if matches!(&packet, AVPacket::Media(m) if m.header.is_key) {
+                        // Just cleared or emptied: these fit.
+                        for header in [&headers.codec, &headers.config].into_iter().flatten() {
+                            queue.push(header.clone());
+                        }
+                        queue.push(packet);
+                        synced = true;
+                    }
+                } else if !queue.push(packet) {
+                    warn!("Kydup guest video output fell behind: back to the next keyframe");
+                    queue.clear();
+                    synced = false;
+                    (current.on_overflow)();
+                }
+            }
+            Err(broadcast::error::RecvError::Lagged(skipped)) => {
+                warn!("Kydup guest video output lagged, skipped {skipped} packets");
+                queue.clear();
+                synced = false;
+                (current.on_overflow)();
+            }
+            // The image ended: wait for another one (the client is told
+            // through its stream events).
+            Ok(AVBroadcast::Shutdown) | Err(broadcast::error::RecvError::Closed) => {
+                drop(rx);
+                return match source.changed().await {
+                    Ok(()) => GuestRead::Moved,
+                    Err(_) => GuestRead::Closed,
+                };
+            }
+        }
+    }
+}
+
+async fn run_guest_audio(
+    tx: broadcast::Sender<AVBroadcast>,
+    notify: Arc<Notify>,
+    send: ProtocolSend<AVPacket>,
+) {
+    let rx = GatedReceiver::new(tx.subscribe(), notify);
+    drop(tx);
+    run_guest_audio_from(rx, send).await;
+}
+
+async fn run_guest_audio_from(rx: GatedReceiver, send: ProtocolSend<AVPacket>) {
+    let queue = GuestQueue::default();
+    tokio::select! {
+        () = read_guest_audio(rx, &queue) => {}
+        res = send_guest_queue(send, &queue) => {
+            if let Err(e) = res {
+                debug!("Kydup guest audio output send error: {e}");
+            }
+        }
+    }
+}
+
+/// KyberNow: a guest's sound, read without waiting: when the guest falls
+/// behind, its backlog goes and it starts again on the next packet (with
+/// the headers, if they changed).
+async fn read_guest_audio(mut rx: GatedReceiver, queue: &GuestQueue) {
+    let mut headers_version = 0u64;
+    let mut synced = false;
+    loop {
+        match rx.recv().await {
+            Ok(AVBroadcast::Data(packet, headers)) => {
+                if is_header(&packet) {
+                    headers_version = headers.version;
+                }
+                if !synced {
+                    if headers.version != headers_version {
+                        for header in [&headers.codec, &headers.config].into_iter().flatten() {
+                            queue.push(header.clone());
+                        }
+                        headers_version = headers.version;
+                    }
+                    queue.push(packet);
+                    synced = true;
+                } else if !queue.push(packet) {
+                    debug!("Kydup guest audio output fell behind: backlog dropped");
+                    queue.clear();
+                    synced = false;
+                }
+            }
+            Err(broadcast::error::RecvError::Lagged(_)) => {
+                queue.clear();
+                synced = false;
+            }
+            Ok(AVBroadcast::Shutdown) | Err(broadcast::error::RecvError::Closed) => return,
+        }
+    }
+}
