         Ok(VideoAcquisition {
             dup,
             metrics_claim,
-            subscription: VideoSubscription::new(key, tx),
+            subscription: VideoSubscription::with_guest(key, tx, guest),
+        })
+    }
+
+    /// KyberNow: a share guest joins a running image (the host's, or a
+    /// guest image), never creating one. `None` when it is gone.
+    pub(crate) fn join_video(&mut self, key: &VideoStreamKey) -> Option<VideoAcquisition> {
+        let dup = self.video_streams.get(key)?.dup.clone();
+        self.subscribe_video(key, true);
+        Some(VideoAcquisition {
+            dup,
+            metrics_claim: None,
+            subscription: VideoSubscription::with_guest(key.clone(), self.reaper_tx.clone(), true),
+        })
+    }
+
+    /// KyberNow: the host's image of `display_id`. Only a session without
+    /// share (the host) creates it or redefines it: when only guests watch
+    /// it, a host asking for another format (or 4:4:4, or intra-refresh)
+    /// gets a new generation (the guests are moved by
+    /// [`crate::kybernow::after_host_start`]), and its bitrate is the
+    /// host's. With another host session on it, the first one's settings
+    /// stay, as before.
+    pub(crate) async fn acquire_host_video(
+        &mut self,
+        ctrl: &Controller,
+        display_id: u32,
+        config: VideoStreamConfig,
+        metrics_requested: bool,
+    ) -> Result<VideoAcquisition> {
+        let start = self.host_start(display_id, &config);
+        let generation = match start {
+            HostStart::Join {
+                generation,
+                bitrate: redefined,
+            } => {
+                if redefined {
+                    self.redefine_host_bitrate(display_id, generation, config.bitrate);
+                }
+                generation
+            }
+            HostStart::New => self.next_generation.wrapping_add(1),
+        };
+        let acquisition = self
+            .acquire_video(
+                ctrl,
+                VideoTopology::Shared {
+                    display_id,
+                    generation,
+                },
+                config,
+                metrics_requested,
+            )
+            .await?;
+        // Only once it runs: a host that failed to start leaves the current
+        // image to its guests.
+        if start == HostStart::New {
+            self.next_generation = generation;
+        }
+        self.host_generations.insert(display_id, generation);
+        Ok(acquisition)
+    }
+
+    /// KyberNow: what a host starting its image of `display_id` with
+    /// `config` does: join the current one (redefining its bitrate when
+    /// only guests watch it), or start the next generation.
+    fn host_start(&self, display_id: u32, config: &VideoStreamConfig) -> HostStart {
+        let Some(VideoStreamKey::Shared { generation, .. }) = self.current_host_key(display_id)
+        else {
+            return HostStart::New;
+        };
+        let Some(stream) = self.video_streams.get(&VideoStreamKey::Shared {
+            display_id,
+            generation,
+        }) else {
+            return HostStart::New;
+        };
+        if stream.host_count() > 0 {
+            // Another session of the host: the first one's settings stay.
+            return HostStart::Join {
+                generation,
+                bitrate: false,
+            };
+        }
+        if stream.config.same_encoder(config) {
+            return HostStart::Join {
+                generation,
+                bitrate: stream.config.bitrate != config.bitrate,
+            };
+        }
+        info!(
+            "Host image of display {display_id} now {config:?} (was {:?}, watched by guests \
+             only): next generation, generation {generation} kept until its guests move",
+            stream.config
+        );
+        HostStart::New
+    }
+
+    fn redefine_host_bitrate(&mut self, display_id: u32, generation: u32, bitrate: u32) {
+        let key = VideoStreamKey::Shared {
+            display_id,
+            generation,
+        };
+        let Some(stream) = self.video_streams.get_mut(&key) else {
+            return;
+        };
+        info!(
+            "Host image of display {display_id}: bitrate {} → {bitrate}",
+            stream.config.bitrate
+        );
+        if let Err(err) = stream
+            .avservice
+            .video_set_bitrate(bitrate.min(i32::MAX as u32) as i32)
+        {
+            warn!("Failed to set bitrate: {err:?}");
+        }
+        stream.config.bitrate = bitrate;
+        self.cap_guest_images(display_id);
+    }
+
+    /// KyberNow: the key of `display_id`'s current host image, if it runs.
+    pub(crate) fn current_host_key(&self, display_id: u32) -> Option<VideoStreamKey> {
+        let generation = *self.host_generations.get(&display_id)?;
+        let key = VideoStreamKey::Shared {
+            display_id,
+            generation,
+        };
+        self.video_streams.contains_key(&key).then_some(key)
+    }
+
+    /// KyberNow: `display_id`'s current host image, as `choose` sees it.
+    pub(crate) fn host_image(&self, display_id: u32, screen: Mode) -> Option<HostImage> {
+        let stream = self
+            .video_streams
+            .get(&self.current_host_key(display_id)?)?;
+        Some(HostImage {
+            mode: screen,
+            codec: ImageCodec::from(&stream.config.codec),
+            yuv444: stream.config.yuv444,
+            bitrate: stream.config.bitrate,
         })
     }
 
+    /// KyberNow: a host image of an older generation, while a newer one
+    /// runs (its guests move, then it closes).
+    pub(crate) fn is_retired_host_key(&self, key: &VideoStreamKey) -> bool {
+        matches!(key, VideoStreamKey::Shared { display_id, .. }
+            if self.current_host_key(*display_id).is_some_and(|current| current != *key))
+    }
+
+    /// KyberNow: closes the older generations of `display_id`'s host image
+    /// (no host on them), even when a guest could not leave them: one
+    /// encoder more beside the budget otherwise. Such a guest is told its
+    /// image stopped (its app starts it again) and its output waits.
+    pub(crate) fn close_retired_host_images(&mut self, display_id: u32) -> AVCleanup {
+        let retired: Vec<VideoStreamKey> = self
+            .video_streams
+            .iter()
+            .filter(|(key, stream)| {
+                key.display_id() == display_id
+                    && self.is_retired_host_key(key)
+                    && stream.host_count() == 0
+            })
+            .map(|(key, _)| key.clone())
+            .collect();
+        let mut cleanup = AVCleanup::default();
+        for key in retired {
+            let stream = self.video_streams.remove(&key);
+            if let Some(stream) = &stream {
+                if stream.client_count > 0 {
+                    warn!(
+                        "{key:?} closed with {} guests that could not leave it",
+                        stream.client_count
+                    );
+                } else {
+                    info!("{key:?} closed");
+                }
+            }
+            cleanup.push_video(stream);
+        }
+        cleanup
+    }
+
+    /// KyberNow: in how long to force the keyframe a guest asks for on the
+    /// host image `key` (see [`KeyframeSpacing`]); `None` when one is
+    /// already put off, or the image is gone.
+    pub(crate) fn guest_keyframe_delay(
+        &mut self,
+        key: &VideoStreamKey,
+        now: Instant,
+    ) -> Option<Duration> {
+        self.video_streams.get_mut(key)?.guest_keyframes.next(now)
+    }
+
+    /// KyberNow: guest images open on `display_id` and made from its mode
+    /// `screen` (one made from another mode no longer fits), those given
+    /// up left out.
+    pub(crate) fn open_guest_images(&self, display_id: u32, screen: Mode) -> Vec<GuestImage> {
+        let now = Instant::now();
+        self.video_streams
+            .keys()
+            .filter_map(|key| match key {
+                VideoStreamKey::Guest {
+                    display_id: d,
+                    image,
+                    screen: made_from,
+                } if *d == display_id
+                    && *made_from == screen
+                    && !self.is_set_aside(*d, image, now) =>
+                {
+                    Some(*image)
+                }
+                _ => None,
+            })
+            .collect()
+    }
+
+    /// KyberNow: whether `key` is the guest image `image` of `display_id`,
+    /// whatever mode it was made from.
+    fn is_guest_image(key: &VideoStreamKey, display_id: u32, image: &GuestImage) -> bool {
+        matches!(key, VideoStreamKey::Guest { display_id: d, image: i, .. }
+            if *d == display_id && i == image)
+    }
+
+    fn is_set_aside(&self, display_id: u32, image: &GuestImage, now: Instant) -> bool {
+        self.set_aside
+            .iter()
+            .any(|(d, i, until)| *d == display_id && i == image && now < *until)
+    }
+
+    /// KyberNow: guest image slots in use on every display: the images
+    /// open and the slots set aside, without `leaving` (the image a guest
+    /// is alone on and leaves) and, with `remade` (a display and its new
+    /// mode), the images of that display made from another mode: all
+    /// their guests are moving off them.
+    pub(crate) fn guest_slots_used(
+        &self,
+        leaving: Option<&VideoStreamKey>,
+        remade: Option<(u32, Mode)>,
+    ) -> usize {
+        let now = Instant::now();
+        let stale = |key: &VideoStreamKey| {
+            matches!((key, remade), (
+                VideoStreamKey::Guest { display_id, screen, .. },
+                Some((remade, mode)),
+            ) if *display_id == remade && *screen != mode)
+        };
+        let open = self
+            .video_streams
+            .keys()
+            .filter(|key| {
+                matches!(key, VideoStreamKey::Guest { .. }) && Some(*key) != leaving && !stale(key)
+            })
+            .count();
+        let set_aside = self
+            .set_aside
+            .iter()
+            .filter(|(display_id, image, until)| {
+                now < *until
+                    && (leaving.is_some_and(|key| Self::is_guest_image(key, *display_id, image))
+                        || !self
+                            .video_streams
+                            .keys()
+                            .any(|key| Self::is_guest_image(key, *display_id, image)))
+            })
+            .count();
+        open + set_aside
+    }
+
+    /// KyberNow: a guest image that sent nothing is given up: its slot
+    /// stays unused for a while. `false` if it is gone or sent something
+    /// since.
+    pub(crate) fn set_aside_stalled(&mut self, key: &VideoStreamKey) -> bool {
+        let VideoStreamKey::Guest {
+            display_id, image, ..
+        } = key
+        else {
+            return false;
+        };
+        let stalled = self
+            .video_streams
+            .get(key)
+            .and_then(|stream| stream.dup.as_ref())
+            .is_some_and(|dup| !dup.received());
+        if stalled {
+            self.set_aside(*display_id, *image, Instant::now());
+        }
+        stalled
+    }
+
+    /// An image set aside again (opened again after its slot came back, or
+    /// its guests started it again) keeps one slot: its time starts over.
+    fn set_aside(&mut self, display_id: u32, image: GuestImage, now: Instant) {
+        self.set_aside
+            .retain(|(d, i, until)| now < *until && (*d, *i) != (display_id, image));
+        self.set_aside
+            .push((display_id, image, now + GUEST_SLOT_SET_ASIDE));
+    }
+
+    /// KyberNow: whether the guest image `image` of `display_id` was given
+    /// up and its slot is still set aside: it is not opened again.
+    pub(crate) fn is_set_aside_now(&self, display_id: u32, image: &GuestImage) -> bool {
+        self.is_set_aside(display_id, image, Instant::now())
+    }
+
+    /// KyberNow: no guest image above the host's bitrate: each guest image
+    /// of `display_id` gets what its ceiling and the host's current
+    /// bitrate allow (down, or back up).
+    pub(crate) fn cap_guest_images(&mut self, display_id: u32) {
+        let Some(host_bitrate) = self
+            .current_host_key(display_id)
+            .and_then(|key| self.video_streams.get(&key))
+            .map(|stream| stream.config.bitrate)
+        else {
+            return;
+        };
+        for (key, stream) in &mut self.video_streams {
+            if !matches!(key, VideoStreamKey::Guest { display_id: d, .. } if *d == display_id) {
+                continue;
+            }
+            let bitrate = stream.ceiling.min(host_bitrate);
+            if bitrate != stream.config.bitrate {
+                info!(
+                    "Guest image {key:?}: bitrate {} → {bitrate}",
+                    stream.config.bitrate
+                );
+                if let Err(err) = stream
+                    .avservice
+                    .video_set_bitrate(bitrate.min(i32::MAX as u32) as i32)
+                {
+                    warn!("Failed to set bitrate: {err:?}");
+                }
+                stream.config.bitrate = bitrate;
+            }
+        }
+    }
