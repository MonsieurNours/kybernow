+        let mut spacing = KeyframeSpacing::default();
+        // Four guests behind at once: one now, one put off, the others
+        // served by that one.
+        assert_eq!(spacing.next(at(0)), Some(Duration::ZERO));
+        assert_eq!(spacing.next(at(100)), Some(Duration::from_millis(1900)));
+        assert_eq!(spacing.next(at(200)), None);
+        assert_eq!(spacing.next(at(1900)), None);
+        // Once the put off one is forced, 2 s again.
+        assert_eq!(spacing.next(at(2500)), Some(Duration::from_millis(1500)));
+        assert_eq!(spacing.next(at(10_000)), Some(Duration::ZERO));
+    }
