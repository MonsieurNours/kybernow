+        let key = guest_key(1, 1920, 1080, 60);
+        insert_stream(&mut manager, key.clone(), (0, 1), video_config());
+        // No kydup: nothing to tell.
+        assert!(!manager.set_aside_stalled(&key));
+
+        let (dup, _upstream) = kydup::KydupVideo::new(|| kydup::LagAction::Continue);
+        manager.video_streams.get_mut(&key).unwrap().dup = Some(dup);
+        assert!(manager.set_aside_stalled(&key));
+        // Not offered any more, its slot still used, even once it is gone.
+        assert!(manager.open_guest_images(1, SCREEN).is_empty());
+        assert_eq!(manager.guest_slots_used(None, None), 1);
+        assert_eq!(manager.guest_slots_used(Some(&key), None), 1);
+        manager.video_streams.remove(&key);
+        assert_eq!(manager.guest_slots_used(None, None), 1);
+
+        // Its time over, the slot is free.
+        manager.set_aside[0].2 = Instant::now();
+        assert_eq!(manager.guest_slots_used(None, None), 0);
+        assert!(!manager.set_aside_stalled(&guest_key(9, 2, 2, 2)));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn a_guest_image_without_an_image_in_3_s_is_reported() {
+        use kymux::types::{AVPacket, MediaPacket, MediaPacketHeader};
+
+        let key = guest_key(1, 1920, 1080, 60);
+        let (signals, mut rx) = tokio::sync::mpsc::unbounded_channel();
+        let (silent, _upstream) = kydup::KydupVideo::new(|| kydup::LagAction::Continue);
+        watch_first_image(silent, signals.clone(), key.clone());
+        tokio::time::sleep(Duration::from_millis(2900)).await;
+        assert!(rx.try_recv().is_err());
+        tokio::time::sleep(Duration::from_millis(200)).await;
+        assert!(matches!(rx.try_recv(), Ok(ShareSignal::Stalled { key: k }) if k == key));
+
+        let (alive, upstream) = kydup::KydupVideo::new(|| kydup::LagAction::Continue);
+        watch_first_image(alive, signals, key);
+        let mut proto = upstream.ready().await.unwrap();
+        proto
+            .send(AVPacket::Media(MediaPacket {
+                header: MediaPacketHeader {
+                    is_config: false,
+                    is_key: true,
+                    pts: 0,
+                    size: 1,
+                },
+                payload: bytes::Bytes::from_static(b"k"),
+            }))
+            .await
+            .unwrap();
+        tokio::time::sleep(Duration::from_secs(4)).await;
+        assert!(rx.try_recv().is_err());
+    }
+
+    #[test]
+    fn the_guests_of_a_host_image_share_its_keyframe_spacing() {
+        let mut manager = AVServicesManager::default();
+        let host = host_key(1, 1);
+        let other = host_key(2, 1);
+        insert_stream(&mut manager, host.clone(), (1, 4), video_config());
+        insert_stream(&mut manager, other.clone(), (1, 1), video_config());
+        let t0 = Instant::now();
+        let at = |ms: u64| t0 + Duration::from_millis(ms);
+
+        // Four guests behind on the same host image: one keyframe now, one
+        // put off to 2 s later, the other two served by that one.
+        assert_eq!(
+            manager.guest_keyframe_delay(&host, at(0)),
+            Some(Duration::ZERO)
+        );
+        assert_eq!(
+            manager.guest_keyframe_delay(&host, at(50)),
+            Some(Duration::from_millis(1950))
+        );
+        assert_eq!(manager.guest_keyframe_delay(&host, at(100)), None);
+        assert_eq!(manager.guest_keyframe_delay(&host, at(150)), None);
+        // Another display's host image has its own.
+        assert_eq!(
+            manager.guest_keyframe_delay(&other, at(150)),
+            Some(Duration::ZERO)
+        );
+        // A host image of the next generation starts afresh; a gone one
+        // gets none.
+        insert_stream(&mut manager, host_key(1, 2), (1, 0), video_config());
+        assert_eq!(
+            manager.guest_keyframe_delay(&host_key(1, 2), at(200)),
+            Some(Duration::ZERO)
+        );
+        assert_eq!(manager.guest_keyframe_delay(&host_key(9, 9), at(200)), None);
+    }
+
+    #[test]
+    fn older_host_generations_close_even_with_a_guest_left() {
+        let mut manager = AVServicesManager::default();
+        insert_stream(&mut manager, host_key(1, 1), (0, 1), video_config());
+        insert_stream(&mut manager, host_key(1, 2), (1, 0), video_config());
+        let cleanup = manager.close_retired_host_images(1);
+        assert_eq!(cleanup.videos.len(), 1);
+        assert!(!manager.video_streams.contains_key(&host_key(1, 1)));
+        assert!(manager.video_streams.contains_key(&host_key(1, 2)));
+        // Its guest's subscription, released later, finds nothing.
+        assert!(manager.take_video_if_last(&host_key(1, 1), true).is_none());
+
+        // Without a newer one running, nothing is older: kept.
+        let mut manager = AVServicesManager::default();
+        insert_stream(&mut manager, host_key(1, 1), (0, 2), video_config());
+        manager.host_generations.insert(1, 2);
+        assert!(!manager.is_retired_host_key(&host_key(1, 1)));
+        assert!(manager.close_retired_host_images(1).is_empty());
+        assert!(manager.video_streams.contains_key(&host_key(1, 1)));
+    }
+
+    #[test]
+    fn images_made_from_an_old_display_mode_are_not_offered() {
+        let mut manager = AVServicesManager::default();
+        let old = guest_key(1, 1920, 1080, 60);
+        insert_stream(&mut manager, old.clone(), (0, 2), video_config());
+        let qhd = Mode {
+            width: 2560,
+            height: 1440,
+            fps: 144,
+        };
+        assert_eq!(manager.open_guest_images(1, SCREEN).len(), 1);
+        assert!(manager.open_guest_images(1, qhd).is_empty());
+        // It still runs: counted, unless all its guests are moving off it
+        // (the display changed mode).
+        assert_eq!(manager.guest_slots_used(None, None), 1);
+        assert_eq!(manager.guest_slots_used(None, Some((1, qhd))), 0);
+        assert_eq!(manager.guest_slots_used(None, Some((1, SCREEN))), 1);
+        assert_eq!(manager.guest_slots_used(None, Some((2, qhd))), 1);
+    }
+
+    #[test]
+    fn guest_images_follow_the_host_bitrate_within_their_ceiling() {
+        let mut manager = AVServicesManager::default();
+        let host = host_key(1, 1);
+        let p1080 = guest_key(1, 1920, 1080, 60);
+        let p720 = guest_key(1, 1280, 720, 30);
+        let elsewhere = guest_key(2, 1280, 720, 30);
+        insert_stream(&mut manager, host.clone(), (1, 0), with_bitrate(10_000_000));
+        for (key, ceiling) in [
+            (&p1080, 16_000_000),
+            (&p720, 6_000_000),
+            (&elsewhere, 6_000_000),
+        ] {
+            insert_stream(&mut manager, key.clone(), (0, 1), with_bitrate(ceiling));
+            manager.video_streams.get_mut(key).unwrap().ceiling = ceiling;
+        }
+
+        manager.cap_guest_images(1);
+        let bitrate =
+            |m: &AVServicesManager, key: &VideoStreamKey| m.video_streams[key].config.bitrate;
+        assert_eq!(bitrate(&manager, &p1080), 10_000_000);
+        assert_eq!(bitrate(&manager, &p720), 6_000_000);
+
+        // The host's bitrate up again: back to their ceiling.
+        manager.video_streams.get_mut(&host).unwrap().config.bitrate = 40_000_000;
+        manager.cap_guest_images(1);
+        assert_eq!(bitrate(&manager, &p1080), 16_000_000);
+
+        // The host's bitrate changes only the images of its display.
+        manager.video_streams.get_mut(&host).unwrap().config.bitrate = 1_000_000;
+        manager.cap_guest_images(1);
+        assert_eq!(bitrate(&manager, &p720), 1_000_000);
+        assert_eq!(bitrate(&manager, &elsewhere), 6_000_000);
+
+        // Without a host image (a share from the computer): unchanged.
+        manager.cap_guest_images(2);
+        assert_eq!(bitrate(&manager, &elsewhere), 6_000_000);
+    }
 }
