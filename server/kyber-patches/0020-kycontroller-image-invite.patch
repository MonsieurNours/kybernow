+        let settle = Settle::default();
+        // A burst: only the last one goes through, once it settled.
+        let first = tokio::spawn(settle.arm());
+        tokio::time::sleep(Duration::from_millis(300)).await;
+        let second = tokio::spawn(settle.arm());
+        tokio::time::sleep(Duration::from_millis(300)).await;
+        let armed = tokio::time::Instant::now();
+        let last = tokio::spawn(settle.arm());
+        assert!(!first.await.unwrap());
+        assert!(!second.await.unwrap());
+        assert!(last.await.unwrap());
+        assert!(armed.elapsed() >= SCREEN_SETTLE);
+        // Announcements far apart each go through.
+        assert!(settle.arm().await);
+        assert!(settle.arm().await);
+    }
