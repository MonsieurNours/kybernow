+/// `/set_bitrate` from a share guest: only on images of its own that it
+/// is alone on, within its preset's ceiling and the host's bitrate.
+/// `false`: refused (403).
+pub(crate) async fn guest_set_bitrate(ctrl: &Controller, uid: &Uuid, bitrate: u32) -> bool {
+    let Ok(services) = ctrl.session_services(uid) else {
+        return false;
+    };
+    let services = services.lock().await;
+    let keys: Vec<&VideoStreamKey> = services
+        .guest_outputs
+        .iter()
+        .filter_map(|output| output.current.as_ref())
+        .collect();
+    let mut manager = ctrl.av_services_manager.lock().await;
+    let alone = |key: &VideoStreamKey| {
+        matches!(key, VideoStreamKey::Guest { .. })
+            && manager
+                .video_streams
+                .get(key)
+                .is_some_and(|stream| stream.client_count == 1)
+    };
+    if keys.is_empty()
+        || keys.len() != services.guest_outputs.len()
+        || !keys.iter().all(|k| alone(k))
+    {
+        return false;
+    }
+    for key in keys {
+        let host = manager
+            .current_host_key(key.display_id())
+            .and_then(|host| manager.video_streams.get(&host))
+            .map_or(u32::MAX, |host| host.config.bitrate);
+        let Some(stream) = manager.video_streams.get_mut(key) else {
+            continue;
+        };
+        stream.ceiling = stream.cap.min(bitrate);
+        let applied = stream.ceiling.min(host);
+        info!("Session {uid}: guest image {key:?} bitrate {applied}");
+        if let Err(err) = stream
+            .avservice
+            .video_set_bitrate(applied.min(i32::MAX as u32) as i32)
+        {
+            warn!("Failed to set bitrate: {err:?}");
+        }
+        stream.config.bitrate = applied;
+    }
+    true
+}
