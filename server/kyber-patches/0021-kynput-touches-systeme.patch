+        assert!(passes(&guest, &key(DEL, false)));
+        assert!(passes(&guest, &key(0x001d, false)));
+        assert!(passes(&guest, &key(KEY_L, true)));
+        assert!(passes(&guest, &key(KEY_L, false)));
+
+        // The host keeps them.
