+        assert!(passes(&host, &key(0x0038, true)));
+        assert!(passes(&host, &key(DEL, true)));
+        assert!(passes(&host, &key(0xe05b, true)));
+        assert!(passes(&host, &key(KEY_L, true)));
+    }
