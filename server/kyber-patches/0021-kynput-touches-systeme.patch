+    #[test]
+    fn system_shortcuts_are_the_hosts() {
+        let guest = ServerPipelineState::new(KEYBOARD);
+        // Ctrl+Alt+Del (either Ctrl, either Alt): the Del press stops, its
+        // release and the modifiers pass.
+        for (ctrl, alt) in [(0x001d, 0x0038), (0xe01d, 0xe038)] {
+            assert!(passes(&guest, &key(ctrl, true)));
+            assert!(passes(&guest, &key(alt, true)));
+            assert!(!passes(&guest, &key(DEL, true)));
+            assert!(passes(&guest, &key(DEL, false)));
+            assert!(passes(&guest, &key(alt, false)));
+            assert!(passes(&guest, &key(ctrl, false)));
+        }
+        // Win+L, either Win.
+        for win in WIN {
+            assert!(passes(&guest, &key(win, true)));
+            assert!(!passes(&guest, &key(KEY_L, true)));
+            assert!(passes(&guest, &key(KEY_L, false)));
+            assert!(passes(&guest, &key(win, false)));
+        }
+        // Del, Ctrl+Del, Alt+Del and L alone pass.
+        assert!(passes(&guest, &key(DEL, true)));
+        assert!(passes(&guest, &key(DEL, false)));
