 use session::identity::Identity;
@@ -581,6 +582,73 @@ pub(crate) async fn set_bitrate(
     HttpResponse::Ok().finish()
 }
 
+/// Shortest time between two keyframes forced for one session. A
+/// client that keeps losing packets would otherwise get an IDR per round trip,
+/// and on a shared stream every other client would pay for them too.
+const FORCE_IDR_MIN_INTERVAL: Duration = Duration::from_millis(150);
+
+/// The client's decoder lost a reference picture (packets lost
+/// beyond FEC). Under intra-refresh (the default) the encoder never sends a
+/// keyframe on its own, so the client asks for one. Same scoping as
+/// `set_bitrate`: only this session's video streams; the dispatcher collapses
+/// concurrent requests. A request within `FORCE_IDR_MIN_INTERVAL` of the last
+/// forced keyframe is ignored (still 200: the keyframe is on its way).
+#[post("/force_idr")]
+pub(crate) async fn force_idr(ctrl: web::Data<Controller>, user: Identity) -> HttpResponse {
+    let Ok(uid) = user.uid() else {
+        return HttpResponse::Unauthorized().finish();
+    };
+
+    // Checked and recorded under the sessions lock: of two concurrent
+    // requests, only one gets through.
+    let now = Instant::now();
+    let services = ctrl.with_session(&uid, |s| {
+        let recent = s
+            .last_force_idr
+            .is_some_and(|last| now.saturating_duration_since(last) < FORCE_IDR_MIN_INTERVAL);
+        if !recent {
+            s.last_force_idr = Some(now);
+        }
+        Ok((!recent).then(|| s.services.clone()))
+    });
+    let services = match services {
+        Ok(Some(s)) => s,
+        Ok(None) => {
+            debug!(
+                "Keyframe request ignored: one was forced less than {FORCE_IDR_MIN_INTERVAL:?} ago"
+            );
+            return HttpResponse::Ok().finish();
+        }
+        Err(err) => {
+            warn!("Session not found: {err}");
+            return HttpResponse::Forbidden().finish();
+        }
+    };
+
+    let mut services = services.lock().await;
+    debug!("Keyframe requested by the client");
+
+    if !services.video_subscriptions.is_empty() {
+        let av_services_manager = ctrl.av_services_manager.lock().await;
+        for sub in &services.video_subscriptions {
+            let Some(stream) = av_services_manager.video_streams.get(sub.key()) else {
+                continue;
+            };
+            if let Err(err) = stream.avservice.video_force_idr() {
+                warn!("Failed to force IDR: {err:?}");
+            }
+        }
+    } else {
+        for avserver in &mut services.video {
+            if let Err(err) = avserver.video_force_idr().await {
+                warn!("Failed to force IDR: {err:?}");
+            }
+        }
+    }
+
+    HttpResponse::Ok().finish()
+}
+
 fn create_listening_socket(config: &config::Config) -> std::io::Result<std::net::TcpListener> {
     use socket2::{Domain, Protocol, Socket, Type};
     use std::net::{IpAddr, Ipv4Addr, Ipv6Addr};
@@ -773,7 +841,8 @@ async fn real_main(config: config::Config) -> Result<()> {
                 .service(websocket_service)
                 .service(enumerate_displays)
                 .service(stop_streaming)
-                .service(set_bitrate);
+                .service(set_bitrate)
+                .service(force_idr);
 
             if let Some(webclient_root) = &webclient_root {
                 app.service(web::redirect("/webclient", "/webclient/"))

