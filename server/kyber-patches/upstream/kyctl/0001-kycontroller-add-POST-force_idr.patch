diff --git a/kycontroller/src/main.rs b/kycontroller/src/main.rs
index 9a65dad..a46a3ca 100644
--- a/kycontroller/src/main.rs
+++ b/kycontroller/src/main.rs
@@ -24,6 +24,7 @@ use std::net::SocketAddr;
 use std::path::PathBuf;
 use std::process::ExitCode;
 use std::sync::Arc;
+use std::time::{Duration, Instant};
 
 use actix_session::SessionMiddleware;
 use actix_session::storage::CookieSessionStore;
@@ -31,7 +32,7 @@ use actix_web::{
     App, HttpMessage, HttpRequest, HttpResponse, HttpServer, cookie, get, middleware, post, web,
 };
 use clap::Parser;
-use log::{error, info, warn};
+use log::{debug, error, info, warn};
 use log4ky::notice;
