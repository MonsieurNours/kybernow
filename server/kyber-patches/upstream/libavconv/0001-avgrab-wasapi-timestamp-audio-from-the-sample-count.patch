From 2a16491efa6266d0a2629800dcae3f81ef704830 Mon Sep 17 00:00:00 2001
From: Matthieu Requenna | MonsieurNours <matthieu.requenna@live.fr>
Date: Wed, 21 Oct 2026 00:24:23 +0200
Subject: [PATCH] avgrab/wasapi: timestamp audio from the sample count

avgrabi_capture_send_frame() stamped every frame with the time it was
sent downstream. WASAPI packets read in a burst (several per wake-up, or
after a scheduling delay) got almost the same timestamp, so audio went
backward in time for the encoder and the player.

Let a provider set its own timestamps (CAPTURE_SEND_PROVIDER_PTS, which
resolves the "allow using provider timestamps" TODO), and have the
WASAPI provider derive them from the number of samples captured since
the last synchronisation point. It resynchronises on the capture clock
reported by WASAPI (u64QPCPosition, the same QueryPerformanceCounter
clock as av_gettime_relative()) at the first packet, on a data
discontinuity, or when the two drift apart by more than 40 ms. The
arrival time is only used when WASAPI reports no valid position
(AUDCLNT_BUFFERFLAGS_TIMESTAMP_ERROR).

Also send zeros for packets flagged AUDCLNT_BUFFERFLAGS_SILENT: their
buffer content is undefined.
---
 libavgrab/avgrab.c   |  4 ++--
 libavgrab/internal.h |  3 +++
 libavgrab/wasapi.c   | 43 ++++++++++++++++++++++++++++++++++++++++---
 3 files changed, 45 insertions(+), 5 deletions(-)

diff --git a/libavgrab/avgrab.c b/libavgrab/avgrab.c
index 6b6538173b..546e1851f0 100644
--- a/libavgrab/avgrab.c
+++ b/libavgrab/avgrab.c
@@ -1195,8 +1195,8 @@ int avgrabi_capture_send_frame(GrabCapture *c, unsigned stream_idx,
     int hook_repeating = 0;
     int ret = 0;
 
-    // TODO allow using provider timestamps
-    frame->pts       = av_gettime_relative() - c->params.epoch;
+    if (!(flags & CAPTURE_SEND_PROVIDER_PTS))
+        frame->pts   = av_gettime_relative() - c->params.epoch;
     frame->time_base = AV_TIME_BASE_Q;
     if (frame->nb_samples && frame->sample_rate) {
         frame->duration = av_rescale_q(frame->nb_samples,
diff --git a/libavgrab/internal.h b/libavgrab/internal.h
index 0bef4a80e7..2c4542b946 100644
--- a/libavgrab/internal.h
+++ b/libavgrab/internal.h
@@ -189,6 +189,9 @@ int avgrabi_source_stream_add(GrabSource *src,
 
 enum CaptureSendFlags {
     CAPTURE_SEND_HEARTBEAT      = (1 << 0),
+    /* frame->pts is set by the provider, in AV_TIME_BASE_Q and relative to
+     * params.epoch: keep it. */
+    CAPTURE_SEND_PROVIDER_PTS   = (1 << 1),
 };
 
 int avgrabi_capture_send_frame(GrabCapture *c, unsigned stream_idx,
diff --git a/libavgrab/wasapi.c b/libavgrab/wasapi.c
index 0d16aa4c14..e42fd784bb 100644
--- a/libavgrab/wasapi.c
+++ b/libavgrab/wasapi.c
@@ -9,6 +9,7 @@
  */
 
 #include <stdatomic.h>
+#include <stdlib.h>
 
 #define COBJMACROS
 #define CONST_VTABLE
@@ -27,6 +28,7 @@
 #include <libavutil/error.h>
 #include <libavutil/frame.h>
 #include <libavutil/log.h>
+#include <libavutil/mathematics.h>
 #include <libavutil/mem.h>
 #include <libavutil/samplefmt.h>
 #include <libavutil/time.h>
@@ -57,8 +59,19 @@ typedef struct WasapiCapture {
     int                         sample_rate;
     int                         block_align;
     AVChannelLayout             ch_layout;
+
+    /* Timestamps follow the sample count, resynchronised on the capture
+     * clock when they drift from it. The arrival time gave packets read in
+     * a burst almost the same timestamp, which went backward in time for
+     * the encoder and the player. */
+    int64_t                     sync_pts;     /* us, first sample since the last sync */
+    int64_t                     sync_samples; /* samples captured since the last sync */
+    int                         synced;
 } WasapiCapture;
 
+/* Largest drift from the capture clock before resynchronising. */
+#define WASAPI_RESYNC_US 40000
+
 static void wasapi_capture_uninit(GrabCapture *c)
 {
     WasapiCapture *priv = c->priv;
@@ -251,8 +264,9 @@ static int wasapi_capture_thread(GrabCapture *c)
         if (atomic_load(&c->quit))
             break;
 
+        UINT64 qpc = 0;
         hr = IAudioCaptureClient_GetBuffer(priv->capture, &buf, &nb_samples,
-                                           &flags, NULL, NULL);
+                                           &flags, NULL, &qpc);
         if (hr == AUDCLNT_S_BUFFER_EMPTY) {
             // XXX make this interruptible
             DWORD wait = WaitForSingleObject(priv->event, INFINITE);
@@ -275,11 +289,34 @@ static int wasapi_capture_thread(GrabCapture *c)
             goto finish;
         }
 
-        memcpy(frame->data[0], buf, nb_samples * priv->block_align);
+        /* The buffer of a silent packet is undefined: send zeros. */
+        if (flags & AUDCLNT_BUFFERFLAGS_SILENT)
+            memset(frame->data[0], 0, nb_samples * priv->block_align);
+        else
+            memcpy(frame->data[0], buf, nb_samples * priv->block_align);
 
         IAudioCaptureClient_ReleaseBuffer(priv->capture, nb_samples);
 
-        ret = avgrabi_capture_send_frame(c, 0, frame, 0);
+        {
+            /* u64QPCPosition is in 100 ns units, on the same clock as
+             * av_gettime_relative() (QueryPerformanceCounter). */
+            int qpc_valid = qpc && !(flags & AUDCLNT_BUFFERFLAGS_TIMESTAMP_ERROR);
+            int64_t captured = qpc_valid ? (int64_t)(qpc / 10) - c->params.epoch
+                                         : av_gettime_relative() - c->params.epoch;
+            int64_t expected = priv->sync_pts +
+                               av_rescale(priv->sync_samples, 1000000, priv->sample_rate);
+            if (!priv->synced || (flags & AUDCLNT_BUFFERFLAGS_DATA_DISCONTINUITY) ||
+                llabs(captured - expected) > WASAPI_RESYNC_US) {
+                priv->sync_pts     = captured;
+                priv->sync_samples = 0;
+                priv->synced       = 1;
+                expected           = captured;
+            }
+            frame->pts = expected;
+            priv->sync_samples += nb_samples;
+        }
+
+        ret = avgrabi_capture_send_frame(c, 0, frame, CAPTURE_SEND_PROVIDER_PTS);
         if (ret < 0) {
             if (ret != AVERROR_EOF && ret != AVERROR_EXIT)
                 av_log(c, AV_LOG_ERROR, "Unable to send a frame downstream: %s\n",

