+/// How each connection queues the datagrams it sends (video, and audio over an
+/// unreliable protocol), selected by `datagram_send_queue`.
+///
+/// quinn drops the oldest queued datagrams once the queue is full. A deep
+/// queue rides out large frames (keyframes, 4K) while pacing spreads them out,
+/// but when the path is congested it can hold seconds of stale frames. A short
+/// queue bounds that delay: under congestion the oldest frames are dropped
+/// instead, and the client asks for a keyframe.
+#[derive(Debug, Clone, Copy, Default, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum DatagramSendQueue {
+    /// 8 MiB: about a second of 4K video at 60 Mbit/s.
+    #[default]
+    Deep,
+    /// 3 MiB: about three of the largest 4K frames (a keyframe with its FEC
+    /// repair symbols is up to about 1 MiB).
+    Short,
+}
+
+impl DatagramSendQueue {
+    pub(crate) const fn default_size(self) -> usize {
+        match self {
+            Self::Deep => 8 << 20,
+            Self::Short => 3 << 20,
+        }
+    }
+}
+
+/// Smallest accepted `datagram_send_queue_size`: one full-size datagram must fit.
+const MIN_DATAGRAM_SEND_QUEUE_SIZE: usize = 64 << 10;
+
 /// Concurrency model selected by the `multi_client` config flag.
 ///
 /// `Multi` (default, `multi_client = true`): many concurrent clients share
@@ -69,6 +100,9 @@ pub(crate) struct Config {
     security: crate::security::Config,
     watchdog: Option<bool>,
     multi_client: Option<bool>,
+    datagram_send_queue: Option<DatagramSendQueue>,
+    /// Overrides the size of the `datagram_send_queue` policy, in bytes.
+    datagram_send_queue_size: Option<usize>,
     webclient: Option<String>,
     /// Read from the top-level [kyhub] section by `from_table`.
     #[cfg(feature = "kyhub")]
@@ -124,6 +158,16 @@ impl Config {
         }
     }
 
+    /// Outgoing datagram queue policy and its size in bytes.
+    pub(crate) fn datagram_send_queue(&self) -> (DatagramSendQueue, usize) {
+        let policy = self.datagram_send_queue.unwrap_or_default();
+        let size = self
+            .datagram_send_queue_size
+            .map(|size| size.max(MIN_DATAGRAM_SEND_QUEUE_SIZE))
+            .unwrap_or(policy.default_size());
+        (policy, size)
+    }
+
     pub(crate) fn webclient(&self) -> Option<&str> {
         self.webclient.as_deref()
     }
