+/// KyberNow: KyberNow Share claims.
+#[cfg(test)]
+mod tests {
+    use jsonwebtoken::{EncodingKey, Header, encode};
+
+    use super::*;
+
+    fn authenticate(claims: serde_json::Value) -> Result<Session, Error> {
+        let mut claims = claims;
+        claims["aud"] = "kyber".into();
+        claims["exp"] = (OffsetDateTime::now_utc().unix_timestamp() + 60).into();
+        let token = encode(
+            &Header::default(),
+            &claims,
+            &EncodingKey::from_secret(b"kyber-authentication-development-key"),
+        )
+        .unwrap();
+        Jwt::new(&Config::default()).authenticate(&token)
+    }
+
+    #[test]
+    fn a_token_without_share_claims_is_the_host() {
+        let session = authenticate(serde_json::json!({"sub": "matthieu"})).unwrap();
+        assert_eq!(session.share, None);
+        assert!(!session.admin);
+    }
+
+    #[test]
+    fn a_guest_token_carries_its_role_display_and_revision() {
+        let session = authenticate(serde_json::json!({
+            "sub": "kn-guest-1",
+            "kn_role": "player_kbm",
+            "kn_display": 2221634456u32,
+            "kn_rev": 3,
+        }))
+        .unwrap();
+        assert_eq!(
+            session.share,
+            Some(GuestShare {
+                role: ShareRole::PlayerKbm,
+                display: 2221634456,
+                rev: 3,
+            })
+        );
+        assert!(!session.admin);
+    }
+
+    #[test]
+    fn keyboard_and_mouse_without_gamepads_is_a_role() {
+        let session = authenticate(serde_json::json!({
+            "sub": "kn-guest-1",
+            "kn_role": "kbm",
+            "kn_display": 7,
+            "kn_rev": 2,
+        }))
+        .unwrap();
+        assert_eq!(session.share.map(|s| s.role), Some(ShareRole::Kbm));
+    }
+
+    #[test]
+    fn an_unknown_role_or_a_role_without_display_is_refused() {
+        let unknown = authenticate(serde_json::json!({
+            "sub": "kn-guest-1",
+            "kn_role": "owner",
+            "kn_display": 1,
+        }));
+        assert!(unknown.is_err());
+
+        let no_display = authenticate(serde_json::json!({
+            "sub": "kn-guest-1",
+            "kn_role": "spectator",
+        }));
+        assert!(matches!(no_display, Err(Error::MissingField { .. })));
+    }
+
+    #[test]
+    fn the_admin_token_is_flagged() {
+        let session = authenticate(serde_json::json!({
+            "sub": "kybernow-admin",
+            "kn_admin": true,
+        }))
+        .unwrap();
+        assert!(session.admin);
+        assert_eq!(session.share, None);
+    }
+}
