diff --git a/kycontroller/src/kybernow.rs b/kycontroller/src/kybernow.rs
new file mode 100644
index 0000000..4c9696c
--- /dev/null
+++ b/kycontroller/src/kybernow.rs
@@ -0,0 +1,631 @@
+// KyberNow: KyberNow Share, local sharing. KyberNow Admin, which holds the
+// JWT key, gives each guest a short token (`kn_role`, `kn_display`,
+// `kn_rev`) renewed through `/session/renew`, and drives Kyber through the
+// `/kybernow` routes with its own token (`kn_admin`). A session without
+// `kn_role` is the host's: nothing changes for it.
+
+use std::collections::HashMap;
+use std::net::IpAddr;
+use std::time::{Duration, Instant};
+
+use actix_web::{HttpRequest, HttpResponse, get, http::header, post, web};
+use kyavservice_types::VideoCodec;
+use kynputservice_types::InputRights;
+use log::{info, warn};
+use serde::{Deserialize, Serialize, de::DeserializeOwned};
+use uuid::Uuid;
+
+use crate::auth::{self, GuestShare, ShareRole};
+use crate::avservices_manager::VideoStreamKey;
+use crate::controller::{ClientSession, Controller, SessionEndReason};
+
+/// How long a role is remembered: longer than any token still valid (120 s).
+const ROLE_MEMORY: Duration = Duration::from_secs(10 * 60);
+/// Kyber sessions one guest may hold at once: one, plus one while it
+/// reconnects. Each session has its own input server, so a guest token
+/// must not open them without end.
+pub(crate) const MAX_GUEST_SESSIONS: usize = 2;
+
+/// Why a login is refused (`Controller::insert_session`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Refused {
+    /// Closed by KyberNow Admin (`/kybernow/close`), until its ban ends.
+    Banned,
+    /// A guest that already holds `MAX_GUEST_SESSIONS` sessions.
+    TooManySessions,
+}
+
+/// Whether one more session of `newcomer` would be one too many: a guest
+/// (with a share) already holding `MAX_GUEST_SESSIONS` sessions. Never the
+/// host.
+pub(crate) fn too_many_sessions<'a>(
+    sessions: impl Iterator<Item = &'a ClientSession>,
+    newcomer: &ClientSession,
+) -> bool {
+    newcomer.share.is_some()
+        && sessions
+            .filter(|s| s.username == newcomer.username)
+            .count()
+            >= MAX_GUEST_SESSIONS
+}
+
+/// `/kybernow/close`: default and longest ban, in seconds.
+const DEFAULT_BAN_SECONDS: u64 = 130;
+const MAX_BAN_SECONDS: u64 = 600;
+
+/// The latest role of each guest (`sub`) and the closed guests' bans, kept
+/// even without a session. Small: stale entries go at each change.
+#[derive(Default)]
+pub(crate) struct ShareMemory {
+    /// Revision, role, and when it was recorded.
+    roles: HashMap<String, (u64, ShareRole, Instant)>,
+    /// End of the ban.
+    bans: HashMap<String, Instant>,
+}
+
+impl ShareMemory {
+    fn prune(&mut self, now: Instant) {
+        self.roles
+            .retain(|_, (_, _, at)| now.saturating_duration_since(*at) < ROLE_MEMORY);
+        self.bans.retain(|_, until| *until > now);
+    }
+
+    /// Keeps the role with the highest revision.
+    pub(crate) fn remember(&mut self, user: &str, rev: u64, role: ShareRole) {
+        let now = Instant::now();
+        self.prune(now);
+        if self
+            .roles
+            .get(user)
+            .is_none_or(|(known, _, _)| rev > *known)
+        {
+            self.roles.insert(user.to_owned(), (rev, role, now));
+        }
+    }
+
+    pub(crate) fn ban(&mut self, user: &str, duration: Duration) {
+        let now = Instant::now();
+        self.prune(now);
+        self.bans.insert(user.to_owned(), now + duration);
+    }
+
+    pub(crate) fn is_banned(&mut self, user: &str) -> bool {
+        self.prune(Instant::now());
+        self.bans.contains_key(user)
+    }
+
+    /// Login: refused (`false`) while the user is banned. A role remembered
+    /// with a newer revision than the token's replaces it.
+    pub(crate) fn admit(&mut self, session: &mut ClientSession) -> bool {
+        if self.is_banned(&session.username) {
+            warn!(
+                "Refusing login for \"{}\": closed by KyberNow Admin",
+                session.username
+            );
+            return false;
+        }
+
+        if let Some(share) = &mut session.share
+            && let Some((rev, role, _)) = self.roles.get(&session.username)
+            && *rev > share.rev
+        {
+            info!(
+                "\"{}\" logs in as {role:?} (rev {rev}), not {:?} (rev {})",
+                session.username, share.role, share.rev
+            );
+            share.role = *role;
+            share.rev = *rev;
+        }
+        true
+    }
+}
+
+/// The input rights of a role: gamepads and keyboard-and-mouse are two
+/// independent rights; never the clipboard for a guest.
+pub(crate) fn role_rights(role: ShareRole) -> InputRights {
+    InputRights {
+        keyboard_mouse: matches!(role, ShareRole::Kbm | ShareRole::PlayerKbm),
+        gamepads: matches!(role, ShareRole::Player | ShareRole::PlayerKbm),
+        clipboard: false,
+    }
+}
+
+/// `None` for the host (everything).
+pub(crate) fn input_rights(share: Option<&GuestShare>) -> Option<InputRights> {
+    share.map(|share| role_rights(share.role))
+}
+
+/// Whether a session sees this display: a guest only sees its own.
+pub(crate) fn shows(share: Option<&GuestShare>, display_id: u32) -> bool {
+    share.is_none_or(|share| share.display == display_id)
+}
+
+/// The display imposed on a guest session; `None` for the host (or a
+/// session that is gone).
+pub(crate) fn guest_display(ctrl: &Controller, uid: &Uuid) -> Option<u32> {
+    ctrl.with_session(uid, |s| Ok(s.share.as_ref().map(|share| share.display)))
+        .ok()
+        .flatten()
+}
+
+pub(crate) fn is_guest(ctrl: &Controller, uid: &Uuid) -> bool {
+    guest_display(ctrl, uid).is_some()
+}
+
+/// Gives a guest session a role of a newer revision (its display stays).
+/// `false` for the host or an older or equal revision: a token still valid
+/// never gives back a withdrawn right.
+pub(crate) fn update_role(session: &mut ClientSession, rev: u64, role: ShareRole) -> bool {
+    match &mut session.share {
+        Some(share) if rev > share.rev => {
+            share.rev = rev;
+            share.role = role;
+            true
+        }
+        _ => false,
+    }
+}
+
+/// Brings the session's input server in line with its current role,
+/// without touching the image. The role is read under the services lock, as
+/// at the start of a session: of a start and a role change, the last one
+/// applies the latest role.
+pub(crate) async fn apply_input_rights(ctrl: &Controller, uid: &Uuid) {
+    let Ok(services) = ctrl.session_services(uid) else {
+        return;
+    };
+    let mut services = services.lock().await;
+
+    let Ok(Some(rights)) = ctrl.with_session(uid, |s| Ok(input_rights(s.share.as_ref()))) else {
+        return;
+    };
+    if services.input_rights == Some(rights) {
+        return;
+    }
+    let Some(input) = services.input.as_mut() else {
+        return;
+    };
+
+    match input.set_rights(rights).await {
+        Ok(()) => {
+            info!("Session {uid}: input rights {rights:?}");
+            services.input_rights = Some(rights);
+        }
+        Err(err) => warn!("Session {uid}: failed to set input rights: {err:?}"),
+    }
+}
+
+fn from_loopback(req: &HttpRequest) -> bool {
+    req.peer_addr().is_some_and(|peer| match peer.ip() {
+        IpAddr::V4(v4) => v4.is_loopback(),
+        // A dual-stack listener reports 127.0.0.1 as ::ffff:127.0.0.1.
+        IpAddr::V6(v6) => {
+            v6.is_loopback() || v6.to_ipv4_mapped().is_some_and(|v4| v4.is_loopback())
+        }
+    })
+}
+
+/// KyberNow Admin only: from this computer (403), with its own token (401).
+fn admin_refusal(req: &HttpRequest) -> Option<HttpResponse> {
+    if !from_loopback(req) {
+        warn!("/kybernow refused to {:?}: not local", req.peer_addr());
+        return Some(HttpResponse::Forbidden().finish());
+    }
+
+    let admin = req
+        .headers()
+        .get(header::AUTHORIZATION)
+        .and_then(|h| auth::AuthorizationHeader::from_header(h, None))
+        .and_then(|h| Some((auth::registry().backend(h.kind)?, h.creds)))
+        .is_some_and(|(backend, creds)| backend.authenticate(creds).is_ok_and(|s| s.admin));
+    if !admin {
+        warn!("/kybernow refused: no valid KyberNow Admin token");
+        return Some(HttpResponse::Unauthorized().finish());
+    }
+
+    None
+}
+
+/// The body is only read once the caller is known to be KyberNow Admin.
+fn admin_request<T: DeserializeOwned>(req: &HttpRequest, body: &[u8]) -> Result<T, HttpResponse> {
+    if let Some(refusal) = admin_refusal(req) {
+        return Err(refusal);
+    }
+    serde_json::from_slice(body).map_err(|err| {
+        warn!("/kybernow: invalid request: {err}");
+        HttpResponse::BadRequest().finish()
+    })
+}
+
+#[derive(Serialize)]
+struct SessionEntry {
+    uid: Uuid,
+    user: String,
+    role: Option<ShareRole>,
+    display: Option<u32>,
+    streaming: bool,
+    inputs: bool,
+}
+
+#[derive(Serialize)]
+struct StreamEntry {
+    display: u32,
+    codec: &'static str,
+    yuv444: bool,
+}
+
+#[derive(Serialize)]
+struct SessionsResponse {
+    sessions: Vec<SessionEntry>,
+    streams: Vec<StreamEntry>,
+}
+
+fn codec_name(codec: &VideoCodec) -> &'static str {
+    match codec {
+        VideoCodec::H264 => "h264",
+        VideoCodec::HEVC => "hevc",
+        VideoCodec::AV1 => "av1",
+    }
+}
+
+/// `GET /kybernow/sessions`: every session, and the shared video streams.
+#[get("/sessions")]
+pub(crate) async fn get_sessions(ctrl: web::Data<Controller>, req: HttpRequest) -> HttpResponse {
+    if let Some(refusal) = admin_refusal(&req) {
+        return refusal;
+    }
+
+    let listed: Vec<_> = ctrl
+        .sessions
+        .lock()
+        .unwrap()
+        .values()
+        .map(|s| {
+            let entry = SessionEntry {
+                uid: s.uid,
+                user: s.username.clone(),
+                role: s.share.as_ref().map(|share| share.role),
+                display: s.share.as_ref().map(|share| share.display),
+                streaming: s.session.as_ref().is_some_and(|s| s.data_plane.is_some()),
+                inputs: false,
+            };
+            (entry, s.services.clone())
+        })
+        .collect();
+
+    let mut sessions = Vec::with_capacity(listed.len());
+    for (mut entry, services) in listed {
+        entry.inputs = services.lock().await.input.is_some();
+        sessions.push(entry);
+    }
+
+    let streams = ctrl
+        .av_services_manager
+        .lock()
+        .await
+        .video_streams
+        .iter()
+        .filter_map(|(key, stream)| match key {
+            VideoStreamKey::Shared { display_id } => Some(StreamEntry {
+                display: *display_id,
+                codec: codec_name(&stream.config.codec),
+                yuv444: stream.config.yuv444,
+            }),
+            VideoStreamKey::Exclusive { .. } => None,
+        })
+        .collect();
+
+    HttpResponse::Ok().json(SessionsResponse { sessions, streams })
+}
+
+#[derive(Deserialize)]
+struct RoleRequest {
+    user: String,
+    role: ShareRole,
+    rev: u64,
+}
+
+/// `POST /kybernow/role`: a guest's new role, for its sessions (newer
+/// revision only) and its next logins.
+#[post("/role")]
+pub(crate) async fn post_role(
+    ctrl: web::Data<Controller>,
+    req: HttpRequest,
+    body: web::Bytes,
+) -> HttpResponse {
+    let RoleRequest { user, role, rev } = match admin_request(&req, &body) {
+        Ok(request) => request,
+        Err(refusal) => return refusal,
+    };
+
+    // Recorded before going through the sessions: a login running now
+    // either reads it or is among them (see `Controller::insert_session`).
+    ctrl.share_memory.lock().unwrap().remember(&user, rev, role);
+
+    let updated: Vec<Uuid> = ctrl
+        .sessions
+        .lock()
+        .unwrap()
+        .values_mut()
+        .filter(|s| s.username == user)
+        .filter_map(|s| update_role(s, rev, role).then_some(s.uid))
+        .collect();
+    info!(
+        "\"{user}\" is now {role:?} (rev {rev}): {} sessions",
+        updated.len()
+    );
+
+    // The image goes on; only the inputs change.
+    for uid in &updated {
+        apply_input_rights(&ctrl, uid).await;
+    }
+
+    HttpResponse::Ok().json(serde_json::json!({ "sessions": updated.len() }))
+}
+
+#[derive(Deserialize)]
+struct CloseRequest {
+    user: String,
+    ban_seconds: Option<u64>,
+}
+
+/// `POST /kybernow/close`: closes every session of a guest now, and refuses
+/// its logins and renewals for a while.
+#[post("/close")]
+pub(crate) async fn post_close(
+    ctrl: web::Data<Controller>,
+    req: HttpRequest,
+    body: web::Bytes,
+) -> HttpResponse {
+    let CloseRequest { user, ban_seconds } = match admin_request(&req, &body) {
+        Ok(request) => request,
+        Err(refusal) => return refusal,
+    };
+    let ban = Duration::from_secs(
+        ban_seconds
+            .unwrap_or(DEFAULT_BAN_SECONDS)
+            .min(MAX_BAN_SECONDS),
+    );
+
+    // Banned first: a login running now is refused, or closed below.
+    ctrl.share_memory.lock().unwrap().ban(&user, ban);
+
+    // The input servers go first: what the guest holds is released (every
+    // right withdrawn, answered once done) before they stop.
+    let services: Vec<_> = ctrl
+        .sessions
+        .lock()
+        .unwrap()
+        .values()
+        .filter(|s| s.username == user)
+        .map(|s| s.services.clone())
+        .collect();
+    for services in services {
+        let input = services.lock().await.input.take();
+        if let Some(mut input) = input {
+            if let Err(err) = input.set_rights(InputRights::NONE).await {
+                warn!("Failed to release the inputs of \"{user}\": {err:?}");
+            }
+            if let Err(err) = input.stop().await {
+                warn!("Failed to stop the input server of \"{user}\": {err:?}");
+            }
+        }
+    }
+
+    // Then as an expired session: image and sound released (their encoder
+    // stops with its last viewer), control and data planes dropped.
+    let mut closed = 0;
+    ctrl.remove_sessions_if(
+        |s| {
+            let matches = s.username == user;
+            closed += usize::from(matches);
+            matches
+        },
+        SessionEndReason::UserLogout,
+    )
+    .await;
+    info!("Closed {closed} sessions of \"{user}\", banned for {ban:?}");
+
+    HttpResponse::Ok().json(serde_json::json!({ "closed": closed }))
+}
