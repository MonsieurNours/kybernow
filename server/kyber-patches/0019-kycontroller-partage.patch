+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn session(user: &str, share: Option<GuestShare>) -> ClientSession {
+        ClientSession::new(
+            Uuid::new_v4(),
+            auth::Session {
+                username: user.to_owned(),
+                sub: Some(user.to_owned()),
+                expiration: None,
+                share,
+                admin: false,
+            },
+        )
+    }
+
+    fn guest(role: ShareRole, rev: u64) -> Option<GuestShare> {
+        Some(GuestShare {
+            role,
+            display: 7,
+            rev,
+        })
+    }
+
+    #[test]
+    fn roles_give_their_rights() {
+        assert_eq!(role_rights(ShareRole::Spectator), InputRights::NONE);
+        assert_eq!(
+            role_rights(ShareRole::Player),
+            InputRights {
+                keyboard_mouse: false,
+                gamepads: true,
+                clipboard: false,
+            }
+        );
+        assert_eq!(
+            role_rights(ShareRole::Kbm),
+            InputRights {
+                keyboard_mouse: true,
+                gamepads: false,
+                clipboard: false,
+            }
+        );
+        assert_eq!(
+            role_rights(ShareRole::PlayerKbm),
+            InputRights {
+                keyboard_mouse: true,
+                gamepads: true,
+                clipboard: false,
+            }
+        );
+        assert_eq!(input_rights(None), None);
+    }
+
+    #[test]
+    fn a_guest_only_sees_its_display() {
+        let share = guest(ShareRole::Spectator, 0);
+        assert!(shows(share.as_ref(), 7));
+        assert!(!shows(share.as_ref(), 8));
+        assert!(shows(None, 8));
+    }
+
+    #[test]
+    fn only_a_newer_revision_changes_the_role() {
+        let mut s = session("kn-guest-1", guest(ShareRole::Player, 3));
+        assert!(!update_role(&mut s, 3, ShareRole::PlayerKbm));
+        assert!(!update_role(&mut s, 2, ShareRole::PlayerKbm));
+        assert!(update_role(&mut s, 4, ShareRole::Spectator));
+        assert_eq!(s.share, guest(ShareRole::Spectator, 4));
+
+        let mut host = session("matthieu", None);
+        assert!(!update_role(&mut host, 9, ShareRole::Spectator));
+        assert_eq!(host.share, None);
+    }
+
+    #[test]
+    fn a_pushed_role_wins_over_an_older_token_at_login() {
+        let mut memory = ShareMemory::default();
+        memory.remember("kn-guest-1", 5, ShareRole::Spectator);
+        memory.remember("kn-guest-1", 4, ShareRole::PlayerKbm);
+
+        let mut old_token = session("kn-guest-1", guest(ShareRole::PlayerKbm, 4));
+        assert!(memory.admit(&mut old_token));
+        assert_eq!(old_token.share, guest(ShareRole::Spectator, 5));
+
+        let mut newer_token = session("kn-guest-1", guest(ShareRole::Player, 6));
+        assert!(memory.admit(&mut newer_token));
+        assert_eq!(newer_token.share, guest(ShareRole::Player, 6));
+
+        let mut host = session("kn-guest-1", None);
+        assert!(memory.admit(&mut host));
+        assert_eq!(host.share, None);
+    }
+
+    #[test]
+    fn a_guest_holds_two_sessions_at_most() {
+        let lea = || session("kn-guest-1", guest(ShareRole::Spectator, 1));
+        let one = [lea()];
+        let two = [lea(), lea()];
+        assert!(!too_many_sessions(one.iter(), &lea()));
+        assert!(too_many_sessions(two.iter(), &lea()));
+        // Another guest, and the host, are not counted against it.
+        let max = session("kn-guest-2", guest(ShareRole::Player, 1));
+        assert!(!too_many_sessions(two.iter(), &max));
+        let hosts = [session("matthieu", None), session("matthieu", None)];
+        assert!(!too_many_sessions(hosts.iter(), &session("matthieu", None)));
+    }
+
+    #[test]
+    fn a_closed_user_is_refused_until_its_ban_ends() {
+        let mut memory = ShareMemory::default();
+        memory.ban("kn-guest-1", Duration::from_secs(60));
+        assert!(!memory.admit(&mut session("kn-guest-1", guest(ShareRole::Player, 1))));
+        assert!(memory.admit(&mut session("kn-guest-2", guest(ShareRole::Player, 1))));
+
+        memory.ban("kn-guest-1", Duration::ZERO);
+        assert!(!memory.is_banned("kn-guest-1"));
+        assert!(memory.bans.is_empty());
+    }
+
+    #[test]
+    fn the_memory_forgets_stale_roles() {
+        let mut memory = ShareMemory::default();
+        memory.remember("kn-guest-1", 1, ShareRole::Player);
+        let later = Instant::now() + ROLE_MEMORY + Duration::from_secs(1);
+        memory.prune(later);
+        assert!(memory.roles.is_empty());
+    }
+
+    #[test]
+    fn only_this_computer_reaches_the_admin_routes() {
+        use actix_web::test::TestRequest;
+
+        let from = |peer: &str| {
+            TestRequest::default()
+                .peer_addr(peer.parse().unwrap())
+                .to_http_request()
+        };
+        assert!(from_loopback(&from("127.0.0.1:5000")));
+        assert!(from_loopback(&from("[::1]:5000")));
+        assert!(from_loopback(&from("[::ffff:127.0.0.1]:5000")));
+        assert!(!from_loopback(&from("192.168.1.20:5000")));
+        assert!(!from_loopback(&from("[::ffff:192.168.1.20]:5000")));
+
+        let refusal = admin_refusal(&from("192.168.1.20:5000"));
+        assert_eq!(
+            refusal.map(|r| r.status()),
+            Some(actix_web::http::StatusCode::FORBIDDEN)
+        );
+    }
+
+    #[cfg(feature = "auth-jwt")]
+    #[test]
+    fn the_admin_routes_need_the_admin_token() {
+        use actix_web::http::StatusCode;
+        use actix_web::test::TestRequest;
+        use jsonwebtoken::{EncodingKey, Header, encode};
+
+        static AUTH: std::sync::Once = std::sync::Once::new();
+        AUTH.call_once(|| {
+            actix_web::rt::System::new()
+                .block_on(auth::init(&auth::Config::default()))
+                .unwrap();
+        });
+
+        let token = |claims: serde_json::Value| {
+            let mut claims = claims;
+            claims["aud"] = "kyber".into();
+            claims["exp"] = (time::OffsetDateTime::now_utc().unix_timestamp() + 60).into();
+            encode(
+                &Header::default(),
+                &claims,
+                &EncodingKey::from_secret(b"kyber-authentication-development-key"),
+            )
+            .unwrap()
+        };
+        let status = |authorization: Option<String>| {
+            let mut req = TestRequest::default().peer_addr("127.0.0.1:5000".parse().unwrap());
+            if let Some(authorization) = authorization {
+                req = req.insert_header((header::AUTHORIZATION, authorization));
+            }
+            admin_refusal(&req.to_http_request()).map(|r| r.status())
+        };
+
+        let admin = token(serde_json::json!({"sub": "kybernow-admin", "kn_admin": true}));
+        assert_eq!(status(Some(format!("Bearer {admin}"))), None);
+
+        let guest = token(serde_json::json!({
+            "sub": "kn-guest-1",
+            "kn_role": "player",
+            "kn_display": 1,
+        }));
+        assert_eq!(
+            status(Some(format!("Bearer {guest}"))),
+            Some(StatusCode::UNAUTHORIZED)
+        );
+        assert_eq!(status(None), Some(StatusCode::UNAUTHORIZED));
+    }
+}
