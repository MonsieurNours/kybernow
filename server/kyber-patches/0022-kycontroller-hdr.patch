diff --git a/kycontroller/src/hdr.rs b/kycontroller/src/hdr.rs
new file mode 100644
index 0000000..f9a197b
--- /dev/null
+++ b/kycontroller/src/hdr.rs
@@ -0,0 +1,90 @@
+// KyberNow (0022): HDR. The start request (`/start_session`) gives `hdr`
+// for each display, beside `yuv444`; kycontroller passes it to kyavserver
+// (`KymuxStartVideo`). The host's flag decides how the display is captured
+// (16-bit float or not); each client's flag says what it shows: a client
+// without HDR on a display captured in HDR gets an image of its own, brought
+// to SDR (patch 0020), a client with HDR shares the HDR image.
+//
+// `hdr` is read from the request's JSON here rather than from kyctl-common's
+// `StartRequestVideo`, which the apps' kyclient patch owns: a request without
+// it (an older app, the web client) is a request without HDR.
+
+use kyavservice_types::VideoCodec;
+use log::warn;
+
+/// The `hdr` flag of each `video` entry of a start request, in order;
+/// `false` when absent.
+pub(crate) fn requested(request: &serde_json::Value) -> Vec<bool> {
+    request
+        .get("video")
+        .and_then(serde_json::Value::as_array)
+        .map(|video| {
+            video
+                .iter()
+                .map(|v| {
+                    v.get("hdr")
+                        .and_then(serde_json::Value::as_bool)
+                        .unwrap_or(false)
+                })
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+/// Why `hdr` cannot be had with this format: H.264 and 4:4:4 have no HDR
+/// (kyavserver refuses the rest, x264 for one).
+pub(crate) fn refusal(codec: &VideoCodec, yuv444: bool) -> Option<&'static str> {
+    if *codec == VideoCodec::H264 {
+        Some("H.264 (HEVC or AV1 only)")
+    } else if yuv444 {
+        Some("4:4:4 (4:2:0 only)")
+    } else {
+        None
+    }
+}
+
+/// The HDR of a display's stream: what was asked, unless the format has
+/// none; then the display goes SDR, with a line in the log.
+pub(crate) fn accepted(display_id: u32, hdr: bool, codec: &VideoCodec, yuv444: bool) -> bool {
+    if !hdr {
+        return false;
+    }
+    match refusal(codec, yuv444) {
+        Some(reason) => {
+            warn!("HDR refused on display {display_id} with {reason}: SDR");
+            false
+        }
+        None => true,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn hdr_flags_in_order_absent_is_false() {
+        let request = serde_json::json!({
+            "bitrate": 1,
+            "video": [
+                { "display_id": 1, "codec": "HEVC", "yuv444": false, "hdr": true },
+                { "display_id": 2, "codec": "HEVC", "yuv444": false },
+                { "display_id": 3, "codec": "AV1", "yuv444": false, "hdr": false },
+                { "display_id": 4, "codec": "AV1", "yuv444": false, "hdr": "yes" },
+            ]
+        });
+        assert_eq!(requested(&request), vec![true, false, false, false]);
+        assert!(requested(&serde_json::json!({ "bitrate": 1 })).is_empty());
+        assert!(requested(&serde_json::json!({ "video": null })).is_empty());
+    }
+
+    #[test]
+    fn hdr_only_with_hevc_or_av1_in_420() {
+        assert!(accepted(1, true, &VideoCodec::HEVC, false));
+        assert!(accepted(1, true, &VideoCodec::AV1, false));
+        assert!(!accepted(1, true, &VideoCodec::H264, false));
+        assert!(!accepted(1, true, &VideoCodec::HEVC, true));
+        assert!(!accepted(1, false, &VideoCodec::HEVC, false));
+        assert_eq!(refusal(&VideoCodec::AV1, false), None);
+    }
+}
