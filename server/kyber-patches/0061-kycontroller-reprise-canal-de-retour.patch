+/// KyberNow (0061): the picture losses the feedback channel reports
+/// (`FeedbackEvent::Lost`, patch 0052) repaired at once, without waiting
+/// for the application to see them: the repair goes up to the frame before
+/// the first one lost (the encoder takes the newest it sent up to there).
+/// Only for a session with one video stream; the application's
+/// `/recover` stays the fallback, and the encoder drops the same request
+/// twice. Ends with the channel.
+pub(crate) async fn repair_on_loss(
+    ctrl: Arc<Controller>,
+    uid: Uuid,
+    mut lost: tokio::sync::broadcast::Receiver<kymux::kyproto::FeedbackEvent>,
+) {
+    use tokio::sync::broadcast::error::RecvError;
+    loop {
+        match lost.recv().await {
+            Ok(kymux::kyproto::FeedbackEvent::Lost { frames, .. }) => {
+                let Some(first) = frames.iter().map(|f| f.pts).min() else {
+                    continue;
+                };
+                debug!("Session {uid}: picture lost from {first}, repaired");
+                if !crate::repair(&ctrl, &uid, first.saturating_sub(1), true).await {
+                    return;
+                }
+            }
+            Ok(_) | Err(RecvError::Lagged(_)) => {}
+            Err(RecvError::Closed) => return,
+        }
+    }
+}
+
