diff --git a/kyclient/src/uplink.rs b/kyclient/src/uplink.rs
new file mode 100644
index 0000000..03a894c
--- /dev/null
+++ b/kyclient/src/uplink.rs
@@ -0,0 +1,281 @@
+// KyberNow (0085): upstream streams, from the app to the computer (camera,
+// microphone).
+//
+// The app says which kinds it can send (`Client::set_uplink_kinds`) before
+// starting the stream; the start request carries them in `uplink`, beside
+// kyctl-common's `StartRequest`. A Station that offers a kind answers with a
+// kyproto data endpoint for it (`uplink` of the response); this module
+// connects to each one and hands the app an `Uplink` (`Client::uplink`),
+// until the stream stops. An older Station answers without `uplink`: no
+// kind is offered.
+//
+// The packets themselves (START, MEDIA, PAUSE, STOP from the app, STATUS
+// from the computer) are the app's business; see kycontroller's `uplink.rs`.
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+
+use kymux::{kyproto, types};
+use log::{info, warn};
+use tokio::sync::mpsc;
+
+use crate::runtime;
+
+/// How many packets wait to go up at most: past it, `try_send` refuses
+/// (the app drops a frame rather than delaying everything else).
+const QUEUE: usize = 24;
+
+/// What `Uplink::try_send` did.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum UplinkSend {
+    Sent,
+    /// The queue is full: the network can't keep up.
+    Full,
+    /// The stream stopped, or the computer closed it.
+    Closed,
+}
+
+/// An upstream stream of one kind, for the duration of a stream.
+#[derive(Clone)]
+pub struct Uplink {
+    kind: String,
+    tx: mpsc::Sender<Vec<u8>>,
+    rx: Arc<Mutex<std::sync::mpsc::Receiver<Vec<u8>>>>,
+    closed: Arc<AtomicBool>,
+}
+
+impl Uplink {
+    pub fn kind(&self) -> &str {
+        &self.kind
+    }
+
+    /// Queues a packet; never waits.
+    pub fn try_send(&self, payload: Vec<u8>) -> UplinkSend {
+        if self.closed.load(Ordering::Relaxed) {
+            return UplinkSend::Closed;
+        }
+        match self.tx.try_send(payload) {
+            Ok(()) => UplinkSend::Sent,
+            Err(mpsc::error::TrySendError::Full(_)) => UplinkSend::Full,
+            Err(mpsc::error::TrySendError::Closed(_)) => UplinkSend::Closed,
+        }
+    }
+
+    /// The next packet from the computer, if any; never waits.
+    pub fn try_recv(&self) -> Option<Vec<u8>> {
+        self.rx.lock().ok()?.try_recv().ok()
+    }
+
+    pub fn is_closed(&self) -> bool {
+        self.closed.load(Ordering::Relaxed) || self.tx.is_closed()
+    }
+}
+
+/// The other end of an `Uplink` made by `Uplink::pair`.
+pub struct UplinkPeer {
+    /// What the app sent.
+    pub sent: mpsc::Receiver<Vec<u8>>,
+    /// What the computer answers.
+    pub answer: std::sync::mpsc::Sender<Vec<u8>>,
+    closed: Arc<AtomicBool>,
+}
+
+impl UplinkPeer {
+    /// The computer closes the stream.
+    pub fn close(&self) {
+        self.closed.store(true, Ordering::Relaxed);
+    }
+}
+
+impl Uplink {
+    /// An uplink with no network behind it, for tests: `queue` packets wait
+    /// at most, the peer reads them and answers.
+    pub fn pair(kind: &str, queue: usize) -> (Uplink, UplinkPeer) {
+        let (tx, sent) = mpsc::channel(queue);
+        let (answer, rx) = std::sync::mpsc::channel();
+        let closed = Arc::new(AtomicBool::new(false));
+        (
+            Uplink {
+                kind: kind.to_owned(),
+                tx,
+                rx: Arc::new(Mutex::new(rx)),
+                closed: closed.clone(),
+            },
+            UplinkPeer {
+                sent,
+                answer,
+                closed,
+            },
+        )
+    }
+}
+
+/// The kinds to ask for and the uplinks of the current stream.
+#[derive(Clone, Default)]
+pub(crate) struct Uplinks {
+    inner: Arc<Mutex<UplinksInner>>,
+}
+
+#[derive(Default)]
+struct UplinksInner {
+    kinds: Vec<String>,
+    open: HashMap<String, Uplink>,
+}
+
+impl Uplinks {
+    pub(crate) fn set_kinds(&self, kinds: Vec<String>) {
+        self.inner.lock().unwrap().kinds = kinds;
+    }
+
+    pub(crate) fn kinds(&self) -> Vec<String> {
+        self.inner.lock().unwrap().kinds.clone()
+    }
+
+    pub(crate) fn get(&self, kind: &str) -> Option<Uplink> {
+        let inner = self.inner.lock().unwrap();
+        inner.open.get(kind).filter(|u| !u.is_closed()).cloned()
+    }
+
+    /// The stream stopped: every uplink closes.
+    pub(crate) fn clear(&self) {
+        let mut inner = self.inner.lock().unwrap();
+        for uplink in inner.open.values() {
+            uplink.closed.store(true, Ordering::Relaxed);
+        }
+        inner.open.clear();
+    }
+
+    /// Connects to the endpoints the computer gave; the tasks carry the
+    /// packets until they are dropped (the stream stops).
+    pub(crate) fn connect(
+        &self,
+        connection: &kyproto::Connection,
+        endpoints: &[(String, u16)],
+    ) -> Vec<runtime::Task> {
+        let mut tasks = Vec::new();
+        let mut inner = self.inner.lock().unwrap();
+        for (kind, id) in endpoints {
+            let endpoint = match connection.connect_data_endpoint(*id) {
+                Ok(endpoint) => endpoint,
+                Err(err) => {
+                    warn!("Uplink \"{kind}\": endpoint not connected: {err}");
+                    continue;
+                }
+            };
+            let (tx, up) = mpsc::channel(QUEUE);
+            // Bounded: an app that no longer reads its statuses does not
+            // make them pile up without end (the oldest are kept, the
+            // newest dropped).
+            let (down, rx) = std::sync::mpsc::sync_channel(STATUS_QUEUE);
+            let closed = Arc::new(AtomicBool::new(false));
+            inner.open.insert(
+                kind.clone(),
+                Uplink {
+                    kind: kind.clone(),
+                    tx,
+                    rx: Arc::new(Mutex::new(rx)),
+                    closed: closed.clone(),
+                },
+            );
+            info!("Uplink \"{kind}\" offered by the computer");
+            tasks.push(runtime::Task::spawn(pump(
+                kind.clone(),
+                endpoint,
+                up,
+                down,
+                closed,
+            )));
+        }
+        tasks
+    }
+}
+
+/// Statuses from the computer waiting for the app.
+const STATUS_QUEUE: usize = 64;
+
+async fn pump(
+    kind: String,
+    endpoint: types::DataEndpoint,
+    mut up: mpsc::Receiver<Vec<u8>>,
+    down: std::sync::mpsc::SyncSender<Vec<u8>>,
+    closed: Arc<AtomicBool>,
+) {
+    let (mut send, mut recv) = match endpoint.ready().await {
+        Ok(protocol) => protocol,
+        Err(err) => {
+            warn!("Uplink \"{kind}\" not ready: {err}");
+            closed.store(true, Ordering::Relaxed);
+            return;
+        }
+    };
+    let receive = async {
+        while let Ok(Some(packet)) = recv.recv().await {
+            match down.try_send(packet.payload.to_vec()) {
+                Ok(()) => {}
+                Err(std::sync::mpsc::TrySendError::Full(_)) => {
+                    warn!("Uplink \"{kind}\": status dropped, the app does not read them");
+                }
+                Err(std::sync::mpsc::TrySendError::Disconnected(_)) => break,
+            }
+        }
+    };
+    let transmit = async {
+        while let Some(payload) = up.recv().await {
+            if let Err(err) = send.send(types::DataPacket { payload: payload.into() }).await {
+                info!("Uplink \"{kind}\" closed: {err}");
+                break;
+            }
+        }
+    };
+    futures::pin_mut!(receive, transmit);
+    futures::future::select(receive, transmit).await;
+    closed.store(true, Ordering::Relaxed);
+}
+
+/// `uplink` added to the start request.
+pub(crate) fn add_to_request(body: &mut serde_json::Value, kinds: &[String]) {
+    if kinds.is_empty() {
+        return;
+    }
+    if let Some(body) = body.as_object_mut() {
+        body.insert("uplink".to_owned(), serde_json::json!(kinds));
+    }
+}
+
+/// `uplink` of the start response: the kind and endpoint of each.
+pub(crate) fn from_response(body: &serde_json::Value) -> Vec<(String, u16)> {
+    body.get("uplink")
+        .and_then(serde_json::Value::as_array)
+        .map(|uplinks| {
+            uplinks
+                .iter()
+                .filter_map(|u| {
+                    let kind = u.get("kind")?.as_str()?.to_owned();
+                    let id = u16::try_from(u.get("endpoint")?.as_u64()?).ok()?;
+                    Some((kind, id))
+                })
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn request_and_response() {
+        let mut body = serde_json::json!({"audio": true});
+        add_to_request(&mut body, &[]);
+        assert!(body.get("uplink").is_none());
+        add_to_request(&mut body, &["camera".to_owned()]);
+        assert_eq!(body["uplink"][0], "camera");
+
+        let response = serde_json::json!({
+            "uplink": [{"kind": "camera", "endpoint": 12}, {"kind": "x"}, {"kind": "microphone", "endpoint": 70000}]
+        });
+        assert_eq!(from_response(&response), vec![("camera".to_owned(), 12)]);
+        assert!(from_response(&serde_json::json!({})).is_empty());
+    }
+}
