+    #[test]
+    fn cursor_sync_keeps_shape_on_move() {
+        let state = ServerPipelineState::new();
+
+        let shape = Cursor {
+            display_id: 43,
+            visible: true,
+            x: 1,
+            y: 2,
+            xhot: 3,
+            yhot: 4,
+            width: 5,
+            height: 6,
+            data: CursorData::Raw(vec![7, 8, 9, 10]),
+        };
+        state.on_packet(&shape.clone().to_packet(InputTarget::Client));
+
+        // Position only: the shape stays in the state sent to new clients.
+        let moved = Cursor {
+            x: 100,
+            y: 200,
+            data: CursorData::None,
+            ..shape.clone()
+        };
+        state.on_packet(&moved.to_packet(InputTarget::Client));
+
+        let expected = Cursor {
+            x: 100,
+            y: 200,
+            ..shape
+        };
+        let ret = state.on_control_event(&ControlEvent::ClientConnected);
+        assert_eq!(
+            ret.generated_events,
+            Some(vec![expected.to_packet(InputTarget::Client)])
+        );
+    }
