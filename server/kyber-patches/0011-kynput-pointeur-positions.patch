     fn on_cursor(&mut self, cursor: kynput_rs::Cursor, pkt: &kynput_rs::Packet) {
+        // A visible pointer without a shape is a move: clients that already
+        // had the shape keep it. A client connecting later still needs it, so
+        // the cached packet keeps the last shape at the new position.
+        if cursor.visible && cursor.data == kynput_rs::CursorData::None {
+            let cached = self
+                .cursors
+                .get(&cursor.display_id)
+                .and_then(kynput_rs::Cursor::from_packet)
+                .filter(|cached| cached.visible && cached.data != kynput_rs::CursorData::None);
+            if let Some(cached) = cached {
+                let moved = kynput_rs::Cursor {
+                    x: cursor.x,
+                    y: cursor.y,
+                    ..cached
+                };
+                self.cursors.insert(
+                    cursor.display_id,
+                    moved.to_packet(kynput_rs::InputTarget::Client),
+                );
+                return;
+            }
+        }
+
         self.cursors.insert(cursor.display_id, pkt.clone());
     }
 
