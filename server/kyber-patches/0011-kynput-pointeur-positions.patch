+/// Pointer state shared by every connected pipe (one per captured display).
+#[derive(Default)]
+struct SharedCursor {
+    /// Last shape received, from any display.
+    last_shape: Option<Cursor>,
+    /// Display on which clients were last sent a visible pointer with a
+    /// visible shape: further moves on that display need no shape.
+    shown_on: Option<u32>,
