+/// KyberNow: stable display ID, the same as the txproto backend gives: the
+/// CRC-32 (FFmpeg's AV_CRC_32_IEEE, initial value all ones) of the Windows
+/// device name (`\\.\DISPLAY2`). Clients keep the same IDs whatever the
+/// backend, and an ID no longer shifts when a display is added or removed.
+pub(crate) fn display_id(name: &str) -> u32 {
+    static TABLE: std::sync::OnceLock<[u32; 256]> = std::sync::OnceLock::new();
+    let table = TABLE.get_or_init(|| {
+        let mut t = [0u32; 256];
+        for (i, entry) in t.iter_mut().enumerate() {
+            let mut c = (i as u32) << 24;
+            for _ in 0..8 {
+                c = if c & 0x8000_0000 != 0 { (c << 1) ^ 0x04C1_1DB7 } else { c << 1 };
+            }
+            *entry = c.swap_bytes();
+        }
+        t
+    });
+    name.bytes()
+        .fold(u32::MAX, |crc, b| table[((crc ^ b as u32) & 0xff) as usize] ^ (crc >> 8))
+}
