+/// Largest payload a data packet may announce. The size is read from the
+/// peer and the payload buffer is allocated before it is read: without a
+/// limit, a single header (`FF FF FF FF`) makes the receiver allocate 4 GiB.
+/// The largest payload KyberNow sends is a camera frame (8 MiB at most).
+pub const MAX_DATA_PACKET_SIZE: usize = 16 * 1024 * 1024;
+
 #[derive(Debug, Clone)]
 pub struct DataPacket {
     pub payload: Bytes,
@@ -47,9 +53,15 @@ impl super::Serializable for DataPacket {
