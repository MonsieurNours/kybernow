diff --git a/subprojects/txproto/src/kn_timing.h b/subprojects/txproto/src/kn_timing.h
new file mode 100644
index 0000000..b37aafb
--- /dev/null
+++ b/subprojects/txproto/src/kn_timing.h
@@ -0,0 +1,478 @@
+/*
+ * KyberNow (0023): time spent by each image at each step on the computer,
+ * in SDR and in HDR, for both capture engines. The same file is in txproto
+ * (src/kn_timing.h), libavgrab (libavgrab/kn_timing.h) and libavconv
+ * (libavconv/kn_timing.h).
+ *
+ * The capture attaches a KnFrameTiming to each image: frame side data of a
+ * type of its own (like libavgrab's), carried through the filters with the
+ * image and ignored by the encoders. The encoder adds when the image went
+ * in and when its packet came out, and logs one line every 5 s:
+ *
+ *   Timing in ms (5 s, 300 images, HDR10 3840x2160, hevc_nvenc):
+ *   present->capture 1.20 (p95 2.10), submit 0.05 (p95 0.09), GPU conversion
+ *   0.80 (p95 1.00), queue 0.40 (p95 0.90), encode 4.10 (p95 5.00),
+ *   capture->packet 5.40 (p95 7.10)
+ *
+ *  - present->capture: Windows showed the image (DXGI's LastPresentTime,
+ *    WGC's SystemRelativeTime) until the capture took it;
+ *  - submit: from then until its copy or conversion was queued on the
+ *    graphics card (time on the processor);
+ *  - GPU copy / GPU conversion: the graphics card's own time for it, from
+ *    D3D11 timestamp queries read without waiting, one or more images later
+ *    (KnGpuTimer: the value of a recent image);
+ *  - queue: from then until the encoder got the image (filters, scaling,
+ *    queues, an image held back by max_framerate);
+ *  - encode: until its packet came out of the encoder;
+ *  - capture->packet: the capture taking it until the packet (the time on
+ *    the computer, network aside).
+ * Averages, and 95th percentiles in brackets.
+ *
+ * Clock: QueryPerformanceCounter, the one of LastPresentTime and of WGC.
+ */
+
+#ifndef KN_TIMING_H
+#define KN_TIMING_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+#include <libavutil/frame.h>
+#include <libavutil/mem.h>
+#include <libavutil/time.h>
+
+/* Frame side data: a KnFrameTiming ("KNTM", outside FFmpeg's types). */
+#define KN_FRAME_DATA_TIMING ((enum AVFrameSideDataType)(('K' << 24) | ('N' << 16) | ('T' << 8) | 'M'))
+
+typedef struct KnFrameTiming {
+    int64_t present;   /* Windows showed the image (kn_ticks()), 0 if unknown */
+    int64_t acquired;  /* the capture took it */
+    int64_t submitted; /* its copy or conversion was queued on the graphics card */
+    float gpu_ms;      /* graphics card time of the copy or conversion (a recent image), < 0 if unknown */
+    int mode;          /* 0 SDR, 1 HDR10, 2 SDR from an HDR capture (KN_HDR_*) */
+} KnFrameTiming;
+
+/* Ticks per second of kn_ticks(). */
+static inline int64_t kn_ticks_freq(void)
+{
+#ifdef _WIN32
+    static int64_t freq;
+    if (!freq) {
+        LARGE_INTEGER f;
+        QueryPerformanceFrequency(&f);
+        freq = f.QuadPart > 0 ? f.QuadPart : 1;
+    }
+    return freq;
+#else
+    return 1000000;
+#endif
+}
+
+static inline int64_t kn_ticks(void)
+{
+#ifdef _WIN32
+    LARGE_INTEGER t;
+    QueryPerformanceCounter(&t);
+    return t.QuadPart;
+#else
+    return av_gettime_relative();
+#endif
+}
+
+/* WGC's SystemRelativeTime (QueryPerformanceCounter in 100 ns units). */
+static inline int64_t kn_ticks_from_100ns(int64_t t)
+{
+    return (int64_t)((double)t * (double)kn_ticks_freq() / 10000000.0);
+}
+
+static inline double kn_ticks_ms(int64_t t)
+{
+    return (double)t * 1000.0 / (double)kn_ticks_freq();
+}
+
+/* Attaches `t` to `frame` (nothing if memory runs out: timing is optional). */
+static inline void kn_timing_attach(AVFrame *frame, const KnFrameTiming *t)
+{
+    AVFrameSideData *sd = av_frame_new_side_data(frame, KN_FRAME_DATA_TIMING, sizeof(*t));
+    if (sd)
+        memcpy(sd->data, t, sizeof(*t));
+}
+
+#ifdef KN_TIMING_D3D11
+/* The graphics card's time of the copy or conversion: D3D11 timestamp
+ * queries around it, read without waiting (D3D11_ASYNC_GETDATA_DONOTFLUSH)
+ * on the next images. Called under the device lock (ID3D10Multithread). */
+#include "kn_hdr_capture.h"
+
+#define KN_GPU_QUERIES 8
+
+typedef struct KnGpuTimer {
+    ID3D11Query *disjoint[KN_GPU_QUERIES], *begin[KN_GPU_QUERIES], *end[KN_GPU_QUERIES];
+    unsigned head, tail; /* queued, read */
+    float last_ms;       /* the latest measure, -1 before the first */
+    int ready, failed;
+} KnGpuTimer;
+
+static inline void kn_gpu_timer_free(KnGpuTimer *t)
+{
+    for (int i = 0; i < KN_GPU_QUERIES; i++) {
+        if (t->disjoint[i])
+            ID3D11Query_Release(t->disjoint[i]);
+        if (t->begin[i])
+            ID3D11Query_Release(t->begin[i]);
+        if (t->end[i])
+            ID3D11Query_Release(t->end[i]);
+    }
+    memset(t, 0, sizeof(*t));
+    t->last_ms = -1;
+}
+
+static inline int kn_gpu_timer_init(KnGpuTimer *t, ID3D11Device *device)
+{
+    D3D11_QUERY_DESC disjoint = { D3D11_QUERY_TIMESTAMP_DISJOINT, 0 };
+    D3D11_QUERY_DESC stamp = { D3D11_QUERY_TIMESTAMP, 0 };
+
+    kn_gpu_timer_free(t);
+    for (int i = 0; i < KN_GPU_QUERIES; i++) {
+        if (FAILED(ID3D11Device_CreateQuery(device, &disjoint, &t->disjoint[i])) ||
+            FAILED(ID3D11Device_CreateQuery(device, &stamp, &t->begin[i])) ||
+            FAILED(ID3D11Device_CreateQuery(device, &stamp, &t->end[i]))) {
+            kn_gpu_timer_free(t);
+            t->failed = 1;
+            return -1;
+        }
+    }
+    t->ready = 1;
+    return 0;
+}
+
+static inline void kn_gpu_timer_begin(KnGpuTimer *t, ID3D11Device *device, ID3D11DeviceContext *ctx)
+{
+    unsigned i;
+    if (!t->ready && (t->failed || kn_gpu_timer_init(t, device) < 0))
+        return;
+    if (t->head - t->tail == KN_GPU_QUERIES)
+        t->tail++; /* never read: the oldest is reused */
+    i = t->head % KN_GPU_QUERIES;
+    ID3D11DeviceContext_Begin(ctx, (ID3D11Asynchronous *)t->disjoint[i]);
+    ID3D11DeviceContext_End(ctx, (ID3D11Asynchronous *)t->begin[i]);
+}
+
+static inline void kn_gpu_timer_end(KnGpuTimer *t, ID3D11DeviceContext *ctx)
+{
+    unsigned i;
+    if (!t->ready)
+        return;
+    i = t->head % KN_GPU_QUERIES;
+    ID3D11DeviceContext_End(ctx, (ID3D11Asynchronous *)t->end[i]);
+    ID3D11DeviceContext_End(ctx, (ID3D11Asynchronous *)t->disjoint[i]);
+    t->head++;
+}
+
+/* Reads the queries the graphics card has finished, oldest first. */
+static inline void kn_gpu_timer_collect(KnGpuTimer *t, ID3D11DeviceContext *ctx)
+{
+    while (t->ready && t->tail != t->head) {
+        const unsigned i = t->tail % KN_GPU_QUERIES;
+        D3D11_QUERY_DATA_TIMESTAMP_DISJOINT dj;
+        UINT64 b, e;
+        if (ID3D11DeviceContext_GetData(ctx, (ID3D11Asynchronous *)t->disjoint[i], &dj, sizeof(dj),
+                                        D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK ||
+            ID3D11DeviceContext_GetData(ctx, (ID3D11Asynchronous *)t->begin[i], &b, sizeof(b),
+                                        D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK ||
+            ID3D11DeviceContext_GetData(ctx, (ID3D11Asynchronous *)t->end[i], &e, sizeof(e),
+                                        D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK)
+            break;
+        if (!dj.Disjoint && dj.Frequency && e >= b)
+            t->last_ms = (float)((double)(e - b) * 1000.0 / (double)dj.Frequency);
+        t->tail++;
+    }
+}
+
+/* The device lock of the encoders and filters (FFmpeg's D3D11 device). */
+static inline ID3D10Multithread *kn_timing_lock(ID3D11DeviceContext *ctx)
+{
+    ID3D10Multithread *mt = NULL;
+    if (SUCCEEDED(ID3D11DeviceContext_QueryInterface(ctx, &kn_iid_d3d10_multithread, (void **)&mt)))
+        ID3D10Multithread_Enter(mt);
+    return mt;
+}
+
+static inline void kn_timing_unlock(ID3D10Multithread *mt)
+{
+    if (mt) {
+        ID3D10Multithread_Leave(mt);
+        ID3D10Multithread_Release(mt);
+    }
+}
+
+/* GPU priority of the capture and encoding work: during a game that keeps
+ * the card busy, the copy, the conversion and the encoding would otherwise
+ * wait behind its frames (up to one game frame). Process class through
+ * D3DKMTSetProcessSchedulingPriorityClass (gdi32.dll, loaded at run time):
+ * REALTIME (SeIncreaseBasePriorityPrivilege, kyavserver runs as SYSTEM)
+ * only when hardware-accelerated GPU scheduling is known to be off, HIGH
+ * otherwise or if REALTIME is refused (with that scheduling on, REALTIME
+ * can freeze NVENC or the driver, as Sunshine found); then
+ * IDXGIDevice::SetGPUThreadPriority(7) on `device`. `buf` gets the log. */
+enum { KN_KMT_PRIORITY_HIGH = 4, KN_KMT_PRIORITY_REALTIME = 5 };
+#define KN_KMTQAITYPE_WDDM_2_7_CAPS 70
+
+typedef struct KnKmtOpenAdapterFromLuid { LUID luid; UINT adapter; } KnKmtOpenAdapterFromLuid;
+typedef struct KnKmtCloseAdapter { UINT adapter; } KnKmtCloseAdapter;
+typedef struct KnKmtQueryAdapterInfo {
+    UINT adapter;
+    UINT type;
+    void *data;
+    UINT size;
+} KnKmtQueryAdapterInfo;
+typedef LONG (APIENTRY *kn_kmt_set_priority_fn)(HANDLE process, int priority);
+typedef LONG (APIENTRY *kn_kmt_open_fn)(KnKmtOpenAdapterFromLuid *args);
+typedef LONG (APIENTRY *kn_kmt_close_fn)(const KnKmtCloseAdapter *args);
+typedef LONG (APIENTRY *kn_kmt_query_fn)(const KnKmtQueryAdapterInfo *args);
+
+/* Hardware-accelerated GPU scheduling on the adapter `luid`: 1 on, 0 off,
+ * -1 unknown (Windows before 10 2004, or the query refused). */
+static inline int kn_gpu_hags(HMODULE gdi, LUID luid)
+{
+    kn_kmt_open_fn open = (kn_kmt_open_fn)(void *)GetProcAddress(gdi, "D3DKMTOpenAdapterFromLuid");
+    kn_kmt_close_fn close = (kn_kmt_close_fn)(void *)GetProcAddress(gdi, "D3DKMTCloseAdapter");
+    kn_kmt_query_fn query = (kn_kmt_query_fn)(void *)GetProcAddress(gdi, "D3DKMTQueryAdapterInfo");
+    KnKmtOpenAdapterFromLuid o = { luid, 0 };
+    KnKmtCloseAdapter c;
+    KnKmtQueryAdapterInfo q;
+    UINT caps = 0; /* D3DKMT_WDDM_2_7_CAPS: bit 0 HwSchSupported, bit 1 HwSchEnabled */
+    LONG status;
+
+    if (!open || !close || !query || open(&o) < 0)
+        return -1;
+    q.adapter = o.adapter;
+    q.type = KN_KMTQAITYPE_WDDM_2_7_CAPS;
+    q.data = &caps;
+    q.size = sizeof(caps);
+    status = query(&q);
+    c.adapter = o.adapter;
+    close(&c);
+    return status < 0 ? -1 : !!(caps & 2);
+}
+
+/* SeIncreaseBasePriorityPrivilege on, if the process holds it. */
+static inline int kn_gpu_priority_privilege(void)
+{
+    HANDLE token;
+    TOKEN_PRIVILEGES tp = { 0 };
+    int ok;
+
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &token))
+        return 0;
+    tp.PrivilegeCount = 1;
+    tp.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+    ok = LookupPrivilegeValueW(NULL, L"SeIncreaseBasePriorityPrivilege", &tp.Privileges[0].Luid) &&
+         AdjustTokenPrivileges(token, FALSE, &tp, 0, NULL, NULL) &&
+         GetLastError() == ERROR_SUCCESS;
+    CloseHandle(token);
+    return ok;
+}
+
+static inline void kn_gpu_priority(ID3D11Device *device, char *buf, size_t size)
+{
+    static const GUID iid_dxgi_device = { /* {54ec77fa-1377-44e6-8c32-88fd5f44c84c} */
+        0x54ec77fa, 0x1377, 0x44e6, { 0x8c, 0x32, 0x88, 0xfd, 0x5f, 0x44, 0xc8, 0x4c }
+    };
+    HMODULE gdi = GetModuleHandleW(L"gdi32.dll");
+    kn_kmt_set_priority_fn set = NULL;
+    IDXGIDevice *dxgi = NULL;
+    IDXGIAdapter *adapter = NULL;
+    DXGI_ADAPTER_DESC desc = { 0 };
+    const char *class_name = "unchanged";
+    char why[96] = "";
+    int hags = -1, privilege, thread = 0;
+    LONG status = 0;
+    HRESULT hr;
+
+    if (!gdi)
+        gdi = LoadLibraryExW(L"gdi32.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (gdi)
+        set = (kn_kmt_set_priority_fn)(void *)GetProcAddress(gdi, "D3DKMTSetProcessSchedulingPriorityClass");
+    if (FAILED(hr = ID3D11Device_QueryInterface(device, &iid_dxgi_device, (void **)&dxgi))) {
+        snprintf(buf, size, "GPU priority: no IDXGIDevice (0x%lX)", hr);
+        return;
+    }
+    if (SUCCEEDED(IDXGIDevice_GetAdapter(dxgi, &adapter))) {
+        IDXGIAdapter_GetDesc(adapter, &desc);
+        IDXGIAdapter_Release(adapter);
+        if (gdi)
+            hags = kn_gpu_hags(gdi, desc.AdapterLuid);
+    }
+
+    privilege = kn_gpu_priority_privilege();
+    if (!set) {
+        snprintf(why, sizeof(why), ", D3DKMTSetProcessSchedulingPriorityClass not found");
+    } else {
+        if (hags == 0 && privilege && (status = set(GetCurrentProcess(), KN_KMT_PRIORITY_REALTIME)) >= 0) {
+            class_name = "REALTIME";
+        } else {
+            if (hags != 0)
+                snprintf(why, sizeof(why), ", %s", hags == 1 ? "hardware-accelerated GPU scheduling on"
+                                                              : "GPU scheduling mode unknown");
+            else
+                snprintf(why, sizeof(why), ", REALTIME refused (%s 0x%lX)",
+                         privilege ? "status" : "no privilege,", (unsigned long)status);
+            status = set(GetCurrentProcess(), KN_KMT_PRIORITY_HIGH);
+            class_name = status >= 0 ? "HIGH" : "unchanged";
+            if (status < 0)
+                snprintf(why + strlen(why), sizeof(why) - strlen(why), ", HIGH refused (0x%lX)",
+                         (unsigned long)status);
+        }
+    }
+
+    hr = IDXGIDevice_SetGPUThreadPriority(dxgi, 7);
+    if (FAILED(hr) || FAILED(IDXGIDevice_GetGPUThreadPriority(dxgi, &thread)))
+        thread = 0;
+    IDXGIDevice_Release(dxgi);
+    snprintf(buf, size, "GPU priority: process class %s%s, GPU thread priority %d%s (vendor 0x%04X)",
+             class_name, why, thread, FAILED(hr) ? " (SetGPUThreadPriority refused)" : "",
+             desc.VendorId);
+}
+#endif /* KN_TIMING_D3D11 */
+
+#ifdef KN_TIMING_ENCODER
+#include <libavcodec/avcodec.h>
+
+#define KN_TIMING_PERIOD_MS 5000
+#define KN_TIMING_PENDING 64
+#define KN_TIMING_SAMPLES 4096
+
+enum { KN_T_PRESENT, KN_T_SUBMIT, KN_T_GPU, KN_T_QUEUE, KN_T_ENCODE, KN_T_TOTAL, KN_T_NB };
+
+typedef struct KnTimingStats {
+    /* Images given to the encoder, waiting for their packet. */
+    struct {
+        int64_t pts, sent;
+        KnFrameTiming t;
+        int used;
+    } pending[KN_TIMING_PENDING];
+    unsigned next;
+
+    float samples[KN_T_NB][KN_TIMING_SAMPLES];
+    int count[KN_T_NB];
+    int images;
+    int64_t start;
+    int mode, width, height;
+} KnTimingStats;
+
+/* Before avcodec_send_frame(): when the image went in. Nothing for an image
+ * without KnFrameTiming (another capture). */
+static inline void kn_timing_sent(KnTimingStats **ps, const AVFrame *frame)
+{
+    const AVFrameSideData *sd = frame ? av_frame_get_side_data(frame, KN_FRAME_DATA_TIMING) : NULL;
+    KnTimingStats *s;
+    unsigned i;
+
+    if (!sd || sd->size < sizeof(KnFrameTiming))
+        return;
+    if (!*ps && !(*ps = av_mallocz(sizeof(**ps))))
+        return;
+    s = *ps;
+    i = s->next++ % KN_TIMING_PENDING;
+    s->pending[i].pts = frame->pts;
+    s->pending[i].sent = kn_ticks();
+    memcpy(&s->pending[i].t, sd->data, sizeof(KnFrameTiming));
+    s->pending[i].used = 1;
+    s->mode = s->pending[i].t.mode;
+    s->width = frame->width;
+    s->height = frame->height;
+}
+
+static inline void kn_timing_add(KnTimingStats *s, int step, double ms)
+{
+    if (ms >= 0 && ms < 10000 && s->count[step] < KN_TIMING_SAMPLES)
+        s->samples[step][s->count[step]++] = (float)ms;
+}
+
+static inline int kn_timing_cmp(const void *a, const void *b)
+{
+    const float x = *(const float *)a, y = *(const float *)b;
+    return (x > y) - (x < y);
+}
+
+/* "1.20 (p95 2.10)" for `step`, "n/a" without a measure. */
+static inline const char *kn_timing_step(KnTimingStats *s, int step, char *buf, size_t size)
+{
+    const int n = s->count[step];
+    double sum = 0;
+    if (!n)
+        return "n/a";
+    qsort(s->samples[step], n, sizeof(float), kn_timing_cmp);
+    for (int i = 0; i < n; i++)
+        sum += s->samples[step][i];
+    snprintf(buf, size, "%.2f (p95 %.2f)", sum / n,
+             s->samples[step][(n * 95 + 99) / 100 - 1]);
+    return buf;
+}
+
+/* After avcodec_receive_packet(): the image's steps. Every 5 s, writes the
+ * line to log into `line` and returns 1 (0 otherwise). */
+static inline int kn_timing_packet(KnTimingStats *s, const AVCodecContext *avctx, const AVPacket *pkt,
+                                   char *line, size_t size)
+{
+    char b[KN_T_NB][48];
+    int64_t now;
+
+    if (!s)
+        return 0;
+    now = kn_ticks();
+    for (int i = 0; i < KN_TIMING_PENDING; i++) {
+        const KnFrameTiming *t = &s->pending[i].t;
+        if (!s->pending[i].used || s->pending[i].pts != pkt->pts)
+            continue;
+        s->pending[i].used = 0;
+        if (t->present > 0 && t->acquired >= t->present)
+            kn_timing_add(s, KN_T_PRESENT, kn_ticks_ms(t->acquired - t->present));
+        kn_timing_add(s, KN_T_SUBMIT, kn_ticks_ms(t->submitted - t->acquired));
+        if (t->gpu_ms >= 0)
+            kn_timing_add(s, KN_T_GPU, t->gpu_ms);
+        kn_timing_add(s, KN_T_QUEUE, kn_ticks_ms(s->pending[i].sent - t->submitted));
+        kn_timing_add(s, KN_T_ENCODE, kn_ticks_ms(now - s->pending[i].sent));
+        kn_timing_add(s, KN_T_TOTAL, kn_ticks_ms(now - t->acquired));
+        s->images++;
+        break;
+    }
+    if (!s->start)
+        s->start = now;
+    if (kn_ticks_ms(now - s->start) < KN_TIMING_PERIOD_MS)
+        return 0;
+
+    if (s->images)
+        snprintf(line, size, "Timing in ms (%.0f s, %d images, %s %dx%d, %s): present->capture %s, submit %s, "
+                 "%s %s, queue %s, encode %s, capture->packet %s",
+                 kn_ticks_ms(now - s->start) / 1000.0, s->images,
+                 s->mode == 1 ? "HDR10" : s->mode == 2 ? "SDR from HDR" : "SDR", s->width, s->height,
+                 avctx->codec ? avctx->codec->name : "?",
+                 kn_timing_step(s, KN_T_PRESENT, b[KN_T_PRESENT], sizeof(b[0])),
+                 kn_timing_step(s, KN_T_SUBMIT, b[KN_T_SUBMIT], sizeof(b[0])),
+                 s->mode ? "GPU conversion" : "GPU copy",
+                 kn_timing_step(s, KN_T_GPU, b[KN_T_GPU], sizeof(b[0])),
+                 kn_timing_step(s, KN_T_QUEUE, b[KN_T_QUEUE], sizeof(b[0])),
+                 kn_timing_step(s, KN_T_ENCODE, b[KN_T_ENCODE], sizeof(b[0])),
+                 kn_timing_step(s, KN_T_TOTAL, b[KN_T_TOTAL], sizeof(b[0])));
+    memset(s->count, 0, sizeof(s->count));
+    s->start = now;
+    if (!s->images)
+        return 0;
+    s->images = 0;
+    return 1;
+}
+
+static inline void kn_timing_free(KnTimingStats **ps)
+{
+    av_freep(ps);
+}
+#endif /* KN_TIMING_ENCODER */
+
+#endif /* KN_TIMING_H */
