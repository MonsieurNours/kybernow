@@ -801,6 +801,29 @@ pub enum VideoCodec {
     H264,
     HEVC,
     AV1,
+    /// KyberNow (0025): PyroWave (docs/pyrowave.md), only from a Station
+    /// that announces it. C: KYCLIENT_VIDEO_CODEC_PYRO_WAVE.
+    PyroWave,
+}
+
+/// KyberNow (0025): the newest PyroWave configuration packet (`KNPW`
+/// version) this app's decoder reads, for the whole process: an app reads
+/// the same packets on every display. 1 until the app says more.
+static PYROWAVE_HEADER: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(1);
+
+/// KyberNow (0025): sets the newest PyroWave configuration packet this app
+/// reads (2: the header with the HDR10 metadata, docs/kyber-changes.md).
+/// The Station sends version 1 to an app that never said so (0.11.7 and
+/// older read only its 16 bytes).
+pub fn set_pyrowave_header(version: u8) {
+    PYROWAVE_HEADER.store(version.max(1), std::sync::atomic::Ordering::Relaxed);
+}
+
+/// KyberNow (0025): what a start request tells the Station, with `codec`
+/// PyroWave only, and only above version 1 (an older Station ignores it).
+pub(crate) fn pyrowave_header(codec: &VideoCodec) -> Option<u8> {
+    let version = PYROWAVE_HEADER.load(std::sync::atomic::Ordering::Relaxed);
+    (*codec == VideoCodec::PyroWave && version >= 2).then_some(version)
 }
 
