+    /* KyberNow: timestamps follow the sample count, resynchronised on the
+     * capture clock when it drifts. Wall-clock time at GetBuffer() made
+     * packets read in a burst share almost the same pts, so audio went
+     * "backward in time" for the encoder and the player. */
+    int64_t sync_pts;     /* us, pts of the first sample since the last sync */
+    int64_t sync_samples; /* samples captured since the last sync */
+    int synced;
 } WasapiCapture;
 
+#define WASAPI_RESYNC_US 40000
