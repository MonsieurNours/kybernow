+        /* u64QPCPosition is in 100 ns units, on the same clock as
+         * av_gettime_relative() (QueryPerformanceCounter). */
+        int64_t captured = qpc ? (int64_t)(qpc / 10) - priv->epoch
+                               : av_gettime_relative() - priv->epoch;
+        int64_t expected = priv->sync_pts +
+                           av_rescale(priv->sync_samples, 1000000, entry->sample_rate);
+        if (!priv->synced || (flags & AUDCLNT_BUFFERFLAGS_DATA_DISCONTINUITY) ||
+            llabs(captured - expected) > WASAPI_RESYNC_US) {
+            priv->sync_pts = captured;
+            priv->sync_samples = 0;
+            priv->synced = 1;
+            expected = captured;
+        }
+        f->pts = expected;
