diff --git a/subprojects/txproto/src/kn_audio_clock.h b/subprojects/txproto/src/kn_audio_clock.h
new file mode 100644
index 0000000..e3bfc57
--- /dev/null
+++ b/subprojects/txproto/src/kn_audio_clock.h
@@ -0,0 +1,58 @@
+/*
+ * KyberNow (0003): the clock of the WASAPI capture, shared by txproto
+ * (iosys_wasapi.c) and libavconv (libavgrab/wasapi.c, 0009): one source,
+ * so that a fix made for one engine is made for both (KYB-06, KYB-47).
+ *
+ * Timestamps follow the sample count, resynchronised on the capture clock
+ * when they drift by more than 40 ms, after a discontinuity, or at the
+ * first packet. Wall-clock time at GetBuffer() made packets read in a burst
+ * share almost the same pts, so audio went "backward in time" for the
+ * encoder and the player.
+ *
+ * Plain C: the arithmetic is tested on any machine; the caller reads the
+ * WASAPI flags and position.
+ */
+#ifndef KN_AUDIO_CLOCK_H
+#define KN_AUDIO_CLOCK_H
+
+#include <stdint.h>
+#include <stdlib.h>
+
+#include <libavutil/mathematics.h>
+#include <libavutil/time.h>
+
+#define KN_AUDIO_RESYNC_US 40000
+
+typedef struct KnAudioClock {
+    int64_t sync_pts;     /* us, pts of the first sample since the last sync */
+    int64_t sync_samples; /* samples captured since the last sync */
+    int synced;
+} KnAudioClock;
+
+/* When a packet was captured, in us since `epoch`: its device position
+ * (u64QPCPosition, 100 ns units on the clock of av_gettime_relative(),
+ * QueryPerformanceCounter) unless it is missing or flagged in error (device
+ * change, resume), the time it is read otherwise. */
+static inline int64_t kn_audio_captured_us(uint64_t qpc, int qpc_error, int64_t epoch)
+{
+    if (qpc && !qpc_error)
+        return (int64_t)(qpc / 10) - epoch;
+    return av_gettime_relative() - epoch;
+}
+
+/* The pts of a packet of `samples` samples captured at `captured` (us). */
+static inline int64_t kn_audio_clock_pts(KnAudioClock *c, int64_t captured, int discontinuity,
+                                         int sample_rate, int samples)
+{
+    int64_t expected = c->sync_pts + av_rescale(c->sync_samples, 1000000, sample_rate);
+    if (!c->synced || discontinuity || llabs(captured - expected) > KN_AUDIO_RESYNC_US) {
+        c->sync_pts = captured;
+        c->sync_samples = 0;
+        c->synced = 1;
+        expected = captured;
+    }
+    c->sync_samples += samples;
+    return expected;
+}
+
+#endif /* KN_AUDIO_CLOCK_H */
