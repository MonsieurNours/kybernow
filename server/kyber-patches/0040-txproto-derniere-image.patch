+/* KyberNow (0040): see SNAME.latest_only. */
+void RENAME(fifo_set_latest_only)(AVBufferRef *dst, int latest_only)
+{
+    SNAME *ctx = (SNAME *)dst->data;
+    pthread_mutex_lock(&ctx->lock);
+    ctx->latest_only = !!latest_only;
+    pthread_mutex_unlock(&ctx->lock);
+}
+
+/* KyberNow (0040): items replaced by a newer one since the FIFO was made. */
+int RENAME(fifo_get_dropped)(AVBufferRef *src)
+{
+    if (!src)
+        return 0;
+
+    SNAME *ctx = (SNAME *)src->data;
+    pthread_mutex_lock(&ctx->lock);
+    int ret = ctx->dropped;
+    pthread_mutex_unlock(&ctx->lock);
+    return ret;
+}
