+/* KyberNow (0040): images dropped at the input, for a newer one. In the
+ * metrics (`encoder_input_dropped`, the count since the encoder started,
+ * with the pts of the image that goes in) at most once a second, and in the
+ * log at most once every 5 s, when it changed. */
+static void kn_report_dropped(EncodingContext *ctx, const AVFrame *frame)
+{
+    const int dropped = sp_frame_fifo_get_dropped(ctx->src_frames);
+    const int64_t now = av_gettime_relative();
+
+    if (dropped == ctx->kn_dropped_sent && dropped == ctx->kn_dropped_logged)
+        return;
 
+    if (dropped != ctx->kn_dropped_sent && ctx->metrics &&
+        now - ctx->kn_dropped_sent_at >= 1000000) {
+        const tx_metrics_entry metrics[] = {
+            { .key = "pts", .value = frame->pts },
+            { .key = "encoder_input_dropped", .value = dropped },
+        };
+        tx_metrics_push(ctx->metrics, metrics, SP_ARRAY_ELEMS(metrics));
+        ctx->kn_dropped_sent = dropped;
+        ctx->kn_dropped_sent_at = now;
+    }
+
+    if (dropped != ctx->kn_dropped_logged &&
+        now - ctx->kn_dropped_logged_at >= 5000000) {
+        sp_log(ctx, SP_LOG_INFO, "Encoder busy: %d older images dropped for a newer one "
+               "(%d in all)\n", dropped - ctx->kn_dropped_logged, dropped);
+        ctx->kn_dropped_logged = dropped;
+        ctx->kn_dropped_logged_at = now;
+    }
+}
