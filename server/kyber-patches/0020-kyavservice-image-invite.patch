diff --git a/kyavservice/src/kybernow.rs b/kyavservice/src/kybernow.rs
new file mode 100644
index 0000000..7ef6d6b
--- /dev/null
+++ b/kyavservice/src/kybernow.rs
@@ -0,0 +1,189 @@
+// KyberNow (0020): KyberNow Share, a guest's own image. kycontroller may ask
+// kyavserver for an image made for a guest: scaled down (`scale`, always
+// 4:2:0) and at a lower rate (`max_fps`). Neither is given for the host's
+// image, which stays as it was. Here, what both engines share: what they can
+// make, the scaling filters put before the encoder, and the bitrate floor.
+
+use kyavservice_types::VideoScale;
+
+use crate::config::VideoEncoder;
+
+/// Lowest bitrate of a guest's own image (bits/s). The display's floor
+/// (`[kyavserver] minimum_bitrate`, 5 Mbit/s by default) would lift a 720p30
+/// image above the bitrate kycontroller gives it.
+const GUEST_MIN_BITRATE: u32 = 1_000_000;
+
+/// Whether the image is a guest's own one (scaled down or at a lower rate).
+pub(crate) fn is_guest_image(scale: Option<VideoScale>, max_fps: Option<u32>) -> bool {
+    scale.is_some() || max_fps.is_some()
+}
+
+/// Bitrate floor of an image: the display's, at most 1 Mbit/s for a guest's
+/// own image.
+pub(crate) fn minimum_bitrate(display_floor: u32, guest_image: bool) -> u32 {
+    if guest_image {
+        display_floor.min(GUEST_MIN_BITRATE)
+    } else {
+        display_floor
+    }
+}
+
+/// Encoders whose image can be scaled down: on Windows only (D3D11 frames of
+/// the desktop capture), on the graphics card for NVENC, AMF and QSV, in
+/// software for x264.
+pub(crate) fn can_scale(encoder: VideoEncoder, windows: bool) -> bool {
+    windows
+        && matches!(
+            encoder,
+            VideoEncoder::NVENC | VideoEncoder::AMF | VideoEncoder::QSV | VideoEncoder::X264
+        )
+}
+
+/// Checks a guest's own image against what the engine can make: `scaling`
+/// with this encoder, `rate_limit` a capped rate. The error is why the
+/// stream is refused at start.
+pub(crate) fn check(
+    scale: Option<VideoScale>,
+    max_fps: Option<u32>,
+    scaling: bool,
+    rate_limit: bool,
+) -> Result<(), String> {
+    if let Some(VideoScale { width, height }) = scale {
+        if !scaling {
+            return Err(format!(
+                "cannot scale the image down to {width}x{height} with this encoder"
+            ));
+        }
+        if width == 0 || height == 0 || width % 2 != 0 || height % 2 != 0 {
+            return Err(format!(
+                "cannot scale the image down to {width}x{height}: even, non-zero sizes only"
+            ));
+        }
+    }
+    match max_fps {
+        Some(_) if !rate_limit => Err("cannot cap the image rate with this engine".to_string()),
+        Some(0) => Err("cannot cap the image rate to 0".to_string()),
+        _ => Ok(()),
+    }
+}
+
+/// NVENC and AMF: the D3D11 video processor scales the BGRA capture down and
+/// converts it to NV12, on the device of its input frames (the capture's).
+/// Its output is BT.601 limited range (the processor's default color space),
+/// labelled as such so that players convert it back right (NVENC labels the
+/// host's BGRA image the same way).
+pub(crate) fn d3d11_scale(scale: VideoScale) -> String {
+    format!(
+        "scale_d3d11=width={}:height={}:format=nv12,setparams=colorspace=bt470bg:range=tv",
+        scale.width, scale.height
+    )
+}
+
+/// QSV: the size options of `scale_qsv`, nothing for the display as is.
+pub(crate) fn qsv_size(scale: Option<VideoScale>) -> String {
+    scale
+        .map(|s| format!("w={}:h={}:", s.width, s.height))
+        .unwrap_or_default()
+}
+
+/// x264: the software scaler, after the image is downloaded, nothing for the
+/// display as is.
+pub(crate) fn software_scale(scale: Option<VideoScale>) -> String {
+    scale
+        .map(|s| format!("scale=w={}:h={},", s.width, s.height))
+        .unwrap_or_default()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const P1080: VideoScale = VideoScale {
+        width: 1920,
+        height: 1080,
+    };
+
+    #[test]
+    fn host_image_keeps_the_display_floor() {
+        assert!(!is_guest_image(None, None));
+        assert_eq!(minimum_bitrate(5_000_000, false), 5_000_000);
+        assert_eq!(minimum_bitrate(500_000, false), 500_000);
+    }
+
+    #[test]
+    fn guest_image_floor_is_one_megabit_at_most() {
+        assert!(is_guest_image(Some(P1080), None));
+        assert!(is_guest_image(None, Some(60)));
+        assert_eq!(minimum_bitrate(5_000_000, true), 1_000_000);
+        assert_eq!(minimum_bitrate(500_000, true), 500_000);
+    }
+
+    #[test]
+    fn windows_encoders_scale() {
+        for encoder in [
+            VideoEncoder::NVENC,
+            VideoEncoder::AMF,
+            VideoEncoder::QSV,
+            VideoEncoder::X264,
+        ] {
+            assert!(can_scale(encoder, true), "{encoder:?}");
+            assert!(!can_scale(encoder, false), "{encoder:?}");
+        }
+        for encoder in [
+            VideoEncoder::VAAPI,
+            VideoEncoder::V4L2M2M,
+            VideoEncoder::VIDEOTOOLBOX,
+        ] {
+            assert!(!can_scale(encoder, true), "{encoder:?}");
+        }
+    }
+
+    #[test]
+    fn check_accepts_the_host_image_everywhere() {
+        assert_eq!(check(None, None, false, false), Ok(()));
+    }
+
+    #[test]
+    fn check_accepts_what_the_engine_makes() {
+        assert_eq!(check(Some(P1080), Some(60), true, true), Ok(()));
+        assert_eq!(check(Some(P1080), None, true, false), Ok(()));
+        assert_eq!(check(None, Some(30), false, true), Ok(()));
+    }
+
+    #[test]
+    fn check_refuses_what_the_engine_cannot_make() {
+        assert!(check(Some(P1080), None, false, true).is_err());
+        assert!(check(None, Some(30), true, false).is_err());
+        assert!(check(Some(P1080), Some(30), true, false).is_err());
+    }
+
+    #[test]
+    fn check_refuses_odd_or_empty_sizes_and_zero_rate() {
+        for (width, height) in [(1281, 720), (1280, 721), (0, 720), (1280, 0)] {
+            assert!(
+                check(Some(VideoScale { width, height }), None, true, true).is_err(),
+                "{width}x{height}"
+            );
+        }
+        assert!(check(None, Some(0), true, true).is_err());
+    }
+
+    #[test]
+    fn d3d11_scale_outputs_labelled_nv12() {
+        assert_eq!(
+            d3d11_scale(VideoScale {
+                width: 1280,
+                height: 720
+            }),
+            "scale_d3d11=width=1280:height=720:format=nv12,setparams=colorspace=bt470bg:range=tv"
+        );
+    }
+
+    #[test]
+    fn qsv_and_software_sizes_are_empty_for_the_host() {
+        assert_eq!(qsv_size(None), "");
+        assert_eq!(software_scale(None), "");
+        assert_eq!(qsv_size(Some(P1080)), "w=1920:h=1080:");
+        assert_eq!(software_scale(Some(P1080)), "scale=w=1920:h=1080,");
+    }
+}
