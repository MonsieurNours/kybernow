+/// KyberNow (0020): links the capture to NVENC or AMF, through the scaling
+/// filter of a guest's own image if there is one.
+fn link_d3d11(
+    ctx: &Txproto,
+    scale: Option<VideoScale>,
+    video_source: &txproto_rs::Handle,
+    encoder: &txproto_rs::Handle,
