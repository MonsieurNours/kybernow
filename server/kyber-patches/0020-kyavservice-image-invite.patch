+    // while scale_d3d11 works on the device of its input frames (the
+    // capture's), the one NVENC and AMF encode on.
+    let graph = kybernow::d3d11_scale(scale);
+    info!("Scale the image down: {graph}");
+    let options = Dictionary::from_entries(&[("dump_graph", false).into()])?;
+    let filter = ctx.create_filtergraph(&graph, txproto_rs::HWDeviceType::NONE, Some(options))?;
+    let init_opts = Dictionary::from_entries(&[("fifo_size", 1).into()])?;
+    ctx.ctrl_opts(&filter, init_opts)?;
+
+    ctx.link(video_source, &filter, 0)?;
+    ctx.link(&filter, encoder, 0)?;
+
+    Ok(())
