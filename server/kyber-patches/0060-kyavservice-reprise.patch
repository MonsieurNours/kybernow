+/// KyberNow (0060): a client lost what followed `last_pts`.
+fn handle_video_recover(
+    ctx: &mut Option<Context>,
+    response: ReceivedCommand<'_, IpcApi>,
+    last_pts: u64,
+) -> Result<()> {
+    info!("Video repair up to {last_pts}");
+
+    let Some(ctx) = ctx.as_ref() else {
+        response.send(Err(kyavservice_types::Error("No session started".into())))?;
+        return Ok(());
+    };
+
+    let Some(encoder) = ctx.encoder.as_ref() else {
+        response.send(Err(kyavservice_types::Error("No active encoder".into())))?;
+        return Ok(());
+    };
+
+    response.send(Ok(Response::None))?;
+
+    ctx.ctx.encoder_recover(encoder, last_pts)?;
+    ctx.ctx.commit()?;
+
+    Ok(())
+}
