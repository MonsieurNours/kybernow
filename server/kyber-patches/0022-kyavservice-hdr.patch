diff --git a/kyavservice/src/hdr.rs b/kyavservice/src/hdr.rs
new file mode 100644
index 0000000..d9a2a5d
--- /dev/null
+++ b/kyavservice/src/hdr.rs
@@ -0,0 +1,194 @@
+// KyberNow (0022): HDR. kycontroller asks kyavserver for an HDR10 image
+// (`hdr`) or for the SDR image of a display captured in HDR for its host
+// (`hdr_capture`, a share guest without HDR). Windows desktop capture only:
+// the capture duplicates the desktop in 16-bit float and converts it on the
+// graphics card (txproto and libavgrab, `kn_hdr_capture.h`), the encoders
+// get P010 (HEVC Main 10, AV1 10 bits). What both engines share is here.
+
+use kyavservice_types::{VideoCodec, VideoScale};
+
+use crate::config::VideoEncoder;
+
+/// What the capture makes of the display (its `hdr` option).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) enum HdrMode {
+    /// 8-bit BGRA, as without HDR.
+    #[default]
+    Off,
+    /// HDR10: PQ, BT.2020, P010.
+    Pq,
+    /// The SDR image of a display in HDR: 16-bit float brought to 8-bit
+    /// BGRA, then the SDR path as it is.
+    SdrFromHdr,
+}
+
+impl HdrMode {
+    /// The capture's `hdr` option (txproto and libavgrab).
+    pub(crate) fn capture_option(self) -> i64 {
+        match self {
+            Self::Off => 0,
+            Self::Pq => 1,
+            Self::SdrFromHdr => 2,
+        }
+    }
+
+    pub(crate) fn is_pq(self) -> bool {
+        self == Self::Pq
+    }
+}
+
+/// The mode of an image, and why `hdr` was turned down (the display then
+/// goes SDR, from its 16-bit float capture). HDR10 needs Windows, HEVC or
+/// AV1, 4:2:0, and NVENC, AMF or Quick Sync (10-bit encoders on D3D11
+/// frames).
+pub(crate) fn mode(
+    hdr: bool,
+    hdr_capture: bool,
+    encoder: VideoEncoder,
+    codec: &VideoCodec,
+    yuv444: bool,
+    windows: bool,
+) -> (HdrMode, Option<String>) {
+    if !hdr && !hdr_capture {
+        return (HdrMode::Off, None);
+    }
+    if !windows {
+        return (
+            HdrMode::Off,
+            hdr.then(|| "HDR refused: Windows desktop capture only".to_string()),
+        );
+    }
+    if !hdr {
+        return (HdrMode::SdrFromHdr, None);
+    }
+    let refused = if *codec == VideoCodec::H264 {
+        Some("HDR refused with H.264 (HEVC or AV1 only): SDR image".to_string())
+    } else if yuv444 {
+        Some("HDR refused with 4:4:4 (4:2:0 only): SDR image".to_string())
+    } else if !matches!(
+        encoder,
+        VideoEncoder::NVENC | VideoEncoder::AMF | VideoEncoder::QSV
+    ) {
+        Some(format!(
+            "HDR refused with the {encoder:?} encoder (NVENC, AMF or Quick Sync only): SDR image"
+        ))
+    } else {
+        None
+    };
+    match refused {
+        Some(reason) => (HdrMode::SdrFromHdr, Some(reason)),
+        None => (HdrMode::Pq, None),
+    }
+}
+
+/// NVENC and AMF, an HDR10 guest image: the D3D11 video processor scales
+/// the P010 capture down, P010 out (the frame's BT.2020/PQ labels and HDR
+/// metadata are kept).
+pub(crate) fn d3d11_scale(scale: VideoScale) -> String {
+    format!(
+        "scale_d3d11=width={}:height={}:format=p010",
+        scale.width, scale.height
+    )
+}
+
+/// The pixel format given to Quick Sync's scaler.
+pub(crate) fn qsv_format(mode: HdrMode) -> &'static str {
+    if mode.is_pq() { "p010" } else { "nv12" }
+}
+
+/// The HEVC profile of an HDR10 image (NVENC, AMF, Quick Sync); none for
+/// AV1 (10 bits from the P010 frames) or without HDR.
+pub(crate) fn hevc_profile(mode: HdrMode, codec: &VideoCodec) -> Option<&'static str> {
+    (mode.is_pq() && *codec == VideoCodec::HEVC).then_some("main10")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn no_hdr_is_the_capture_as_before() {
+        for encoder in [VideoEncoder::NVENC, VideoEncoder::X264] {
+            assert_eq!(
+                mode(false, false, encoder, &VideoCodec::H264, true, true),
+                (HdrMode::Off, None)
+            );
+        }
+    }
+
+    #[test]
+    fn hdr10_with_hevc_or_av1_on_hardware_encoders() {
+        for encoder in [VideoEncoder::NVENC, VideoEncoder::AMF, VideoEncoder::QSV] {
+            for codec in [VideoCodec::HEVC, VideoCodec::AV1] {
+                assert_eq!(
+                    mode(true, true, encoder, &codec, false, true),
+                    (HdrMode::Pq, None)
+                );
+                assert_eq!(
+                    mode(true, false, encoder, &codec, false, true),
+                    (HdrMode::Pq, None)
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn hdr_refused_goes_sdr_from_the_float_capture() {
+        let refused = [
+            (VideoEncoder::NVENC, VideoCodec::H264, false),
+            (VideoEncoder::NVENC, VideoCodec::HEVC, true),
+            (VideoEncoder::X264, VideoCodec::HEVC, false),
+            (VideoEncoder::VAAPI, VideoCodec::AV1, false),
+        ];
+        for (encoder, codec, yuv444) in refused {
+            let (m, reason) = mode(true, false, encoder, &codec, yuv444, true);
+            assert_eq!(m, HdrMode::SdrFromHdr, "{encoder:?} {codec:?} {yuv444}");
+            assert!(reason.is_some_and(|r| r.starts_with("HDR refused")));
+        }
+    }
+
+    #[test]
+    fn sdr_guest_of_an_hdr_display() {
+        for encoder in [VideoEncoder::NVENC, VideoEncoder::QSV, VideoEncoder::X264] {
+            assert_eq!(
+                mode(false, true, encoder, &VideoCodec::H264, false, true),
+                (HdrMode::SdrFromHdr, None)
+            );
+        }
+    }
+
+    #[test]
+    fn hdr_is_windows_only() {
+        let (m, reason) = mode(true, true, VideoEncoder::VAAPI, &VideoCodec::HEVC, false, false);
+        assert_eq!(m, HdrMode::Off);
+        assert!(reason.is_some());
+        assert_eq!(
+            mode(false, true, VideoEncoder::VAAPI, &VideoCodec::HEVC, false, false),
+            (HdrMode::Off, None)
+        );
+    }
+
+    #[test]
+    fn capture_options() {
+        assert_eq!(HdrMode::Off.capture_option(), 0);
+        assert_eq!(HdrMode::Pq.capture_option(), 1);
+        assert_eq!(HdrMode::SdrFromHdr.capture_option(), 2);
+    }
+
+    #[test]
+    fn hdr10_filters_and_profile() {
+        assert_eq!(
+            d3d11_scale(VideoScale {
+                width: 1920,
+                height: 1080
+            }),
+            "scale_d3d11=width=1920:height=1080:format=p010"
+        );
+        assert_eq!(qsv_format(HdrMode::Pq), "p010");
+        assert_eq!(qsv_format(HdrMode::SdrFromHdr), "nv12");
+        assert_eq!(qsv_format(HdrMode::Off), "nv12");
+        assert_eq!(hevc_profile(HdrMode::Pq, &VideoCodec::HEVC), Some("main10"));
+        assert_eq!(hevc_profile(HdrMode::Pq, &VideoCodec::AV1), None);
+        assert_eq!(hevc_profile(HdrMode::SdrFromHdr, &VideoCodec::HEVC), None);
+    }
+}
