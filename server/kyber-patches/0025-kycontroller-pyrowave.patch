diff --git a/kycontroller/src/pyrowave.rs b/kycontroller/src/pyrowave.rs
new file mode 100644
index 0000000..578deec
--- /dev/null
+++ b/kycontroller/src/pyrowave.rs
@@ -0,0 +1,77 @@
+// KyberNow (0025): PyroWave (docs/pyrowave.md). A client asks for it only
+// when the Station announces it (KyberNow Admin, `GET /api/stream/info`),
+// with a fallback codec; the Station encodes it only when the engine of
+// `[kyavserver] backend` has a PyroWave encoder on this system and
+// `[kyavserver] pyrowave` allows it. kyavserver checks again with the same
+// rule (0025-kyavservice, `engine_encodes`) and the same fallback.
+
+use kyctl_common::enums::VideoCodec;
+use log::warn;
+
+/// Whether the engine of `[kyavserver] backend` encodes PyroWave on this
+/// system: txproto (the default) on Windows and the Mac (ScreenCaptureKit),
+/// libavconv on Windows and Linux (PipeWire).
+pub(crate) fn engine_encodes(backend: Option<&str>) -> bool {
+    if backend.is_some_and(|b| b.eq_ignore_ascii_case("libavconv")) {
+        cfg!(any(target_os = "windows", target_os = "linux"))
+    } else {
+        cfg!(any(target_os = "windows", target_os = "macos"))
+    }
+}
+
+/// The codec a display's stream gets: PyroWave if asked for and offered,
+/// else the fallback (H.264 without one); any other codec as asked.
+pub(crate) fn codec(asked: VideoCodec, fallback: Option<VideoCodec>, offered: bool) -> VideoCodec {
+    if asked != VideoCodec::PyroWave || offered {
+        return asked;
+    }
+    let fallback = fallback
+        .filter(|c| *c != VideoCodec::PyroWave)
+        .unwrap_or(VideoCodec::H264);
+    warn!("PyroWave not offered by this Station: {fallback:?} instead");
+    fallback
+}
+
+/// The newest PyroWave configuration packet (`KNPW` version) the encoder
+/// writes for a client that reads up to `asked` (its start request): 0 for
+/// another codec, 1 for an app that says nothing (0.11.7 and older), 2 at
+/// most (the newest this Station writes).
+pub(crate) fn header(codec: &VideoCodec, asked: Option<u8>) -> u8 {
+    if *codec != VideoCodec::PyroWave {
+        return 0;
+    }
+    asked.unwrap_or(1).clamp(1, 2)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pyrowave_when_offered_else_the_fallback() {
+        assert_eq!(codec(VideoCodec::PyroWave, Some(VideoCodec::HEVC), true), VideoCodec::PyroWave);
+        assert_eq!(codec(VideoCodec::PyroWave, Some(VideoCodec::HEVC), false), VideoCodec::HEVC);
+        assert_eq!(codec(VideoCodec::PyroWave, None, false), VideoCodec::H264);
+        assert_eq!(codec(VideoCodec::PyroWave, Some(VideoCodec::PyroWave), false), VideoCodec::H264);
+        assert_eq!(codec(VideoCodec::AV1, None, false), VideoCodec::AV1);
+    }
+
+    #[test]
+    fn the_engines_that_encode_pyrowave() {
+        // Same rule as kyavservice's `engine_encodes` (KYB-31).
+        let txproto = cfg!(any(target_os = "windows", target_os = "macos"));
+        let libavconv = cfg!(any(target_os = "windows", target_os = "linux"));
+        assert_eq!(engine_encodes(None), txproto);
+        assert_eq!(engine_encodes(Some("txproto")), txproto);
+        assert_eq!(engine_encodes(Some("libavconv")), libavconv);
+    }
+
+    #[test]
+    fn the_header_an_older_app_reads() {
+        assert_eq!(header(&VideoCodec::HEVC, Some(2)), 0);
+        assert_eq!(header(&VideoCodec::PyroWave, None), 1);
+        assert_eq!(header(&VideoCodec::PyroWave, Some(0)), 1);
+        assert_eq!(header(&VideoCodec::PyroWave, Some(2)), 2);
+        assert_eq!(header(&VideoCodec::PyroWave, Some(9)), 2);
+    }
+}
