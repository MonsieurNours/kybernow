+/* KyberNow (0018): duplication through IDXGIOutput5::DuplicateOutput1, in a
+ * per-monitor-v2 DPI aware process. With the older IDXGIOutput1 call, the
+ * outputs of SudoVDA (IddCx) created after the first one come back with their
+ * content placed at their desktop position inside their own texture. Trial
+ * until checked on a multi-display host. */
+typedef HANDLE kn_dpi_ctx;
+#define KN_DPI_CTX_PMV2 ((kn_dpi_ctx)(intptr_t)-4)
+
+/* {80A07424-AB52-42EB-833C-0C42FD282D98} */
+static const GUID kn_iid_dxgi_output5 = {
+    0x80a07424, 0xab52, 0x42eb, { 0x83, 0x3c, 0x0c, 0x42, 0xfd, 0x28, 0x2d, 0x98 }
+};
+
+static atomic_int kn_dpi_done;
+
+static FARPROC kn_user32(const char *name)
+{
+    HMODULE user32 = GetModuleHandleW(L"user32.dll");
+    return user32 ? GetProcAddress(user32, name) : NULL;
+}
+
+/* DPI awareness of the calling thread, for the log. */
+static const char *kn_dpi_name(void)
+{
+    typedef kn_dpi_ctx (WINAPI *get_ctx_t)(void);
+    typedef int (WINAPI *awareness_t)(kn_dpi_ctx);
+    typedef BOOL (WINAPI *equal_t)(kn_dpi_ctx, kn_dpi_ctx);
+    get_ctx_t get_ctx = (get_ctx_t)(void *)kn_user32("GetThreadDpiAwarenessContext");
+    awareness_t awareness = (awareness_t)(void *)kn_user32("GetAwarenessFromDpiAwarenessContext");
+    equal_t equal = (equal_t)(void *)kn_user32("AreDpiAwarenessContextsEqual");
+    if (!get_ctx || !awareness)
+        return "unknown";
+    kn_dpi_ctx ctx = get_ctx();
+    if (equal && equal(ctx, KN_DPI_CTX_PMV2))
+        return "per-monitor v2";
+    switch (awareness(ctx)) {
+    case 0: return "unaware";
+    case 1: return "system";
+    case 2: return "per-monitor";
+    default: return "unknown";
     }
 }
 
+/* Process (once) and calling thread made per-monitor-v2 DPI aware. */
+static void kn_dpi_aware(void *log)
+{
+    typedef BOOL (WINAPI *set_process_t)(kn_dpi_ctx);
+    typedef kn_dpi_ctx (WINAPI *set_thread_t)(kn_dpi_ctx);
+    set_thread_t set_thread = (set_thread_t)(void *)kn_user32("SetThreadDpiAwarenessContext");
+
+    if (!atomic_exchange(&kn_dpi_done, 1)) {
+        const char *before = kn_dpi_name();
+        set_process_t set_process = (set_process_t)(void *)kn_user32("SetProcessDpiAwarenessContext");
+        BOOL ok = set_process ? set_process(KN_DPI_CTX_PMV2) : FALSE;
+        DWORD err = ok ? 0 : GetLastError();
+        sp_log(log, SP_LOG_INFO, "DXGI: process DPI awareness before: %s, after: %s (SetProcessDpiAwarenessContext: %s, error %lu)\n", before, kn_dpi_name(), ok ? "ok" : "failed", err);
+    }
+    if (set_thread)
+        set_thread(KN_DPI_CTX_PMV2);
+}
+
+/* DuplicateOutput1 with 8-bit BGRA (the format of the rest of the chain),
+ * falling back to DuplicateOutput. */
+static HRESULT kn_duplicate(void *log, IDXGIOutput1 *output, IUnknown *device,
+                            IDXGIOutputDuplication **dup)
+{
+    IDXGIOutput5 *output5 = NULL;
+    HRESULT hr5;
+    HRESULT hr;
+
+    kn_dpi_aware(log);
+    hr5 = IDXGIOutput1_QueryInterface(output, &kn_iid_dxgi_output5, (void **)&output5);
+    if (SUCCEEDED(hr5)) {
+        const DXGI_FORMAT formats[] = { DXGI_FORMAT_B8G8R8A8_UNORM };
+        hr5 = IDXGIOutput5_DuplicateOutput1(output5, device, 0, 1, formats, dup);
+        IDXGIOutput5_Release(output5);
+        if (SUCCEEDED(hr5)) {
+            sp_log(log, SP_LOG_INFO, "DXGI: duplication via DuplicateOutput1 (thread DPI awareness: %s)\n", kn_dpi_name());
+            return hr5;
+        }
+    }
+    hr = IDXGIOutput1_DuplicateOutput(output, device, dup);
+    sp_log(log, SP_LOG_INFO, "DXGI: duplication via DuplicateOutput (DuplicateOutput1 unavailable or failed: 0x%lX; DuplicateOutput: 0x%lX; thread DPI awareness: %s)\n", hr5, hr, kn_dpi_name());
+    return hr;
+}
