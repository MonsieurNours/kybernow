+
+/// GPU priority of the capture and the encoding on Windows (`[kyavserver]
+/// gpu_priority`), see kn_gpu_priority() in kn_timing.h (txproto, libavgrab).
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub(crate) enum GpuPriority {
+    /// Windows' own scheduling, as in Kyber: the capture and the encoding
+    /// wait behind a game that keeps the graphics card busy.
+    Normal,
+    /// Process class HIGH and GPU thread priority 7.
+    #[default]
+    High,
+    /// Process class REALTIME (HIGH if Windows refuses it): always before a
+    /// game's frames, at the risk of a driver freeze on some computers.
+    Realtime,
+}
+
+impl GpuPriority {
+    /// Value of the capture's `gpu_priority` option (KN_GPU_PRIORITY_*).
+    pub(crate) fn capture_option(self) -> i64 {
+        match self {
+            Self::Normal => 0,
+            Self::High => 1,
+            Self::Realtime => 2,
+        }
+    }
+}
