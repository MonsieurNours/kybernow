+/* KyberNow (0022): copies the captured texture `src` into `frame`, through
+ * the converter for an HDR10 stream (P010), or for an SDR one when `src` is
+ * 16-bit float (the SDR image of a display captured in HDR). */
+static int kn_copy_frame(GrabCapture *c, ID3D11DeviceContext *device_ctx,
+                         ID3D11Resource *src, AVFrame *frame)
+{
+    DXGICapture *priv_c = c->priv;
+    ID3D11Texture2D *dst = (ID3D11Texture2D *)frame->data[0];
+    const UINT slice = (UINT)(intptr_t)frame->data[1];
+    ID3D11Texture2D *src2d = NULL;
+    ID3D11Device *device = NULL;
+    D3D11_TEXTURE2D_DESC desc = { 0 };
+    char err[512];
+    int mode;
+    HRESULT hr;
+
+    if (SUCCEEDED(ID3D11Resource_QueryInterface(src, &IID_ID3D11Texture2D, (void **)&src2d))) {
+        ID3D11Texture2D_GetDesc(src2d, &desc);
+        ID3D11Texture2D_Release(src2d);
+    }
+    mode = c->params.hdr == KN_HDR_PQ ? KN_HDR_PQ :
+           desc.Format == DXGI_FORMAT_R16G16B16A16_FLOAT ? KN_HDR_SDR : KN_HDR_OFF;
+    if (mode == KN_HDR_OFF) {
+        ID3D11DeviceContext_CopySubresourceRegion(device_ctx, (ID3D11Resource *)dst, slice,
+                                                  0, 0, 0, src, 0, NULL);
+        return 0;
+    }
+
+    if (priv_c->kn_conv.mode != mode) {
+        int ret;
+        kn_hdr_conv_free(&priv_c->kn_conv);
+        ID3D11DeviceContext_GetDevice(device_ctx, &device);
+        ret = kn_hdr_conv_init(&priv_c->kn_conv, device, mode, err, sizeof(err));
+        ID3D11Device_Release(device);
+        if (ret < 0) {
+            av_log(c, AV_LOG_ERROR, "HDR: no conversion on the graphics card: %s\n", err);
+            return AVERROR_EXTERNAL;
+        }
+        av_log(c, AV_LOG_INFO, "HDR: conversion to %s on the graphics card\n",
+               mode == KN_HDR_PQ ? "HDR10 (PQ, BT.2020, P010)" : "SDR (BT.709, 8 bits)");
+    }
+    hr = kn_hdr_conv_run(&priv_c->kn_conv, device_ctx, src, dst, slice,
+                         frame->width, frame->height, &priv_c->kn_info);
+    if (FAILED(hr)) {
+        if (!priv_c->kn_conv_errors++)
+            av_log(c, AV_LOG_ERROR, "HDR: conversion failed: 0x%lX\n", hr);
+        return AVERROR_EXTERNAL;
+    }
+    if (c->params.hdr == KN_HDR_PQ)
+        return kn_hdr_tag_frame(frame, &priv_c->kn_info);
+    return 0;
+}
