diff --git a/subprojects/libavconv/libavconv/kn_hdr_meta.h b/subprojects/libavconv/libavconv/kn_hdr_meta.h
new file mode 100644
index 0000000..0858667
--- /dev/null
+++ b/subprojects/libavconv/libavconv/kn_hdr_meta.h
@@ -0,0 +1,240 @@
+/*
+ * KyberNow (0022): HDR10 static metadata written into the coded stream.
+ *
+ * The same file is in txproto (src/kn_hdr_meta.h) and in libavconv
+ * (libavconv/kn_hdr_meta.h).
+ *
+ * AMF and Quick Sync write the mastering display and content light level
+ * metadata from the frames' side data. NVENC only does it with the Video
+ * Codec SDK 13 headers, and Kyber builds against SDK 12.1 (older drivers):
+ * for NVENC, the metadata is added to each keyframe after encoding, as a
+ * prefix SEI NAL unit (HEVC, payloads 137 and 144) or as two metadata OBUs
+ * (AV1, HDR_MDCV and HDR_CLL), so that TVs which expect them get them.
+ *
+ * The bitstream writers below use plain C only (tested on any machine);
+ * kn_hdr_add_to_packet() is the FFmpeg glue.
+ */
+
+#ifndef KN_HDR_META_H
+#define KN_HDR_META_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef struct KnHdrMeta {
+    /* CIE 1931 xy, red, green, blue, then white */
+    double primaries[3][2];
+    double white[2];
+    /* cd/m2 */
+    double max_luminance;
+    double min_luminance;
+    unsigned max_cll;
+    unsigned max_fall;
+} KnHdrMeta;
+
+static inline unsigned kn_hdr_fixed(double v, double scale, unsigned max)
+{
+    double f = v * scale + 0.5;
+    if (f < 0)
+        return 0;
+    if (f > (double)max)
+        return max;
+    return (unsigned)f;
+}
+
+static inline size_t kn_hdr_put16(uint8_t *p, unsigned v)
+{
+    p[0] = (uint8_t)(v >> 8);
+    p[1] = (uint8_t)v;
+    return 2;
+}
+
+static inline size_t kn_hdr_put32(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)(v >> 24);
+    p[1] = (uint8_t)(v >> 16);
+    p[2] = (uint8_t)(v >> 8);
+    p[3] = (uint8_t)v;
+    return 4;
+}
+
+/* HEVC: a prefix SEI NAL unit (start code included) with the mastering
+ * display colour volume (137) and content light level (144) messages.
+ * Returns its size, 0 if `size` is too small (64 bytes are always enough). */
+static inline size_t kn_hdr_hevc_sei(const KnHdrMeta *m, uint8_t *out, size_t size)
+{
+    /* G, B, R order (H.265 D.3.28); chromaticity in 0.00002 units,
+     * luminance in 0.0001 cd/m2. */
+    static const int order[3] = { 1, 2, 0 };
+    uint8_t rbsp[40];
+    size_t n = 0, o = 0;
+    int zeros = 0;
+
+    rbsp[n++] = 137;
+    rbsp[n++] = 24;
+    for (int i = 0; i < 3; i++) {
+        n += kn_hdr_put16(rbsp + n, kn_hdr_fixed(m->primaries[order[i]][0], 50000, 50000));
+        n += kn_hdr_put16(rbsp + n, kn_hdr_fixed(m->primaries[order[i]][1], 50000, 50000));
+    }
+    n += kn_hdr_put16(rbsp + n, kn_hdr_fixed(m->white[0], 50000, 50000));
+    n += kn_hdr_put16(rbsp + n, kn_hdr_fixed(m->white[1], 50000, 50000));
+    n += kn_hdr_put32(rbsp + n, kn_hdr_fixed(m->max_luminance, 10000, 0xFFFFFFFFu));
+    n += kn_hdr_put32(rbsp + n, kn_hdr_fixed(m->min_luminance, 10000, 0xFFFFFFFFu));
+    rbsp[n++] = 144;
+    rbsp[n++] = 4;
+    n += kn_hdr_put16(rbsp + n, m->max_cll > 65535 ? 65535 : m->max_cll);
+    n += kn_hdr_put16(rbsp + n, m->max_fall > 65535 ? 65535 : m->max_fall);
+    rbsp[n++] = 0x80; /* rbsp_trailing_bits */
+
+    if (size < 6 + n * 3 / 2 + 1)
+        return 0;
+    out[o++] = 0; out[o++] = 0; out[o++] = 0; out[o++] = 1;
+    out[o++] = 39 << 1; /* PREFIX_SEI_NUT, nuh_layer_id 0 */
+    out[o++] = 1;       /* nuh_temporal_id_plus1 */
+    for (size_t i = 0; i < n; i++) {
+        if (zeros >= 2 && rbsp[i] <= 3) {
+            out[o++] = 3; /* emulation_prevention_three_byte */
+            zeros = 0;
+        }
+        out[o++] = rbsp[i];
+        zeros = rbsp[i] ? 0 : zeros + 1;
+    }
+    return o;
+}
+
+/* AV1: two metadata OBUs, HDR_MDCV then HDR_CLL. Returns their size, 0 if
+ * `size` is too small (64 bytes are always enough). */
+static inline size_t kn_hdr_av1_obus(const KnHdrMeta *m, uint8_t *out, size_t size)
+{
+    size_t o = 0;
+
+    if (size < 48)
+        return 0;
+    /* HDR_MDCV: R, G, B, then white in 0.16 fixed point, luminance max in
+     * 24.8 and min in 18.14. */
+    out[o++] = (5 << 3) | 2; /* OBU_METADATA, obu_has_size_field */
+    out[o++] = 1 + 24 + 1;   /* obu_size (one leb128 byte) */
+    out[o++] = 2;            /* METADATA_TYPE_HDR_MDCV */
+    for (int i = 0; i < 3; i++) {
+        o += kn_hdr_put16(out + o, kn_hdr_fixed(m->primaries[i][0], 65536, 65535));
+        o += kn_hdr_put16(out + o, kn_hdr_fixed(m->primaries[i][1], 65536, 65535));
+    }
+    o += kn_hdr_put16(out + o, kn_hdr_fixed(m->white[0], 65536, 65535));
+    o += kn_hdr_put16(out + o, kn_hdr_fixed(m->white[1], 65536, 65535));
+    o += kn_hdr_put32(out + o, kn_hdr_fixed(m->max_luminance, 256, 0xFFFFFFFFu));
+    o += kn_hdr_put32(out + o, kn_hdr_fixed(m->min_luminance, 16384, 0xFFFFFFFFu));
+    out[o++] = 0x80; /* trailing_bits */
+    /* HDR_CLL */
+    out[o++] = (5 << 3) | 2;
+    out[o++] = 1 + 4 + 1;
+    out[o++] = 1; /* METADATA_TYPE_HDR_CLL */
+    o += kn_hdr_put16(out + o, m->max_cll > 65535 ? 65535 : m->max_cll);
+    o += kn_hdr_put16(out + o, m->max_fall > 65535 ? 65535 : m->max_fall);
+    out[o++] = 0x80;
+    return o;
+}
+
+/* Where the metadata goes in a coded picture: after an access unit
+ * delimiter (HEVC) or a temporal delimiter (AV1) that starts it, at the
+ * start otherwise. -1: not a layout this code knows (left alone). */
+static inline long kn_hdr_insert_at(const uint8_t *data, size_t size, int av1)
+{
+    size_t sc;
+
+    if (av1) {
+        /* Temporal delimiter with a size field: 0x12 0x00. */
+        if (size >= 2 && data[0] == 0x12 && data[1] == 0x00)
+            return 2;
+        if (size >= 1 && ((data[0] >> 3) & 15) != 0 && (data[0] & 2))
+            return 0;
+        return -1;
+    }
+    /* Annex B only (start codes), as NVENC writes it. */
+    if (size >= 4 && !data[0] && !data[1] && !data[2] && data[3] == 1)
+        sc = 4;
+    else if (size >= 3 && !data[0] && !data[1] && data[2] == 1)
+        sc = 3;
+    else
+        return -1;
+    if (size > sc && ((data[sc] >> 1) & 63) == 35) { /* AUD_NUT */
+        for (size_t i = sc + 1; i + 3 <= size; i++)
+            if (!data[i] && !data[i + 1] && data[i + 2] == 1)
+                return (long)((i > 0 && !data[i - 1]) ? i - 1 : i);
+        return (long)size;
+    }
+    return 0;
+}
+
+#ifdef KN_HDR_META_FFMPEG
+#include <libavcodec/avcodec.h>
+#include <libavutil/mastering_display_metadata.h>
+
+/* Whether the metadata must be added by hand to this encoder's keyframes:
+ * NVENC, HEVC or AV1, PQ, with the display's metadata known. */
+static inline int kn_hdr_meta_from_ctx(const AVCodecContext *avctx, KnHdrMeta *m)
+{
+    const AVFrameSideData *sd;
+    const AVMasteringDisplayMetadata *mdm;
+    const char *name = avctx->codec ? avctx->codec->name : NULL;
+    size_t len = name ? strlen(name) : 0;
+
+    if (len < 6 || strcmp(name + len - 6, "_nvenc"))
+        return 0;
+    if (avctx->codec_id != AV_CODEC_ID_HEVC && avctx->codec_id != AV_CODEC_ID_AV1)
+        return 0;
+    if (avctx->color_trc != AVCOL_TRC_SMPTE2084)
+        return 0;
+    sd = av_frame_side_data_get(avctx->decoded_side_data, avctx->nb_decoded_side_data,
+                                AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
+    if (!sd)
+        return 0;
+    mdm = (const AVMasteringDisplayMetadata *)sd->data;
+    if (!mdm->has_primaries || !mdm->has_luminance)
+        return 0;
+    for (int i = 0; i < 3; i++) {
+        m->primaries[i][0] = av_q2d(mdm->display_primaries[i][0]);
+        m->primaries[i][1] = av_q2d(mdm->display_primaries[i][1]);
+    }
+    m->white[0] = av_q2d(mdm->white_point[0]);
+    m->white[1] = av_q2d(mdm->white_point[1]);
+    m->max_luminance = av_q2d(mdm->max_luminance);
+    m->min_luminance = av_q2d(mdm->min_luminance);
+    m->max_cll = m->max_fall = 0;
+    sd = av_frame_side_data_get(avctx->decoded_side_data, avctx->nb_decoded_side_data,
+                                AV_FRAME_DATA_CONTENT_LIGHT_LEVEL);
+    if (sd) {
+        const AVContentLightMetadata *cll = (const AVContentLightMetadata *)sd->data;
+        m->max_cll = cll->MaxCLL;
+        m->max_fall = cll->MaxFALL;
+    }
+    return 1;
+}
+
+/* Adds the HDR10 metadata to a keyframe of an NVENC encoder (see the top of
+ * this file); any other packet is left as is. */
+static inline int kn_hdr_add_to_packet(const AVCodecContext *avctx, AVPacket *pkt)
+{
+    KnHdrMeta m;
+    uint8_t meta[64];
+    size_t n;
+    long at;
+    int av1, ret;
+
+    if (!(pkt->flags & AV_PKT_FLAG_KEY) || pkt->size <= 0 || !kn_hdr_meta_from_ctx(avctx, &m))
+        return 0;
+    av1 = avctx->codec_id == AV_CODEC_ID_AV1;
+    n = av1 ? kn_hdr_av1_obus(&m, meta, sizeof(meta)) : kn_hdr_hevc_sei(&m, meta, sizeof(meta));
+    at = kn_hdr_insert_at(pkt->data, pkt->size, av1);
+    if (!n || at < 0)
+        return 0;
+    ret = av_grow_packet(pkt, (int)n);
+    if (ret < 0)
+        return ret;
+    memmove(pkt->data + at + n, pkt->data + at, pkt->size - n - at);
+    memcpy(pkt->data + at, meta, n);
+    return 0;
+}
+#endif /* KN_HDR_META_FFMPEG */
+
+#endif /* KN_HDR_META_H */
