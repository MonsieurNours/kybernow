diff --git a/kycontroller/src/uplink.rs b/kycontroller/src/uplink.rs
new file mode 100644
index 0000000..9570e34
--- /dev/null
+++ b/kycontroller/src/uplink.rs
@@ -0,0 +1,334 @@
+//! KyberNow (patch 0080): the device's microphone, sent to this computer.
+//!
+//! The device registers a Kymux audio endpoint on the session's connection
+//! and names it in its start request (`uplink.microphone`); the controller
+//! connects to it with the session's audio protocol, like the device does
+//! for the computer's sound, the other way round. Every packet goes to the
+//! Station's own microphone helper, `kybernow-micro` beside this controller
+//! (or the one `KYBERNOW_MICRO` names), started for the session: it decodes
+//! the Opus and plays it into the computer's virtual microphone (VB-CABLE on
+//! Windows, the « Micro KyberNow » device of KyberNow.driver on the Mac, a
+//! PipeWire source on Linux). Several sessions each get their helper; the
+//! system mixes them.
+//!
+//! The helper reads one record per packet on its stdin: a big-endian `u16`
+//! length, then
+//!
+//! - `b'C'`, the codec (big-endian `u32`, Kymux ids: `opus`), the samples per
+//!   packet (`u16`) and the channels (`u8`), before the first media packet
+//!   and at every change;
+//! - `b'M'`, the capture time in microseconds (`u64`), then the packet (the
+//!   Opus header that opens the stream, a configuration packet for Kymux,
+//!   is not passed);
+//! - `b'S'`, alone: the device stopped sending (muted, a one-byte packet
+//!   marked `is_config`); the helper plays silence at once instead of
+//!   waiting for its jitter buffer to run dry.
+//!
+//! `kybernow-micro --check` answers whether the virtual microphone is there
+//! (exit 0), missing (exit 3), or cannot work on this computer (other).
+//!
+//! Who may send: the host always; a KyberNow Share guest only with the
+//! `kn_mic` claim of its token (a friend borrowing the computer gets it, a
+//! share guest when the host allows guests' microphones), changed in session
+//! by `POST /kybernow/role` (`mic`). A refused right drops the packets, the
+//! helper keeps playing silence.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
+
+use kyctl_common::kymux::{StartRequest, StartSessionUplinkResponse};
+use kymux::{kyproto, types::AVPacket};
+use log::{info, warn};
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::process::Command;
+
+use crate::utils::Task;
+
+/// Why the microphone is not taken, as the device reads it.
+pub(crate) const NOT_ALLOWED: &str = "not_allowed";
+pub(crate) const NO_DEVICE: &str = "no_device";
+pub(crate) const UNSUPPORTED: &str = "unsupported";
+
+/// The helper's exit code when the virtual microphone is missing.
+const EXIT_NO_DEVICE: i32 = 3;
+
+/// The microphone helper: `KYBERNOW_MICRO`, else `kybernow-micro` beside
+/// this controller.
+fn helper() -> Option<PathBuf> {
+    if let Some(path) = std::env::var_os("KYBERNOW_MICRO") {
+        let path = PathBuf::from(path);
+        return path.is_file().then_some(path);
+    }
+    let name = if cfg!(windows) {
+        "kybernow-micro.exe"
+    } else {
+        "kybernow-micro"
+    };
+    let path = std::env::current_exe().ok()?.parent()?.join(name);
+    path.is_file().then_some(path)
+}
+
+fn command(path: &PathBuf) -> Command {
+    let mut command = Command::new(path);
+    command
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::piped())
+        .kill_on_drop(true);
+    #[cfg(windows)]
+    command.creation_flags(0x0800_0000); // CREATE_NO_WINDOW
+    command
+}
+
+/// The last check and when it was made: a session start should not wait for
+/// the helper each time (up to 3 s). A ready microphone is trusted for a
+/// minute, a missing one for 10 s (VB-CABLE just installed from Admin).
+static LAST_CHECK: std::sync::Mutex<Option<(std::time::Instant, Result<(), &'static str>)>> =
+    std::sync::Mutex::new(None);
+
+async fn check(path: &PathBuf) -> Result<(), &'static str> {
+    if let Some((at, result)) = *LAST_CHECK.lock().unwrap() {
+        let keep = if result.is_ok() { 60 } else { 10 };
+        if at.elapsed() < Duration::from_secs(keep) {
+            return result;
+        }
+    }
+    let result = check_now(path).await;
+    *LAST_CHECK.lock().unwrap() = Some((std::time::Instant::now(), result));
+    result
+}
+
+/// Asks the helper whether the virtual microphone is there.
+async fn check_now(path: &PathBuf) -> Result<(), &'static str> {
+    let mut command = command(path);
+    command.arg("--check").stdin(std::process::Stdio::null());
+    let status = match tokio::time::timeout(Duration::from_secs(3), command.status()).await {
+        Ok(Ok(status)) => status,
+        Ok(Err(err)) => {
+            warn!("Microphone helper did not start: {err}");
+            return Err(UNSUPPORTED);
+        }
+        Err(_) => {
+            warn!("Microphone helper did not answer its check in 3 s");
+            return Err(UNSUPPORTED);
+        }
+    };
+    match status.code() {
+        Some(0) => Ok(()),
+        Some(EXIT_NO_DEVICE) => Err(NO_DEVICE),
+        _ => Err(UNSUPPORTED),
+    }
+}
+
+/// The helper's record for one packet; `None` for a hole (the helper's
+/// jitter buffer sees the gap in the capture times).
+pub(crate) fn record(packet: &AVPacket) -> Option<Vec<u8>> {
+    let mut body = Vec::new();
+    match packet {
+        AVPacket::Codec(codec) => {
+            body.push(b'C');
+            body.extend_from_slice(&codec.header.codec.to_be_bytes());
+            body.extend_from_slice(&codec.header.frame_size.to_be_bytes());
+            // Kymux's codec header has no channel count: the microphone is mono.
+            body.push(1);
+        }
+        // The Opus header the device sends as configuration: nothing to pass.
+        AVPacket::Media(media) if media.header.is_config && media.payload.starts_with(b"OpusHead") => return None,
+        AVPacket::Media(media) if media.header.is_config && media.payload.len() <= 1 => body.push(b'S'),
+        AVPacket::Media(media) => {
+            body.push(b'M');
+            body.extend_from_slice(&media.header.pts.to_be_bytes());
+            body.extend_from_slice(&media.payload);
+        }
+        AVPacket::Hole(_) => return None,
+    }
+    let len = u16::try_from(body.len()).ok()?;
+    let mut out = Vec::with_capacity(2 + body.len());
+    out.extend_from_slice(&len.to_be_bytes());
+    out.extend_from_slice(&body);
+    Some(out)
+}
+
+/// Takes the device's microphone if it offered one: `None` when it did not
+/// (or over WebSocket, which has no endpoint of the device's own).
+pub(crate) async fn start(
+    connection: Option<&kyproto::Connection>,
+    request: &StartRequest,
+    allowed: Arc<AtomicBool>,
+) -> Option<(Option<Task>, StartSessionUplinkResponse)> {
+    let id = request.uplink.as_ref()?.microphone?;
+    let refuse = |reason: &str| {
+        info!("Device microphone not taken: {reason}");
+        Some((
+            None,
+            StartSessionUplinkResponse {
+                microphone: false,
+                microphone_refused: Some(reason.to_owned()),
+            },
+        ))
+    };
+    let Some(connection) = connection else {
+        return refuse(UNSUPPORTED);
+    };
+    if !allowed.load(Ordering::Relaxed) {
+        return refuse(NOT_ALLOWED);
+    }
+    let Some(path) = helper() else {
+        return refuse(UNSUPPORTED);
+    };
+    if let Err(reason) = check(&path).await {
+        return refuse(reason);
+    }
+    let protocol = request.kymux_config.kyproto_config().audio_protocol;
+    let endpoint = match connection.connect_audio_endpoint(id, protocol.into()) {
+        Ok(endpoint) => endpoint,
+        Err(err) => {
+            warn!("Device microphone endpoint {id:X}: {err}");
+            return refuse(UNSUPPORTED);
+        }
+    };
+    let task = Task::spawn(async move {
+        match endpoint.ready().await {
+            Ok(stream) => run(path, stream, allowed).await,
+            Err(err) => warn!("Device microphone not ready: {err}"),
+        }
+    });
+    info!("Device microphone taken on endpoint {id:X}");
+    Some((
+        Some(task),
+        StartSessionUplinkResponse {
+            microphone: true,
+            microphone_refused: None,
+        },
+    ))
+}
+
+/// Starts the helper and copies the stream to it until either ends.
+async fn run(
+    path: PathBuf,
+    mut stream: kymux::types::ProtocolRecv<AVPacket>,
+    allowed: Arc<AtomicBool>,
+) {
+    let mut command = command(&path);
+    command.stdin(std::process::Stdio::piped());
+    let mut child = match command.spawn() {
+        Ok(child) => child,
+        Err(err) => {
+            warn!("Microphone helper did not start: {err}");
+            return;
+        }
+    };
+    if let Some(errors) = child.stderr.take() {
+        tokio::spawn(async move {
+            let mut lines = BufReader::new(errors).lines();
+            while let Ok(Some(line)) = lines.next_line().await {
+                info!("kybernow-micro: {line}");
+            }
+        });
+    }
+    let Some(mut input) = child.stdin.take() else {
+        return;
+    };
+    let mut codec: Option<Vec<u8>> = None;
+    let mut was_allowed = true;
+    loop {
+        let packet = match stream.recv().await {
+            Ok(Some(packet)) => packet,
+            Ok(None) => break,
+            Err(err) => {
+                info!("Device microphone ended: {err}");
+                break;
+            }
+        };
+        let Some(bytes) = record(&packet) else {
+            continue;
+        };
+        if matches!(packet, AVPacket::Codec(_)) {
+            codec = Some(bytes.clone());
+        }
+        let now_allowed = allowed.load(Ordering::Relaxed);
+        if now_allowed != was_allowed {
+            info!(
+                "Device microphone {}",
+                if now_allowed { "allowed again" } else { "no longer allowed" }
+            );
+            was_allowed = now_allowed;
+            // Silence at once; back: the codec first, in case it changed.
+            let resume = if now_allowed { codec.clone() } else { record(&silence()) };
+            if let Some(resume) = resume
+                && input.write_all(&resume).await.is_err()
+            {
+                break;
+            }
+            if !now_allowed {
+                continue;
+            }
+        }
+        if !now_allowed && !matches!(packet, AVPacket::Codec(_)) {
+            continue;
+        }
+        if let Err(err) = input.write_all(&bytes).await {
+            warn!("Microphone helper stopped reading: {err}");
+            break;
+        }
+    }
+    drop(input);
+    if tokio::time::timeout(Duration::from_secs(1), child.wait())
+        .await
+        .is_err()
+    {
+        let _ = child.kill().await;
+    }
+}
+
+fn silence() -> AVPacket {
+    AVPacket::Media(kymux::types::MediaPacket {
+        header: kymux::types::MediaPacketHeader {
+            is_config: true,
+            is_key: true,
+            pts: 0,
+            size: 1,
+        },
+        payload: bytes::Bytes::from_static(&[0]),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use bytes::Bytes;
+    use kymux::types::{CodecPacket, CodecPacketHeader, MediaPacket, MediaPacketHeader};
+
+    #[test]
+    fn a_codec_record_says_opus_480_mono() {
+        let codec = record(&AVPacket::Codec(CodecPacket {
+            header: CodecPacketHeader {
+                codec: u32::from_be_bytes(*b"opus"),
+                rotation: 0,
+                frame_size: 480,
+            },
+        }))
+        .unwrap();
+        assert_eq!(&codec[..], &[0, 8, b'C', b'o', b'p', b'u', b's', 0x01, 0xe0, 1]);
+    }
+
+    #[test]
+    fn a_media_record_carries_its_time_and_an_empty_one_is_silence() {
+        let media = record(&AVPacket::Media(MediaPacket {
+            header: MediaPacketHeader {
+                is_config: false,
+                is_key: true,
+                pts: 10_000,
+                size: 2,
+            },
+            payload: Bytes::from_static(&[9, 8]),
+        }))
+        .unwrap();
+        assert_eq!(u16::from_be_bytes([media[0], media[1]]), 11);
+        assert_eq!(media[2], b'M');
+        assert_eq!(u64::from_be_bytes(media[3..11].try_into().unwrap()), 10_000);
+        assert_eq!(&media[11..], &[9, 8]);
+        assert_eq!(&record(&silence()).unwrap()[..], &[0, 1, b'S']);
+    }
+}
