@@ -940,6 +940,13 @@ typedef struct AVGrabCaptureParams {
      * brought to 8-bit BGRA).
      */
     int                         hdr;
+
+    /**
+     * KyberNow (0024), Windows desktop duplication: GPU priority of the
+     * capture and encoding work, 0 = Windows' own, 1 = high (the default),
+     * 2 = realtime (high if Windows refuses it).
+     */
+    int                         gpu_priority;
 } AVGrabCaptureParams;
 
