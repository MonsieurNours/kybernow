     c->p.src      = &c->src->p;
     c->p.hooks    = &cp->hooks;
     c->p.params   = &c->params;
+    c->params.gpu_priority = 1; /* KyberNow (0024): high unless set */
 
     if (provider->size_capture) {
         c->priv = av_mallocz(provider->size_capture);
diff --git a/subprojects/libavconv/libavgrab/avgrab.h b/subprojects/libavconv/libavgrab/avgrab.h
index b7fe2b9..23a6a4c 100644
--- a/subprojects/libavconv/libavgrab/avgrab.h
