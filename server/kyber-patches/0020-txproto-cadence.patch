+/* Sends a captured image downstream; KyberNow (0020): a held one too.
+ * Returns sp_frame_fifo_push()'s result: 0, AVERROR(ENOBUFS) for a dropped
+ * image (counted), or the error that stops the capture. */
+static int kn_send_frame(IOSysEntry *entry, DxgiCapture *priv, DxgiCtx *ctx,
+                         AVFrame **frame)
+{
+    FormatExtraData *fe = (FormatExtraData *)(*frame)->opaque_ref->data;
+    int err;
+
+    if (ctx->metrics) {
+        const tx_metrics_entry metrics[] = {
+            { .key = "pts", .value = (*frame)->pts },
+            { .key = "acquired", .value = (*frame)->pts + priv->epoch },
+        };
+        tx_metrics_push(ctx->metrics, metrics, SP_ARRAY_ELEMS(metrics));
+    }
+
+    sp_log(entry, SP_LOG_TRACE, "Pushing frame to FIFO, pts = %f (%I64d)\n",
+           av_q2d(fe->time_base) * (*frame)->pts, (*frame)->pts);
+
+    err = sp_frame_fifo_push(entry->frames, *frame);
+    av_frame_free(frame);
+    if (err == AVERROR(ENOBUFS)) {
+        priv->dropped_frames++;
+        sp_log(entry, SP_LOG_WARN, "Dropping frame (%i dropped so far)!\n",
+            priv->dropped_frames);
+
+        SPGenericData entries[] = {
+            { "dropped_frames", NULL, &priv->dropped_frames, SP_DATA_TYPE_INT},
+            { 0 },
+        };
+        sp_eventlist_dispatch(entry, entry->events, SP_EVENT_ON_STATS, entries);
+    } else if (err) {
+        sp_log(entry, SP_LOG_ERROR, "Unable to push frame to FIFO: %s!\n",
+               av_err2str(err));
+    }
+
+    return err;
+}
