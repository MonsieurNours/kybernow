+/* KyberNow (0020): "max_framerate", at most this many images per second (a
+ * KyberNow Share guest's own image). Images go out on a grid of
+ * 1/max_framerate, each within a quarter of an interval of its time: one
+ * that comes then goes at once; one that comes earlier is held (the latest
+ * one only) until the end of that window, unless a newer one comes. A still
+ * desktop sends nothing more than without it, and a display at that rate (or
+ * a multiple of it) is not held back by its own jitter. Without the option,
+ * every image goes out as it comes. Times in microseconds. */
+static int64_t kn_interval_us(const DxgiCapture *priv)
+{
+    return priv->max_framerate > 0 ? 1000000 / priv->max_framerate : 0;
+}
+
+/* Time left to hold an image that came at `arrived`, <= 0: it goes now. */
+static int64_t kn_hold_us(int64_t arrived, int64_t now, int64_t due, int64_t interval)
+{
+    if (arrived >= due - interval / 4)
+        return 0;
+    return due + interval / 4 - now;
+}
+
+/* Time of the next image, after one sent at `now` for the time `due`: on
+ * time or a little late, the grid goes on; after a pause, it starts again. */
+static int64_t kn_next_due(int64_t due, int64_t now, int64_t interval)
+{
+    return now - due < interval ? due + interval : now + interval;
 }
 
+/* The frame rate given to the encoder (its rate control): the display's
+ * refresh rate, at most max_framerate. */
+static AVRational kn_frame_rate(const DxgiCapture *priv, AVRational refresh)
+{
+    const AVRational max = av_make_q(priv->max_framerate, 1);
+
+    if (priv->max_framerate > 0 &&
+        (!refresh.num || !refresh.den || av_cmp_q(refresh, max) > 0))
+        return max;
+    return refresh;
+}
