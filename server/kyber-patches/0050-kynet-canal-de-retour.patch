diff --git a/kyproto/src/feedback/arrivals.rs b/kyproto/src/feedback/arrivals.rs
new file mode 100644
index 0000000..5917443
--- /dev/null
+++ b/kyproto/src/feedback/arrivals.rs
@@ -0,0 +1,200 @@
+// KyberNow: what the viewer sees of the Station's numbered datagrams
+// (docs/canal-de-retour.md, "Datagram numbering").
+
+use std::collections::{BTreeMap, VecDeque};
+
+use crate::runtime::{Duration, Instant};
+
+/// A gap still open this long after a later datagram came is a loss.
+pub(crate) const LOSE_AFTER: Duration = Duration::from_millis(50);
+/// Window of the out-of-order delays.
+pub(crate) const REORDER_WINDOW: Duration = Duration::from_secs(2);
+/// Gaps followed one by one; past it (a stall), the rest counts lost at once.
+const MAX_GAP: u64 = 16_384;
+/// Datagrams judged lost that a late arrival can still be matched to.
+const RECENT_LOST: usize = 4_096;
+
+/// The missing-frame wait before any numbered datagram, and with an older
+/// Station: Kyber's own.
+pub(crate) const DEFAULT_WAIT: Duration = Duration::from_millis(50);
+pub(crate) const MIN_WAIT: Duration = Duration::from_millis(8);
+const WAIT_MARGIN: Duration = Duration::from_millis(4);
+/// Datagrams to see before the wait follows the measures.
+pub(crate) const WAIT_AFTER_DATAGRAMS: u64 = 500;
+
+/// The missing-frame wait for a disorder of `reorder_us` (99th percentile).
+pub(crate) fn wait_for(reorder_us: u32, seen: u64) -> Duration {
+    if seen < WAIT_AFTER_DATAGRAMS {
+        return DEFAULT_WAIT;
+    }
+    (Duration::from_micros(u64::from(reorder_us)) * 2 + WAIT_MARGIN).clamp(MIN_WAIT, DEFAULT_WAIT)
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct ArrivalLog {
+    hi: Option<u64>,
+    /// Missing numbers, and when a later one made them missing.
+    missing: BTreeMap<u64, Instant>,
+    recent_lost: VecDeque<u64>,
+    pub(crate) received: u64,
+    pub(crate) lost: u64,
+    pub(crate) late: u64,
+    received_i: u32,
+    lost_i: u32,
+    reorder: VecDeque<(Instant, u32)>,
+}
+
+impl ArrivalLog {
+    pub(crate) fn hi_raw(&self) -> u32 {
+        self.hi.unwrap_or(0) as u32
+    }
+
+    pub(crate) fn seen(&self) -> u64 {
+        self.received + self.lost
+    }
+
+    /// A numbered datagram arrived.
+    pub(crate) fn arrived(&mut self, raw: u32, now: Instant) {
+        let Some(hi) = self.hi else {
+            self.hi = Some(u64::from(raw));
+            self.received += 1;
+            self.received_i += 1;
+            return;
+        };
+        let diff = i64::from(raw.wrapping_sub(hi as u32) as i32);
+        let seq = hi as i64 + diff;
+        if seq < 0 {
+            return;
+        }
+        let seq = seq as u64;
+        if seq > hi {
+            let gap = seq - hi - 1;
+            if gap > MAX_GAP {
+                // A stall: what it skipped is lost, not followed one by one.
+                self.lost += gap;
+                self.lost_i = self.lost_i.saturating_add(gap as u32);
+            } else {
+                for s in hi + 1..seq {
+                    self.missing.insert(s, now);
+                }
+            }
+            self.hi = Some(seq);
+            self.received += 1;
+            self.received_i += 1;
+        } else if let Some(noticed) = self.missing.remove(&seq) {
+            let delay = now.saturating_duration_since(noticed);
+            self.reorder.push_back((now, delay.as_micros().min(u32::MAX as u128) as u32));
+            self.received += 1;
+            self.received_i += 1;
+        } else if let Some(i) = self.recent_lost.iter().position(|s| *s == seq) {
+            self.recent_lost.remove(i);
+            self.late += 1;
+        }
+        // Else a copy of one already here: nothing.
+    }
+
+    /// Gaps open for LOSE_AFTER become losses.
+    pub(crate) fn settle(&mut self, now: Instant) {
+        while let Some((&seq, &noticed)) = self.missing.iter().next() {
+            if now.saturating_duration_since(noticed) < LOSE_AFTER {
+                break;
+            }
+            self.missing.remove(&seq);
+            self.lost += 1;
+            self.lost_i += 1;
+            self.recent_lost.push_back(seq);
+            if self.recent_lost.len() > RECENT_LOST {
+                self.recent_lost.pop_front();
+            }
+        }
+        while self
+            .reorder
+            .front()
+            .is_some_and(|(t, _)| now.saturating_duration_since(*t) > REORDER_WINDOW)
+        {
+            self.reorder.pop_front();
+        }
+    }
+
+    /// Datagrams settled and lost since the last call.
+    pub(crate) fn take_interval(&mut self) -> (u32, u32) {
+        let lost = self.lost_i;
+        let settled = self.received_i.saturating_add(lost);
+        self.received_i = 0;
+        self.lost_i = 0;
+        (settled, lost)
+    }
+
+    /// 99th percentile of the out-of-order delays over REORDER_WINDOW, µs.
+    pub(crate) fn reorder_us(&self) -> u32 {
+        super::repair::percentile(self.reorder.iter().map(|(_, d)| f64::from(*d)).collect(), 0.99)
+            as u32
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn in_order_datagrams_lose_nothing_and_wait_little() {
+        let t0 = Instant::now();
+        let mut log = ArrivalLog::default();
+        for i in 0..1000u32 {
+            log.arrived(i, t0 + Duration::from_micros(u64::from(i) * 100));
+        }
+        log.settle(t0 + Duration::from_secs(1));
+        assert_eq!((log.received, log.lost, log.late), (1000, 0, 0));
+        assert_eq!(log.take_interval(), (1000, 0));
+        assert_eq!(log.reorder_us(), 0);
+        assert_eq!(wait_for(log.reorder_us(), log.seen()), MIN_WAIT);
+    }
+
+    #[test]
+    fn a_gap_is_lost_after_50_ms_and_late_after() {
+        let t0 = Instant::now();
+        let mut log = ArrivalLog::default();
+        log.arrived(0, t0);
+        log.arrived(3, t0);
+        log.settle(t0 + Duration::from_millis(10));
+        assert_eq!(log.lost, 0);
+        log.arrived(1, t0 + Duration::from_millis(5));
+        log.settle(t0 + Duration::from_millis(60));
+        assert_eq!((log.received, log.lost), (3, 1));
+        assert_eq!(log.take_interval(), (4, 1));
+        log.arrived(2, t0 + Duration::from_millis(70));
+        assert_eq!(log.late, 1);
+        assert_eq!(log.reorder_us(), 5_000);
+    }
+
+    #[test]
+    fn the_wait_follows_the_disorder_within_its_bounds() {
+        assert_eq!(wait_for(0, 10), DEFAULT_WAIT, "too early");
+        assert_eq!(wait_for(0, 10_000), MIN_WAIT);
+        assert_eq!(wait_for(5_000, 10_000), Duration::from_millis(14));
+        assert_eq!(wait_for(40_000, 10_000), DEFAULT_WAIT);
+    }
+
+    #[test]
+    fn numbers_wrap_around() {
+        let t0 = Instant::now();
+        let mut log = ArrivalLog::default();
+        log.arrived(u32::MAX - 1, t0);
+        log.arrived(u32::MAX, t0);
+        log.arrived(1, t0);
+        log.arrived(0, t0 + Duration::from_millis(1));
+        log.settle(t0 + Duration::from_secs(1));
+        assert_eq!((log.received, log.lost), (4, 0));
+        assert_eq!(log.hi_raw(), 1);
+    }
+
+    #[test]
+    fn a_stall_counts_its_gap_at_once() {
+        let t0 = Instant::now();
+        let mut log = ArrivalLog::default();
+        log.arrived(0, t0);
+        log.arrived(100_000, t0);
+        assert_eq!(log.lost, 99_999);
+        assert!(log.missing.is_empty());
+    }
+}
diff --git a/kyproto/src/feedback/loopback.rs b/kyproto/src/feedback/loopback.rs
new file mode 100644
index 0000000..093a90e
--- /dev/null
+++ b/kyproto/src/feedback/loopback.rs
@@ -0,0 +1,295 @@
+// KyberNow: the feedback channel end to end, over an in-memory connection
+// that drops some of the Station's datagrams.
+
+use std::pin::Pin;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::task::{Context, Poll};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use kymux_types::av::*;
+use kynet::error::{ClosedStreamError, ConnectionError, SendDatagramError};
+use kynet::{ConnectionDriver, ConnectionStats, RecvStream, RecvStreamDriver, SendStream, SendStreamDriver};
+use tokio::io::{AsyncRead, AsyncWrite, DuplexStream, ReadBuf};
+use tokio::sync::{Mutex, mpsc};
+
+use crate::runtime::Duration;
+use crate::{AudioProtocol, Connection, VideoProtocol};
+
+#[derive(Debug)]
+struct Writer(DuplexStream);
+
+impl AsyncWrite for Writer {
+    fn poll_write(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &[u8]) -> Poll<std::io::Result<usize>> {
+        Pin::new(&mut self.0).poll_write(cx, buf)
+    }
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.0).poll_flush(cx)
+    }
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.0).poll_shutdown(cx)
+    }
+}
+
+#[async_trait]
+impl SendStreamDriver for Writer {
+    async fn finish(&mut self) -> Result<(), ClosedStreamError> {
+        Ok(())
+    }
+    fn reset(&mut self) {}
+    async fn closed(&mut self) -> Result<(), ConnectionError> {
+        std::future::pending().await
+    }
+}
+
+#[derive(Debug)]
+struct Reader(DuplexStream);
+
+impl AsyncRead for Reader {
+    fn poll_read(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &mut ReadBuf<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.0).poll_read(cx, buf)
+    }
+}
+
+#[async_trait]
+impl RecvStreamDriver for Reader {
+    fn stop(&mut self) {}
+    async fn closed(&mut self) -> Result<(), ConnectionError> {
+        std::future::pending().await
+    }
+}
+
+fn stream() -> (SendStream, RecvStream) {
+    let (a, b) = tokio::io::duplex(1 << 20);
+    (SendStream::new(Writer(a)), RecvStream::new(Reader(b)))
+}
+
+/// One side of the in-memory connection. Datagrams this side sends are
+/// dropped when `drop(n)` says so (n: their rank, from 0).
+#[derive(Debug)]
+struct Side {
+    uni_tx: mpsc::UnboundedSender<RecvStream>,
+    uni_rx: Mutex<mpsc::UnboundedReceiver<RecvStream>>,
+    bi_tx: mpsc::UnboundedSender<(SendStream, RecvStream)>,
+    bi_rx: Mutex<mpsc::UnboundedReceiver<(SendStream, RecvStream)>>,
+    dg_tx: mpsc::UnboundedSender<Bytes>,
+    dg_rx: Mutex<mpsc::UnboundedReceiver<Bytes>>,
+    sent: AtomicU64,
+    drop_every: u64,
+}
+
+#[async_trait]
+impl ConnectionDriver for Side {
+    async fn open_uni(&self) -> Result<SendStream, ConnectionError> {
+        let (send, recv) = stream();
+        self.uni_tx.send(recv).map_err(|_| ConnectionError("closed".into()))?;
+        Ok(send)
+    }
+    async fn open_bi(&self) -> Result<(SendStream, RecvStream), ConnectionError> {
+        let (send_mine, recv_theirs) = stream();
+        let (send_theirs, recv_mine) = stream();
+        self.bi_tx
+            .send((send_theirs, recv_theirs))
+            .map_err(|_| ConnectionError("closed".into()))?;
+        Ok((send_mine, recv_mine))
+    }
+    async fn accept_uni(&self) -> Result<RecvStream, ConnectionError> {
+        self.uni_rx.lock().await.recv().await.ok_or_else(|| ConnectionError("closed".into()))
+    }
+    async fn accept_bi(&self) -> Result<(SendStream, RecvStream), ConnectionError> {
+        self.bi_rx.lock().await.recv().await.ok_or_else(|| ConnectionError("closed".into()))
+    }
+    async fn read_datagram(&self) -> Result<Bytes, ConnectionError> {
+        self.dg_rx.lock().await.recv().await.ok_or_else(|| ConnectionError("closed".into()))
+    }
+    async fn send_datagram(&self, data: Bytes) -> Result<(), SendDatagramError> {
+        let n = self.sent.fetch_add(1, Ordering::Relaxed);
+        if self.drop_every > 0 && n % self.drop_every == self.drop_every - 1 {
+            return Ok(());
+        }
+        let _ = self.dg_tx.send(data);
+        Ok(())
+    }
+    async fn closed(&self) -> Result<(), ConnectionError> {
+        std::future::pending().await
+    }
+    fn close(&self, _error_code: u32, _reason: &str) {}
+    fn max_datagram_size(&self) -> Option<usize> {
+        Some(1200)
+    }
+    async fn stats(&self) -> ConnectionStats {
+        ConnectionStats { rtt: Some(Duration::from_millis(1)), packets_lost: Some(0) }
+    }
+}
+
+/// (Station, viewer): the Station drops one datagram in `drop_every`.
+fn pair(drop_every: u64) -> (kynet::Connection, kynet::Connection) {
+    let (uni_a, uni_b) = (mpsc::unbounded_channel(), mpsc::unbounded_channel());
+    let (bi_a, bi_b) = (mpsc::unbounded_channel(), mpsc::unbounded_channel());
+    let (dg_a, dg_b) = (mpsc::unbounded_channel(), mpsc::unbounded_channel());
+    let station = Side {
+        uni_tx: uni_a.0,
+        uni_rx: Mutex::new(uni_b.1),
+        bi_tx: bi_a.0,
+        bi_rx: Mutex::new(bi_b.1),
+        dg_tx: dg_a.0,
+        dg_rx: Mutex::new(dg_b.1),
+        sent: AtomicU64::new(0),
+        drop_every,
+    };
+    let viewer = Side {
+        uni_tx: uni_b.0,
+        uni_rx: Mutex::new(uni_a.1),
+        bi_tx: bi_b.0,
+        bi_rx: Mutex::new(bi_a.1),
+        dg_tx: dg_b.0,
+        dg_rx: Mutex::new(dg_a.1),
+        sent: AtomicU64::new(0),
+        drop_every: 0,
+    };
+    (kynet::Connection::new(station), kynet::Connection::new(viewer))
+}
+
+fn codec(frame_size: u16) -> AVPacket {
+    AVPacket::Codec(CodecPacket { header: CodecPacketHeader { codec: 1, rotation: 0, frame_size } })
+}
+
+fn config() -> AVPacket {
+    AVPacket::Media(MediaPacket {
+        header: MediaPacketHeader { is_config: true, is_key: false, pts: 0, size: 16 },
+        payload: Bytes::from(vec![0; 16]),
+    })
+}
+
+fn media(pts: u64, key: bool, size: usize) -> AVPacket {
+    AVPacket::Media(MediaPacket {
+        header: MediaPacketHeader { is_config: false, is_key: key, pts, size: size as u32 },
+        payload: Bytes::from(vec![(pts % 251) as u8; size]),
+    })
+}
+
+struct Received {
+    media: u64,
+    holes: u64,
+}
+
+/// Audio (10 ms packets of 300 bytes, sped up) and video (frames of 5
+/// symbols) for about 1.5 s, one Station datagram in `drop_every` lost.
+async fn run(drop_every: u64, feedback: bool, audio_redundancy: bool) -> (Received, Received, Option<crate::FeedbackHostSnapshot>, Option<crate::FeedbackClientSnapshot>) {
+    let (a, b) = pair(drop_every);
+    let (station, viewer) = tokio::join!(Connection::accept(a), Connection::connect(b));
+    let (station, viewer) = (station.unwrap(), viewer.unwrap());
+
+    let host = if feedback {
+        Some(station.register_feedback_endpoint(audio_redundancy).await.unwrap())
+    } else {
+        None
+    };
+    let audio_protocol = if feedback && audio_redundancy { AudioProtocol::Unreliable } else { AudioProtocol::UnreliableFec };
+    let (audio_id, audio_ep) = station.register_audio_endpoint(audio_protocol).await.unwrap();
+    let (video_id, video_ep) = station.register_video_endpoint(VideoProtocol::UnreliableFec).await.unwrap();
+    let client = host.as_ref().map(|(id, _)| viewer.connect_feedback_endpoint(*id).unwrap());
+    let audio_in = viewer.connect_audio_endpoint(audio_id, audio_protocol).unwrap();
+    let video_in = viewer.connect_video_endpoint(video_id, VideoProtocol::UnreliableFec).unwrap();
+    let (audio_out, audio_in) = tokio::join!(audio_ep.ready(), audio_in.ready());
+    let (video_out, video_in) = tokio::join!(video_ep.ready(), video_in.ready());
+    let (mut audio_out, audio_in) = (audio_out.unwrap(), audio_in.unwrap());
+    let (mut video_out, video_in) = (video_out.unwrap(), video_in.unwrap());
+
+    let count = |mut r: kymux_types::ProtocolRecv<AVPacket>| {
+        tokio::spawn(async move {
+            let mut got = Received { media: 0, holes: 0 };
+            while let Ok(Ok(Some(p))) = tokio::time::timeout(Duration::from_millis(300), r.recv()).await {
+                match p {
+                    AVPacket::Media(_) => got.media += 1,
+                    AVPacket::Hole(_) => got.holes += 1,
+                    AVPacket::Codec(_) => {}
+                }
+            }
+            got
+        })
+    };
+    let audio_count = count(audio_in);
+    let video_count = count(video_in);
+
+    // Codec and config packets go over streams: let them arrive before the
+    // datagrams that need them, as on a real network.
+    audio_out.send(codec(480)).await.unwrap();
+    audio_out.send(config()).await.unwrap();
+    video_out.send(codec(0)).await.unwrap();
+    video_out.send(config()).await.unwrap();
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    for i in 0..600u64 {
+        audio_out.send(media(i * 10_000, false, 300)).await.unwrap();
+        if i % 4 == 0 {
+            video_out.send(media(i * 10_000, i == 0, 5_000)).await.unwrap();
+        }
+        tokio::time::sleep(Duration::from_millis(2)).await;
+    }
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    let host_snapshot = host.as_ref().map(|(_, h)| h.snapshot());
+    let client_snapshot = client.as_ref().map(|c| c.snapshot());
+    (audio_count.await.unwrap(), video_count.await.unwrap(), host_snapshot, client_snapshot)
+}
+
+#[tokio::test]
+async fn the_channel_measures_the_losses_and_the_sound_survives_them() {
+    let (audio, video, host, client) = run(20, true, true).await;
+    assert_eq!((audio.media, audio.holes), (601, 0), "each lost datagram comes back with the next");
+    assert_eq!((video.media, video.holes), (151, 0), "150 frames and the config packet");
+    let host = host.unwrap();
+    let report = host.last_report.unwrap();
+    assert!(report.received > 1_000, "{report:?}");
+    let loss = report.lost as f64 / (report.received + report.lost) as f64;
+    assert!((0.04..0.06).contains(&loss), "{loss}");
+    // Per 100 ms interval, one in 20 lost: around 5 %, more in some.
+    assert!((0.04..0.10).contains(&host.loss_p95), "{}", host.loss_p95);
+    assert!(host.protected_loss.is_some(), "the repair follows the reports");
+    assert!(host.repair_ratio > 0.0);
+    let client = client.unwrap();
+    assert_eq!(client.wait_us, 8_000, "in-order datagrams: the shortest wait");
+    assert_eq!(client.lost_frames, 0);
+    let beat = client.beat.unwrap();
+    assert!(beat.audio_redundancy);
+    assert!(beat.loss_p95_pm >= 40, "{beat:?}");
+}
+
+#[tokio::test]
+async fn without_the_channel_the_former_transport_runs() {
+    let (audio, video, _, _) = run(20, false, false).await;
+    // RaptorQ's 30 % repairs these losses as before.
+    assert_eq!((audio.media, audio.holes), (601, 0));
+    assert_eq!((video.media, video.holes), (151, 0));
+}
+
+#[tokio::test]
+async fn plain_datagrams_without_redundancy_lose_sound() {
+    // The channel on, the sound's redundancy off and the sound in plain
+    // datagrams: the losses show, so the test above proves the copies.
+    let (a, b) = pair(20);
+    let (station, viewer) = tokio::join!(Connection::accept(a), Connection::connect(b));
+    let (station, viewer) = (station.unwrap(), viewer.unwrap());
+    let (_, _host) = station.register_feedback_endpoint(false).await.unwrap();
+    let (audio_id, audio_ep) = station.register_audio_endpoint(AudioProtocol::Unreliable).await.unwrap();
+    let audio_in = viewer.connect_audio_endpoint(audio_id, AudioProtocol::Unreliable).unwrap();
+    let (out, inp) = tokio::join!(audio_ep.ready(), audio_in.ready());
+    let (mut out, mut inp) = (out.unwrap(), inp.unwrap());
+    out.send(codec(480)).await.unwrap();
+    out.send(config()).await.unwrap();
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    let counter = tokio::spawn(async move {
+        let mut media_n = 0;
+        while let Ok(Ok(Some(p))) = tokio::time::timeout(Duration::from_millis(300), inp.recv()).await {
+            if matches!(p, AVPacket::Media(_)) {
+                media_n += 1;
+            }
+        }
+        media_n
+    });
+    for i in 0..200u64 {
+        out.send(media(i * 10_000, false, 300)).await.unwrap();
+        tokio::time::sleep(Duration::from_millis(2)).await;
+    }
+    let media_n = counter.await.unwrap();
+    assert!(media_n < 201 && media_n >= 186, "{media_n}");
+}
diff --git a/kyproto/src/feedback/mod.rs b/kyproto/src/feedback/mod.rs
new file mode 100644
index 0000000..93f5d9b
--- /dev/null
+++ b/kyproto/src/feedback/mod.rs
@@ -0,0 +1,879 @@
+// KyberNow: feedback channel from the viewer to the Station, and what uses
+// it: the RaptorQ repair share, the missing-frame wait and the sound's
+// redundancy. Contract: docs/canal-de-retour.md (KyberNow repository).
+//
+// Nothing here runs unless the viewer asked for it in its start request
+// and the Station answered: an older peer on either side keeps Kyber's
+// former transport.
+
+pub(crate) mod arrivals;
+pub(crate) mod repair;
+#[cfg(all(test, not(target_family = "wasm")))]
+mod loopback;
+
+use std::collections::{HashMap, VecDeque};
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering};
+
+use bytes::{BufMut, Bytes, BytesMut};
+use kymux_util::*;
+#[allow(unused)]
+use log::{debug, error, info, warn};
+use serde::{Deserialize, Serialize};
