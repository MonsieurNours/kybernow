+    /// KyberNow: the Station's end of the feedback channel, for a viewer
+    /// that asked for it. From now on every datagram of this connection is
+    /// numbered: call it before the media endpoints. With
+    /// `audio_redundancy`, the sound sent in `Unreliable` carries the
+    /// previous packet too.
+    pub async fn register_feedback_endpoint(
+        &self,
+        audio_redundancy: bool,
+    ) -> Result<(u16, FeedbackHost), ProtocolError> {
+        let id = self.get_endpoint_id();
+        let ready_notifier = self
+            .control
+            .register_ready_notifier(id)
+            .map_err(ProtocolError::new)?;
+        self.control
+            .register_endpoint(id)
+            .await
+            .map_err(ProtocolError::new)?;
+        let ky_channel = self.router.register(id).map_err(ProtocolError::new)?;
+        let host = feedback::start_host(
+            ky_channel,
+            ready_notifier,
+            self.router.transport().clone(),
+            self.conn.clone(),
+            audio_redundancy,
+        );
+        Ok((id, host))
+    }
+
+    /// KyberNow: the viewer's end of the feedback channel the Station opened.
