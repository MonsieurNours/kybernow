diff --git a/kyproto/src/feedback/repair.rs b/kyproto/src/feedback/repair.rs
new file mode 100644
index 0000000..be947e6
--- /dev/null
+++ b/kyproto/src/feedback/repair.rs
@@ -0,0 +1,295 @@
+// KyberNow: RaptorQ repair share from the raw loss the viewer reports
+// (docs/canal-de-retour.md, "Picture repair").
+
+use std::collections::VecDeque;
+
+use crate::runtime::{Duration, Instant};
+
+/// Residual loss aimed at, per frame: probability that more datagrams of a
+/// frame are lost than its repair symbols can make up for.
+pub(crate) const TARGET_MISS: f64 = 1e-3;
+/// Loss probability protected against on a path that reports none.
+pub(crate) const FLOOR_LOSS: f64 = 0.005;
+/// Weight of the reported 95th percentile.
+pub(crate) const GAIN: f64 = 1.25;
+/// Highest loss probability protected against (past it, the automatic
+/// bitrate has to act, the repair alone cannot).
+pub(crate) const MAX_LOSS: f64 = 0.35;
+/// Frames up to this many source symbols take an exact repair count.
+const EXACT_UP_TO: usize = 128;
+/// One-sided normal quantile for TARGET_MISS (1e-3).
+const Z: f64 = 3.09;
+
+/// Window of the reported losses.
+pub(crate) const LOSS_WINDOW: Duration = Duration::from_secs(5);
+/// An interval settling fewer datagrams says too little to be counted.
+pub(crate) const MIN_SETTLED: u32 = 20;
+
+/// The former rule: 30 % of the source symbols, at least 2.
+pub(crate) fn legacy_repair(source_symbols: usize) -> u32 {
+    ((source_symbols as f32 * 0.3).ceil() as u32).max(2)
+}
+
+/// P(X > r) for X ~ Binomial(n, p).
+fn tail_above(n: usize, r: usize, p: f64) -> f64 {
+    if r >= n {
+        return 0.0;
+    }
+    let q = 1.0 - p;
+    let mut pmf = q.powi(n as i32);
+    let mut cdf = pmf;
+    for i in 0..r {
+        pmf *= (n - i) as f64 / (i + 1) as f64 * p / q;
+        cdf += pmf;
+    }
+    (1.0 - cdf).max(0.0)
+}
+
+/// Largest repair count a frame of `k` source symbols may take.
+fn cap(k: usize) -> u32 {
+    (k.div_ceil(2) as u32).max(3)
+}
+
+/// Smallest repair count keeping a frame of `k` source symbols whole with
+/// probability 1 - TARGET_MISS at loss probability `p`.
+pub(crate) fn repair_for(k: usize, p: f64) -> u32 {
+    let k = k.max(1);
+    let cap = cap(k);
+    if k > EXACT_UP_TO {
+        let mean = k as f64 * p;
+        // The binomial's right tail is heavier than the normal's: 2 more
+        // symbols cover the skew (checked against the exact count at 128).
+        let r = ((mean + Z * (mean * (1.0 - p)).sqrt()) / (1.0 - p)).ceil() as u32 + 2;
+        return r.clamp(1, cap);
+    }
+    let mut r = 1;
+    while r < cap && tail_above(k + r as usize, r as usize, p) > TARGET_MISS {
+        r += 1;
+    }
+    r
+}
+
+/// Loss probability protected against, from the reports' 95th percentile.
+pub(crate) fn protected_loss(p95: f64) -> f64 {
+    (FLOOR_LOSS + GAIN * p95).min(MAX_LOSS)
+}
+
+/// The repair rule in force on a connection.
+#[derive(Debug, Clone)]
+pub(crate) struct RepairPolicy {
+    /// `None`: the former 30 % and at least 2 (no feedback, or not yet).
+    loss: Option<f64>,
+    /// Repair count for 1..=EXACT_UP_TO source symbols (index 0 unused).
+    table: Vec<u32>,
+}
+
+impl Default for RepairPolicy {
+    fn default() -> Self {
+        Self::legacy()
+    }
+}
+
+impl RepairPolicy {
+    pub(crate) fn legacy() -> Self {
+        Self { loss: None, table: Vec::new() }
+    }
+
+    pub(crate) fn adaptive(loss: f64) -> Self {
+        let mut table = vec![0; EXACT_UP_TO + 1];
+        for (k, r) in table.iter_mut().enumerate().skip(1) {
+            *r = repair_for(k, loss);
+        }
+        Self { loss: Some(loss), table }
+    }
+
+    pub(crate) fn loss(&self) -> Option<f64> {
+        self.loss
+    }
+
+    pub(crate) fn repair_symbols(&self, source_symbols: usize) -> u32 {
+        match self.loss {
+            None => legacy_repair(source_symbols),
+            Some(p) => match self.table.get(source_symbols.max(1)) {
+                Some(&r) => r,
+                None => repair_for(source_symbols, p),
+            },
+        }
+    }
+
+    /// Share aimed at, in ‰ of the source symbols, for a frame of 50 symbols
+    /// (a 60 KB frame, about 30 Mbit/s at 60 fps): what the beat announces.
+    pub(crate) fn share_pm(&self) -> u16 {
+        let k = 50;
+        (self.repair_symbols(k) as u64 * 1000 / k as u64).min(u16::MAX as u64) as u16
+    }
+}
+
+/// The share of datagrams lost per reported interval, over LOSS_WINDOW.
+#[derive(Debug, Default)]
+pub(crate) struct LossWindow {
+    samples: VecDeque<(Instant, f64)>,
+}
+
+/// Samples kept at most: a report every 100 ms makes about 50 in the
+/// window; a player sending reports without end must not make the Station
+/// sort thousands of them every 100 ms.
+const MAX_SAMPLES: usize = 100;
+
+impl LossWindow {
+    pub(crate) fn push(&mut self, at: Instant, settled: u32, lost: u32) {
+        if settled < MIN_SETTLED {
+            return;
+        }
+        self.samples
+            .push_back((at, f64::from(lost.min(settled)) / f64::from(settled)));
+        while self
+            .samples
+            .front()
+            .is_some_and(|(t, _)| at.saturating_duration_since(*t) > LOSS_WINDOW)
+            || self.samples.len() > MAX_SAMPLES
+        {
+            self.samples.pop_front();
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn len(&self) -> usize {
+        self.samples.len()
+    }
+
+    /// 95th percentile (nearest rank), 0 without samples.
+    pub(crate) fn p95(&self) -> f64 {
+        percentile(self.samples.iter().map(|(_, f)| *f).collect(), 0.95)
+    }
+}
+
+/// Nearest-rank percentile of `values` (0 when empty).
+pub(crate) fn percentile(mut values: Vec<f64>, q: f64) -> f64 {
+    if values.is_empty() {
+        return 0.0;
+    }
+    values.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));
+    let rank = ((q * values.len() as f64).ceil() as usize).clamp(1, values.len());
+    values[rank - 1]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_former_rule_stays_without_feedback() {
+        let p = RepairPolicy::legacy();
+        // Kyber's f32 rounding included (0.3 × 50 = 15.000001 → 16).
+        let expected: Vec<u32> = [1usize, 10, 50, 300]
+            .iter()
+            .map(|&k| ((k as f32 * 0.3).ceil() as u32).max(2))
+            .collect();
+        assert_eq!(
+            [1, 10, 50, 300].map(|k| p.repair_symbols(k)).to_vec(),
+            expected
+        );
+        assert_eq!(p.repair_symbols(50), 16);
+    }
+
+    #[test]
+    fn a_clean_path_takes_little_repair() {
+        let p = RepairPolicy::adaptive(protected_loss(0.0));
+        assert_eq!(p.repair_symbols(1), 1);
+        assert_eq!(p.repair_symbols(10), 2);
+        assert_eq!(p.repair_symbols(50), 3);
+        assert!(p.repair_symbols(300) <= 8, "{}", p.repair_symbols(300));
+        assert!(p.repair_symbols(4000) <= 4000 / 50, "{}", p.repair_symbols(4000));
+    }
+
+    #[test]
+    fn every_frame_size_meets_the_target_or_its_cap() {
+        for p95 in [0.0, 0.01, 0.02, 0.05, 0.1] {
+            let p = protected_loss(p95);
+            for k in 1..=EXACT_UP_TO {
+                let r = repair_for(k, p);
+                assert!(r >= 1 && r <= cap(k));
+                if r < cap(k) {
+                    assert!(tail_above(k + r as usize, r as usize, p) <= TARGET_MISS);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn the_normal_approximation_meets_the_exact_count_at_the_seam() {
+        for p95 in [0.0, 0.02, 0.05] {
+            let p = protected_loss(p95);
+            let exact = repair_for(EXACT_UP_TO, p);
+            let approx = repair_for(EXACT_UP_TO + 1, p);
+            assert!(approx + 1 >= exact, "p {p}: exact {exact}, approx {approx}");
+            // And it still meets the target.
+            let k = EXACT_UP_TO + 1;
+            assert!(tail_above(k + approx as usize, approx as usize, p) <= 2.0 * TARGET_MISS);
+        }
+    }
+
+    #[test]
+    fn more_loss_more_repair_up_to_half() {
+        let low = RepairPolicy::adaptive(protected_loss(0.01));
+        let high = RepairPolicy::adaptive(protected_loss(0.1));
+        assert!(high.repair_symbols(100) > low.repair_symbols(100));
+        let worst = RepairPolicy::adaptive(protected_loss(1.0));
+        assert_eq!(worst.repair_symbols(100), 50);
+        assert_eq!(worst.repair_symbols(1000), 500);
+    }
+
+    #[test]
+    fn the_window_keeps_five_seconds_of_whole_intervals() {
+        let t0 = Instant::now();
+        let mut w = LossWindow::default();
+        w.push(t0, 10, 5); // too few datagrams: ignored
+        assert_eq!(w.len(), 0);
+        for i in 0..100u64 {
+            let lost = if i % 10 == 0 { 10 } else { 0 };
+            w.push(t0 + Duration::from_millis(i * 100), 100, lost);
+        }
+        assert_eq!(w.len(), 51);
+        assert!((w.p95() - 0.1).abs() < 1e-9);
+    }
+
+    #[test]
+    fn the_window_is_capped() {
+        let t0 = Instant::now();
+        let mut w = LossWindow::default();
+        // Ten thousand reports in the same second.
+        for _ in 0..10_000 {
+            w.push(t0, 100, 1);
+        }
+        assert_eq!(w.len(), MAX_SAMPLES);
+    }
+
+    /// A simulated frame stream through Bernoulli losses: the residual loss
+    /// stays near the target at the reported rate.
+    #[test]
+    fn simulated_random_losses_keep_frames_whole() {
+        let mut seed = 0x2545_f491_4f6c_dd1du64;
+        let mut rand = move || {
+            seed ^= seed << 13;
+            seed ^= seed >> 7;
+            seed ^= seed << 17;
+            (seed >> 11) as f64 / (1u64 << 53) as f64
+        };
+        for (loss, sizes) in [(0.02, [3usize, 20, 60]), (0.05, [3, 20, 60])] {
+            let policy = RepairPolicy::adaptive(protected_loss(loss));
+            for k in sizes {
+                let r = policy.repair_symbols(k) as usize;
+                let frames = 20_000;
+                let mut missed = 0;
+                for _ in 0..frames {
+                    let got = (0..k + r).filter(|_| rand() >= loss).count();
+                    if got < k {
+                        missed += 1;
+                    }
+                }
+                let rate = missed as f64 / frames as f64;
+                assert!(rate <= 0.003, "loss {loss}, K {k}, R {r}: {rate}");
+            }
+        }
+    }
+}
