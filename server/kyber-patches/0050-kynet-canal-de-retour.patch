+// Station side.
+
+/// The Station's view of one viewer.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct FeedbackHostSnapshot {
+    /// Raw loss, 95th percentile over 5 s (0 to 1).
+    pub loss_p95: f64,
+    /// Loss probability the repair protects against, `None` while the
+    /// former 30 % holds.
+    pub protected_loss: Option<f64>,
+    /// Repair sent over the last second, over the source bytes (0.3 = 30 %).
+    pub repair_ratio: f64,
+    pub last_report: Option<Report>,
+}
+
+/// A picture packet the viewer lost, as the Station sent it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct LostFrame {
+    pub seq: u32,
+    pub pts: u64,
+    pub key: bool,
+}
+
+#[derive(Debug, Clone)]
+pub enum FeedbackEvent {
+    /// Packets `first..first + count` of picture endpoint `endpoint` will
+    /// never reach the decoder. `frames`: those the Station still knows.
+    Lost {
+        endpoint: u16,
+        first: u32,
+        count: u32,
+        frames: Vec<LostFrame>,
+    },
+    Report(Report),
+}
+
+/// The Station's end of a viewer's feedback channel. Dropping it stops the
+/// channel (the repair goes back to the former rule).
+pub struct FeedbackHost {
+    endpoint: u16,
+    events: broadcast::Sender<FeedbackEvent>,
+    snapshot: KyArc<KyMutex<FeedbackHostSnapshot>>,
+    transport: KyArc<Transport>,
+    _task: Task,
+}
+
+impl FeedbackHost {
+    pub fn endpoint(&self) -> u16 {
+        self.endpoint
+    }
+
+    pub fn subscribe(&self) -> broadcast::Receiver<FeedbackEvent> {
+        self.events.subscribe()
+    }
+
+    pub fn snapshot(&self) -> FeedbackHostSnapshot {
+        self.snapshot.lock().clone()
+    }
+
+    pub fn audio_redundancy(&self) -> bool {
+        self.transport.audio_redundancy()
+    }
+}
+
+impl Drop for FeedbackHost {
+    fn drop(&mut self) {
+        *self.transport.repair.lock() = RepairPolicy::legacy();
+    }
+}
+
+pub(crate) fn start_host(
+    channel: KyChannel,
+    ready: crate::control::ReadyNotifier,
+    transport: KyArc<Transport>,
+    conn: kynet::Connection,
+    audio_redundancy: bool,
+) -> FeedbackHost {
+    transport.audio_redundancy.store(audio_redundancy, Ordering::Relaxed);
+    transport.numbering.store(true, Ordering::Relaxed);
+    let endpoint = channel.endpoint_id();
+    let (events, _) = broadcast::channel(64);
+    let snapshot = KyArc::new(KyMutex::new(FeedbackHostSnapshot::default()));
+    let task = {
+        let events = events.clone();
+        let snapshot = snapshot.clone();
+        let transport = transport.clone();
+        Task::spawn_task(
+            async move {
+                if let Err(err) = ready.ready().await {
+                    warn!("Feedback endpoint not ready: {err}");
+                    return;
+                }
+                if let Err(err) = run_host(channel, transport, conn, events, snapshot).await {
+                    info!("Feedback channel ended: {err}");
+                }
+            },
+            "feedback host",
+        )
+    };
+    FeedbackHost { endpoint, events, snapshot, transport, _task: task }
+}
+
+struct HostState {
+    window: LossWindow,
+    first_report: Option<Instant>,
+    last_report: Option<Instant>,
+    last_n: Option<u32>,
+    /// The loss ids already handled, newest last (`LOSS_IDS_KEPT`).
+    loss_ids: VecDeque<u32>,
+    /// New losses still handled in this period (`LOSSES_PER_PERIOD`).
+    losses_left: u32,
+    /// Cumulative source and repair bytes, once per period, over 1 s.
+    counters: VecDeque<(Instant, u64, u64)>,
+    lost_frames: u64,
+}
+
+/// Loss ids remembered as handled: a loss repeated in the next reports (8
+/// of them) is handled once, and one reported out of order is still handled
+/// (a threshold on the newest id skipped it: losses 3 and 4, `Lost(3)` lost
+/// or late, 3 was never repaired).
+const LOSS_IDS_KEPT: usize = 64;
+/// New losses handled per period at most (a misbehaving player must not
+/// make the Station repair without end).
+const LOSSES_PER_PERIOD: u32 = 32;
+
+impl HostState {
+    /// Whether a loss with this id is new (ids grow, wrapping): not handled
+    /// yet, and not older than the ids kept.
+    fn new_loss(&mut self, id: u32) -> bool {
+        if self.loss_ids.contains(&id) {
+            return false;
+        }
+        if let Some(&newest) = self.loss_ids.back()
+            && self.loss_ids.len() >= LOSS_IDS_KEPT
+            && (id.wrapping_sub(newest) as i32) < -(LOSS_IDS_KEPT as i32)
+        {
+            return false; // older than what is remembered
+        }
+        if self.losses_left == 0 {
+            return false;
+        }
+        self.losses_left -= 1;
+        // Kept in id order, the newest last.
+        let at = self
+            .loss_ids
+            .iter()
+            .rposition(|&kept| (id.wrapping_sub(kept) as i32) > 0)
+            .map_or(0, |i| i + 1);
+        self.loss_ids.insert(at, id);
+        if self.loss_ids.len() > LOSS_IDS_KEPT {
+            self.loss_ids.pop_front();
+        }
+        true
+    }
+}
+
+fn lost_event(transport: &Transport, loss: &FrameLoss) -> FeedbackEvent {
+    let frames = transport
+        .sent
+        .lock()
+        .get(&loss.ep)
+        .map(|ring| {
+            ring.iter()
+                .filter(|f| f.seq.wrapping_sub(loss.first) < loss.count)
+                .map(|f| LostFrame { seq: f.seq, pts: f.pts, key: f.key })
+                .collect()
+        })
+        .unwrap_or_default();
+    FeedbackEvent::Lost { endpoint: loss.ep, first: loss.first, count: loss.count, frames }
+}
+
+async fn run_host(
+    mut channel: KyChannel,
+    transport: KyArc<Transport>,
+    conn: kynet::Connection,
+    events: broadcast::Sender<FeedbackEvent>,
+    snapshot: KyArc<KyMutex<FeedbackHostSnapshot>>,
+) -> Result<(), ProtocolError> {
+    let mut st = HostState {
+        window: LossWindow::default(),
+        first_report: None,
+        last_report: None,
+        last_n: None,
+        loss_ids: VecDeque::new(),
+        losses_left: LOSSES_PER_PERIOD,
+        counters: VecDeque::new(),
+        lost_frames: 0,
+    };
+    let mut beat = Beat {
+        audio_redundancy: transport.audio_redundancy(),
+        ..Default::default()
+    };
+    let mut next_tick = Instant::now() + PERIOD;
+    let mut next_log = Instant::now() + LOG_EVERY;
+    loop {
+        tokio::select! {
+            datagram = channel.recv_datagram() => {
+                let datagram = datagram.map_err(ProtocolError::new)?;
+                let now = Instant::now();
+                match decode(&datagram) {
+                    Some(Msg::Report(report)) => {
+                        if st.last_n.is_some_and(|n| (report.n.wrapping_sub(n) as i32) <= 0) {
+                            continue; // older than one already read
+                        }
+                        st.last_n = Some(report.n);
+                        st.first_report.get_or_insert(now);
+                        st.last_report = Some(now);
+                        st.window.push(now, report.expected_i, report.lost_i);
+                        for loss in &report.losses {
+                            if st.new_loss(loss.id) {
+                                st.lost_frames += u64::from(loss.count);
+                                let _ = events.send(lost_event(&transport, loss));
+                            }
+                        }
+                        beat.report = report.n;
+                        snapshot.lock().last_report = Some(report.clone());
+                        let _ = events.send(FeedbackEvent::Report(report));
+                    }
+                    Some(Msg::Lost(loss)) => {
+                        if st.new_loss(loss.id) {
+                            st.lost_frames += u64::from(loss.count);
+                            let _ = events.send(lost_event(&transport, &loss));
+                        }
+                    }
+                    _ => {} // unknown, or not for this side
+                }
+            }
+            _ = runtime::sleep_until(next_tick) => {
+                let now = Instant::now();
+                next_tick = now + PERIOD;
+                st.losses_left = LOSSES_PER_PERIOD;
+                // Repair rule.
+                let trusted = st.first_report.is_some_and(|t| now.saturating_duration_since(t) >= TRUST_AFTER)
+                    && st.last_report.is_some_and(|t| now.saturating_duration_since(t) < SILENCE);
+                let p95 = st.window.p95();
+                let wanted = trusted.then(|| repair::protected_loss(p95));
+                {
+                    let mut policy = transport.repair.lock();
+                    let change = match (policy.loss(), wanted) {
+                        (None, None) => false,
+                        (Some(a), Some(b)) => (a - b).abs() > a.min(b) * 0.05,
+                        _ => true,
+                    };
+                    if change {
+                        *policy = match wanted {
+                            Some(p) => RepairPolicy::adaptive(p),
+                            None => RepairPolicy::legacy(),
+                        };
+                    }
+                    beat.repair_pm = policy.share_pm();
+                }
+                // Repair actually sent over the last second.
+                let src = transport.source_bytes.load(Ordering::Relaxed);
+                let rep = transport.repair_bytes.load(Ordering::Relaxed);
+                st.counters.push_back((now, src, rep));
+                while st.counters.len() > 2
+                    && st.counters.get(1).is_some_and(|(t, _, _)| now.saturating_duration_since(*t) >= Duration::from_secs(1))
+                {
+                    st.counters.pop_front();
+                }
+                let ratio = match st.counters.front() {
+                    Some(&(_, s0, r0)) if src > s0 => (rep - r0) as f64 / (src - s0) as f64,
+                    _ => 0.0,
+                };
+                let stats = KyChannel::connection_stats_(&conn).await;
+                beat.n = beat.n.wrapping_add(1);
+                beat.repair_ratio_pm = (ratio * 1000.0).round().min(f64::from(u16::MAX)) as u16;
+                beat.loss_p95_pm = (p95 * 1000.0).round() as u16;
+                beat.rtt_us = stats.rtt.map_or(0, |d| d.as_micros().min(u32::MAX as u128) as u32);
+                beat.quic_lost = stats.packets_lost.unwrap_or(0);
+                {
+                    let mut s = snapshot.lock();
+                    s.loss_p95 = p95;
+                    s.protected_loss = wanted;
+                    s.repair_ratio = ratio;
+                }
+                if let Some(datagram) = encode(&channel, &Msg::Beat(beat.clone())) {
+                    // A full send queue drops the beat: the next one follows.
+                    let _ = channel.send_datagram(datagram).await;
+                }
+                if now >= next_log {
+                    next_log = now + LOG_EVERY;
+                    let last = snapshot.lock().last_report.clone().unwrap_or_default();
+                    info!(
+                        "Feedback: raw loss p95 {:.1} %, repair {} ‰ aimed, {} ‰ sent, wait {} ms, disorder p99 {} µs, datagrams lost {}/{} (late {}), frames lost {}",
+                        p95 * 100.0,
+                        beat.repair_pm,
+                        beat.repair_ratio_pm,
+                        last.wait_us / 1000,
+                        last.reorder_us,
+                        last.lost,
+                        last.received + last.lost,
+                        last.late,
+                        st.lost_frames,
+                    );
+                }
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Viewer side.
+
+/// The viewer's view of the channel, cumulative since it started.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct FeedbackClientSnapshot {
+    pub received: u64,
+    pub lost: u64,
+    pub late: u64,
+    pub reorder_us: u32,
+    pub wait_us: u32,
+    /// Picture packets handed to the decoder and given up, all endpoints.
+    pub frames: u64,
+    pub lost_frames: u64,
+    /// The Station's last beat, if any.
+    pub beat: Option<Beat>,
+}
+
+/// The viewer's end of the feedback channel. Dropping it stops the reports
+/// (the wait goes back to 50 ms).
+pub struct FeedbackClient {
+    snapshot: KyArc<KyMutex<FeedbackClientSnapshot>>,
+    transport: KyArc<Transport>,
+    _task: Task,
+}
+
+impl FeedbackClient {
+    pub fn snapshot(&self) -> FeedbackClientSnapshot {
+        self.snapshot.lock().clone()
+    }
+
+    /// A handle that reads the snapshot without keeping the channel alive.
+    pub fn reader(&self) -> FeedbackClientReader {
+        FeedbackClientReader { snapshot: self.snapshot.clone() }
+    }
+}
+
+#[derive(Clone)]
+pub struct FeedbackClientReader {
+    snapshot: KyArc<KyMutex<FeedbackClientSnapshot>>,
+}
+
+impl FeedbackClientReader {
+    pub fn snapshot(&self) -> FeedbackClientSnapshot {
+        self.snapshot.lock().clone()
+    }
+}
+
+impl Drop for FeedbackClient {
+    fn drop(&mut self) {
+        self.transport.wait_us.store(0, Ordering::Relaxed);
+    }
+}
+
+pub(crate) fn start_client(
+    channel: KyChannel,
+    ready: crate::control::ReadyNotifier,
+    transport: KyArc<Transport>,
+) -> FeedbackClient {
+    let snapshot = KyArc::new(KyMutex::new(FeedbackClientSnapshot::default()));
+    let task = {
+        let snapshot = snapshot.clone();
+        let transport = transport.clone();
+        Task::spawn_task(
+            async move {
+                if let Err(err) = ready.ready().await {
+                    warn!("Feedback endpoint not ready: {err}");
+                    return;
+                }
+                if let Err(err) = run_client(channel, transport, snapshot).await {
+                    info!("Feedback channel ended: {err}");
+                }
+            },
+            "feedback client",
+        )
+    };
+    FeedbackClient { snapshot, transport, _task: task }
+}
+
+fn build_report(transport: &Transport, n: u32, now: Instant) -> Report {
+    let (hi, received, lost, late, (expected_i, lost_i), reorder_us, seen) = {
+        let mut log = transport.arrivals.lock();
+        log.settle(now);
+        (log.hi_raw(), log.received, log.lost, log.late, log.take_interval(), log.reorder_us(), log.seen())
+    };
+    let wait = arrivals::wait_for(reorder_us, seen);
+    let wait_us = wait.as_micros() as u32;
+    transport.wait_us.store(wait_us, Ordering::Relaxed);
+    let book = transport.book.lock();
+    let mut streams: Vec<StreamReport> = book
+        .endpoints
+        .iter()
+        .map(|(&ep, e)| StreamReport { ep, delivered: e.delivered, frames: e.frames, lost: e.lost })
+        .collect();
+    streams.sort_by_key(|s| s.ep);
+    Report {
+        n,
+        hi,
+        received,
+        lost,
+        late,
+        expected_i,
+        lost_i,
+        reorder_us,
+        wait_us,
+        streams,
+        losses: book.losses.iter().copied().collect(),
+    }
+}
+
+async fn run_client(
+    mut channel: KyChannel,
+    transport: KyArc<Transport>,
+    snapshot: KyArc<KyMutex<FeedbackClientSnapshot>>,
+) -> Result<(), ProtocolError> {
+    let mut n = 0u32;
+    let mut next_tick = Instant::now() + PERIOD;
+    loop {
+        tokio::select! {
+            datagram = channel.recv_datagram() => {
+                let datagram = datagram.map_err(ProtocolError::new)?;
+                if let Some(Msg::Beat(beat)) = decode(&datagram) {
+                    snapshot.lock().beat = Some(beat);
+                }
+            }
+            _ = transport.loss_notify.notified() => {
+                let pending = std::mem::take(&mut transport.book.lock().pending);
+                for loss in pending {
+                    if let Some(datagram) = encode(&channel, &Msg::Lost(loss)) {
+                        let _ = channel.send_datagram(datagram).await;
+                    }
+                }
+            }
+            _ = runtime::sleep_until(next_tick) => {
+                let now = Instant::now();
+                next_tick = now + PERIOD;
+                n = n.wrapping_add(1);
+                let report = build_report(&transport, n, now);
+                {
+                    let mut s = snapshot.lock();
+                    s.received = report.received;
+                    s.lost = report.lost;
+                    s.late = report.late;
+                    s.reorder_us = report.reorder_us;
+                    s.wait_us = report.wait_us;
+                    s.frames = report.streams.iter().map(|e| e.frames).sum();
+                    s.lost_frames = report.streams.iter().map(|e| e.lost).sum();
+                }
+                match encode(&channel, &Msg::Report(report)) {
+                    Some(datagram) => {
+                        let _ = channel.send_datagram(datagram).await;
+                    }
+                    None => warn!("Feedback report too large for a datagram"),
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn host_state() -> HostState {
+        HostState {
+            window: LossWindow::default(),
+            first_report: None,
+            last_report: None,
+            last_n: None,
+            loss_ids: VecDeque::new(),
+            losses_left: LOSSES_PER_PERIOD,
+            counters: VecDeque::new(),
+            lost_frames: 0,
+        }
+    }
+
+    #[test]
+    fn losses_out_of_order_are_all_handled_once() {
+        let mut st = host_state();
+        // Lost(3) lost: the report repeats [3, 4] after Lost(4).
+        assert!(st.new_loss(4));
+        assert!(st.new_loss(3), "an older loss not handled yet");
+        assert!(!st.new_loss(3));
+        assert!(!st.new_loss(4));
+        assert!(st.new_loss(5));
+        // Ids wrap.
+        let mut st = host_state();
+        assert!(st.new_loss(u32::MAX));
+        assert!(st.new_loss(0));
+        assert!(!st.new_loss(u32::MAX));
+    }
+
+    #[test]
+    fn old_and_too_many_losses_are_dropped() {
+        let mut st = host_state();
+        for id in 100..100 + LOSSES_PER_PERIOD {
+            assert!(st.new_loss(id));
+        }
+        assert!(!st.new_loss(1000), "past the period's budget");
+        st.losses_left = LOSSES_PER_PERIOD;
+        assert!(st.new_loss(1000));
+        for id in 2000..2000 + LOSS_IDS_KEPT as u32 {
+            st.losses_left = LOSSES_PER_PERIOD;
+            st.new_loss(id);
+        }
+        assert!(!st.new_loss(100), "older than the ids kept");
+    }
+
+    #[test]
+    fn messages_keep_their_fields_and_ignore_new_ones() {
+        let report = Report {
+            n: 7,
+            received: 1000,
+            lost: 3,
+            streams: vec![StreamReport { ep: 4, delivered: 99, frames: 100, lost: 1 }],
+            losses: vec![FrameLoss { id: 1, ep: 4, first: 50, count: 1 }],
+            ..Default::default()
+        };
+        let bytes = rmp_serde::to_vec_named(&Msg::Report(report.clone())).unwrap();
+        match rmp_serde::from_slice::<Msg>(&bytes).unwrap() {
+            Msg::Report(r) => assert_eq!(r, report),
+            other => panic!("{other:?}"),
+        }
+
+        // A later version's beat: one more field, one fewer.
+        #[derive(Serialize)]
+        struct LaterBeat {
+            n: u32,
+            repair_pm: u16,
+            something_new: String,
+        }
+        #[derive(Serialize)]
+        enum LaterMsg {
+            Beat(LaterBeat),
+        }
+        let bytes = rmp_serde::to_vec_named(&LaterMsg::Beat(LaterBeat {
+            n: 3,
+            repair_pm: 40,
+            something_new: "x".into(),
+        }))
+        .unwrap();
+        match rmp_serde::from_slice::<Msg>(&bytes).unwrap() {
+            Msg::Beat(b) => {
+                assert_eq!((b.n, b.repair_pm, b.rtt_us), (3, 40, 0));
+            }
+            other => panic!("{other:?}"),
+        }
+
+        // A message kind this version does not know: not decoded, ignored.
+        #[derive(Serialize)]
+        enum Unknown {
+            Recovery { frame: u32 },
+        }
+        let bytes = rmp_serde::to_vec_named(&Unknown::Recovery { frame: 1 }).unwrap();
+        let mut datagram = vec![0, 0];
+        datagram.extend(bytes);
+        assert!(decode(&datagram).is_none());
+    }
+
+    #[test]
+    fn a_full_report_fits_a_small_datagram() {
+        let report = Report {
+            n: u32::MAX,
+            hi: u32::MAX,
+            received: u64::MAX,
+            lost: u64::MAX,
+            late: u64::MAX,
+            expected_i: u32::MAX,
+            lost_i: u32::MAX,
+            reorder_us: u32::MAX,
+            wait_us: u32::MAX,
+            streams: vec![
+                StreamReport { ep: u16::MAX, delivered: u32::MAX, frames: u64::MAX, lost: u64::MAX };
+                4
