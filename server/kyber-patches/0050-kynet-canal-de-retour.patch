+
+/// Version of the channel, `v` of the request and the answer.
+pub const FEEDBACK_VERSION: u32 = 1;
+
+/// Top bit of the endpoint id: the datagram ends with its number.
+pub(crate) const NUMBERED: u16 = 0x8000;
+pub(crate) const SEQ_SIZE: usize = 4;
+
+/// Reports and beats.
+const PERIOD: Duration = Duration::from_millis(100);
+/// Frame losses repeated in each report.
+const LOSSES_REPEATED: usize = 8;
+/// Packets the Station remembers per picture endpoint (pts, keyframe).
+const SENT_KEPT: usize = 512;
+/// Reports needed before the repair follows them, and silence after which
+/// it goes back to the former rule.
+const TRUST_AFTER: Duration = Duration::from_secs(1);
+const SILENCE: Duration = Duration::from_secs(1);
+/// Summary in the Station's log.
+const LOG_EVERY: Duration = Duration::from_secs(10);
+
+// ---------------------------------------------------------------------------
+// Messages (MessagePack with field names).
+
+/// A picture packet the viewer gave up.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct FrameLoss {
+    pub id: u32,
+    pub ep: u16,
+    pub first: u32,
+    pub count: u32,
+}
+
+/// One picture endpoint as the viewer sees it.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct StreamReport {
+    pub ep: u16,
+    /// Last packet number handed to the decoder.
+    pub delivered: u32,
+    pub frames: u64,
+    pub lost: u64,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Report {
+    pub n: u32,
+    pub hi: u32,
+    pub received: u64,
+    pub lost: u64,
+    pub late: u64,
+    pub expected_i: u32,
+    pub lost_i: u32,
+    pub reorder_us: u32,
+    pub wait_us: u32,
+    pub streams: Vec<StreamReport>,
+    pub losses: Vec<FrameLoss>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Beat {
+    pub n: u32,
+    pub report: u32,
+    pub repair_pm: u16,
+    pub repair_ratio_pm: u16,
+    pub loss_p95_pm: u16,
+    pub audio_redundancy: bool,
+    pub rtt_us: u32,
+    pub quic_lost: u64,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+enum Msg {
+    Report(Report),
+    Lost(FrameLoss),
+    Beat(Beat),
+}
+
+fn encode(channel: &KyChannel, msg: &Msg) -> Option<Bytes> {
+    let body = rmp_serde::to_vec_named(msg).ok()?;
+    let mut buf = BytesMut::with_capacity(2 + body.len());
+    channel.write_datagram_header(&mut buf);
+    buf.put(&body[..]);
+    let max = channel.max_datagram_size()?;
+    (buf.len() <= max).then(|| buf.freeze())
+}
+
+fn decode(datagram: &[u8]) -> Option<Msg> {
+    rmp_serde::from_slice(datagram.get(2..)?).ok()
+}
+
+// ---------------------------------------------------------------------------
+// Per-connection state, shared by the router and the endpoints.
+
+#[derive(Debug, Clone, Copy)]
+struct SentFrame {
+    seq: u32,
+    pts: u64,
+    key: bool,
+}
+
+#[derive(Debug, Default)]
+struct EndpointBook {
+    delivered: u32,
+    frames: u64,
+    lost: u64,
+}
+
+#[derive(Debug, Default)]
+struct Book {
+    endpoints: HashMap<u16, EndpointBook>,
+    losses: VecDeque<FrameLoss>,
+    pending: Vec<FrameLoss>,
+    next_id: u32,
+}
+
+pub(crate) struct Transport {
+    // Station side.
+    numbering: AtomicBool,
+    next_seq: AtomicU32,
+    repair: KyMutex<RepairPolicy>,
+    audio_redundancy: AtomicBool,
+    source_bytes: AtomicU64,
+    repair_bytes: AtomicU64,
+    sent: KyMutex<HashMap<u16, VecDeque<SentFrame>>>,
+    // Viewer side.
+    arrivals: KyMutex<ArrivalLog>,
+    wait_us: AtomicU32,
+    book: KyMutex<Book>,
+    loss_notify: Notify,
+}
+
+impl Default for Transport {
+    fn default() -> Self {
+        Self {
+            numbering: AtomicBool::new(false),
+            next_seq: AtomicU32::new(0),
+            repair: KyMutex::new(RepairPolicy::legacy()),
+            audio_redundancy: AtomicBool::new(false),
+            source_bytes: AtomicU64::new(0),
+            repair_bytes: AtomicU64::new(0),
+            sent: KyMutex::new(HashMap::new()),
+            arrivals: KyMutex::new(ArrivalLog::default()),
+            wait_us: AtomicU32::new(0),
+            book: KyMutex::new(Book::default()),
+            loss_notify: Notify::new(),
+        }
+    }
+}
+
+impl Transport {
+    // --- Numbering (router).
+
+    pub(crate) fn numbering(&self) -> bool {
+        self.numbering.load(Ordering::Relaxed)
+    }
+
+    pub(crate) fn next_seq(&self) -> u32 {
+        self.next_seq.fetch_add(1, Ordering::Relaxed)
+    }
+
+    pub(crate) fn arrived(&self, raw: u32) {
+        self.arrivals.lock().arrived(raw, Instant::now());
+    }
+
+    // --- Picture repair (sender).
+
+    pub(crate) fn repair_symbols(&self, source_symbols: usize) -> u32 {
+        self.repair.lock().repair_symbols(source_symbols)
+    }
+
+    pub(crate) fn count_repair(&self, source_bytes: usize, repair_bytes: usize) {
+        self.source_bytes.fetch_add(source_bytes as u64, Ordering::Relaxed);
+        self.repair_bytes.fetch_add(repair_bytes as u64, Ordering::Relaxed);
+    }
+
+    pub(crate) fn sent_frame(&self, ep: u16, seq: u32, pts: u64, key: bool) {
+        if !self.numbering() {
+            return;
+        }
+        let mut sent = self.sent.lock();
+        let ring = sent.entry(ep).or_default();
+        ring.push_back(SentFrame { seq, pts, key });
+        while ring.len() > SENT_KEPT {
+            ring.pop_front();
+        }
+    }
+
+    // --- Sound (sender).
+
+    pub(crate) fn audio_redundancy(&self) -> bool {
+        self.audio_redundancy.load(Ordering::Relaxed)
+    }
+
+    // --- Picture receiver.
+
+    pub(crate) fn video_wait(&self) -> Duration {
+        match self.wait_us.load(Ordering::Relaxed) {
+            0 => arrivals::DEFAULT_WAIT,
+            us => Duration::from_micros(u64::from(us)),
+        }
+    }
+
+    pub(crate) fn delivered(&self, ep: u16, seq: u64) {
+        let mut book = self.book.lock();
+        let e = book.endpoints.entry(ep).or_default();
+        e.delivered = seq as u32;
+        e.frames += 1;
+    }
+
+    pub(crate) fn gave_up(&self, ep: u16, first: u64, count: u64) {
+        {
+            let mut book = self.book.lock();
+            book.endpoints.entry(ep).or_default().lost += count;
+            let id = book.next_id;
+            book.next_id = book.next_id.wrapping_add(1);
+            let loss = FrameLoss { id, ep, first: first as u32, count: count.min(u32::MAX as u64) as u32 };
+            book.losses.push_back(loss);
+            while book.losses.len() > LOSSES_REPEATED {
+                book.losses.pop_front();
+            }
+            book.pending.push(loss);
+            if book.pending.len() > 64 {
+                book.pending.remove(0);
+            }
+        }
+        self.loss_notify.notify_one();
+    }
+}
