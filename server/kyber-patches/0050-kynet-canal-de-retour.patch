+            losses: vec![FrameLoss { id: u32::MAX, ep: u16::MAX, first: u32::MAX, count: u32::MAX }; 8],
+        };
+        let bytes = rmp_serde::to_vec_named(&Msg::Report(report)).unwrap();
+        assert!(bytes.len() < 1000, "{}", bytes.len());
+    }
+
+    #[test]
+    fn the_viewer_book_repeats_its_last_losses() {
+        let t = Transport::default();
+        for i in 0..10 {
+            t.gave_up(4, i * 10, 1);
+        }
+        t.delivered(4, 95);
+        let r = build_report(&t, 1, Instant::now());
+        assert_eq!(r.losses.len(), LOSSES_REPEATED);
+        assert_eq!(r.losses.first().unwrap().id, 2);
+        assert_eq!(r.streams, vec![StreamReport { ep: 4, delivered: 95, frames: 1, lost: 10 }]);
+        assert_eq!(r.wait_us, 50_000, "no datagram seen yet");
+    }
+
+    #[test]
+    fn the_station_names_the_lost_frames_it_still_knows() {
+        let t = Transport::default();
+        t.numbering.store(true, Ordering::Relaxed);
+        for seq in 0..600u32 {
+            t.sent_frame(2, seq, u64::from(seq) * 16_666, seq % 100 == 0);
+        }
+        match lost_event(&t, &FrameLoss { id: 0, ep: 2, first: 599, count: 1 }) {
+            FeedbackEvent::Lost { frames, .. } => {
+                assert_eq!(frames, vec![LostFrame { seq: 599, pts: 599 * 16_666, key: false }])
+            }
+            other => panic!("{other:?}"),
