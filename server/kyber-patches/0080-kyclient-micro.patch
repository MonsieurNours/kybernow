+/// KyberNow (0080): feeds the microphone endpoint once the computer
+/// connects to it, or notes why it does not take it.
+fn feed_microphone(
+    uplink: &crate::uplink::Uplink,
+    host_config: &StartSessionResponse,
+    id: u16,
+    endpoint: types::AudioServerEndpoint,
+) -> Option<runtime::Task> {
+    use crate::uplink::UplinkState;
+    let answer = host_config.uplink.as_ref();
+    if !answer.is_some_and(|a| a.microphone) {
+        let reason = match answer {
+            Some(a) => a
+                .microphone_refused
+                .clone()
+                .unwrap_or_else(|| "unsupported".to_owned()),
+            None => "old_station".to_owned(),
+        };
+        info!("The computer does not take the microphone: {reason}");
+        uplink.set_state(UplinkState::Refused(reason));
+        return None;
+    }
+    let uplink = uplink.clone();
+    Some(runtime::Task::spawn(async move {
+        let mut sender = match endpoint.ready().await {
+            Ok(sender) => sender,
+            Err(err) => {
+                warn!("Microphone endpoint {id:X} not ready: {err:?}");
+                uplink.set_state(UplinkState::Refused("unsupported".to_owned()));
+                return;
+            }
+        };
+        info!("Microphone sent on endpoint {id:X}");
+        let mut packets = uplink.open();
+        while let Some(packet) = packets.recv().await {
+            if let Err(err) = sender.send(packet).await {
+                warn!("Microphone stopped: {err:?}");
+                break;
+            }
+        }
+        uplink.close();
+    }))
+}
