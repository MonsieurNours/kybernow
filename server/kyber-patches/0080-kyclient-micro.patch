diff --git a/kyclient/src/uplink.rs b/kyclient/src/uplink.rs
new file mode 100644
index 0000000..8d689bc
--- /dev/null
+++ b/kyclient/src/uplink.rs
@@ -0,0 +1,212 @@
+//! KyberNow (patch 0080): what the device sends to the computer, its
+//! microphone (docs/micro.md).
+//!
+//! The application keeps one [`Uplink`] for the whole session (it outlives
+//! the image's restarts) and gives it to each [`crate::StreamingSessionConfig`].
+//! With [`Uplink::set_offer`] on, every start of the image registers a Kymux
+//! audio endpoint on the session's connection and names it in the start
+//! request; the computer connects to it if it takes the microphone, and says
+//! why not otherwise ([`UplinkState::Refused`]). The application encodes
+//! (Opus, mono, 48 kHz) and hands each packet to [`Uplink::send`]; the codec
+//! packet goes first on every endpoint that opens.
+//!
+//! Packets are lossy and never wait: a packet the connection has no room for
+//! is dropped (late sound is worse than a gap, the computer conceals it).
+
+use std::sync::{Arc, Mutex};
+
+use kymux::types::{AVPacket, CodecPacket, CodecPacketHeader, MediaPacket, MediaPacketHeader};
+use tokio::sync::mpsc;
+
+/// Packets waiting for the connection: 100 ms of 10 ms Opus packets.
+const QUEUED: usize = 10;
+
+/// Whether the computer takes the microphone.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub enum UplinkState {
+    /// Not offered, or no image started yet.
+    #[default]
+    Idle,
+    /// Offered, waiting for the computer's answer or its connection.
+    Offered,
+    /// The computer takes it: packets go.
+    Open,
+    /// The computer does not take it: `not_allowed`, `no_device`,
+    /// `unsupported`, or `old_station` (a controller without patch 0080).
+    Refused(String),
+}
+
+#[derive(Default)]
+struct Inner {
+    offer: bool,
+    codec: Option<CodecPacketHeader>,
+    tx: Option<mpsc::Sender<AVPacket>>,
+    state: UplinkState,
+}
+
+/// The application's handle on the device's microphone. Clones share it.
+#[derive(Clone, Default)]
+pub struct Uplink(Arc<Mutex<Inner>>);
+
+impl std::fmt::Debug for Uplink {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "Uplink({:?})", self.state())
+    }
+}
+
+impl Uplink {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Offers the microphone at the next start of the image (on: the
+    /// application can send; it may still send nothing, as when muted).
+    pub fn set_offer(&self, offer: bool) {
+        self.0.lock().unwrap().offer = offer;
+    }
+
+    pub fn offered(&self) -> bool {
+        self.0.lock().unwrap().offer
+    }
+
+    /// The codec (a Kymux id: `u32::from_be_bytes(*b"opus")`) and the samples
+    /// per packet. Kept, sent first on each endpoint that opens.
+    pub fn set_codec(&self, codec: u32, frame_size: u16) {
+        let header = CodecPacketHeader {
+            codec,
+            rotation: 0,
+            frame_size,
+        };
+        let mut inner = self.0.lock().unwrap();
+        if let Some(tx) = &inner.tx {
+            let _ = tx.try_send(AVPacket::Codec(CodecPacket {
+                header: header.clone(),
+            }));
+        }
+        inner.codec = Some(header);
+    }
+
+    /// One encoded packet, captured at `pts` microseconds. `false` when the
+    /// computer does not take the microphone (nothing sent). An empty packet
+    /// says the device stopped sending: the computer plays silence at once.
+    /// It travels as one byte marked `is_config` (the transport's error
+    /// correction wants a payload).
+    pub fn send(&self, payload: &[u8], pts: u64) -> bool {
+        let inner = self.0.lock().unwrap();
+        let Some(tx) = &inner.tx else {
+            return false;
+        };
+        let silence = payload.is_empty();
+        let payload: &[u8] = if silence { &[0] } else { payload };
+        let packet = AVPacket::Media(MediaPacket {
+            header: MediaPacketHeader {
+                is_config: silence,
+                is_key: true,
+                pts,
+                size: payload.len() as u32,
+            },
+            payload: payload.to_vec().into(),
+        });
+        match tx.try_send(packet) {
+            Ok(()) | Err(mpsc::error::TrySendError::Full(_)) => true,
+            Err(mpsc::error::TrySendError::Closed(_)) => false,
+        }
+    }
+
+    pub fn state(&self) -> UplinkState {
+        self.0.lock().unwrap().state.clone()
+    }
+
+    pub fn is_open(&self) -> bool {
+        self.state() == UplinkState::Open
+    }
+
+    pub(crate) fn set_state(&self, state: UplinkState) {
+        self.0.lock().unwrap().state = state;
+    }
+
+    /// The computer connected: the queue its task drains, the codec first,
+    /// then the Opus header as a configuration packet: Kymux's audio
+    /// receiver delivers nothing of a group before its configuration packet
+    /// (the computer's sound starts the same way).
+    pub(crate) fn open(&self) -> mpsc::Receiver<AVPacket> {
+        let (tx, rx) = mpsc::channel(QUEUED);
+        let mut inner = self.0.lock().unwrap();
+        if let Some(header) = inner.codec.clone() {
+            let _ = tx.try_send(AVPacket::Codec(CodecPacket { header }));
+        }
+        let head = opus_head();
+        let _ = tx.try_send(AVPacket::Media(MediaPacket {
+            header: MediaPacketHeader {
+                is_config: true,
+                is_key: true,
+                pts: 0,
+                size: head.len() as u32,
+            },
+            payload: head.into(),
+        }));
+        inner.tx = Some(tx);
+        inner.state = UplinkState::Open;
+        rx
+    }
+
+    /// The image stopped, or the connection: nothing goes until the next start.
+    pub(crate) fn close(&self) {
+        let mut inner = self.0.lock().unwrap();
+        inner.tx = None;
+        if inner.state == UplinkState::Open || inner.state == UplinkState::Offered {
+            inner.state = UplinkState::Idle;
+        }
+    }
+}
+
+/// Opus identification header (RFC 7845): mono, 48 kHz, no gain.
+fn opus_head() -> Vec<u8> {
+    let mut head = b"OpusHead".to_vec();
+    head.push(1); // version
+    head.push(1); // channels
+    head.extend_from_slice(&312u16.to_le_bytes()); // pre-skip
+    head.extend_from_slice(&48_000u32.to_le_bytes());
+    head.extend_from_slice(&0i16.to_le_bytes()); // gain
+    head.push(0); // mapping family
+    head
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nothing_goes_before_the_computer_opens_and_the_codec_goes_first() {
+        let uplink = Uplink::new();
+        uplink.set_codec(u32::from_be_bytes(*b"opus"), 480);
+        assert!(!uplink.send(&[1], 0));
+        let mut rx = uplink.open();
+        assert!(uplink.is_open());
+        assert!(matches!(rx.try_recv(), Ok(AVPacket::Codec(c)) if c.header.frame_size == 480));
+        // The configuration packet, without which nothing of the group is delivered.
+        assert!(matches!(rx.try_recv(), Ok(AVPacket::Media(m)) if m.header.is_config && m.payload.starts_with(b"OpusHead")));
+        assert!(uplink.send(&[1, 2], 10_000));
+        assert!(matches!(rx.try_recv(), Ok(AVPacket::Media(m)) if m.header.pts == 10_000));
+        uplink.close();
+        assert_eq!(uplink.state(), UplinkState::Idle);
+        assert!(!uplink.send(&[1], 0));
+    }
+
+    #[test]
+    fn a_full_queue_drops_without_failing() {
+        let uplink = Uplink::new();
+        let _rx = uplink.open();
+        for pts in 0..(QUEUED as u64 + 5) {
+            assert!(uplink.send(&[0], pts));
+        }
+    }
+
+    #[test]
+    fn a_refusal_stays_until_the_next_start() {
+        let uplink = Uplink::new();
+        uplink.set_state(UplinkState::Refused("no_device".into()));
+        uplink.close();
+        assert_eq!(uplink.state(), UplinkState::Refused("no_device".into()));
+    }
+}
