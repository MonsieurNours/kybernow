+/// KyberNow: `POST /force_idr` (kycontroller patched by KyberNow).
+pub(crate) async fn force_idr(http_client: &HttpClient) -> Result<()> {
+    let url = format!("{base_url}/force_idr", base_url = http_client.base_url());
+
+    http_client
+        .post(&url)
+        .send()
+        .await?
+        .error_for_status()?;
+
+    Ok(())
+}
