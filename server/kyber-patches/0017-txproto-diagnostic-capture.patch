+/* KyberNow: bytes per pixel of the duplicated desktop, 0 if unknown. */
+static int diag_bytes_per_pixel(DXGI_FORMAT format)
+{
+    switch (format) {
+    case DXGI_FORMAT_B8G8R8A8_UNORM:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+    case DXGI_FORMAT_R8G8B8A8_UNORM:
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+    case DXGI_FORMAT_R10G10B10A2_UNORM:
+        return 4;
+    case DXGI_FORMAT_R16G16B16A16_FLOAT:
+        return 8;
+    default:
+        return 0;
+    }
+}
+
+/* KyberNow: describes the first frame of a capture in the log: size and
+ * format of the texture DXGI hands over, mode and desktop coordinates of the
+ * output, and the first and last non-black columns of its middle row. On a
+ * multi-display host, this tells whether an output's image is shifted
+ * inside the duplicated texture (content at its desktop position) or not. */
+static void log_capture_diag(IOSysEntry *entry, DxgiCapture *priv, DxgiCtx *ctx,
+                             ID3D11Resource *res)
+{
+    ID3D11Texture2D *tex = NULL;
+    ID3D11Texture2D *staging = NULL;
+    D3D11_TEXTURE2D_DESC td;
+    DXGI_OUTDUPL_DESC od;
+    int first = -1, last = -1;
 
+    if (FAILED(ID3D11Resource_QueryInterface(res, &IID_ID3D11Texture2D, (void **)&tex)))
+        return;
+    ID3D11Texture2D_GetDesc(tex, &td);
+    ID3D11Texture2D_Release(tex);
+    IDXGIOutputDuplication_GetDesc(priv->output_duplication, &od);
+
+    int bpp = diag_bytes_per_pixel(td.Format);
+    if (bpp && td.Width && td.Height) {
+        D3D11_TEXTURE2D_DESC sd = {
+            .Width = td.Width, .Height = 1, .MipLevels = 1, .ArraySize = 1,
+            .Format = td.Format, .SampleDesc = { .Count = 1 },
+            .Usage = D3D11_USAGE_STAGING, .CPUAccessFlags = D3D11_CPU_ACCESS_READ,
+        };
+        if (SUCCEEDED(ID3D11Device_CreateTexture2D(ctx->d3d11_device, &sd, NULL, &staging))) {
+            D3D11_BOX box = { 0, td.Height / 2, 0, td.Width, td.Height / 2 + 1, 1 };
+            D3D11_MAPPED_SUBRESOURCE map;
+            ID3D11DeviceContext_CopySubresourceRegion(ctx->d3d11_device_ctx,
+                                                      (ID3D11Resource *)staging, 0,
+                                                      0, 0, 0, res, 0, &box);
+            if (SUCCEEDED(ID3D11DeviceContext_Map(ctx->d3d11_device_ctx,
+                                                  (ID3D11Resource *)staging, 0,
+                                                  D3D11_MAP_READ, 0, &map))) {
+                const uint8_t *row = map.pData;
+                /* Colour bytes only: alpha is the last byte (or half) of a pixel. */
+                int colour = bpp == 8 ? 6 : 3;
+                for (int x = 0; x < (int)td.Width; x++) {
+                    const uint8_t *px = row + (size_t)x * bpp;
+                    int lit = 0;
+                    for (int b = 0; b < colour; b++)
+                        lit |= px[b];
+                    if (lit) {
+                        if (first < 0)
+                            first = x;
+                        last = x;
+                    }
+                }
+                ID3D11DeviceContext_Unmap(ctx->d3d11_device_ctx, (ID3D11Resource *)staging, 0);
+            }
+            ID3D11Texture2D_Release(staging);
+        }
+    }
+
+    sp_log(entry, SP_LOG_INFO,
+           "Capture diag: texture %ux%u (format %d, %u level(s), array %u), "
+           "mode %ux%u, desktop (%d,%d) %dx%d, desktop image in system memory: %d, "
+           "middle row: first non-black x=%d, last x=%d\n",
+           td.Width, td.Height, (int)td.Format, td.MipLevels, td.ArraySize,
+           od.ModeDesc.Width, od.ModeDesc.Height,
+           entry->x, entry->y, entry->width, entry->height,
+           (int)od.DesktopImageInSystemMemory, first, last);
+}
