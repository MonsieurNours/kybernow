+//! KyberNow: a synthetic pen (Windows 10 1809 and later), fed with the
+//! client's [`Pen`] packets: pressure, tilt, rotation, eraser and barrel
+//! button reach drawing apps through Windows Ink, and apps that know nothing
+//! of pens get the mouse Windows makes from it.
+
+use std::time::{Duration, Instant};
+
+use log::{info, warn};
+use windows_sys::Win32::{
+    Foundation::*,
+    UI::{Controls::*, Input::Pointer::*, WindowsAndMessaging::*},
+};
+
+use crate::{Display, Pen};
+
+/// Windows lets a synthetic pen go when it is not updated for a while: the
+/// last state is injected again at this pace while the pen is near.
+pub(crate) const REPEAT: Duration = Duration::from_millis(50);
+
+/// Windows' pen pressure goes from 0 to 1024.
+const WINDOWS_MAX_PRESSURE: u32 = 1024;
+
+pub(crate) struct HostPen {
+    device: HSYNTHETICPOINTERDEVICE,
+    /// The last pen state injected while near the surface (screen pixels,
+    /// in contact or not), to send its transitions and repeat it.
+    last: Option<(POINTER_PEN_INFO, bool)>,
+    last_at: Instant,
+}
+
+impl HostPen {
+    pub(crate) fn create() -> Option<Self> {
+        let device = unsafe { CreateSyntheticPointerDevice(PT_PEN, 1, POINTER_FEEDBACK_DEFAULT) };
+        if device == 0 {
+            warn!("CreateSyntheticPointerDevice(PT_PEN) failed: {}", unsafe { GetLastError() });
+            return None;
+        }
+        info!("Synthetic pen created");
+        Some(Self {
+            device,
+            last: None,
+            last_at: Instant::now(),
+        })
+    }
+
+    /// When the pen must be injected again (see [`REPEAT`]).
+    pub(crate) fn next_deadline(&self) -> Option<Duration> {
+        self.last
+            .as_ref()
+            .map(|_| REPEAT.saturating_sub(self.last_at.elapsed()))
+    }
+
+    /// Injects `pen` at (`x`, `y`) in virtual screen pixels. Returns false
+    /// when Windows refused it (another desktop: the caller switches and
+    /// tries again).
+    pub(crate) fn inject(&mut self, pen: &Pen, x: i32, y: i32) -> bool {
+        let in_range = pen.has(Pen::IN_RANGE);
+        let contact = in_range && pen.has(Pen::CONTACT);
+        let was_contact = self.last.as_ref().is_some_and(|(_, contact)| *contact);
+
+        let mut flags = if contact && !was_contact {
+            POINTER_FLAG_DOWN
+        } else if !contact && was_contact {
+            POINTER_FLAG_UP
+        } else {
+            POINTER_FLAG_UPDATE
+        };
+        if in_range {
+            flags |= POINTER_FLAG_INRANGE | POINTER_FLAG_PRIMARY;
+        }
+        if contact {
+            flags |= POINTER_FLAG_INCONTACT | POINTER_FLAG_FIRSTBUTTON;
+        }
+
+        let mut pen_flags = PEN_FLAG_NONE;
+        if pen.has(Pen::BARREL) {
+            pen_flags |= PEN_FLAG_BARREL;
+        }
+        if pen.has(Pen::ERASER) {
+            // The eraser end near the surface is "inverted"; touching, it
+            // erases.
+            pen_flags |= if contact { PEN_FLAG_ERASER } else { PEN_FLAG_INVERTED };
+        }
+        let mut pen_mask = PEN_MASK_PRESSURE;
+        if pen.has(Pen::TILT) {
+            pen_mask |= PEN_MASK_TILT_X | PEN_MASK_TILT_Y;
+        }
+        if pen.has(Pen::ROTATION) {
+            pen_mask |= PEN_MASK_ROTATION;
+        }
+
+        let mut info: POINTER_PEN_INFO = unsafe { std::mem::zeroed() };
+        info.pointerInfo.pointerType = PT_PEN;
+        info.pointerInfo.pointerFlags = flags;
+        info.pointerInfo.ptPixelLocation = POINT { x, y };
+        info.penFlags = pen_flags;
+        info.penMask = pen_mask;
+        info.pressure = if contact {
+            // A touching pen never weighs 0: Windows Ink would draw nothing.
+            (pen.pressure as u32 * WINDOWS_MAX_PRESSURE / Pen::MAX_PRESSURE as u32).max(1)
+        } else {
+            0
+        };
+        info.rotation = pen.rotation as u32 % 360;
+        info.tiltX = pen.tilt_x.clamp(-90, 90) as i32;
+        info.tiltY = pen.tilt_y.clamp(-90, 90) as i32;
+
+        if !self.send(&info) {
+            return false;
+        }
+        self.last = in_range.then(|| {
+            // Repeats are updates of the same state.
+            let mut repeat = info;
+            repeat.pointerInfo.pointerFlags &= !(POINTER_FLAG_DOWN | POINTER_FLAG_UP);
+            repeat.pointerInfo.pointerFlags |= POINTER_FLAG_UPDATE;
+            (repeat, contact)
+        });
+        self.last_at = Instant::now();
+        true
+    }
+
+    /// Injects the last state again (see [`REPEAT`]).
+    pub(crate) fn repeat(&mut self) -> bool {
+        let Some((info, _)) = self.last else {
+            return true;
+        };
+        self.last_at = Instant::now();
+        self.send(&info)
+    }
+
+    fn send(&self, info: &POINTER_PEN_INFO) -> bool {
+        let input = POINTER_TYPE_INFO {
+            r#type: PT_PEN,
+            Anonymous: POINTER_TYPE_INFO_0 { penInfo: *info },
+        };
+        let ok = unsafe { InjectSyntheticPointerInput(self.device, &input, 1) } != 0;
+        if !ok {
+            let err = unsafe { GetLastError() };
+            if err != ERROR_ACCESS_DENIED {
+                warn!("InjectSyntheticPointerInput failed: {err}");
+                // Only a desktop switch is worth trying again.
+                return true;
+            }
+        }
+        ok
+    }
+}
+
+impl Drop for HostPen {
+    fn drop(&mut self) {
+        unsafe { DestroySyntheticPointerDevice(self.device) };
+    }
+}
+
+/// The pen's position in virtual screen pixels, from its position on one of
+/// the captured displays.
+/// Kept on that display: a position out of it (a client's rounding, or a
+/// client that sends anything) never lands on another one.
+pub(crate) fn screen_position(display: &Display, pen: &Pen) -> (i32, i32) {
+    let x = (pen.x as i32).clamp(0, (display.width - 1).max(0));
+    let y = (pen.y as i32).clamp(0, (display.height - 1).max(0));
+    (display.x + x, display.y + y)
+}
