+
+/// KyberNow: splits the session bitrate between its video streams in
+/// proportion to `weights` (pixels per second of each display), or evenly,
+/// as before, when one of them is unknown (0). Rounded down.
+pub(crate) fn bitrate_shares(total: u32, weights: &[u64]) -> Vec<u32> {
+    if weights.contains(&0) {
+        return vec![total / weights.len() as u32; weights.len()];
+    }
+    let sum: u128 = weights.iter().map(|&w| u128::from(w)).sum();
+    weights
+        .iter()
+        .map(|&w| (u128::from(total) * u128::from(w) / sum) as u32)
+        .collect()
+}
+
+/// KyberNow: pixels per second of a display (width × height × refresh
+/// rate), 0 when unknown. The size comes from Kyber's display list, the
+/// refresh rate from Windows (the display at the same desktop position):
+/// neither the start request nor the display list carries one.
+pub(crate) fn pixel_rate(displays: &[kyavservice_types::Display], display_id: u32) -> u64 {
+    let Some(display) = displays.iter().find(|d| d.id == display_id) else {
+        return 0;
+    };
+    let (Ok(width), Ok(height)) = (u64::try_from(display.width), u64::try_from(display.height))
+    else {
+        return 0;
+    };
+    let refresh_rate = refresh_rate_at(display.x, display.y).unwrap_or(0);
+    width * height * u64::from(refresh_rate)
 }
 
+/// KyberNow: current refresh rate (Hz) of the Windows display whose top-left
+/// corner is at `(x, y)` on the desktop.
+#[cfg(windows)]
+fn refresh_rate_at(x: i32, y: i32) -> Option<u32> {
+    use windows_sys::Win32::Graphics::Gdi::{
+        DEVMODEW, DISPLAY_DEVICE_ATTACHED_TO_DESKTOP, DISPLAY_DEVICEW, ENUM_CURRENT_SETTINGS,
+        EnumDisplayDevicesW, EnumDisplaySettingsW,
+    };
+
+    for index in 0.. {
+        let mut device = DISPLAY_DEVICEW {
+            cb: size_of::<DISPLAY_DEVICEW>() as u32,
+            ..Default::default()
+        };
+        // SAFETY: `device` is a valid DISPLAY_DEVICEW with `cb` set.
+        if unsafe { EnumDisplayDevicesW(std::ptr::null(), index, &mut device, 0) } == 0 {
+            break;
+        }
+        if device.StateFlags & DISPLAY_DEVICE_ATTACHED_TO_DESKTOP == 0 {
+            continue;
+        }
+        let mut mode = DEVMODEW {
+            dmSize: size_of::<DEVMODEW>() as u16,
+            ..Default::default()
+        };
+        // SAFETY: `DeviceName` is NUL-terminated by Windows, `mode` is a
+        // valid DEVMODEW with `dmSize` set.
+        let ok = unsafe {
+            EnumDisplaySettingsW(device.DeviceName.as_ptr(), ENUM_CURRENT_SETTINGS, &mut mode)
+        };
+        // SAFETY: display devices fill the display variant of the union.
+        let position = unsafe { mode.Anonymous1.Anonymous2.dmPosition };
+        // 0 and 1 mean "hardware default": unknown.
+        if ok != 0 && (position.x, position.y) == (x, y) && mode.dmDisplayFrequency > 1 {
+            return Some(mode.dmDisplayFrequency);
+        }
+    }
+    None
+}
+
+#[cfg(not(windows))]
+fn refresh_rate_at(_x: i32, _y: i32) -> Option<u32> {
+    None
+}
