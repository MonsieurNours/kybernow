+    /// KyberNow: bitrate split by pixels per second, evenly when a mode is
+    /// unknown.
+    #[test]
+    fn bitrate_shares_follow_pixels_per_second() {
+        // 4K at 160 Hz, 5K at 60 Hz, 3456 × 2234 at 60 Hz.
+        let weights = [3840 * 2160 * 160, 5120 * 2880 * 60, 3456 * 2234 * 60];
+        let shares = bitrate_shares(150_000_000, &weights);
+        assert_eq!(shares, vec![74_414_758, 49_609_839, 25_975_401]);
+        assert!(shares.iter().sum::<u32>() <= 150_000_000);
+        // u32::MAX bits/s over two 8K displays at 240 Hz: no overflow.
+        let big = 7680 * 4320 * 240;
+        assert_eq!(bitrate_shares(u32::MAX, &[big, big]), vec![u32::MAX / 2; 2]);
+        assert_eq!(bitrate_shares(30_000_000, &[1920 * 1080 * 60, 0]), vec![15_000_000; 2]);
+        assert_eq!(bitrate_shares(20_000_000, &[0]), vec![20_000_000]);
+        assert_eq!(bitrate_shares(20_000_000, &[]), Vec::<u32>::new());
     }
 
