+#[cfg(test)]
+mod pen_tests {
+    use super::*;
+
+    #[test]
+    fn pen_button_choice() {
+        use MouseButtonType::{Left, Right};
+        assert_eq!(pen_button(None, false, false), None);
+        assert_eq!(pen_button(None, true, false), Some(Left));
+        assert_eq!(pen_button(None, true, true), Some(Right));
+        assert_eq!(pen_button(None, false, true), Some(Right));
+        // La pointe posée garde le clic gauche, le bouton du stylet appuyé ensuite n'y change rien.
+        assert_eq!(pen_button(Some(Left), true, true), Some(Left));
+        assert_eq!(pen_button(Some(Left), false, false), None);
+        // Le clic droit tient tant que le bouton ou la pointe le tient.
+        assert_eq!(pen_button(Some(Right), true, false), Some(Right));
+        assert_eq!(pen_button(Some(Right), false, false), None);
+    }
+
+    /// Un Backend sur l'écran principal, sans autorisation ni envoi.
+    fn backend() -> (Backend, u32) {
+        let main = CGDisplay::main();
+        let b = main.bounds();
+        let scale = main.pixels_wide() as f64 / b.size.width;
+        let display = Display {
+            id: 7,
+            x: (b.origin.x * scale) as i32,
+            y: (b.origin.y * scale) as i32,
+            width: main.pixels_wide() as i32,
+            height: main.pixels_high() as i32,
+        };
+        let backend = Backend {
+            modifiers: Modifiers::default(),
+            position: CGPoint::new(0.0, 0.0),
+            buttons: Default::default(),
+            displays: HashMap::from([(display.id, display)]),
+            source: CGEventSource::new(CGEventSourceStateID::Private).ok(),
+            last_click: None,
+            warned_access: true,
+            pen: PenState::default(),
+            posted: Vec::new(),
+        };
+        (backend, 7)
+    }
+
+    fn kinds(events: &[CGEvent]) -> Vec<u32> {
+        events.iter().map(|e| e.get_type() as u32).collect()
+    }
+
+    #[test]
+    fn pen_stroke() {
+        let (mut b, id) = backend();
+        let mut pen = Pen::new(id, 100, 80);
+        pen.flags |= Pen::TILT | Pen::ROTATION;
+        pen.tilt_x = 32;
+        pen.tilt_y = -64;
+        pen.rotation = 90;
+        b.inject_pen(&pen).unwrap(); // approche
+        pen.flags |= Pen::CONTACT;
+        pen.pressure = Pen::MAX_PRESSURE / 2;
+        b.inject_pen(&pen).unwrap(); // pointe posée
+        pen.x += 10;
+        b.inject_pen(&pen).unwrap(); // trait
+        pen.flags &= !Pen::CONTACT;
+        pen.pressure = 0;
+        b.inject_pen(&pen).unwrap(); // pointe levée
+        pen.flags = 0;
+        b.inject_pen(&pen).unwrap(); // départ
+        let t = |k: CGEventType| k as u32;
+        assert_eq!(
+            kinds(&b.posted),
+            [
+                t(CGEventType::TabletProximity),
+                t(CGEventType::MouseMoved),
+                t(CGEventType::LeftMouseDown),
+                t(CGEventType::LeftMouseDragged),
+                t(CGEventType::LeftMouseUp),
+                t(CGEventType::TabletProximity),
+            ]
+        );
+        let p = &b.posted;
+        assert_eq!(p[0].get_integer_value_field(EventField::TABLET_PROXIMITY_EVENT_ENTER_PROXIMITY), 1);
+        assert_eq!(p[0].get_integer_value_field(EventField::TABLET_PROXIMITY_EVENT_POINTER_TYPE), POINTER_TYPE_PEN);
+        assert_eq!(p[5].get_integer_value_field(EventField::TABLET_PROXIMITY_EVENT_ENTER_PROXIMITY), 0);
+        let down = &p[2];
+        assert_eq!(down.get_integer_value_field(EventField::MOUSE_EVENT_SUB_TYPE), SUBTYPE_TABLET_POINT);
+        assert!((down.get_double_value_field(EventField::TABLET_EVENT_POINT_PRESSURE) - 0.5).abs() < 0.01);
+        assert!((down.get_double_value_field(EventField::TABLET_EVENT_TILT_X) - 0.5).abs() < 0.01);
+        assert!((down.get_double_value_field(EventField::TABLET_EVENT_TILT_Y) + 1.0).abs() < 0.01);
+        assert!((down.get_double_value_field(EventField::TABLET_EVENT_ROTATION) - 90.0).abs() < 0.01);
+        assert_eq!(down.get_integer_value_field(EventField::TABLET_EVENT_DEVICE_ID), PEN_DEVICE_ID);
+        assert_eq!(p[4].get_double_value_field(EventField::TABLET_EVENT_POINT_PRESSURE), 0.0);
+        assert!(!b.buttons.left);
+    }
+
+    #[test]
+    fn pen_flipped_and_flushed() {
+        let (mut b, id) = backend();
+        let mut pen = Pen::new(id, 50, 50);
+        pen.flags |= Pen::CONTACT;
+        b.inject_pen(&pen).unwrap();
+        // La gomme sans passer par le départ : la pointe est levée et sort d'abord.
+        pen.flags |= Pen::ERASER;
+        b.inject_pen(&pen).unwrap();
+        // « Tout relâcher » du serveur d'entrées : flags à 0.
+        b.inject_pen(&Pen { pressure: 0, flags: 0, ..pen }).unwrap();
+        let t = |k: CGEventType| k as u32;
+        assert_eq!(
+            kinds(&b.posted),
+            [
+                t(CGEventType::TabletProximity),
+                t(CGEventType::MouseMoved),
+                t(CGEventType::LeftMouseDown),
+                t(CGEventType::LeftMouseUp),
+                t(CGEventType::TabletProximity),
+                t(CGEventType::TabletProximity),
+                t(CGEventType::LeftMouseDown),
+                t(CGEventType::LeftMouseUp),
+                t(CGEventType::TabletProximity),
+            ]
+        );
+        assert_eq!(b.posted[5].get_integer_value_field(EventField::TABLET_PROXIMITY_EVENT_POINTER_TYPE), POINTER_TYPE_ERASER);
+        // Une pression nulle en contact devient la plus petite.
+        assert!(b.posted[2].get_double_value_field(EventField::TABLET_EVENT_POINT_PRESSURE) > 0.0);
+        assert!(b.pen.near.is_none() && b.pen.held.is_none() && !b.buttons.left);
+    }
+
+    #[test]
+    fn barrel_hover_is_right_click() {
+        let (mut b, id) = backend();
+        let mut pen = Pen::new(id, 50, 50);
+        b.inject_pen(&pen).unwrap();
+        pen.flags |= Pen::BARREL;
+        b.inject_pen(&pen).unwrap();
+        pen.flags &= !Pen::BARREL;
+        b.inject_pen(&pen).unwrap();
+        let t = |k: CGEventType| k as u32;
+        assert_eq!(
+            kinds(&b.posted),
+            [t(CGEventType::TabletProximity), t(CGEventType::MouseMoved), t(CGEventType::RightMouseDown), t(CGEventType::RightMouseUp)]
+        );
+        assert_eq!(b.posted[2].get_integer_value_field(EventField::TABLET_EVENT_POINT_BUTTONS), 2);
+    }
+}
