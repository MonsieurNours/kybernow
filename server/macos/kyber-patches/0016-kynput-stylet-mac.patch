+// KyberNow (server/macos/kyber-patches/0016) : stylet (paquet `Pen`,
+// docs/stylet.md).
+//
+// Comme une tablette sur le Mac : l'approche et le départ sont des événements
+// de proximité (`kCGEventTabletProximity`, pointe ou gomme), le reste des
+// événements de souris de sous-type tablette (`kCGEventMouseSubtypeTabletPoint`)
+// qui portent la pression, l'inclinaison et la rotation : survol en
+// `MouseMoved`, pointe posée en clic gauche glissé. Le bouton du stylet est
+// un clic droit, comme le fait le pilote d'une tablette : appuyé en survol ou
+// pointe posée, tenu jusqu'à ce que le bouton et la pointe soient relâchés.
+// Les logiciels qui ne connaissent pas les tablettes y voient une souris.
+
+/// Identifiant du stylet, le même dans la proximité et les points.
+const PEN_DEVICE_ID: i64 = 0x4b4e;
+/// Identifiant de l'outil : le même pour la pointe et la gomme (un seul stylet).
+const PEN_UNIQUE_ID: i64 = 0x4b4e_0001;
+/// `NSPointingDeviceType` : pointe et gomme.
+const POINTER_TYPE_PEN: i64 = 1;
+const POINTER_TYPE_ERASER: i64 = 3;
+/// `kCGEventMouseSubtypeTabletPoint`.
+const SUBTYPE_TABLET_POINT: i64 = 1;
+/// Ce que le stylet donne (`NX_TABLET_CAPABILITY_*`) : identifiant, X, Y,
+/// boutons, inclinaison X et Y, pression, rotation.
+const PEN_CAPABILITIES: i64 = 0x0001 | 0x0002 | 0x0004 | 0x0040 | 0x0080 | 0x0100 | 0x0400 | 0x2000;
+/// Inclinaison de macOS (−1 à 1) à son maximum, en degrés (celle des tablettes
+/// Wacom ; l'app Mac fait la conversion inverse).
+const PEN_MAX_TILT: f64 = 64.0;
+/// Pression en contact, au moins (à 0, un logiciel de dessin ne trace rien).
+const PEN_MIN_PRESSURE: f64 = 1.0 / 1024.0;
+
+#[derive(Default)]
+struct PenState {
+    /// Près de la surface : `Some(gomme)`.
+    near: Option<bool>,
+    /// Le bouton de souris que le stylet tient (gauche : pointe, droit : bouton du stylet).
+    held: Option<MouseButtonType>,
+}
+
+/// Le bouton que le stylet doit tenir, d'après celui qu'il tient déjà.
+fn pen_button(held: Option<MouseButtonType>, contact: bool, barrel: bool) -> Option<MouseButtonType> {
+    match held {
+        Some(MouseButtonType::Left) if contact => held,
+        Some(MouseButtonType::Right) if contact || barrel => held,
+        _ if barrel => Some(MouseButtonType::Right),
+        _ if contact => Some(MouseButtonType::Left),
+        _ => None,
+    }
 }
 
