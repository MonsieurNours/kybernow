+    /// KyberNow : entrée ou sortie de proximité du stylet (pointe ou gomme).
+    fn pen_proximity_event(&self, eraser: bool, enter: bool) -> Option<CGEvent> {
+        let event = CGEvent::new(self.source()?).ok()?;
+        event.set_type(CGEventType::TabletProximity);
+        unsafe { CGEventSetLocation(raw(&event), self.position) };
+        let fields = [
+            (EventField::TABLET_PROXIMITY_EVENT_VENDOR_ID, 0),
+            (EventField::TABLET_PROXIMITY_EVENT_TABLET_ID, 1),
+            (EventField::TABLET_PROXIMITY_EVENT_POINTER_ID, 1),
+            (EventField::TABLET_PROXIMITY_EVENT_DEVICE_ID, PEN_DEVICE_ID),
+            (EventField::TABLET_PROXIMITY_EVENT_SYSTEM_TABLET_ID, 1),
+            (EventField::TABLET_PROXIMITY_EVENT_VENDOR_POINTER_TYPE, 0),
+            (EventField::TABLET_PROXIMITY_EVENT_VENDOR_POINTER_SERIAL_NUMBER, 1),
+            (EventField::TABLET_PROXIMITY_EVENT_VENDOR_UNIQUE_ID, PEN_UNIQUE_ID),
+            (EventField::TABLET_PROXIMITY_EVENT_CAPABILITY_MASK, PEN_CAPABILITIES),
+            (
+                EventField::TABLET_PROXIMITY_EVENT_POINTER_TYPE,
+                if eraser { POINTER_TYPE_ERASER } else { POINTER_TYPE_PEN },
+            ),
+            (EventField::TABLET_PROXIMITY_EVENT_ENTER_PROXIMITY, i64::from(enter)),
+        ];
+        for (field, value) in fields {
+            event.set_integer_value_field(field, value);
+        }
+        event.set_flags(self.flags());
+        Some(event)
+    }
+
+    /// KyberNow : un point du stylet à `self.position`, en événement de souris
+    /// de sous-type tablette.
+    fn pen_point_event(&self, kind: CGEventType, button: Option<MouseButtonType>, pen: &Pen, dx: i64, dy: i64) -> Option<CGEvent> {
+        let event = CGEvent::new_mouse_event(self.source()?, kind, self.position, CGMouseButton::Left).ok()?;
+        // Le sous-type d'abord : il dit à macOS comment lire les champs qui suivent.
+        event.set_integer_value_field(EventField::MOUSE_EVENT_SUB_TYPE, SUBTYPE_TABLET_POINT);
+        if let Some(b) = button {
+            event.set_integer_value_field(EventField::MOUSE_EVENT_BUTTON_NUMBER, button_number(b));
+        }
+        event.set_integer_value_field(EventField::MOUSE_EVENT_DELTA_X, dx);
+        event.set_integer_value_field(EventField::MOUSE_EVENT_DELTA_Y, dy);
+        let contact = pen.has(Pen::CONTACT);
+        let pressure = if contact { f64::from(pen.pressure_fraction()).max(PEN_MIN_PRESSURE) } else { 0.0 };
+        let tilt = |degrees: i8| (f64::from(degrees) / PEN_MAX_TILT).clamp(-1.0, 1.0);
+        let buttons = i64::from(contact) | if pen.has(Pen::BARREL) { 2 } else { 0 };
+        event.set_double_value_field(EventField::MOUSE_EVENT_PRESSURE, pressure);
+        event.set_integer_value_field(EventField::TABLET_EVENT_POINT_X, self.position.x.round() as i64);
+        event.set_integer_value_field(EventField::TABLET_EVENT_POINT_Y, self.position.y.round() as i64);
+        event.set_integer_value_field(EventField::TABLET_EVENT_POINT_BUTTONS, buttons);
+        event.set_double_value_field(EventField::TABLET_EVENT_POINT_PRESSURE, pressure);
+        event.set_double_value_field(EventField::TABLET_EVENT_TILT_X, tilt(pen.tilt_x));
+        event.set_double_value_field(EventField::TABLET_EVENT_TILT_Y, tilt(pen.tilt_y));
+        event.set_double_value_field(EventField::TABLET_EVENT_ROTATION, f64::from(pen.rotation));
+        event.set_integer_value_field(EventField::TABLET_EVENT_DEVICE_ID, PEN_DEVICE_ID);
+        event.set_flags(self.flags());
+        Some(event)
+    }
+
+    /// KyberNow : bouton du stylet appuyé ou relâché (clic, double clic compris).
+    fn post_pen_button(&mut self, button: MouseButtonType, pressed: bool, pen: &Pen) {
+        self.buttons.update(button, pressed);
+        let (down, up, _) = button_types(button);
+        let clicks = self.click_state(button, pressed);
+        let Some(event) = self.pen_point_event(if pressed { down } else { up }, Some(button), pen, 0, 0) else {
+            warn!("Failed to create pen button event");
+            return;
         };
-        cg.set_integer_value_field(EventField::MOUSE_EVENT_CLICK_STATE, clicks);
-        cg.set_flags(self.flags());
-        self.post(&cg);
+        event.set_integer_value_field(EventField::MOUSE_EVENT_CLICK_STATE, clicks);
+        info!("Pen {:?} button {}", button, if pressed { "down" } else { "up" });
+        self.post(&event);
+    }
+
+    /// KyberNow : le stylet quitte la surface (bouton relâché, sortie de proximité).
+    fn pen_leave(&mut self, pen: &Pen) {
+        let Some(eraser) = self.pen.near.take() else { return };
+        if let Some(button) = self.pen.held.take() {
+            let lifted = Pen { pressure: 0, flags: Pen::IN_RANGE, ..*pen };
+            self.post_pen_button(button, false, &lifted);
+        }
+        match self.pen_proximity_event(eraser, false) {
+            Some(event) => self.post(&event),
+            None => warn!("Failed to create pen proximity event"),
+        }
+        info!("Pen left ({})", if eraser { "eraser" } else { "tip" });
+    }
+
+    /// KyberNow : un paquet `Pen` de l'app (état complet du stylet).
+    fn inject_pen(&mut self, pen: &Pen) -> Result<()> {
+        let in_range = pen.has(Pen::IN_RANGE);
+        let eraser = pen.has(Pen::ERASER);
+        // Parti, ou l'autre bout du stylet : sortie de proximité d'abord.
+        if self.pen.near.is_some_and(|e| !in_range || e != eraser) {
+            self.pen_leave(pen);
+        }
+        if !in_range {
+            return Ok(());
+        }
+        let Some(display) = self.displays.get(&pen.display_id) else {
+            warn!("Got a Pen on unknown Display ID {}", pen.display_id);
+            return Ok(());
+        };
+        let Some((origin, scale)) = locate(display) else {
+            warn!("Display {} ({}x{} at {},{}) not found among the active displays", display.id, display.width, display.height, display.x, display.y);
+            return Ok(());
+        };
+        let target = CGPoint::new(origin.x + f64::from(pen.x) / scale, origin.y + f64::from(pen.y) / scale);
+        let (dx, dy) = ((target.x - self.position.x).round() as i64, (target.y - self.position.y).round() as i64);
+        self.position = target;
+
+        if self.pen.near.is_none() {
+            match self.pen_proximity_event(eraser, true) {
+                Some(event) => self.post(&event),
+                None => warn!("Failed to create pen proximity event"),
+            }
+            self.pen.near = Some(eraser);
+            info!("Pen near ({})", if eraser { "eraser" } else { "tip" });
+        }
+
+        let contact = pen.has(Pen::CONTACT);
+        let wanted = pen_button(self.pen.held, contact, pen.has(Pen::BARREL));
+        if wanted != self.pen.held {
+            if let Some(button) = self.pen.held.take() {
+                self.post_pen_button(button, false, pen);
+            }
+            if let Some(button) = wanted {
+                // La position d'abord : l'appui se fait là où est le stylet.
+                if dx != 0 || dy != 0 {
+                    if let Some(event) = self.pen_point_event(CGEventType::MouseMoved, None, pen, dx, dy) {
+                        self.post(&event);
+                    }
+                }
+                self.post_pen_button(button, true, pen);
+                self.pen.held = Some(button);
+            }
+            return Ok(());
+        }
+        let (kind, button) = match self.pen.held {
+            Some(b) => (button_types(b).2, Some(b)),
+            None => (CGEventType::MouseMoved, None),
+        };
+        let Some(event) = self.pen_point_event(kind, button, pen, dx, dy) else {
+            warn!("Failed to create pen event");
+            return Ok(());
+        };
+        debug!("Pen at {:.0},{:.0} pressure {} tilt {},{} rotation {} flags {:#x}", target.x, target.y, pen.pressure, pen.tilt_x, pen.tilt_y, pen.rotation, pen.flags);
+        self.post(&event);
         Ok(())
     }
 
