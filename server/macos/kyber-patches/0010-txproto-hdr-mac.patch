+
+/*
+ * KyberNow (0010): the white of the desktop. ScreenCaptureKit writes SDR
+ * white at 100 nits in its PQ image (measured on 2026-11-03: 10-bit level
+ * 509), where the Windows Station puts it at the device's SDR white (203 nits
+ * by default): on the device, the desktop looked dim. The image is brought
+ * up on the GPU: P010 PQ -> R'G'B' -> linear x gain -> PQ -> P010, the gain
+ * being the device's SDR white / 100 (`hdr-sdr-white.json`, written by
+ * Admin when it switches the virtual display to HDR; 203 nits without it).
+ * HDR content keeps its ratio to the white.
+ */
+static NSString *const kn_gain_source =
+    @"#include <metal_stdlib>\n"
+     "using namespace metal;\n"
+     "constant float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;\n"
+     "static float eotf(float e) { float p = pow(max(e, 0.0f), 1.0f / m2); return pow(max(p - c1, 0.0f) / (c2 - c3 * p), 1.0f / m1); }\n"
+     "static float oetf(float l) { float y = pow(clamp(l, 0.0f, 1.0f), m1); return pow((c1 + c2 * y) / (1.0f + c3 * y), m2); }\n"
+     "kernel void kn_gain(texture2d<float, access::read> yIn [[texture(0)]],\n"
+     "                    texture2d<float, access::read> cIn [[texture(1)]],\n"
+     "                    texture2d<float, access::write> yOut [[texture(2)]],\n"
+     "                    texture2d<float, access::write> cOut [[texture(3)]],\n"
+     "                    constant float &gain [[buffer(0)]],\n"
+     "                    uint2 gid [[thread_position_in_grid]]) {\n"
+     "    if (gid.x >= cIn.get_width() || gid.y >= cIn.get_height()) return;\n"
+     "    const float k = 65535.0f / 64.0f;\n"
+     "    float2 c = cIn.read(gid).rg * k;\n"
+     "    float cb = (c.x - 512.0f) / 896.0f, cr = (c.y - 512.0f) / 896.0f;\n"
+     "    float3 sum = 0.0f; float n = 0.0f;\n"
+     "    for (uint dy = 0; dy < 2; dy++) for (uint dx = 0; dx < 2; dx++) {\n"
+     "        uint2 p = gid * 2 + uint2(dx, dy);\n"
+     "        if (p.x >= yIn.get_width() || p.y >= yIn.get_height()) continue;\n"
+     "        float y = (yIn.read(p).r * k - 64.0f) / 876.0f;\n"
+     "        float3 rgb = clamp(float3(y + 1.4746f * cr, y - 0.16455f * cb - 0.57135f * cr, y + 1.8814f * cb), 0.0f, 1.0f);\n"
+     "        rgb = float3(oetf(eotf(rgb.r) * gain), oetf(eotf(rgb.g) * gain), oetf(eotf(rgb.b) * gain));\n"
+     "        float yo = dot(rgb, float3(0.2627f, 0.6780f, 0.0593f));\n"
+     "        yOut.write(float4((yo * 876.0f + 64.0f) / k), p);\n"
+     "        sum += rgb; n += 1.0f;\n"
+     "    }\n"
+     "    float3 a = sum / max(n, 1.0f);\n"
+     "    float ya = dot(a, float3(0.2627f, 0.6780f, 0.0593f));\n"
+     "    cOut.write(float4(((a.b - ya) / 1.8814f * 896.0f + 512.0f) / k, ((a.r - ya) / 1.4746f * 896.0f + 512.0f) / k, 0.0f, 0.0f), gid);\n"
+     "}\n";
+
+/* The device's SDR white for this display, in nits (203 by default). */
+static float kn_sdr_white(CGDirectDisplayID display)
+{
+    NSString *path = [NSHomeDirectory() stringByAppendingPathComponent:
+                      @"Library/Application Support/KyberNow/hdr-sdr-white.json"];
+    NSData *data = [NSData dataWithContentsOfFile:path];
+    NSDictionary *map = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+    id v = [map isKindOfClass:[NSDictionary class]] ? map[[NSString stringWithFormat:@"%u", display]] : nil;
+    float nits = [v isKindOfClass:[NSNumber class]] ? [v floatValue] : 203.0f;
+    return nits >= 80.0f && nits <= 1000.0f ? nits : 203.0f;
+}
+
+static int kn_gain_init(SCKCapture *capture)
+{
+    capture->mtl_device = MTLCreateSystemDefaultDevice();
+    if (!capture->mtl_device)
+        return -1;
+    NSError *err = nil;
+    id<MTLLibrary> lib = [capture->mtl_device newLibraryWithSource:kn_gain_source options:nil error:&err];
+    id<MTLFunction> fn = [lib newFunctionWithName:@"kn_gain"];
+    capture->mtl_gain = fn ? [capture->mtl_device newComputePipelineStateWithFunction:fn error:&err] : nil;
+    capture->mtl_queue = [capture->mtl_device newCommandQueue];
+    if (!capture->mtl_gain || !capture->mtl_queue ||
+        CVMetalTextureCacheCreate(NULL, NULL, capture->mtl_device, NULL, &capture->mtl_cache) != kCVReturnSuccess) {
+        capture->mtl_gain = nil;
+        return -1;
+    }
+    return 0;
+}
+
+static id<MTLTexture> kn_texture(SCKCapture *capture, CVPixelBufferRef pb, size_t plane,
+                                 MTLPixelFormat fmt, CVMetalTextureRef *keep)
+{
+    if (CVMetalTextureCacheCreateTextureFromImage(NULL, capture->mtl_cache, pb, NULL, fmt,
+            CVPixelBufferGetWidthOfPlane(pb, plane), CVPixelBufferGetHeightOfPlane(pb, plane),
+            plane, keep) != kCVReturnSuccess)
+        return nil;
+    return CVMetalTextureGetTexture(*keep);
+}
+
+/* `pb` brought to the device's SDR white: a new buffer (retained), or NULL
+ * to send `pb` as it is. */
+static CVPixelBufferRef kn_gain_apply(SCKCapture *capture, CVPixelBufferRef pb)
+{
+    if (!capture->mtl_gain || capture->hdr_gain <= 1.001f ||
+        CVPixelBufferGetPixelFormatType(pb) != kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange)
+        return NULL;
+    int w = (int)CVPixelBufferGetWidth(pb), h = (int)CVPixelBufferGetHeight(pb);
+    if (!capture->gain_pool || capture->gain_w != w || capture->gain_h != h) {
+        if (capture->gain_pool)
+            CVPixelBufferPoolRelease(capture->gain_pool);
+        capture->gain_pool = NULL;
+        NSDictionary *attrs = @{
+            (id)kCVPixelBufferPixelFormatTypeKey: @(kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange),
+            (id)kCVPixelBufferWidthKey: @(w), (id)kCVPixelBufferHeightKey: @(h),
+            (id)kCVPixelBufferIOSurfacePropertiesKey: @{},
+            (id)kCVPixelBufferMetalCompatibilityKey: @YES,
+        };
+        if (CVPixelBufferPoolCreate(NULL, NULL, (__bridge CFDictionaryRef)attrs, &capture->gain_pool) != kCVReturnSuccess)
+            return NULL;
+        capture->gain_w = w;
+        capture->gain_h = h;
+    }
+    CVPixelBufferRef out = NULL;
+    if (CVPixelBufferPoolCreatePixelBuffer(NULL, capture->gain_pool, &out) != kCVReturnSuccess)
+        return NULL;
+    CVMetalTextureRef t[4] = { NULL };
+    id<MTLTexture> yIn = kn_texture(capture, pb, 0, MTLPixelFormatR16Unorm, &t[0]);
+    id<MTLTexture> cIn = kn_texture(capture, pb, 1, MTLPixelFormatRG16Unorm, &t[1]);
+    id<MTLTexture> yOut = kn_texture(capture, out, 0, MTLPixelFormatR16Unorm, &t[2]);
+    id<MTLTexture> cOut = kn_texture(capture, out, 1, MTLPixelFormatRG16Unorm, &t[3]);
+    BOOL ok = yIn && cIn && yOut && cOut;
+    if (ok) {
+        id<MTLCommandBuffer> cmd = [capture->mtl_queue commandBuffer];
+        id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
+        [enc setComputePipelineState:capture->mtl_gain];
+        [enc setTexture:yIn atIndex:0];
+        [enc setTexture:cIn atIndex:1];
+        [enc setTexture:yOut atIndex:2];
+        [enc setTexture:cOut atIndex:3];
+        float gain = capture->hdr_gain;
+        [enc setBytes:&gain length:sizeof(gain) atIndex:0];
+        MTLSize group = MTLSizeMake(16, 16, 1);
+        MTLSize grid = MTLSizeMake(((NSUInteger)cIn.width + 15) / 16, ((NSUInteger)cIn.height + 15) / 16, 1);
+        [enc dispatchThreadgroups:grid threadsPerThreadgroup:group];
+        [enc endEncoding];
+        [cmd commit];
+        [cmd waitUntilCompleted];
+        ok = cmd.status == MTLCommandBufferStatusCompleted;
+    }
+    for (int i = 0; i < 4; i++)
+        if (t[i])
+            CFRelease(t[i]);
+    if (!ok) {
+        CVPixelBufferRelease(out);
+        return NULL;
+    }
+    CVBufferPropagateAttachments(pb, out);
+    return out;
 }
 
