+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn retina() -> (Vec<Display>, Vec<Rect>) {
+        let d = Display { id: 7, width: 2868, height: 1320, x: 0, y: 0 };
+        let b = Rect { origin: Point { x: 0.0, y: 0.0 }, size: Size { width: 1434.0, height: 660.0 } };
+        (vec![d], vec![b])
+    }
+
+    fn shape(n: u32) -> Shape {
+        Shape { width: 2, height: 2, xhot: 1, yhot: 1, data: vec![0xFF00_0000 | n; 4] }
+    }
+
+    #[test]
+    fn position_in_pixels_of_the_kyber_display() {
+        let (d, b) = retina();
+        assert_eq!(display_under(Point { x: 100.5, y: 10.0 }, &d, &b), Some((7, 201, 20, 2.0)));
+        assert_eq!(display_under(Point { x: 2000.0, y: 10.0 }, &d, &b), None);
+    }
+
+    #[test]
+    fn shape_then_positions_then_hidden() {
+        let mut sent = Sent::default();
+        let mut reads = 0;
+        let mut read = |_: f64| {
+            reads += 1;
+            Some(shape(1))
+        };
+        let first = next_packet(&mut sent, Some((7, 10, 10, 2.0)), &mut read, Some(1)).unwrap();
+        assert!(matches!(first.data, CursorData::Raw(_)) && first.visible);
+        // Même place : rien. Ailleurs : la position seule.
+        assert!(next_packet(&mut sent, Some((7, 10, 10, 2.0)), &mut read, Some(1)).is_none());
+        let moved = next_packet(&mut sent, Some((7, 11, 10, 2.0)), &mut read, Some(1)).unwrap();
+        assert_eq!((moved.x, moved.data), (11, CursorData::None));
+        // Hors des écrans : masqué une fois.
+        let hidden = next_packet(&mut sent, None, &mut read, Some(1)).unwrap();
+        assert!(!hidden.visible && hidden.display_id == 7);
+        assert!(next_packet(&mut sent, None, &mut read, Some(1)).is_none());
+        // De retour : la forme de nouveau.
+        let back = next_packet(&mut sent, Some((7, 11, 10, 2.0)), &mut read, Some(1)).unwrap();
+        assert!(matches!(back.data, CursorData::Raw(_)));
+        drop(read);
+        assert_eq!(reads, 1, "forme relue seulement quand le compteur change");
+    }
+
+    #[test]
+    fn new_seed_with_a_new_shape_sends_it() {
+        let mut sent = Sent::default();
+        next_packet(&mut sent, Some((7, 10, 10, 2.0)), &mut |_| Some(shape(1)), Some(1)).unwrap();
+        // Compteur changé, même image : la position seule.
+        let same = next_packet(&mut sent, Some((7, 12, 10, 2.0)), &mut |_| Some(shape(1)), Some(2)).unwrap();
+        assert_eq!(same.data, CursorData::None);
+        let other = next_packet(&mut sent, Some((7, 12, 10, 2.0)), &mut |_| Some(shape(2)), Some(3)).unwrap();
+        assert!(matches!(other.data, CursorData::Raw(_)));
+    }
+
+    /// Lit le vrai pointeur depuis un fil, comme kynputserver (`-- --ignored`).
+    #[test]
+    #[ignore]
+    fn reads_the_system_cursor() {
+        let (shape, seed, at) = thread::spawn(|| (read_shape(2.0), cursor_seed(), location())).join().unwrap();
+        let shape = shape.expect("forme du pointeur");
+        println!("forme {}x{} point actif ({}, {}), compteur {seed:?}, position {at:?}", shape.width, shape.height, shape.xhot, shape.yhot);
+        assert!(shape.data.iter().any(|px| px >> 24 != 0), "image non vide");
+    }
+
+    #[test]
+    fn hidden_only_after_the_delay() {
+        let mut hide = HideDelay::default();
+        let t0 = Instant::now();
+        assert!(!hide.hidden(true, t0));
+        assert!(!hide.hidden(false, t0));
+        assert!(!hide.hidden(false, t0 + Duration::from_millis(200)));
+        assert!(hide.hidden(false, t0 + Duration::from_millis(260)));
+        // Visible de nouveau : tout de suite ; un nouveau masquage repart de zéro.
+        assert!(!hide.hidden(true, t0 + Duration::from_millis(300)));
+        assert!(!hide.hidden(false, t0 + Duration::from_millis(400)));
+        assert!(hide.hidden(false, t0 + Duration::from_millis(700)));
+    }
+
+    #[test]
+    fn straight_alpha() {
+        assert_eq!(unpremultiply(0x8040_2010), 0x807F_3F1F);
+        assert_eq!(unpremultiply(0x0012_3456), 0);
+        assert_eq!(unpremultiply(0xFF12_3456), 0xFF12_3456);
