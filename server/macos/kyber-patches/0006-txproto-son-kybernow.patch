+/* KyberNow (0006): one frame per Core Audio cycle of the loopback input,
+ * interleaved floats, timed by the cycle's host time (same clock as SCK). */
+static void kn_push_input(IOSysEntry *entry, const AudioBufferList *in,
+                          const AudioTimeStamp *when)
+{
+    SCKCapture *capture = (SCKCapture *)entry->io_priv;
+    if (!in || in->mNumberBuffers < 1 || atomic_load(&capture->quit))
+        return;
+    int ch = capture->kn_channels;
+    const AudioBuffer *b = &in->mBuffers[0];
+    if (!b->mData || b->mNumberChannels != (UInt32)ch)
+        return;
+    int nb_samples = b->mDataByteSize / (4 * ch);
+    if (nb_samples <= 0)
+        return;
+
+    AVFrame *frame = av_frame_alloc();
+    if (!frame)
+        return;
+    frame->format = AV_SAMPLE_FMT_FLT;
+    frame->sample_rate = 48000;
+    frame->nb_samples = nb_samples;
+    av_channel_layout_default(&frame->ch_layout, ch);
+    if (av_frame_get_buffer(frame, 0) < 0) {
+        av_frame_free(&frame);
+        return;
+    }
+    memcpy(frame->data[0], b->mData, (size_t)nb_samples * ch * 4);
+
+    uint64_t host = (when && (when->mFlags & kAudioTimeStampHostTimeValid))
+                    ? when->mHostTime : mach_absolute_time();
+    frame->pts = (int64_t)(AudioConvertHostTimeToNanos(host) / 1000) - capture->epoch;
+    frame->duration = av_rescale_q(nb_samples, (AVRational){1, 48000}, AV_TIME_BASE_Q);
+
+    frame->opaque_ref = av_buffer_allocz(sizeof(FormatExtraData));
+    if (!frame->opaque_ref) {
+        av_frame_free(&frame);
+        return;
+    }
+    FormatExtraData *fe = (FormatExtraData *)frame->opaque_ref->data;
+    fe->time_base = AV_TIME_BASE_Q;
+    fe->bits_per_sample = 32;
+
+    int err = sp_frame_fifo_push(entry->frames, frame);
+    if (err == AVERROR(ENOBUFS)) {
+        capture->dropped_frames++;
+        sp_log(entry, SP_LOG_WARN, "Dropping audio (%d samples, %d dropped so far)\n",
+               nb_samples, capture->dropped_frames);
+    } else if (err) {
+        sp_log(entry, SP_LOG_ERROR, "Push audio frame failed: %s\n", av_err2str(err));
+    }
+    av_frame_free(&frame);
 }
 
+static int kn_startAudioCapture(IOSysEntry *entry, AudioObjectID dev, int channels)
+{
+    SCKCapture *capture = (SCKCapture *)entry->io_priv;
+
+    sp_set_thread_name_self(sp_class_get_name(entry));
+    sp_eventlist_dispatch(entry, entry->events,
+                          SP_EVENT_ON_CONFIG | SP_EVENT_ON_INIT, NULL);
+
+    /* The 48 kHz the entry advertises. */
+    AudioObjectPropertyAddress a = { kAudioDevicePropertyNominalSampleRate,
+                                     kAudioObjectPropertyScopeGlobal,
+                                     kAudioObjectPropertyElementMain };
+    Float64 rate = 48000.0;
+    AudioObjectSetPropertyData(dev, &a, 0, NULL, sizeof(rate), &rate);
+
+    capture->kn_device = dev;
+    capture->kn_channels = channels;
+    OSStatus st = AudioDeviceCreateIOProcIDWithBlock(&capture->kn_proc, dev, NULL,
+        ^(const AudioTimeStamp *now, const AudioBufferList *in, const AudioTimeStamp *in_time,
+          AudioBufferList *out, const AudioTimeStamp *out_time) {
+            (void)now; (void)out; (void)out_time;
+            kn_push_input(entry, in, in_time);
+        });
+    if (st != noErr) {
+        sp_log(entry, SP_LOG_ERROR, "KyberNow audio: IOProc creation failed (%d)\n", (int)st);
+        capture->kn_proc = NULL;
+        return sck_startAudioCapture(entry);
+    }
+    st = AudioDeviceStart(dev, capture->kn_proc);
+    if (st != noErr) {
+        sp_log(entry, SP_LOG_ERROR, "KyberNow audio: start failed (%d)\n", (int)st);
+        AudioDeviceDestroyIOProcID(dev, capture->kn_proc);
+        capture->kn_proc = NULL;
+        return sck_startAudioCapture(entry);
+    }
+    sp_log(entry, SP_LOG_INFO, "KyberNow audio capture started (%d channels)\n", channels);
+    return 0;
+}
