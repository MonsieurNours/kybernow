+/*
+ * KyberNow (server/macos/kyber-patches/0006): during a session, Admin sends
+ * the Mac's sound to the KyberNow output (server/macos/audio-driver), set to
+ * the device's channel count (2, 6 or 8). Its loopback input gives back what
+ * is played there, in WAV channel order: the audio entries then advertise
+ * that channel count and read that input through Core Audio instead of
+ * ScreenCaptureKit (whose capture stutters when the output is a virtual
+ * device, and stays stereo). Reading an input needs the microphone
+ * permission for the bundle that runs Kyber. Any other output: unchanged.
+ */
+#define KN_DEVICE_UID "fr.leslignesclaires.kybernow.audio.device"
+
+/* The KyberNow device if it is the default output, with its channel count. */
+static AudioObjectID kn_output_device(int *channels)
+{
+    AudioObjectPropertyAddress a = { kAudioHardwarePropertyTranslateUIDToDevice,
+                                     kAudioObjectPropertyScopeGlobal,
+                                     kAudioObjectPropertyElementMain };
+    CFStringRef uid = CFSTR(KN_DEVICE_UID);
+    AudioObjectID dev = kAudioObjectUnknown;
+    UInt32 size = sizeof(dev);
+    if (AudioObjectGetPropertyData(kAudioObjectSystemObject, &a, sizeof(uid), &uid,
+                                   &size, &dev) != noErr || dev == kAudioObjectUnknown)
+        return kAudioObjectUnknown;
+
+    AudioObjectID def = kAudioObjectUnknown;
+    size = sizeof(def);
+    a.mSelector = kAudioHardwarePropertyDefaultOutputDevice;
+    if (AudioObjectGetPropertyData(kAudioObjectSystemObject, &a, 0, NULL, &size, &def) != noErr ||
+        def != dev)
+        return kAudioObjectUnknown;
+
+    AudioStreamID stream = 0;
+    size = sizeof(stream);
+    a.mSelector = kAudioDevicePropertyStreams;
+    a.mScope = kAudioObjectPropertyScopeInput;
+    if (AudioObjectGetPropertyData(dev, &a, 0, NULL, &size, &stream) != noErr || !stream)
+        return kAudioObjectUnknown;
+
+    AudioStreamBasicDescription f = { 0 };
+    size = sizeof(f);
+    a.mSelector = kAudioStreamPropertyVirtualFormat;
+    a.mScope = kAudioObjectPropertyScopeGlobal;
+    if (AudioObjectGetPropertyData(stream, &a, 0, NULL, &size, &f) != noErr ||
+        f.mChannelsPerFrame < 1 || f.mChannelsPerFrame > 8)
+        return kAudioObjectUnknown;
+
+    if (channels)
+        *channels = f.mChannelsPerFrame;
+    return dev;
+}
 
