+/// KyberNow (server/macos/kyber-patches/0017, 0019): on a Mac Station,
+/// ScreenCaptureKit gives NV12 (BT.709, full range) that the Metal encoder
+/// takes as is, for PyroWave in 4:2:0 SDR at the device's size: no RGB to
+/// YCbCr pass on the GPU, nor its wait (about 1 ms at 60 Hz). 4:4:4, HDR10
+/// (P010) and a guest's scaled image keep BGRA and the encoder's conversion.
+pub(crate) fn nv12_capture(codec: VideoCodec, yuv444: bool, scaled: bool, pq: bool) -> bool {
+    cfg!(target_os = "macos") && codec == VideoCodec::PyroWave && !yuv444 && !scaled && !pq
+}
+
 /// Options of the PyroWave encoder: bitrate (the frame budget is
 /// bitrate / 8 / fps), 4:4:4 (SDR only), a guest's own image scaled down on
 /// the graphics card by PyroWave itself, its capped rate, the GPU queue
@@ -142,6 +151,16 @@ mod tests {
         assert_eq!(codec, VideoCodec::H264);
     }
 
+    #[test]
+    fn nv12_from_the_mac_capture_for_420_sdr_only() {
+        let mac = cfg!(target_os = "macos");
+        assert_eq!(nv12_capture(VideoCodec::PyroWave, false, false, false), mac);
+        assert!(!nv12_capture(VideoCodec::PyroWave, true, false, false));
+        assert!(!nv12_capture(VideoCodec::PyroWave, false, true, false));
+        assert!(!nv12_capture(VideoCodec::PyroWave, false, false, true));
+        assert!(!nv12_capture(VideoCodec::HEVC, false, false, false));
+    }
