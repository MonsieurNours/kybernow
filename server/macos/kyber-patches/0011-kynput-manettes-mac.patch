+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pad(buttons: &[GamepadButton]) -> PadState {
+        let mut s = PadState::default();
+        for b in buttons {
+            s.set(*b, true);
+        }
+        s
+    }
+
+    #[test]
+    fn dualsense_at_rest() {
+        let r = PadState::default().dualsense_report(0);
+        assert_eq!(r.len(), 64);
+        assert_eq!(&r[..7], &[0x01, 0x80, 0x80, 0x80, 0x80, 0, 0]);
+        assert_eq!(r[8], 0x08, "croix au repos");
+        assert_eq!((r[9], r[10]), (0, 0));
+        assert_eq!((r[33], r[37]), (0x80, 0x80), "pavé tactile non touché");
+    }
+
+    #[test]
+    fn dualsense_buttons_and_axes() {
+        use GamepadButton as B;
+        let mut s = pad(&[B::A, B::Y, B::DPadUp, B::DPadRight, B::Start, B::Guide, B::RightStick]);
+        s.axes[GamepadAxis::LeftX as usize] = i16::MIN;
+        s.axes[GamepadAxis::LeftY as usize] = i16::MAX;
+        s.axes[GamepadAxis::TriggerRight as usize] = i16::MAX;
+        let r = s.dualsense_report(0);
+        assert_eq!((r[1], r[2]), (0x00, 0xff));
+        assert_eq!(r[6], 0xff);
+        assert_eq!(r[8], 0x01 | 0x20 | 0x80, "haut-droite, croix, triangle");
+        assert_eq!(r[9], 0x08 | 0x20 | 0x80, "R2, Options, R3");
+        assert_eq!(r[10], 0x01, "PS");
+        assert_eq!(s.dualsense_report(0)[7], r[7].wrapping_add(1), "numéro de rapport");
+    }
+
+    #[test]
+    fn xbox_report_layout() {
+        use GamepadButton as B;
+        let r = PadState::default().xbox_report();
+        assert_eq!(r.len(), 17);
+        assert_eq!(&r[1..3], &0x8000u16.to_le_bytes());
+        assert_eq!(r[13], 0, "croix au repos");
+        let mut s = pad(&[B::B, B::LeftShoulder, B::Back, B::Start, B::Guide, B::LeftStick, B::DPadLeft]);
+        s.axes[GamepadAxis::RightY as usize] = i16::MAX;
+        s.axes[GamepadAxis::TriggerLeft as usize] = i16::MAX;
+        let r = s.xbox_report();
+        assert_eq!(&r[7..9], &65534u16.to_le_bytes());
+        assert_eq!(&r[9..11], &1023u16.to_le_bytes());
+        assert_eq!(r[13], 7, "gauche");
+        assert_eq!(r[14], 0x02 | 0x40);
+        assert_eq!(r[15], 0x04 | 0x08 | 0x10 | 0x20);
+    }
+
+    #[test]
+    fn opposite_directions_cancel() {
+        use GamepadButton as B;
+        assert_eq!(pad(&[B::DPadUp, B::DPadDown]).hat(), None);
+        assert_eq!(pad(&[B::DPadDown, B::DPadLeft]).hat(), Some(5));
+    }
+
+    #[test]
+    fn model_choice() {
+        let mut b = Backend { pads: Arc::new(Mutex::new(Pads { models: HashMap::new(), rumbled: HashMap::new() })), devices: HashMap::new(), helper: None, helper_failed: None, consumer: Weak::<HostGamepadHandler>::new(), force_xbox: false, started: Instant::now() };
+        assert_eq!(b.model_for(Some(0x054c), Some(0x0ce6)), Model::DualSense);
+        assert_eq!(b.model_for(Some(0x054c), Some(0x05c4)), Model::DualSense);
+        assert_eq!(b.model_for(Some(0x045e), Some(0x0b13)), Model::Xbox);
+        assert_eq!(b.model_for(None, None), Model::Xbox);
+        b.force_xbox = true;
+        assert_eq!(b.model_for(Some(0x054c), Some(0x0ce6)), Model::Xbox);
+    }
+
+    #[test]
+    fn rumble_reports() {
+        let mut ds = vec![0u8; 48];
+        ds[0] = 0x02;
+        ds[1] = 0x03;
+        ds[3] = 0x40; // petit moteur
+        ds[4] = 0xff; // gros moteur
+        assert_eq!(rumble_from_output(Model::DualSense, 0x02, &ds), Some((65535, 0x40 * 257)));
+        assert_eq!(rumble_from_output(Model::DualSense, 0x02, &ds[1..]), Some((65535, 0x40 * 257)));
+        ds[1] = 0x04; // effet de gâchette seulement
+        assert_eq!(rumble_from_output(Model::DualSense, 0x02, &ds), None);
+        let xb = [0x03, 0x03, 0, 0, 100, 50, 0xff, 0, 0xeb];
+        assert_eq!(rumble_from_output(Model::Xbox, 0x03, &xb), Some((65535, 32767)));
+        let xb = [0x03, 0x02, 0, 0, 100, 50, 0xff, 0, 0xeb];
+        assert_eq!(rumble_from_output(Model::Xbox, 0x03, &xb), Some((65535, 0)));
+        assert_eq!(rumble_from_output(Model::Xbox, 0x05, &xb), None);
+    }
