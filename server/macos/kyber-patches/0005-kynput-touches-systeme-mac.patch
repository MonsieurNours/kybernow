+    /// KyberNow (0005): a Mac Station refuses its guests ⌃⌘Q and ⇧⌘Q.
+    #[test]
+    #[cfg(target_os = "macos")]
+    fn mac_system_shortcuts_are_the_hosts() {
+        let guest = ServerPipelineState::new(KEYBOARD);
+        for (win, other) in [(0xe05b, 0x001d), (0xe05c, 0xe01d), (0xe05b, 0x002a), (0xe05c, 0x0036)] {
+            assert!(passes(&guest, &key(win, true)));
+            assert!(passes(&guest, &key(other, true)));
+            assert!(!passes(&guest, &key(KEY_Q, true)), "⌘ + {other:#x} + Q");
+            assert!(passes(&guest, &key(KEY_Q, false)));
+            assert!(passes(&guest, &key(other, false)));
+            assert!(passes(&guest, &key(win, false)));
+        }
+        // ⌘Q (quit the app), ⌘L, Ctrl+Alt+Del pass.
+        for k in [KEY_Q, KEY_L] {
+            assert!(passes(&guest, &key(0xe05b, true)));
+            assert!(passes(&guest, &key(k, true)));
+            assert!(passes(&guest, &key(k, false)));
+            assert!(passes(&guest, &key(0xe05b, false)));
+        }
+        assert!(passes(&guest, &key(0x001d, true)));
+        assert!(passes(&guest, &key(0x0038, true)));
+        assert!(passes(&guest, &key(DEL, true)));
+        // The host keeps them.
+        let host = ServerPipelineState::new(InputRights::ALL);
+        assert!(passes(&host, &key(0xe05b, true)));
+        assert!(passes(&host, &key(0x001d, true)));
+        assert!(passes(&host, &key(KEY_Q, true)));
+    }
 
