+    fn CGEventSourceSetLocalEventsSuppressionInterval(source: *const std::ffi::c_void, seconds: f64);
+    fn CGPreflightPostEventAccess() -> bool;
+    fn CGRequestPostEventAccess() -> bool;
+    fn CGEventSetLocation(event: *const std::ffi::c_void, location: CGPoint);
+}
+
+/// Pointeur CoreFoundation d'un objet de core-graphics (foreign_type!,
+/// repr(transparent)) ; foreign-types n'est pas une dépendance de kynput.
+fn raw<T>(object: &T) -> *const std::ffi::c_void {
+    const { assert!(std::mem::size_of::<T>() == std::mem::size_of::<*const std::ffi::c_void>()) };
+    unsafe { std::mem::transmute_copy(object) }
+}
