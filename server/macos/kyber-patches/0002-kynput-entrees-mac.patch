+/// Place d'un écran de Kyber (en pixels) parmi les écrans actifs : origine en
+/// points et échelle (pixels par point). `None` : écran introuvable.
+fn locate(display: &Display) -> Option<(CGPoint, f64)> {
+    let ids = CGDisplay::active_displays().ok()?;
+    ids.into_iter().find_map(|id| {
+        let b = CGDisplay::new(id).bounds();
+        if b.size.width <= 0.0 || b.size.height <= 0.0 {
+            return None;
+        }
+        let scale = (f64::from(display.width) / b.size.width).round().max(1.0);
+        let same = |a: f64, b: f64| (a - b).abs() <= scale;
+        (same(f64::from(display.width), b.size.width * scale)
+            && same(f64::from(display.height), b.size.height * scale)
+            && same(f64::from(display.x), b.origin.x * scale)
+            && same(f64::from(display.y), b.origin.y * scale))
+        .then_some((b.origin, scale))
+    })
+}
+
+/// La position bornée aux écrans actifs (un déplacement relatif ne sort pas du bureau).
+fn clamp_to_displays(p: CGPoint) -> CGPoint {
+    let Ok(ids) = CGDisplay::active_displays() else { return p };
+    let rects: Vec<_> = ids.into_iter().map(|id| CGDisplay::new(id).bounds()).collect();
+    if rects.iter().any(|r| p.x >= r.origin.x && p.x < r.origin.x + r.size.width && p.y >= r.origin.y && p.y < r.origin.y + r.size.height) {
+        return p;
+    }
+    // Hors de tout écran : ramenée sur le plus proche.
+    rects
+        .iter()
+        .map(|r| {
+            CGPoint::new(
+                p.x.clamp(r.origin.x, r.origin.x + r.size.width - 1.0),
+                p.y.clamp(r.origin.y, r.origin.y + r.size.height - 1.0),
+            )
+        })
+        .min_by(|a, b| {
+            let d = |q: &CGPoint| (q.x - p.x).powi(2) + (q.y - p.y).powi(2);
+            d(a).total_cmp(&d(b))
+        })
+        .unwrap_or(p)
+}
