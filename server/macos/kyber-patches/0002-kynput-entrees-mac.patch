+/// Types d'événement d'un bouton : appui, relâche, glisser.
+fn button_types(button: MouseButtonType) -> (CGEventType, CGEventType, CGEventType) {
+    match button {
+        MouseButtonType::Left => (CGEventType::LeftMouseDown, CGEventType::LeftMouseUp, CGEventType::LeftMouseDragged),
+        MouseButtonType::Right => (CGEventType::RightMouseDown, CGEventType::RightMouseUp, CGEventType::RightMouseDragged),
+        _ => (CGEventType::OtherMouseDown, CGEventType::OtherMouseUp, CGEventType::OtherMouseDragged),
+    }
