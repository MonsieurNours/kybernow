+/// Numéro de bouton de macOS (0 gauche, 1 droit, 2 milieu, puis ordre USB).
+fn button_number(button: MouseButtonType) -> i64 {
+    match button {
+        MouseButtonType::Left => 0,
+        MouseButtonType::Right => 1,
+        MouseButtonType::Middle => 2,
+        MouseButtonType::Side => 3,
+        MouseButtonType::Extra => 4,
+    }
