+
+/* KyberNow (0006, 0013): the loopback input, interleaved floats, in 10 ms
+ * frames; each frame is timed by its first sample, from the cycle's host time
+ * (same clock as SCK). */
+static void kn_push_input(IOSysEntry *entry, const AudioBufferList *in,
+                          const AudioTimeStamp *when)
+{
+    SCKCapture *capture = (SCKCapture *)entry->io_priv;
+    if (!in || in->mNumberBuffers < 1 || atomic_load(&capture->quit))
+        return;
+    int ch = capture->kn_channels;
+    const AudioBuffer *b = &in->mBuffers[0];
+    if (!b->mData || b->mNumberChannels != (UInt32)ch || ch < 1 || ch > 8)
+        return;
+    int nb_samples = b->mDataByteSize / (4 * ch);
+    if (nb_samples <= 0)
+        return;
+
+    uint64_t host = (when && (when->mFlags & kAudioTimeStampHostTimeValid))
+                    ? when->mHostTime : mach_absolute_time();
+    int64_t base = (int64_t)(AudioConvertHostTimeToNanos(host) / 1000) - capture->epoch;
+    const float *src = (const float *)b->mData;
+    int done = 0;
+    while (done < nb_samples) {
+        if (!capture->kn_acc_n)
+            capture->kn_acc_pts = base + av_rescale(done, 1000000, 48000);
+        int take = FFMIN(480 - capture->kn_acc_n, nb_samples - done);
+        memcpy(capture->kn_acc + (size_t)capture->kn_acc_n * ch, src + (size_t)done * ch,
+               (size_t)take * ch * 4);
+        capture->kn_acc_n += take;
+        done += take;
+        if (capture->kn_acc_n == 480) {
+            kn_emit(entry, capture->kn_acc, 480, capture->kn_acc_pts);
+            capture->kn_acc_n = 0;
+        }
+    }
 }
 
