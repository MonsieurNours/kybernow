+/* KyberNow (0013): a full 10 ms frame into the ring (real-time thread: a
+ * copy, two atomics and a semaphore signal); a full ring loses the frame,
+ * counted, logged by the ring's thread. */
+static void kn_ring_put(SCKCapture *capture, int ch)
+{
+    unsigned w = atomic_load_explicit(&capture->kn_ring_w, memory_order_relaxed);
+    unsigned r = atomic_load_explicit(&capture->kn_ring_r, memory_order_acquire);
+    if (!capture->kn_ring || w - r >= KN_RING) {
+        atomic_fetch_add_explicit(&capture->kn_ring_dropped, 1, memory_order_relaxed);
+        return;
+    }
+    memcpy(capture->kn_ring[w % KN_RING], capture->kn_acc, (size_t)480 * ch * 4);
+    capture->kn_ring_pts[w % KN_RING] = capture->kn_acc_pts;
+    atomic_store_explicit(&capture->kn_ring_w, w + 1, memory_order_release);
+    dispatch_semaphore_signal(capture->kn_ring_sem);
+}
+
+/* KyberNow (0013): the ring's thread: frames to the encoder, losses logged
+ * (once per change, not per frame). */
+static void *kn_ring_loop(void *arg)
+{
+    IOSysEntry *entry = arg;
+    SCKCapture *capture = (SCKCapture *)entry->io_priv;
+    unsigned dropped_seen = 0;
+    for (;;) {
+        dispatch_semaphore_wait(capture->kn_ring_sem,
+                                dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC));
+        unsigned r = atomic_load_explicit(&capture->kn_ring_r, memory_order_relaxed);
+        unsigned w = atomic_load_explicit(&capture->kn_ring_w, memory_order_acquire);
+        while (r != w) {
+            kn_emit(entry, capture->kn_ring[r % KN_RING], 480, capture->kn_ring_pts[r % KN_RING]);
+            r++;
+            atomic_store_explicit(&capture->kn_ring_r, r, memory_order_release);
+        }
+        unsigned dropped = atomic_load_explicit(&capture->kn_ring_dropped, memory_order_relaxed);
+        if (dropped != dropped_seen) {
+            sp_log(entry, SP_LOG_WARN, "KyberNow audio: %u frames of 10 ms lost (encoder late)\n",
+                   dropped - dropped_seen);
+            dropped_seen = dropped;
+        }
+        if (!atomic_load(&capture->kn_ring_running))
+            return NULL;
+    }
+}
+
+static int kn_ring_start(IOSysEntry *entry)
+{
+    SCKCapture *capture = (SCKCapture *)entry->io_priv;
+    capture->kn_ring = av_malloc(KN_RING * sizeof(*capture->kn_ring));
+    if (!capture->kn_ring)
+        return AVERROR(ENOMEM);
+    atomic_store(&capture->kn_ring_w, 0);
+    atomic_store(&capture->kn_ring_r, 0);
+    atomic_store(&capture->kn_ring_dropped, 0);
+    atomic_store(&capture->kn_ring_running, 1);
+    capture->kn_ring_sem = dispatch_semaphore_create(0);
+    if (pthread_create(&capture->kn_ring_thread, NULL, kn_ring_loop, entry)) {
+        atomic_store(&capture->kn_ring_running, 0);
+        capture->kn_ring_sem = nil;
+        av_freep(&capture->kn_ring);
+        return AVERROR(EAGAIN);
+    }
+    return 0;
+}
+
+/* After the IOProc is gone: what is left is sent, then the thread ends. */
+static void kn_ring_stop(SCKCapture *capture)
+{
+    if (!capture->kn_ring)
+        return;
+    atomic_store(&capture->kn_ring_running, 0);
+    dispatch_semaphore_signal(capture->kn_ring_sem);
+    pthread_join(capture->kn_ring_thread, NULL);
+    capture->kn_ring_sem = nil;
+    av_freep(&capture->kn_ring);
+}
+
+/* KyberNow (0006, 0013): the loopback input, interleaved floats, in 10 ms
+ * frames; each frame is timed by its first sample, from the cycle's host time
+ * (same clock as SCK). */
+static void kn_push_input(IOSysEntry *entry, const AudioBufferList *in,
+                          const AudioTimeStamp *when)
+{
+    SCKCapture *capture = (SCKCapture *)entry->io_priv;
+    if (!in || in->mNumberBuffers < 1 || atomic_load(&capture->quit))
+        return;
+    int ch = capture->kn_channels;
+    const AudioBuffer *b = &in->mBuffers[0];
+    if (!b->mData || b->mNumberChannels != (UInt32)ch || ch < 1 || ch > 8)
+        return;
+    int nb_samples = b->mDataByteSize / (4 * ch);
+    if (nb_samples <= 0)
+        return;
+
+    uint64_t host = (when && (when->mFlags & kAudioTimeStampHostTimeValid))
+                    ? when->mHostTime : mach_absolute_time();
+    int64_t base = (int64_t)(AudioConvertHostTimeToNanos(host) / 1000) - capture->epoch;
+    const float *src = (const float *)b->mData;
+    int done = 0;
+    while (done < nb_samples) {
+        if (!capture->kn_acc_n)
+            capture->kn_acc_pts = base + av_rescale(done, 1000000, 48000);
+        int take = FFMIN(480 - capture->kn_acc_n, nb_samples - done);
+        memcpy(capture->kn_acc + (size_t)capture->kn_acc_n * ch, src + (size_t)done * ch,
+               (size_t)take * ch * 4);
+        capture->kn_acc_n += take;
+        done += take;
+        if (capture->kn_acc_n == 480) {
+            kn_ring_put(capture, ch);
+            capture->kn_acc_n = 0;
+        }
+    }
+}
