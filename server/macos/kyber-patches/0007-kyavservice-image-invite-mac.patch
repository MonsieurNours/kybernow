 /// Encoders whose image can be scaled down: on Windows only (D3D11 frames of
 /// the desktop capture), on the graphics card for NVENC, AMF and QSV, in
 /// software for x264.
+///
+/// KyberNow (server/macos/kyber-patches/0007): on a Mac Station, VideoToolbox
+/// too, through `scale_vt` on the ScreenCaptureKit frames.
 pub(crate) fn can_scale(encoder: VideoEncoder, windows: bool) -> bool {
-    windows
+    (windows
         && matches!(
             encoder,
             VideoEncoder::NVENC | VideoEncoder::AMF | VideoEncoder::QSV | VideoEncoder::X264
-        )
+        ))
+        || (cfg!(target_os = "macos") && matches!(encoder, VideoEncoder::VIDEOTOOLBOX))
 }
 
+/// KyberNow (0007): VideoToolbox scales a guest's own image down on the
+/// capture's frames (ScreenCaptureKit, VideoToolbox pixel buffers).
+pub(crate) fn vt_scale(scale: VideoScale) -> String {
+    format!("scale_vt=w={}:h={}", scale.width, scale.height)
+}
+
 /// Checks a guest's own image against what the engine can make: `scaling`
