+/* KyberNow : empreinte des écrans actifs (identifiant, place, mode), lue sans
+ * ScreenCaptureKit ; ScreenCaptureKit n'est interrogé que si elle change. */
+static void sck_signature(char *out, size_t size)
+{
+    CGDirectDisplayID ids[32];
+    uint32_t n = 0;
+    size_t len = 0;
+    out[0] = 0;
+    if (CGGetActiveDisplayList(32, ids, &n) != kCGErrorSuccess)
+        return;
+    for (uint32_t i = 0; i < n && len < size; i++) {
+        CGRect b = CGDisplayBounds(ids[i]);
+        size_t pw = 0, ph = 0;
+        CGDisplayModeRef m = CGDisplayCopyDisplayMode(ids[i]);
+        if (m) {
+            pw = CGDisplayModeGetPixelWidth(m);
+            ph = CGDisplayModeGetPixelHeight(m);
+            CGDisplayModeRelease(m);
+        }
+        len += snprintf(out + len, size - len, "%u:%d,%d,%d,%d,%zu,%zu,%d;", ids[i],
+                        (int)b.origin.x, (int)b.origin.y, (int)b.size.width,
+                        (int)b.size.height, pw, ph, CGDisplayIsMain(ids[i]));
+    }
+}
+
+static void *sck_watch_thread(void *s)
+{
+    SCKCtx *ctx = s;
+    char now[sizeof(ctx->signature)];
+    while (!atomic_load(&ctx->watch_quit)) {
+        av_usleep(250000);
+        sck_signature(now, sizeof(now));
+        if (strcmp(now, ctx->signature)) {
+            memcpy(ctx->signature, now, sizeof(now));
+            update_entries(ctx);
+        }
+    }
+    return NULL;
+}
