+
+/* KyberNow (0014): a KyberNow virtual display of 4K or more gets every
+ * macOS scale (server/macos/display-agent): macOS draws it larger than the
+ * device's screen ("looks like 2560 x 1440" on a 4K screen: 5120 x 2880) and
+ * the image is brought back to the device's definition here, like a real 4K
+ * panel does. The display agent writes that definition, per display, in
+ * ~/Library/Application Support/KyberNow/virtual-displays.json
+ * ({"<display id>": {"width": 3840, "height": 2160}}). */
+static int kn_panel_size(uint32_t display_id, int *w, int *h)
+{
+    if (CGDisplayVendorNumber(display_id) != 0x4B4E)
+        return 0;
+    @autoreleasepool {
+        NSString *path = [NSHomeDirectory() stringByAppendingPathComponent:
+                          @"Library/Application Support/KyberNow/virtual-displays.json"];
+        NSData *data = [NSData dataWithContentsOfFile:path];
+        if (!data)
+            return 0;
+        NSDictionary *all = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+        if (![all isKindOfClass:[NSDictionary class]])
+            return 0;
+        NSDictionary *d = all[[NSString stringWithFormat:@"%u", display_id]];
+        if (![d isKindOfClass:[NSDictionary class]])
+            return 0;
+        int pw = [d[@"width"] intValue], ph = [d[@"height"] intValue];
+        if (pw <= 0 || ph <= 0)
+            return 0;
+        *w = pw;
+        *h = ph;
+        return 1;
+    }
 }
 
