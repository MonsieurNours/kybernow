+/// KyberNow : adresse source d'un envoi sur macOS. Un Mac branché deux fois au
+/// même réseau (Ethernet et Wi-Fi) répondait sinon depuis l'adresse de la route
+/// par défaut, que le client QUIC rejette (il a appelé l'autre adresse).
+#[cfg(apple)]
+fn apple_src_pktinfo(v4: std::net::Ipv4Addr) -> libc::in_pktinfo {
+    libc::in_pktinfo {
+        ipi_ifindex: 0,
+        ipi_spec_dst: libc::in_addr {
+            s_addr: u32::from_ne_bytes(v4.octets()),
+        },
+        ipi_addr: libc::in_addr { s_addr: 0 },
+    }
+}
