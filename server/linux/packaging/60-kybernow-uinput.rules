# KyberNow Station pour Linux : /dev/uinput et /dev/uhid pour l'utilisateur
# assis devant l'ordinateur (uaccess), pour le clavier, la souris, le pointeur
# absolu, les manettes et le stylet des appareils connectés.
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
# /dev/uhid : manettes PlayStation de l'appareil, en DualSense (pilote hid-playstation)
KERNEL=="uhid", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uhid"
# hidraw de ces DualSense (et DualSense Edge) pour SDL et Steam, comme une vraie branchée en USB
KERNEL=="hidraw*", KERNELS=="0003:054C:0CE6.*", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0003:054C:0DF2.*", TAG+="uaccess"
