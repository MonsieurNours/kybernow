+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+//! KyberNow (Station Linux, correctif 0006) : le stylet de l'appareil,
+//! traduit en événements d'une tablette graphique (evdev). Ce module ne fait
+//! que la traduction, sans uinput (`host_pen.rs` l'écrit) : ses tests passent
+//! aussi hors de Linux.
+//!
+//! - La tablette couvre la boîte autour des écrans que la Station annonce,
+//!   comme le pointeur absolu (`abs_pointer.rs`) : le compositeur (et Xorg)
+//!   étend une tablette sans écran à elle sur tout le bureau.
+//! - Approche (`IN_RANGE`) : outil pointe (`BTN_TOOL_PEN`) ou gomme
+//!   (`BTN_TOOL_RUBBER`), toujours sans pression d'abord : libinput prendrait
+//!   une pression à l'approche pour l'usure de la pointe et la retrancherait.
+//!   Un changement de bout sans départ fait partir l'un avant d'entrer l'autre.
+//! - Contact : `BTN_TOUCH` et une pression jamais sous 6 % de l'étendue :
+//!   libinput décide du contact par la pression (seuil de 5 % sur une tablette
+//!   qu'il ne connaît pas), pas par `BTN_TOUCH`.
+//! - Inclinaison en centièmes de degré (résolution en unités par radian, que
+//!   libinput convertit en degrés) ; mêmes sens que le protocole (X vers la
+//!   droite, Y vers soi). La rotation n'est pas transmise : libinput ne la lit
+//!   que sur certains stylets Wacom.
+//! - Bouton du stylet : `BTN_STYLUS`.
+//! - Départ (pas de `IN_RANGE`) : pointe levée, boutons relâchés, outil retiré.
+
+use crate::{Display, Pen};
+
+/// Étendue des axes X et Y : la boîte des écrans est ramenée à 0..=AXIS_MAX.
+pub(crate) const AXIS_MAX: i32 = 65535;
+/// Résolution des axes X et Y (unités par millimètre) : libinput refuse une
+/// tablette sans taille.
+pub(crate) const AXIS_RESOLUTION: i32 = 100;
+pub(crate) const PRESSURE_MAX: i32 = 4095;
+/// Plus petite pression en contact (6 %), au-dessus du seuil de libinput.
+const CONTACT_FLOOR: i32 = PRESSURE_MAX * 6 / 100;
+/// Inclinaison en centièmes de degré, de -90° à 90°.
+pub(crate) const TILT_MAX: i32 = 9000;
+/// Centièmes de degré par radian (100 × 180 / π).
+pub(crate) const TILT_RESOLUTION: i32 = 5730;
+
+/// Les codes evdev dont la tablette se sert.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Code {
+    ToolPen,
+    ToolRubber,
+    Touch,
+    Stylus,
+    X,
+    Y,
+    Pressure,
+    TiltX,
+    TiltY,
+}
+
+/// Événements d'un même instant (suivis d'un `SYN_REPORT`).
+pub(crate) type Frame = Vec<(Code, i32)>;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Tool {
+    Pen,
+    Rubber,
+}
+
+impl Tool {
+    fn code(self) -> Code {
+        match self {
+            Tool::Pen => Code::ToolPen,
+            Tool::Rubber => Code::ToolRubber,
+        }
+    }
+}
+
+/// État de la tablette, entre deux paquets du stylet.
+#[derive(Default)]
+pub(crate) struct PenTablet {
+    tool: Option<Tool>,
+    touching: bool,
+    barrel: bool,
+}
+
+/// Place (x, y) de l'écran `display_id` dans la boîte des écrans, ramenée
+/// à 0..=AXIS_MAX.
+pub(crate) fn box_position(displays: &[Display], display_id: u32, x: i16, y: i16) -> Option<(i32, i32)> {
+    let display = displays.iter().find(|d| d.id == display_id)?;
+    let left = displays.iter().map(|d| d.x).min()?;
+    let top = displays.iter().map(|d| d.y).min()?;
+    let right = displays.iter().map(|d| d.x + d.width).max()?;
+    let bottom = displays.iter().map(|d| d.y + d.height).max()?;
+    let scale = |v: i32, lo: i32, hi: i32| {
+        let span = (hi - lo - 1).max(1) as i64;
+        (((v - lo).clamp(0, span as i32) as i64 * AXIS_MAX as i64 + span / 2) / span) as i32
+    };
+    Some((scale(display.x + x as i32, left, right), scale(display.y + y as i32, top, bottom)))
+}
+
+fn pressure(pen: &Pen) -> i32 {
+    if !pen.has(Pen::CONTACT) {
+        return 0;
+    }
+    CONTACT_FLOOR + ((pen.pressure as i64 * (PRESSURE_MAX - CONTACT_FLOOR) as i64) / Pen::MAX_PRESSURE as i64) as i32
+}
+
+impl PenTablet {
+    /// Le stylet est près de la surface (outil entré).
+    pub(crate) fn in_range(&self) -> bool {
+        self.tool.is_some()
+    }
+
+    /// Événements pour un paquet `Pen` de l'appareil.
+    pub(crate) fn update(&mut self, pen: &Pen, displays: &[Display]) -> Vec<Frame> {
+        if !pen.has(Pen::IN_RANGE) {
+            return self.leave();
+        }
+        let Some((x, y)) = box_position(displays, pen.display_id, pen.x, pen.y) else {
+            return vec![];
+        };
+        let tool = if pen.has(Pen::ERASER) { Tool::Rubber } else { Tool::Pen };
+        let (tilt_x, tilt_y) = if pen.has(Pen::TILT) {
+            (pen.tilt_x as i32 * 100, pen.tilt_y as i32 * 100)
+        } else {
+            (0, 0)
+        };
+        let place = [(Code::X, x), (Code::Y, y), (Code::TiltX, tilt_x), (Code::TiltY, tilt_y)];
+
+        let mut frames = vec![];
+        if self.tool.is_some_and(|t| t != tool) {
+            frames.extend(self.leave());
+        }
+        if self.tool.is_none() {
+            let mut enter = vec![(tool.code(), 1)];
+            enter.extend(place);
+            enter.push((Code::Pressure, 0));
+            frames.push(enter);
+            self.tool = Some(tool);
+        }
+
+        let mut frame: Frame = place.to_vec();
+        frame.push((Code::Pressure, pressure(pen)));
+        let touching = pen.has(Pen::CONTACT);
+        if touching != self.touching {
+            frame.push((Code::Touch, touching as i32));
+            self.touching = touching;
+        }
+        let barrel = pen.has(Pen::BARREL);
+        if barrel != self.barrel {
+            frame.push((Code::Stylus, barrel as i32));
+            self.barrel = barrel;
+        }
+        frames.push(frame);
+        frames
+    }
+
+    /// Le stylet part : pointe levée, bouton relâché, outil retiré.
+    pub(crate) fn leave(&mut self) -> Vec<Frame> {
+        let Some(tool) = self.tool.take() else {
+            return vec![];
+        };
+        let mut frame = vec![];
+        if std::mem::take(&mut self.touching) {
+            frame.push((Code::Touch, 0));
+        }
+        if std::mem::take(&mut self.barrel) {
+            frame.push((Code::Stylus, 0));
+        }
+        frame.push((Code::Pressure, 0));
+        frame.push((tool.code(), 0));
+        vec![frame]
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn displays() -> Vec<Display> {
+        vec![
+            Display { id: 1, x: 0, y: 0, width: 1920, height: 1080 },
+            Display { id: 2, x: 1920, y: 0, width: 1280, height: 720 },
+        ]
+    }
+
+    fn pen(flags: u8, pressure: u16) -> Pen {
+        Pen { pressure, flags, ..Pen::new(1, 960, 540) }
+    }
+
+    fn value(frame: &Frame, code: Code) -> Option<i32> {
+        frame.iter().find(|(c, _)| *c == code).map(|(_, v)| *v)
+    }
+
+    #[test]
+    fn box_of_the_displays() {
+        let d = displays();
+        assert_eq!(box_position(&d, 1, 0, 0), Some((0, 0)));
+        assert_eq!(box_position(&d, 2, 1279, 0).map(|p| p.0), Some(AXIS_MAX));
+        assert_eq!(box_position(&d, 1, 0, 1079).map(|p| p.1), Some(AXIS_MAX));
+        assert_eq!(box_position(&d, 9, 0, 0), None, "écran inconnu");
+    }
+
+    #[test]
+    fn approach_then_contact_then_leave() {
+        let d = displays();
+        let mut t = PenTablet::default();
+
+        // Contact dès le premier paquet : d'abord l'approche, sans pression.
+        let f = t.update(&pen(Pen::IN_RANGE | Pen::CONTACT, 0), &d);
+        assert_eq!(f.len(), 2);
+        assert_eq!(value(&f[0], Code::ToolPen), Some(1));
+        assert_eq!(value(&f[0], Code::Pressure), Some(0));
+        assert_eq!(value(&f[1], Code::Touch), Some(1));
+        assert_eq!(value(&f[1], Code::Pressure), Some(CONTACT_FLOOR), "jamais 0 en contact");
+        assert!(t.in_range());
+
+        let f = t.update(&pen(Pen::IN_RANGE | Pen::CONTACT, Pen::MAX_PRESSURE), &d);
+        assert_eq!(f.len(), 1);
+        assert_eq!(value(&f[0], Code::Pressure), Some(PRESSURE_MAX));
+        assert_eq!(value(&f[0], Code::Touch), None, "contact inchangé");
+
+        // Pointe levée, survol.
+        let f = t.update(&pen(Pen::IN_RANGE, 0), &d);
+        assert_eq!(value(&f[0], Code::Touch), Some(0));
+        assert_eq!(value(&f[0], Code::Pressure), Some(0));
+
+        // Départ.
+        let f = t.update(&pen(0, 0), &d);
+        assert_eq!(f, vec![vec![(Code::Pressure, 0), (Code::ToolPen, 0)]]);
+        assert!(!t.in_range());
+        assert!(t.leave().is_empty(), "déjà parti");
+    }
+
+    #[test]
+    fn eraser_swap_leaves_the_tip_first() {
+        let d = displays();
+        let mut t = PenTablet::default();
+        t.update(&pen(Pen::IN_RANGE | Pen::CONTACT | Pen::BARREL, 30000), &d);
+        let f = t.update(&pen(Pen::IN_RANGE | Pen::ERASER, 0), &d);
+        assert_eq!(f[0], vec![(Code::Touch, 0), (Code::Stylus, 0), (Code::Pressure, 0), (Code::ToolPen, 0)]);
+        assert_eq!(value(&f[1], Code::ToolRubber), Some(1));
+        assert_eq!(f.len(), 3);
+    }
+
+    #[test]
+    fn tilt_and_barrel() {
+        let d = displays();
+        let mut t = PenTablet::default();
+        let mut p = pen(Pen::IN_RANGE | Pen::TILT | Pen::BARREL, 0);
+        p.tilt_x = -35;
+        p.tilt_y = 60;
+        let f = t.update(&p, &d);
+        let last = f.last().unwrap();
+        assert_eq!(value(last, Code::TiltX), Some(-3500));
+        assert_eq!(value(last, Code::TiltY), Some(6000));
+        assert_eq!(value(last, Code::Stylus), Some(1));
+        // Sans TILT, l'inclinaison est à plat.
+        let f = t.update(&pen(Pen::IN_RANGE | Pen::BARREL, 0), &d);
+        assert_eq!(value(&f[0], Code::TiltX), Some(0));
+        assert_eq!(value(&f[0], Code::Stylus), None);
+    }
+
+    #[test]
+    fn unknown_display_is_ignored() {
+        let mut t = PenTablet::default();
+        let mut p = pen(Pen::IN_RANGE, 0);
+        p.display_id = 7;
+        assert!(t.update(&p, &displays()).is_empty());
+        assert!(!t.in_range());
+    }
+}
