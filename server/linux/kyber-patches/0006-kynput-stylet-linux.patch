+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+//! KyberNow (Station Linux, correctif 0006) : le stylet de l'appareil devient
+//! une tablette graphique de l'ordinateur, « KyberNow stylet », par uinput
+//! (`BTN_TOOL_PEN`, `BTN_TOOL_RUBBER`, `ABS_PRESSURE`, `ABS_TILT_X/Y`,
+//! `BTN_STYLUS`). udev la classe en tablette, libinput la donne au
+//! compositeur (Wayland : `tablet-v2` ; X11 : XInput2), et les logiciels de
+//! dessin y lisent pression, inclinaison et gomme. Traduction dans
+//! `pen_tablet.rs`. La tablette n'est créée qu'au premier paquet du stylet.
+//! Mêmes règles que les autres Stations (docs/stylet.md).
+
+use std::sync::Arc;
+
+use evdev_rs::{AbsInfo, InputEvent as EvdevEvent, TimeVal, UInputDevice, enums::*};
+use log::{debug, error, info, warn};
+
+use super::pen_tablet::{
+    AXIS_MAX, AXIS_RESOLUTION, Code, Frame, PRESSURE_MAX, PenTablet, TILT_MAX, TILT_RESOLUTION,
+};
+use crate::linux::utils::uinput_utils::{UINPUT_DEVICE_DESC_DEFAULT, UinputDeviceDesc, plug_device};
+use crate::pipeline::{InputConsumerHandle, InputHandler};
+use crate::utils::threaded_consumer::{ThreadedConsumer, ThreadedConsumerBackend};
+use crate::{Display, Error, HostConfig, InputConsumer, InputPacket, InputType, Payload, Pen, Result};
+
+const NAME: &str = "KyberNow stylet";
+
+const KEYS: &[EV_KEY] = &[EV_KEY::BTN_TOOL_PEN, EV_KEY::BTN_TOOL_RUBBER, EV_KEY::BTN_TOUCH, EV_KEY::BTN_STYLUS];
+const fn axis(minimum: i32, maximum: i32, resolution: i32) -> AbsInfo {
+    AbsInfo { value: 0, minimum, maximum, fuzz: 0, flat: 0, resolution }
+}
+const ABS: &[(EV_ABS, AbsInfo)] = &[
+    (EV_ABS::ABS_X, axis(0, AXIS_MAX, AXIS_RESOLUTION)),
+    (EV_ABS::ABS_Y, axis(0, AXIS_MAX, AXIS_RESOLUTION)),
+    (EV_ABS::ABS_PRESSURE, axis(0, PRESSURE_MAX, 0)),
+    (EV_ABS::ABS_TILT_X, axis(-TILT_MAX, TILT_MAX, TILT_RESOLUTION)),
+    (EV_ABS::ABS_TILT_Y, axis(-TILT_MAX, TILT_MAX, TILT_RESOLUTION)),
+];
+const DESC: UinputDeviceDesc = UinputDeviceDesc { keys: Some(KEYS), abs: Some(ABS), ..UINPUT_DEVICE_DESC_DEFAULT };
+
+fn event_code(code: Code) -> EventCode {
+    match code {
+        Code::ToolPen => EventCode::EV_KEY(EV_KEY::BTN_TOOL_PEN),
+        Code::ToolRubber => EventCode::EV_KEY(EV_KEY::BTN_TOOL_RUBBER),
+        Code::Touch => EventCode::EV_KEY(EV_KEY::BTN_TOUCH),
+        Code::Stylus => EventCode::EV_KEY(EV_KEY::BTN_STYLUS),
+        Code::X => EventCode::EV_ABS(EV_ABS::ABS_X),
+        Code::Y => EventCode::EV_ABS(EV_ABS::ABS_Y),
+        Code::Pressure => EventCode::EV_ABS(EV_ABS::ABS_PRESSURE),
+        Code::TiltX => EventCode::EV_ABS(EV_ABS::ABS_TILT_X),
+        Code::TiltY => EventCode::EV_ABS(EV_ABS::ABS_TILT_Y),
+    }
+}
+
+struct Backend {
+    /// `None` avant le premier paquet ; `Some(None)` : uinput a refusé.
+    device: Option<Option<UInputDevice>>,
+    tablet: PenTablet,
+    displays: Vec<Display>,
+}
+
+impl Backend {
+    fn device(&mut self) -> Option<&UInputDevice> {
+        self.device
+            .get_or_insert_with(|| match plug_device(NAME, &DESC) {
+                Ok(device) => {
+                    info!("'{NAME}' plugged");
+                    Some(device)
+                }
+                Err(err) => {
+                    warn!("'{NAME}' not plugged: {err:?}");
+                    None
+                }
+            })
+            .as_ref()
+    }
+
+    fn write(&mut self, frames: Vec<Frame>) -> Result<()> {
+        let Some(device) = self.device() else { return Ok(()) };
+        let ts = TimeVal::new(0, 0);
+        for frame in frames {
+            for (code, value) in frame {
+                device.write_event(&EvdevEvent::new(&ts, &event_code(code), value))?;
+            }
+            device.write_event(&EvdevEvent::new(&ts, &EventCode::EV_SYN(EV_SYN::SYN_REPORT), 0))?;
+        }
+        Ok(())
+    }
+
+    fn inject(&mut self, pen: &Pen) -> Result<()> {
+        let was_in = self.tablet.in_range();
+        let frames = self.tablet.update(pen, &self.displays);
+        if frames.is_empty() && pen.has(Pen::IN_RANGE) {
+            warn!("Got a Pen on unknown Display ID {}", pen.display_id);
+        }
+        match (was_in, self.tablet.in_range()) {
+            (false, true) => info!("Pen near ({})", if pen.has(Pen::ERASER) { "eraser" } else { "tip" }),
+            (true, false) => info!("Pen left"),
+            _ => debug!("Pen {pen:?}"),
+        }
+        self.write(frames)
+    }
+}
+
+impl ThreadedConsumerBackend for Backend {
+    fn on_packet(&mut self, pkt: InputPacket) -> Result<()> {
+        match pkt.payload {
+            Payload::Pen(ref pen) => self.inject(pen),
+            _ => {
+                error!("Unexpected packet type {:?}", pkt.get_type());
+                Err(Error::InvalidType)
+            }
+        }
+    }
+
+    fn on_config(&mut self, host_config: Arc<HostConfig>) -> Result<()> {
+        self.displays = host_config.display_list.clone();
+        Ok(())
+    }
+}
+
+impl Drop for Backend {
+    fn drop(&mut self) {
+        let frames = self.tablet.leave();
+        if !frames.is_empty() {
+            let _ = self.write(frames);
+        }
+    }
+}
+
+pub struct HostPenHandler {
+    handler: ThreadedConsumer,
+}
+
+impl HostPenHandler {
+    pub fn new(host_config: Arc<HostConfig>) -> Result<Self> {
+        let builder = Box::new(move || {
+            Ok(Box::new(Backend { device: None, tablet: PenTablet::default(), displays: host_config.display_list.clone() })
+                as Box<dyn ThreadedConsumerBackend>)
+        });
+        Ok(Self { handler: ThreadedConsumer::new("HostPenHandler", builder) })
+    }
+}
+
+impl InputConsumer for HostPenHandler {
+    fn consume(&self, pkt: InputPacket) -> Result<()> {
+        self.handler.consume(pkt)
+    }
+}
+
+impl InputHandler for HostPenHandler {
+    fn start(self: Arc<Self>) -> Result<()> {
+        Ok(())
+    }
+
+    fn stop(self: Arc<Self>) -> Result<()> {
+        self.handler.stop()
+    }
+
+    fn update_host_config(self: Arc<Self>, host_config: Arc<HostConfig>) -> Result<()> {
+        self.handler.update_host_config(host_config)
+    }
+
+    fn to_consumer(self: Arc<Self>) -> Option<InputConsumerHandle> {
+        Some(InputConsumerHandle { consumer: self, handled_types: vec![InputType::Pen] })
+    }
+}
