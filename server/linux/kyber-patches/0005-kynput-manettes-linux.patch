+//! KyberNow (Station Linux, correctif 0005) : une manette PlayStation de
+//! l'appareil devient une DualSense de l'ordinateur, par `/dev/uhid`.
+//!
+//! uhid crée un vrai appareil HID ; le pilote `hid-playstation` de Linux le
+//! prend comme une DualSense branchée en USB (054C:0CE6) : manette, capteurs
+//! et pavé tactile pour evdev, `hidraw` pour SDL et Steam. Les jeux y voient
+//! une DualSense (icônes, gâchettes), et ses vibrations nous reviennent dans
+//! ses rapports de sortie (0x02), que nous renvoyons à l'appareil.
+//!
+//! - Rapports : ceux d'une DualSense en USB (descripteur relevé sur une
+//!   CFI-ZCT1W), comme la Station Mac (correctif Mac 0011).
+//! - `hid-playstation` lit trois rapports de fonction à l'ouverture
+//!   (calibrage 0x05, appairage 0x09, micrologiciel 0x20) : nous y répondons
+//!   (`UHID_GET_REPORT`). Il refuse deux manettes de même adresse MAC (rapport
+//!   0x09) : chacune a la sienne, tirée de son numéro.
+//! - La lumière et les gâchettes adaptatives ne reviennent pas à l'appareil :
+//!   le protocole de Kyber ne porte que la vibration.
+//!
+//! Ce fichier n'utilise que `std` : ses tests passent aussi hors de Linux.
+
+use std::fs::{File, OpenOptions};
+use std::io::{ErrorKind, Read, Write};
+use std::os::unix::fs::OpenOptionsExt;
+use std::time::Instant;
+
+use crate::{GamepadAxis, GamepadButton};
+
+pub(crate) const UHID_PATH: &str = "/dev/uhid";
+
+// linux/uhid.h
+const UHID_DESTROY: u32 = 1;
+const UHID_START: u32 = 2;
+const UHID_STOP: u32 = 3;
+const UHID_OPEN: u32 = 4;
+const UHID_CLOSE: u32 = 5;
+const UHID_OUTPUT: u32 = 6;
+const UHID_GET_REPORT: u32 = 9;
+const UHID_GET_REPORT_REPLY: u32 = 10;
+const UHID_CREATE2: u32 = 11;
+const UHID_INPUT2: u32 = 12;
+const UHID_SET_REPORT: u32 = 13;
+const UHID_SET_REPORT_REPLY: u32 = 14;
+const UHID_DATA_MAX: usize = 4096;
+/// `struct uhid_event` (packée) : type, puis la plus grande des variantes,
+/// `uhid_create2_req` (128 + 64 + 64 + 2 + 2 + 4 × 4 + 4096).
+pub(crate) const UHID_EVENT_SIZE: usize = 4 + 128 + 64 + 64 + 2 + 2 + 16 + UHID_DATA_MAX;
+const BUS_USB: u16 = 0x03;
+const EIO: u16 = 5;
+
+/// État d'une manette, tel que l'appareil l'envoie (conventions de SDL :
+/// axes de -32768 à 32767, Y vers le bas, gâchettes de 0 à 32767).
+#[derive(Default)]
+pub(crate) struct PadState {
+    buttons: u16,
+    axes: [i16; 6],
+    seq: u8,
+}
+
+impl PadState {
+    pub(crate) fn pressed(&self, b: GamepadButton) -> bool {
+        self.buttons & (1 << b as u16) != 0
+    }
+
+    pub(crate) fn set(&mut self, b: GamepadButton, pressed: bool) {
+        if pressed {
+            self.buttons |= 1 << b as u16;
+        } else {
+            self.buttons &= !(1 << b as u16);
+        }
+    }
+
+    pub(crate) fn set_axis(&mut self, a: GamepadAxis, value: i16) {
+        self.axes[a as usize] = value;
+    }
+
+    fn axis(&self, a: GamepadAxis) -> i16 {
+        self.axes[a as usize]
+    }
+
+    /// Croix directionnelle : 0 = haut, puis sens horaire (7 = haut-gauche),
+    /// `None` au repos ; haut et bas (ou gauche et droite) ensemble s'annulent.
+    fn hat(&self) -> Option<u8> {
+        let dy = self.pressed(GamepadButton::DPadDown) as i8 - self.pressed(GamepadButton::DPadUp) as i8;
+        let dx = self.pressed(GamepadButton::DPadRight) as i8 - self.pressed(GamepadButton::DPadLeft) as i8;
+        match (dx, dy) {
+            (0, -1) => Some(0),
+            (1, -1) => Some(1),
+            (1, 0) => Some(2),
+            (1, 1) => Some(3),
+            (0, 1) => Some(4),
+            (-1, 1) => Some(5),
+            (-1, 0) => Some(6),
+            (-1, -1) => Some(7),
+            _ => None,
+        }
+    }
+
+    fn stick8(v: i16) -> u8 {
+        ((v as i32 + 32768) >> 8) as u8
+    }
+
+    fn trigger8(v: i16) -> u8 {
+        (v.max(0) as u32 * 255 / i16::MAX as u32) as u8
+    }
+
+    /// Rapport 0x01 d'une DualSense en USB (64 octets). `timestamp` : horloge
+    /// des capteurs, en tiers de microseconde.
+    pub(crate) fn dualsense_report(&mut self, timestamp: u32) -> [u8; 64] {
+        use GamepadButton as B;
+        let mut r = [0u8; 64];
+        r[0] = 0x01;
+        r[1] = Self::stick8(self.axis(GamepadAxis::LeftX));
+        r[2] = Self::stick8(self.axis(GamepadAxis::LeftY));
+        r[3] = Self::stick8(self.axis(GamepadAxis::RightX));
+        r[4] = Self::stick8(self.axis(GamepadAxis::RightY));
+        let l2 = Self::trigger8(self.axis(GamepadAxis::TriggerLeft));
+        let r2 = Self::trigger8(self.axis(GamepadAxis::TriggerRight));
+        r[5] = l2;
+        r[6] = r2;
+        self.seq = self.seq.wrapping_add(1);
+        r[7] = self.seq;
+        let bit = |b: GamepadButton, v: u8| if self.pressed(b) { v } else { 0 };
+        // Boutons de l'appareil nommés comme ceux d'une manette Xbox : A en
+        // bas (croix), B à droite (rond), X à gauche (carré), Y en haut (triangle).
+        r[8] = self.hat().unwrap_or(8) | bit(B::X, 0x10) | bit(B::A, 0x20) | bit(B::B, 0x40) | bit(B::Y, 0x80);
+        r[9] = bit(B::LeftShoulder, 0x01)
+            | bit(B::RightShoulder, 0x02)
+            | if l2 > 0 { 0x04 } else { 0 }
+            | if r2 > 0 { 0x08 } else { 0 }
+            | bit(B::Back, 0x10)
+            | bit(B::Start, 0x20)
+            | bit(B::LeftStick, 0x40)
+            | bit(B::RightStick, 0x80);
+        r[10] = bit(B::Guide, 0x01);
+        r[28..32].copy_from_slice(&timestamp.to_le_bytes());
+        // Pavé tactile : deux points inactifs (bit haut levé).
+        r[33] = 0x80;
+        r[37] = 0x80;
+        // Batterie pleine, hors charge.
+        r[53] = 0x2a;
+        r[54] = 0x0c;
+        r
+    }
+}
+
+/// Vibration lue dans un rapport de sortie 0x02 d'une DualSense en USB
+/// (numéro du rapport en tête, tel que uhid le donne) : (gros moteur, petit
+/// moteur), de 0 à 65535 ; `None` si le rapport ne parle pas de vibration
+/// (lumière, voyants, gâchettes seulement).
+pub(crate) fn rumble_from_output(data: &[u8]) -> Option<(u16, u16)> {
+    if data.len() < 5 || data[0] != 0x02 {
+        return None;
+    }
+    // valid_flag0 : vibration « compatible » (0x01) ou choix des moteurs (0x02).
+    if data[1] & 0x03 == 0 {
+        return None;
+    }
+    let scale = |v: u8| (v as u32 * 65535 / 255) as u16;
+    // motor_right (petit, aigu), puis motor_left (gros, grave).
+    Some((scale(data[4]), scale(data[3])))
+}
+
+/// Rapport de fonction demandé par `hid-playstation` (ou SDL) ; `None` :
+/// inconnu, on répond par une erreur.
+pub(crate) fn feature_report(rnum: u8, pad: u32) -> Option<Vec<u8>> {
+    match rnum {
+        0x05 => Some(DUALSENSE_CALIBRATION.to_vec()),
+        0x09 => {
+            let mut r = DUALSENSE_PAIRING.to_vec();
+            // Adresse MAC (octets 1 à 6, poids faible d'abord) : une par manette,
+            // sans quoi le pilote refuse la deuxième (« Duplicate device »).
+            // 02 en tête : adresse administrée localement.
+            let id = pad.to_le_bytes();
+            r[1..7].copy_from_slice(&[id[0], id[1], id[2], id[3], 0x4b, 0x02]);
+            Some(r)
+        }
+        0x20 => Some(DUALSENSE_FIRMWARE.to_vec()),
+        _ => None,
+    }
+}
+
+fn event(kind: u32) -> Vec<u8> {
+    let mut e = vec![0u8; UHID_EVENT_SIZE];
+    e[0..4].copy_from_slice(&kind.to_ne_bytes());
+    e
+}
+
+/// `UHID_CREATE2` d'une DualSense en USB.
+pub(crate) fn create_event(pad: u32) -> Vec<u8> {
+    let mut e = event(UHID_CREATE2);
+    let name = b"Sony Interactive Entertainment DualSense Wireless Controller";
+    e[4..4 + name.len()].copy_from_slice(name);
+    let phys = format!("kybernow/gamepad{pad}");
+    e[132..132 + phys.len()].copy_from_slice(phys.as_bytes());
+    let uniq = format!("KyberNow-{pad}");
+    e[196..196 + uniq.len()].copy_from_slice(uniq.as_bytes());
+    let o = 260;
+    e[o..o + 2].copy_from_slice(&(DUALSENSE_DESCRIPTOR.len() as u16).to_ne_bytes());
+    e[o + 2..o + 4].copy_from_slice(&BUS_USB.to_ne_bytes());
+    e[o + 4..o + 8].copy_from_slice(&0x054cu32.to_ne_bytes());
+    e[o + 8..o + 12].copy_from_slice(&0x0ce6u32.to_ne_bytes());
+    e[o + 12..o + 16].copy_from_slice(&0x0100u32.to_ne_bytes());
+    // country : 0
+    e[o + 20..o + 20 + DUALSENSE_DESCRIPTOR.len()].copy_from_slice(&DUALSENSE_DESCRIPTOR);
+    e
+}
+
+/// `UHID_INPUT2` : un rapport d'entrée.
+pub(crate) fn input_event(report: &[u8]) -> Vec<u8> {
+    let mut e = event(UHID_INPUT2);
+    e[4..6].copy_from_slice(&(report.len() as u16).to_ne_bytes());
+    e[6..6 + report.len()].copy_from_slice(report);
+    e
+}
+
+fn get_report_reply(id: u32, data: Option<&[u8]>) -> Vec<u8> {
+    let mut e = event(UHID_GET_REPORT_REPLY);
+    e[4..8].copy_from_slice(&id.to_ne_bytes());
+    match data {
+        Some(d) => {
+            e[10..12].copy_from_slice(&(d.len() as u16).to_ne_bytes());
+            e[12..12 + d.len()].copy_from_slice(d);
+        }
+        None => e[8..10].copy_from_slice(&EIO.to_ne_bytes()),
+    }
+    e
+}
+
+fn set_report_reply(id: u32) -> Vec<u8> {
+    let mut e = event(UHID_SET_REPORT_REPLY);
+    e[4..8].copy_from_slice(&id.to_ne_bytes());
+    e
+}
+
+/// Ce que le noyau nous dit d'une manette.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Incoming {
+    Started,
+    Stopped,
+    Opened,
+    Closed,
+    Output(Vec<u8>),
+    GetReport { id: u32, rnum: u8 },
+    SetReport { id: u32 },
+    Other(u32),
+}
+
+pub(crate) fn parse(e: &[u8]) -> Option<Incoming> {
+    if e.len() < 12 {
+        return None;
+    }
+    let u32_at = |o: usize| u32::from_ne_bytes([e[o], e[o + 1], e[o + 2], e[o + 3]]);
+    let u16_at = |o: usize| u16::from_ne_bytes([e[o], e[o + 1]]) as usize;
+    Some(match u32_at(0) {
+        UHID_START => Incoming::Started,
+        UHID_STOP => Incoming::Stopped,
+        UHID_OPEN => Incoming::Opened,
+        UHID_CLOSE => Incoming::Closed,
+        UHID_OUTPUT if e.len() >= 4 + UHID_DATA_MAX + 2 => {
+            let size = u16_at(4 + UHID_DATA_MAX).min(UHID_DATA_MAX);
+            Incoming::Output(e[4..4 + size].to_vec())
+        }
+        UHID_GET_REPORT => Incoming::GetReport { id: u32_at(4), rnum: e[8] },
+        UHID_SET_REPORT => Incoming::SetReport { id: u32_at(4) },
+        other => Incoming::Other(other),
+    })
+}
+
+/// Une DualSense de l'ordinateur, tenue par `/dev/uhid` : fermer le fichier
+/// la débranche.
+pub(crate) struct DualSense {
+    pad: u32,
+    file: File,
+    state: PadState,
+    started: bool,
+    born: Instant,
+    /// Dernière vibration renvoyée (une vibration nulle ne part qu'après une vraie).
+    rumble: (u16, u16),
+}
+
+impl DualSense {
+    pub(crate) fn plug(pad: u32) -> std::io::Result<Self> {
+        let mut file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .custom_flags(libc::O_NONBLOCK)
+            .open(UHID_PATH)?;
+        file.write_all(&create_event(pad))?;
+        Ok(Self { pad, file, state: PadState::default(), started: false, born: Instant::now(), rumble: (0, 0) })
+    }
+
+    pub(crate) fn file(&self) -> &File {
+        &self.file
+    }
+
+    pub(crate) fn set_button(&mut self, b: GamepadButton, pressed: bool) -> std::io::Result<()> {
+        self.state.set(b, pressed);
+        self.send_report()
+    }
+
+    pub(crate) fn set_axis(&mut self, a: GamepadAxis, value: i16) -> std::io::Result<()> {
+        self.state.set_axis(a, value);
+        self.send_report()
+    }
+
+    fn send_report(&mut self) -> std::io::Result<()> {
+        // Avant UHID_START, le noyau refuse les rapports : l'état part au démarrage.
+        if !self.started {
+            return Ok(());
+        }
+        let ts = (self.born.elapsed().as_micros() as u64 * 3) as u32;
+        let report = self.state.dualsense_report(ts);
+        self.file.write_all(&input_event(&report))
+    }
+
+    /// Lit tout ce que le noyau a pour nous ; rend la nouvelle vibration s'il
+    /// y en a une à renvoyer à l'appareil.
+    pub(crate) fn process(&mut self) -> std::io::Result<Option<(u16, u16)>> {
+        let mut rumble = None;
+        let mut buf = vec![0u8; UHID_EVENT_SIZE];
+        loop {
+            let n = match self.file.read(&mut buf) {
+                Ok(n) => n,
+                Err(e) if e.kind() == ErrorKind::WouldBlock => break,
+                Err(e) if e.kind() == ErrorKind::Interrupted => continue,
+                Err(e) => return Err(e),
+            };
+            match parse(&buf[..n]) {
+                Some(Incoming::Started) => {
+                    log::info!("DualSense {} started by the kernel", self.pad);
+                    self.started = true;
+                    self.send_report()?;
+                }
+                Some(Incoming::Stopped) => self.started = false,
+                Some(Incoming::GetReport { id, rnum }) => {
+                    let report = feature_report(rnum, self.pad);
+                    if report.is_none() {
+                        log::debug!("DualSense {}: unknown feature report {rnum:#04x}", self.pad);
+                    }
+                    self.file.write_all(&get_report_reply(id, report.as_deref()))?;
+                }
+                Some(Incoming::SetReport { id }) => self.file.write_all(&set_report_reply(id))?,
+                Some(Incoming::Output(data)) => {
+                    if let Some(r) = rumble_from_output(&data)
+                        && r != self.rumble
+                    {
+                        self.rumble = r;
+                        rumble = Some(r);
+                    }
+                }
+                Some(Incoming::Opened | Incoming::Closed | Incoming::Other(_)) | None => {}
+            }
+        }
+        Ok(rumble)
+    }
+}
+
+impl Drop for DualSense {
+    fn drop(&mut self) {
+        let _ = self.file.write_all(&event(UHID_DESTROY));
+    }
+}
+
