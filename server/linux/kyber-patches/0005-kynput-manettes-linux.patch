+
+// Rapports de fonction lus à l'ouverture : calibrage des capteurs (0x05,
+// 41 octets), appairage (0x09, 20 octets), micrologiciel (0x20, 64 octets).
+// Valeurs d'inputtino (github.com/games-on-whales/inputtino, MIT), qui les
+// sert au même pilote Linux.
+const DUALSENSE_CALIBRATION: [u8; 41] = [
+    0x05, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x27, 0xf0, 0xd8, 0x10, 0x27, 0xf0, 0xd8, 0x10,
