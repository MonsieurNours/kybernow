+    0x27, 0xf0, 0xd8, 0x0b, 0x00, 0x00, 0x00, 0x00, 0x00,
+];
+const DUALSENSE_PAIRING: [u8; 20] = [
+    0x09, 0x74, 0xe7, 0xd6, 0x3a, 0x53, 0x35, 0x08, 0x25, 0x00, 0x1e, 0x00, 0xee, 0x74, 0xd0, 0xbc,
+    0x00, 0x00, 0x00, 0x00,
+];
+const DUALSENSE_FIRMWARE: [u8; 64] = [
+    0x20, 0x4a, 0x75, 0x6e, 0x20, 0x31, 0x39, 0x20, 0x32, 0x30, 0x32, 0x33, 0x31, 0x34, 0x3a, 0x34,
+    0x37, 0x3a, 0x33, 0x34, 0x03, 0x00, 0x44, 0x00, 0x08, 0x02, 0x00, 0x01, 0x36, 0x00, 0x00, 0x01,
+    0xc1, 0xc8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x54, 0x01, 0x00, 0x00,
+    0x14, 0x00, 0x00, 0x00, 0x0b, 0x00, 0x01, 0x00, 0x06, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+];
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pad(buttons: &[GamepadButton]) -> PadState {
+        let mut s = PadState::default();
+        for b in buttons {
+            s.set(*b, true);
+        }
+        s
+    }
+
+    #[test]
+    fn event_size_matches_the_kernel() {
+        // sizeof(struct uhid_event) sous Linux (x86_64 et arm64).
+        assert_eq!(UHID_EVENT_SIZE, 4380 - 4);
+    }
+
+    #[test]
+    fn create_event_layout() {
+        let e = create_event(7);
+        assert_eq!(e.len(), UHID_EVENT_SIZE);
+        assert_eq!(&e[0..4], &11u32.to_ne_bytes());
+        assert!(e[4..132].starts_with(b"Sony Interactive Entertainment DualSense"));
+        assert!(e[196..260].starts_with(b"KyberNow-7\0"));
+        assert_eq!(&e[260..262], &273u16.to_ne_bytes(), "rd_size");
+        assert_eq!(&e[262..264], &3u16.to_ne_bytes(), "bus USB");
+        assert_eq!(&e[264..268], &0x054cu32.to_ne_bytes());
+        assert_eq!(&e[268..272], &0x0ce6u32.to_ne_bytes());
+        assert_eq!(&e[280..283], &[0x05, 0x01, 0x09], "descripteur");
+        assert_eq!(e[280 + 272], 0xc0);
+    }
+
+    #[test]
+    fn input_event_layout() {
+        let mut s = PadState::default();
+        let e = input_event(&s.dualsense_report(0));
+        assert_eq!(&e[0..4], &12u32.to_ne_bytes());
+        assert_eq!(&e[4..6], &64u16.to_ne_bytes());
+        assert_eq!(e[6], 0x01, "numéro du rapport");
+    }
+
+    #[test]
+    fn parse_kernel_events() {
+        let mut e = event(UHID_GET_REPORT);
+        e[4..8].copy_from_slice(&42u32.to_ne_bytes());
+        e[8] = 0x09;
+        assert_eq!(parse(&e), Some(Incoming::GetReport { id: 42, rnum: 0x09 }));
+
+        let mut e = event(UHID_OUTPUT);
+        e[4..9].copy_from_slice(&[0x02, 0x03, 0x00, 0x40, 0xff]);
+        e[4 + UHID_DATA_MAX..4 + UHID_DATA_MAX + 2].copy_from_slice(&63u16.to_ne_bytes());
+        let Some(Incoming::Output(data)) = parse(&e) else { panic!("rapport de sortie") };
+        assert_eq!(data.len(), 63);
+        assert_eq!(rumble_from_output(&data), Some((65535, 0x40 * 257)));
+
+        assert_eq!(parse(&event(UHID_START)), Some(Incoming::Started));
+        assert_eq!(parse(&[0; 3]), None);
+    }
+
+    #[test]
+    fn get_report_reply_layout() {
+        let r = feature_report(0x05, 0).unwrap();
+        let e = get_report_reply(9, Some(&r));
+        assert_eq!(&e[0..4], &10u32.to_ne_bytes());
+        assert_eq!(&e[4..8], &9u32.to_ne_bytes());
+        assert_eq!(&e[8..10], &0u16.to_ne_bytes(), "pas d'erreur");
+        assert_eq!(&e[10..12], &41u16.to_ne_bytes());
+        assert_eq!(e[12], 0x05);
+        let e = get_report_reply(9, None);
+        assert_eq!(&e[8..10], &EIO.to_ne_bytes());
+    }
+
+    #[test]
+    fn each_pad_has_its_own_mac() {
+        let a = feature_report(0x09, 1).unwrap();
+        let b = feature_report(0x09, 2).unwrap();
+        assert_eq!((a.len(), a[0]), (20, 0x09));
+        assert_ne!(&a[1..7], &b[1..7]);
+        assert_eq!(feature_report(0x20, 0).unwrap().len(), 64);
+        assert_eq!(feature_report(0x42, 0), None);
+    }
+
+    #[test]
+    fn dualsense_at_rest() {
+        let r = PadState::default().dualsense_report(0);
+        assert_eq!(&r[..7], &[0x01, 0x80, 0x80, 0x80, 0x80, 0, 0]);
+        assert_eq!(r[8], 0x08, "croix au repos");
+        assert_eq!((r[9], r[10]), (0, 0));
+        assert_eq!((r[33], r[37]), (0x80, 0x80), "pavé tactile non touché");
+    }
+
+    #[test]
+    fn dualsense_buttons_and_axes() {
+        use GamepadButton as B;
+        let mut s = pad(&[B::A, B::Y, B::DPadUp, B::DPadRight, B::Start, B::Guide, B::RightStick]);
+        s.set_axis(GamepadAxis::LeftX, i16::MIN);
+        s.set_axis(GamepadAxis::LeftY, i16::MAX);
+        s.set_axis(GamepadAxis::TriggerRight, i16::MAX);
+        let r = s.dualsense_report(0);
+        assert_eq!((r[1], r[2]), (0x00, 0xff));
+        assert_eq!(r[6], 0xff);
+        assert_eq!(r[8], 0x01 | 0x20 | 0x80, "haut-droite, croix, triangle");
+        assert_eq!(r[9], 0x08 | 0x20 | 0x80, "R2, Options, R3");
+        assert_eq!(r[10], 0x01, "PS");
+        assert_eq!(s.dualsense_report(0)[7], r[7].wrapping_add(1), "numéro de rapport");
+    }
+
+    #[test]
+    fn opposite_directions_cancel() {
+        use GamepadButton as B;
+        assert_eq!(pad(&[B::DPadUp, B::DPadDown]).hat(), None);
+        assert_eq!(pad(&[B::DPadDown, B::DPadLeft]).hat(), Some(5));
+    }
+
+    #[test]
+    fn rumble_reports() {
+        let mut ds = vec![0u8; 63];
+        ds[0] = 0x02;
+        ds[1] = 0x02; // choix des moteurs (pilote Linux)
+        ds[3] = 0x40; // petit moteur
+        ds[4] = 0xff; // gros moteur
+        assert_eq!(rumble_from_output(&ds), Some((65535, 0x40 * 257)));
+        ds[1] = 0x00;
+        ds[2] = 0x04; // lumière seulement
+        assert_eq!(rumble_from_output(&ds), None);
+        assert_eq!(rumble_from_output(&[0x05, 0x03, 0, 0, 0]), None, "autre rapport");
+    }
+
+    #[test]
+    fn descriptor_size() {
+        assert_eq!(DUALSENSE_DESCRIPTOR.len(), 273);
+    }
+}
