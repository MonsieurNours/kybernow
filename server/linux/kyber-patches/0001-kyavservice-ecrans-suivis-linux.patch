+/// KyberNow : contenu du fichier `sources_file`.
+#[cfg(target_os = "linux")]
+#[derive(Debug, Default, Deserialize)]
+struct SourcesFile {
+    #[serde(default)]
+    video_sources: Vec<GstreamerVideoSource>,
+}
+
+/// KyberNow : sources du fichier `path`, celles qui ne valent rien écartées
+/// (avec un avertissement). Fichier absent ou illisible : aucune source.
+#[cfg(target_os = "linux")]
+pub(crate) fn read_sources_file(path: &std::path::Path) -> Vec<GstreamerVideoSource> {
+    let text = match fs::read_to_string(path) {
+        Ok(text) => text,
+        Err(err) => {
+            if err.kind() != std::io::ErrorKind::NotFound {
+                warn!("GStreamer sources file {}: {err}", path.display());
+            }
+            return Vec::new();
+        }
+    };
+    let file: SourcesFile = match toml::from_str(&text) {
+        Ok(file) => file,
+        Err(err) => {
+            warn!("GStreamer sources file {}: {err}", path.display());
+            return Vec::new();
+        }
+    };
+    let mut names = HashSet::new();
+    file.video_sources
+        .into_iter()
+        .filter(|source| match Config::validate_gstreamer_source(source) {
+            Ok(()) if names.insert(source.name.clone()) => true,
+            Ok(()) => {
+                warn!("GStreamer sources file: duplicate source '{}'", source.name);
+                false
+            }
+            Err(err) => {
+                warn!("GStreamer sources file: {err}");
+                false
+            }
+        })
+        .collect()
 }
 
