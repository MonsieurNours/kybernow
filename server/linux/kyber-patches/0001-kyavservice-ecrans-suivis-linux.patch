+
+/// KyberNow (Station Linux) : surveille le fichier des sources GStreamer tenu
+/// par KyberNow Admin et annonce la nouvelle liste des écrans quand elle
+/// change (écran virtuel créé, retiré ou redimensionné).
+#[cfg(target_os = "linux")]
+pub(crate) fn spawn_sources_file(
+    path: std::path::PathBuf,
+    sender: EventSender<IpcApi>,
+) -> WatcherHandle {
+    const FILE_POLL: Duration = Duration::from_millis(250);
+    let shutdown = Arc::new(AtomicBool::new(false));
+    let shutdown_thread = Arc::clone(&shutdown);
+    let list = |path: &std::path::Path| {
+        crate::config::read_sources_file(path)
+            .iter()
+            .enumerate()
+            .map(|(idx, source)| displays::gstreamer_display(source, idx))
+            .collect::<Vec<_>>()
+    };
+    let join = thread::spawn(move || {
+        // `Display` ne se compare pas : on compare ce qui compte.
+        let key = |d: &[kyavservice_types::Display]| {
+            d.iter().map(|d| (d.id, d.name.clone(), d.width, d.height, d.x, d.y)).collect::<Vec<_>>()
+        };
+        let mut last = key(&list(&path));
+        info!("Watching GStreamer sources file {}", path.display());
+        loop {
+            thread::sleep(FILE_POLL);
+            if shutdown_thread.load(Ordering::SeqCst) {
+                return;
+            }
+            let displays = list(&path);
+            if key(&displays) != last {
+                info!("GStreamer sources changed; {} display(s) now listed", displays.len());
+                last = key(&displays);
+                sender.send(Event::DisplayListUpdated { displays });
+            }
+        }
+    });
+    WatcherHandle { join, shutdown }
+}
