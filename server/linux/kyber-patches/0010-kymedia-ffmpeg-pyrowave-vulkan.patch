++/* Bytes for one frame: bitrate / 8 / fps, a multiple of 4. */
++static size_t pw_frame_budget(AVCodecContext *avctx)
++{
++    PyroWaveVulkanContext *s = avctx->priv_data;
++    AVRational fps = avctx->framerate;
++    int64_t size;
++
++    if (s->fps > 0)
++        fps = (AVRational){ s->fps, 1 };
++    else if (fps.num <= 0 || fps.den <= 0)
++        fps = (AVRational){ 60, 1 };
++    size = av_rescale_rnd(avctx->bit_rate > 0 ? avctx->bit_rate : 200000000, fps.den,
++                          (int64_t)fps.num * 8, AV_ROUND_DOWN);
++    size &= ~(int64_t)3;
++    return FFMAX(size, 4096);
++}
++
++static int pw_encode_dmabuf(AVCodecContext *avctx, const AVFrame *frame, const pyrowave_rate_control *rate)
++{
++    PyroWaveVulkanContext *s = avctx->priv_data;
++    const AVDRMFrameDescriptor *desc = (const AVDRMFrameDescriptor *)frame->data[0];
++    pyrowave_image image;
++    pyrowave_sync_object sync;
++    pyrowave_result r;
++    int ret;
++
++    if (!desc) {
++        av_log(avctx, AV_LOG_ERROR, "Frame without a DRM descriptor\n");
++        return AVERROR(EINVAL);
++    }
++    if ((ret = pw_import(avctx, desc, frame->width, frame->height, &image)) < 0)
++        return ret;
++    sync = pw_wait_for_writer(avctx, desc->objects[0].fd);
++
++    /* Taken from and given back to the compositor's side (foreign queue). */
++    pyrowave_gpu_external_reference ref = { image, VK_QUEUE_FAMILY_FOREIGN_EXT };
++    pyrowave_gpu_sync_operation acquire = {
++        &ref, 1, { sync ? pyrowave_sync_object_get_semaphore(sync) : VK_NULL_HANDLE, 0 } };
++    /* No semaphore at release: packetize() waits for the encode before the
++     * frame (and its buffer) go back to PipeWire. */
++    pyrowave_gpu_sync_operation release = { &ref, 1, { VK_NULL_HANDLE, 0 } };
++
++    pyrowave_scaled_encode_info info = { 0 };
++    r = pyrowave_image_get_image_view(image, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_USAGE_SAMPLED_BIT, &info.view);
++    if (r == PYROWAVE_SUCCESS) {
++        int ten_bits = info.view.view_format == VK_FORMAT_A2R10G10B10_UNORM_PACK32 ||
++                       info.view.view_format == VK_FORMAT_A2B10G10R10_UNORM_PACK32;
++        info.input_color_space         = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
++        info.output_color_space        = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
++        info.intermediate_plane_format = ten_bits ? VK_FORMAT_R16_UNORM : VK_FORMAT_R8_UNORM;
++        info.ycbcr_range               = VK_SAMPLER_YCBCR_RANGE_ITU_FULL;
++        info.ycbcr_chroma_midpoint     = 0.5f;
++        r = pyrowave_encoder_encode_gpu_scaled(s->encoder, &acquire, &release, &info, rate);
++    } else {
++        av_log(avctx, AV_LOG_ERROR, "No view of the DMA-BUF image: %s\n", pw_result_name(r));
++    }
++    /* Waited for by the submission: the temporary payload is consumed. */
++    if (sync)
++        pyrowave_sync_object_destroy(sync);
++    if (r != PYROWAVE_SUCCESS) {
++        av_log(avctx, AV_LOG_ERROR, "Encode failed: %s\n", pw_result_name(r));
++        return AVERROR_EXTERNAL;
++    }
++    return 0;
++}
++
++/* RGB to YCbCr BT.709 full range, 16-bit fixed point. */
++#define PW_Y(r, g, b)  ((13933 * (r) + 46871 * (g) + 4732 * (b) + 32768) >> 16)
++#define PW_CB(r, g, b) (((-7509 * (r) - 25259 * (g) + 32768 * (b) + 32768) >> 16) + 128)
++#define PW_CR(r, g, b) (((32768 * (r) - 29763 * (g) - 3005 * (b) + 32768) >> 16) + 128)
++
++/* A system memory frame (BGR0, RGB0, BGRA, RGBA) to the three planes,
++ * scaled to the encoded size by nearest sampling (a guest's own image). */
++static void pw_convert(PyroWaveVulkanContext *s, const AVFrame *frame)
++{
++    const int bgr = frame->format == AV_PIX_FMT_BGR0 || frame->format == AV_PIX_FMT_BGRA;
++    const int ri = bgr ? 2 : 0, bi = bgr ? 0 : 2;
++    const int sub = s->chroma444 ? 1 : 2;
++
++#define PIXEL(x, y) (frame->data[0] + (int64_t)((y) * frame->height / s->height) * frame->linesize[0] + \
++                     (int64_t)((x) * frame->width / s->width) * 4)
++    for (int y = 0; y < s->height; y++) {
++        uint8_t *luma = s->planes[0] + (size_t)y * s->width;
++        for (int x = 0; x < s->width; x++) {
++            const uint8_t *p = PIXEL(x, y);
++            luma[x] = av_clip_uint8(PW_Y(p[ri], p[1], p[bi]));
++        }
++    }
++    for (int y = 0; y < s->chroma_h; y++) {
++        uint8_t *cb = s->planes[1] + (size_t)y * s->chroma_w;
++        uint8_t *cr = s->planes[2] + (size_t)y * s->chroma_w;
++        for (int x = 0; x < s->chroma_w; x++) {
++            int r = 0, g = 0, b = 0;
++            for (int dy = 0; dy < sub; dy++) {
++                for (int dx = 0; dx < sub; dx++) {
++                    const uint8_t *p = PIXEL(x * sub + dx, y * sub + dy);
++                    r += p[ri];
++                    g += p[1];
++                    b += p[bi];
++                }
++            }
++            r /= sub * sub;
++            g /= sub * sub;
++            b /= sub * sub;
++            cb[x] = av_clip_uint8(PW_CB(r, g, b));
++            cr[x] = av_clip_uint8(PW_CR(r, g, b));
++        }
++    }
++#undef PIXEL
++}
++
++static int pw_encode_cpu(AVCodecContext *avctx, const AVFrame *frame, const pyrowave_rate_control *rate)
++{
++    PyroWaveVulkanContext *s = avctx->priv_data;
++    pyrowave_cpu_buffer buf = { 0 };
++    pyrowave_result r;
++
++    if (!s->planes[0]) {
++        s->chroma_w = s->chroma444 ? s->width : s->width / 2;
++        s->chroma_h = s->chroma444 ? s->height : s->height / 2;
++        s->planes[0] = av_malloc((size_t)s->width * s->height);
++        s->planes[1] = av_malloc((size_t)s->chroma_w * s->chroma_h);
++        s->planes[2] = av_malloc((size_t)s->chroma_w * s->chroma_h);
++        if (!s->planes[0] || !s->planes[1] || !s->planes[2])
++            return AVERROR(ENOMEM);
++    }
++    pw_convert(s, frame);
++
++    buf.format = s->chroma444 ? PYROWAVE_CPU_BUFFER_FORMAT_YUV444P : PYROWAVE_CPU_BUFFER_FORMAT_YUV420P;
++    buf.width  = s->width;
++    buf.height = s->height;
++    for (int i = 0; i < 3; i++) {
++        int w = i ? s->chroma_w : s->width, h = i ? s->chroma_h : s->height;
++        buf.data[i]                = s->planes[i];
++        buf.row_stride_in_bytes[i] = w;
++        buf.plane_size_in_bytes[i] = (size_t)w * h;
++    }
++    r = pyrowave_encoder_encode_cpu(s->encoder, &buf, rate);
++    if (r != PYROWAVE_SUCCESS) {
++        av_log(avctx, AV_LOG_ERROR, "Encode failed: %s\n", pw_result_name(r));
++        return AVERROR_EXTERNAL;
++    }
++    return 0;
++}
++
++static int pw_encode(AVCodecContext *avctx, AVPacket *pkt, const AVFrame *frame, int *got_packet)
++{
++    PyroWaveVulkanContext *s = avctx->priv_data;
++    pyrowave_result r;
++    size_t budget, nb_packets = 0, out_packets, total = 0;
++    int ret;
++
++    *got_packet = 0;
++    budget = pw_frame_budget(avctx);
++    pyrowave_rate_control rate = { budget };
++
++    if (frame->format == AV_PIX_FMT_DRM_PRIME)
++        ret = pw_encode_dmabuf(avctx, frame, &rate);
++    else
++        ret = pw_encode_cpu(avctx, frame, &rate);
++    if (ret < 0)
++        return ret;
++
++    r = pyrowave_encoder_compute_num_packets(s->encoder, s->packet_size, &nb_packets);
++    if (r != PYROWAVE_SUCCESS || !nb_packets) {
++        av_log(avctx, AV_LOG_ERROR, "Packetization failed: %s\n", pw_result_name(r));
++        return AVERROR_EXTERNAL;
++    }
++    if (nb_packets > s->nb_packets_alloc) {
++        ret = av_reallocp_array(&s->packets, nb_packets, sizeof(*s->packets));
++        if (ret < 0) {
++            s->nb_packets_alloc = 0;
++            return ret;
++        }
++        s->nb_packets_alloc = nb_packets;
++    }
++
++    size_t capacity = nb_packets * (size_t)s->packet_size;
++    if ((ret = ff_get_encode_buffer(avctx, pkt, capacity, 0)) < 0)
++        return ret;
++    out_packets = nb_packets;
++    r = pyrowave_encoder_packetize(s->encoder, s->packets, s->packet_size, &out_packets, pkt->data, capacity);
++    if (r != PYROWAVE_SUCCESS || out_packets > nb_packets) {
++        av_log(avctx, AV_LOG_ERROR, "Packetization failed: %s\n", pw_result_name(r));
++        return AVERROR_EXTERNAL;
++    }
++    /* One media packet per frame: the PyroWave packets end to end. */
++    for (size_t i = 0; i < out_packets; i++) {
++        if (s->packets[i].offset != total)
++            memmove(pkt->data + total, pkt->data + s->packets[i].offset, s->packets[i].size);
++        total += s->packets[i].size;
++    }
++    av_shrink_packet(pkt, total);
++
++    pkt->pts = pkt->dts = frame->pts;
++    pkt->flags |= AV_PKT_FLAG_KEY;
++    *got_packet = 1;
++
++    if (!(s->frames++ % 600))
++        av_log(avctx, AV_LOG_VERBOSE, "Frame %"PRId64": %zu bytes (budget %zu), %zu packets\n",
++               s->frames, total, budget, out_packets);
++    return 0;
++}
