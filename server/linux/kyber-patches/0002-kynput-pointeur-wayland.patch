     fn inject_move(&self, event: &MouseMove) -> Result<()> {
         let ts = TimeVal::new(0, 0);
+        super::abs_pointer::release();
 
         if event.dx != 0 {
             let ev_code = EventCode::EV_REL(EV_REL::REL_X);
@@ -120,6 +134,10 @@ impl Backend {
     fn uinput_inject_wheel(&self, ev_code: EventCode, value: i32) -> Result<()> {
         let ts = TimeVal::new(0, 0);
 
+        if super::abs_pointer::active() {
+            return super::abs_pointer::emit(&[(ev_code, value)]);
+        }
+
         let sys_event = EvdevEvent::new(&ts, &ev_code, value);
         self.device.write_event(&sys_event)?;
 
