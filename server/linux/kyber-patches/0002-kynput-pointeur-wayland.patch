         let ev_code = EventCode::EV_KEY(ev_key);
 
+        // KyberNow : un relâchement part vers les deux périphériques : l'appui
+        // a pu partir vers l'autre (glisser commencé en absolu, puis
+        // pointeur capturé), et le compositeur garderait le bouton enfoncé.
+        // Relâcher un bouton qui n'est pas enfoncé ne fait rien.
+        if !event.pressed {
+            super::abs_pointer::release_button(ev_code)?;
+        }
+        // KyberNow : le pointeur absolu (Wayland) tient le pointeur, ses clics
+        // passent par lui.
+        else if super::abs_pointer::active() {
+            return super::abs_pointer::emit(&[(ev_code, 1)]);
+        }
+
         let sys_event = EvdevEvent::new(&ts, &ev_code, event.pressed as i32);
         self.device.write_event(&sys_event)?;
 
