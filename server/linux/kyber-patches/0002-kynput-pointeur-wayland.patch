+//! KyberNow (Station Linux) : pointeur absolu par uinput, pour un bureau
+//! Wayland (GNOME, KDE) où aucun client ne peut placer le pointeur (XTest ne
+//! déplace que celui de Xwayland). Un appareil « KyberNow pointeur » à deux
+//! axes absolus et aux boutons d'une souris : udev le classe en souris
+//! absolue (comme la tablette USB d'une machine virtuelle) et le compositeur
+//! l'étend sur tout son bureau. Ses axes couvrent la boîte autour des écrans
+//! que l'ordinateur annonce (places données par KyberNow Admin).
+//!
+//! Tant que l'appareil place le pointeur, les clics et la molette passent
+//! par lui aussi : GNOME n'applique pas les clics d'une autre souris pendant
+//! qu'un pointeur absolu le tient. Un mouvement relatif (pointeur capturé,
+//! jeux) rend la main à la souris relative.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+use evdev_rs::{AbsInfo, InputEvent as EvdevEvent, TimeVal, UInputDevice, enums::*};
+use log::{info, warn};
+
+use crate::linux::utils::uinput_utils::{UINPUT_DEVICE_DESC_DEFAULT, UinputDeviceDesc, plug_device};
+use crate::{Display, Result};
+
+const NAME: &str = "KyberNow pointeur";
+/// Étendue des axes : la boîte des écrans est ramenée à 0..=AXIS_MAX.
+const AXIS_MAX: i32 = 65535;
+
+const KEYS: &[EV_KEY] = &[
+    EV_KEY::BTN_LEFT,
+    EV_KEY::BTN_RIGHT,
+    EV_KEY::BTN_MIDDLE,
+    EV_KEY::BTN_SIDE,
+    EV_KEY::BTN_EXTRA,
+];
+const RELS: &[EV_REL] = &[
+    EV_REL::REL_HWHEEL,
+    EV_REL::REL_WHEEL,
+    EV_REL::REL_WHEEL_HI_RES,
+    EV_REL::REL_HWHEEL_HI_RES,
+];
+const AXIS: AbsInfo = AbsInfo { value: 0, minimum: 0, maximum: AXIS_MAX, fuzz: 0, flat: 0, resolution: 0 };
+const ABS: &[(EV_ABS, AbsInfo)] = &[(EV_ABS::ABS_X, AXIS), (EV_ABS::ABS_Y, AXIS)];
+const DESC: UinputDeviceDesc = UinputDeviceDesc {
+    keys: Some(KEYS),
+    rels: Some(RELS),
+    abs: Some(ABS),
+    ..UINPUT_DEVICE_DESC_DEFAULT
+};
+
+static DEVICE: OnceLock<Option<Mutex<UInputDevice>>> = OnceLock::new();
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+
+/// Ce bureau ne laisse pas placer le pointeur par X11 (session Wayland, ou
+/// pas de serveur X) : le pointeur absolu passe par uinput.
+pub(crate) fn wanted() -> bool {
+    let wayland = std::env::var_os("WAYLAND_DISPLAY").is_some_and(|v| !v.is_empty())
+        || std::env::var("XDG_SESSION_TYPE").is_ok_and(|v| v == "wayland");
+    let x11 = std::env::var_os("DISPLAY").is_some_and(|v| !v.is_empty());
+    wayland || !x11
+}
+
+fn device() -> Option<&'static Mutex<UInputDevice>> {
+    DEVICE
+        .get_or_init(|| match plug_device(NAME, &DESC) {
+            Ok(device) => Some(Mutex::new(device)),
+            Err(err) => {
+                warn!("'{NAME}' not plugged: {err:?}");
+                None
+            }
+        })
+        .as_ref()
+}
+
+/// Le pointeur absolu tient le pointeur (dernier mouvement absolu).
+pub(crate) fn active() -> bool {
+    ACTIVE.load(Ordering::Relaxed)
+}
+
+/// Un mouvement relatif rend la main à la souris relative.
+pub(crate) fn release() {
+    ACTIVE.store(false, Ordering::Relaxed);
+}
+
+fn write(device: &UInputDevice, events: &[(EventCode, i32)]) -> Result<()> {
+    let ts = TimeVal::new(0, 0);
+    for (code, value) in events {
+        device.write_event(&EvdevEvent::new(&ts, code, *value))?;
+    }
+    device.write_event(&EvdevEvent::new(&ts, &EventCode::EV_SYN(EV_SYN::SYN_REPORT), 0))?;
+    Ok(())
+}
+
+/// Place le pointeur à (x, y) du bureau, dans la boîte des écrans `displays`.
+pub(crate) fn move_to(displays: &[Display], x: i32, y: i32) -> Result<()> {
+    let Some(device) = device() else { return Ok(()) };
+    let (Some(left), Some(top)) = (displays.iter().map(|d| d.x).min(), displays.iter().map(|d| d.y).min()) else {
+        return Ok(());
+    };
+    let right = displays.iter().map(|d| d.x + d.width).max().unwrap_or(left + 1);
+    let bottom = displays.iter().map(|d| d.y + d.height).max().unwrap_or(top + 1);
+    let scale = |v: i32, lo: i32, hi: i32| {
+        let span = (hi - lo - 1).max(1) as i64;
+        (((v - lo).clamp(0, span as i32) as i64 * AXIS_MAX as i64 + span / 2) / span) as i32
+    };
+    if !ACTIVE.swap(true, Ordering::Relaxed) {
+        info!("'{NAME}' takes the pointer ({left},{top})-({right},{bottom})");
+    }
+    let device = device.lock().unwrap_or_else(|e| e.into_inner());
+    write(
+        &device,
+        &[
+            (EventCode::EV_ABS(EV_ABS::ABS_X), scale(x, left, right)),
+            (EventCode::EV_ABS(EV_ABS::ABS_Y), scale(y, top, bottom)),
+        ],
+    )
+}
+
+/// Relâchement d'un bouton par le pointeur absolu s'il est branché (sans le
+/// brancher) : il a pu recevoir l'appui avant qu'un mouvement relatif rende
+/// la main à la souris relative.
+pub(crate) fn release_button(code: EventCode) -> Result<()> {
+    let Some(Some(device)) = DEVICE.get() else { return Ok(()) };
+    let device = device.lock().unwrap_or_else(|e| e.into_inner());
+    write(&device, &[(code, 0)])
+}
+
+/// Clic ou molette par le pointeur absolu (quand il tient le pointeur).
+pub(crate) fn emit(events: &[(EventCode, i32)]) -> Result<()> {
+    let Some(device) = device() else { return Ok(()) };
+    let device = device.lock().unwrap_or_else(|e| e.into_inner());
+    write(&device, events)
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn wanted_follows_the_session() {
+        // Seulement la forme : l'environnement du test décide.
+        let _ = super::wanted();
+    }
+}
