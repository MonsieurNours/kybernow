[Unit]
Description=KyberNow Link (plein écran sur KMS/DRM)
# Pas d'attente de multi-user.target (une unité qui bloque la cible bloquerait
# l'app) ni du réseau en ligne : l'app montre elle-même ce qui se prépare.
After=systemd-user-sessions.service network.target bluetooth.service sound.target kybernow-os-firstboot.service
Wants=bluetooth.service kybernow-os-firstboot.service
Conflicts=getty@tty1.service

[Service]
User=kybernow
Group=kybernow
SupplementaryGroups=video render input audio plugdev netdev
WorkingDirectory=/var/lib/kybernow
RuntimeDirectory=kybernow
Environment=XDG_RUNTIME_DIR=/run/kybernow
Environment=XDG_CONFIG_HOME=/var/lib/kybernow/config
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=alsa
Environment=KYBERNOW_OS=1
# Plymouth garde son image à l'écran jusqu'à la première image de l'app, et
# lâche l'écran (il en est le maître DRM tant qu'il tourne : sans ça, SDL dit
# « kmsdrm not available »). En root (+) : le client plymouth et pkill ne
# peuvent rien sur plymouthd depuis le compte kybernow.
ExecStartPre=+-/bin/sh -c '/usr/bin/plymouth quit --retain-splash || /usr/bin/pkill -x plymouthd || true'
ExecStart=/usr/bin/kybernow
Restart=always
RestartSec=2
TTYPath=/dev/tty1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
