    "Glissez n'importe où pour déplacer le pointeur, touchez pour cliquer, deux doigts pour le clic droit, deux doigts qui glissent pour la molette. La barre est sous la languette." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag anywhere to move the pointer, tap to click, two fingers to right-click, slide two fingers to scroll. The bar is under the tab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez n'importe où pour déplacer le pointeur, touchez pour cliquer, deux doigts pour le clic droit, deux doigts qui glissent pour la molette. La barre est sous la languette."
          }
        }
      }
    },
