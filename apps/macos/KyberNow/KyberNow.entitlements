<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Runtime renforcé : la caméra lit le QR code d'appairage de la console. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- iCloud : ordinateurs publiés pour l'Apple TV (même magasin clé-valeur
	     et même groupe du Trousseau que l'app Apple TV). Exigent un profil de
	     provisionnement. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)fr.leslignesclaires.kybernow</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)fr.leslignesclaires.kybernow</string>
	</array>
</dict>
</plist>
