    "Aucun ordinateur trouvé pour l'instant. Il est peut-être sur un autre réseau (VPN), ou sa Station n'est pas encore à jour : passez par l'onglet Par adresse." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No computer found yet. It may be on another network (VPN), or its Station is not up to date yet: use the By address tab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun ordinateur trouvé pour l'instant. Il est peut-être sur un autre réseau (VPN), ou sa Station n'est pas encore à jour : passez par l'onglet Par adresse."
          }
        }
      }
