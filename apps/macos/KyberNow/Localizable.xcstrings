    "Auto : stéréo pour l'instant, quelle que soit la sortie de ce Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: stereo for now, whatever this Mac's output."
          }
        },
