            "state" : "translated",
            "value" : "Les manettes sont reprises."
          }
        }
      }
    },
    "Les nouveautés avant tout le monde, parfois moins stables. Une version stable plus récente vous est toujours proposée ; décocher ne fait pas revenir en arrière, KyberNow Link attend la stable suivante." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New features before everyone else, sometimes less stable. A newer stable version is always offered; turning this off does not roll back, KyberNow Link waits for the next stable version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveautés avant tout le monde, parfois moins stables. Une version stable plus récente vous est toujours proposée ; décocher ne fait pas revenir en arrière, KyberNow Link attend la stable suivante."
          }
        }
      }
    },
