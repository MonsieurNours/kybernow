new file mode 100644
index 0000000..b74e815
--- /dev/null
+++ b/kyclient/src/media_sink.rs
@@ -0,0 +1,150 @@
+// KyberNow: audio and video packets handed to the application for native
+// decoding (VideoToolbox + Metal, Opus + Core Audio on Apple platforms)
+// instead of VLC.
+
+/// Kind of a packet handed to a `PacketSink`.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MediaPacketKind {
+    /// Codec change: `codec` is set, no data.
+    Codec,
+    /// Encoded data. Video: Annex B, `is_config` marks parameter sets.
+    /// Audio: Opus packets, `is_config` marks the OpusHead.
+    Media,
+    /// Lost data (`missing_samples` for audio).
+    Hole,
+    /// Last call for this sink: the stream is over (stopped, failed or
+    /// aborted) and no packet will follow. The application may release
+    /// whatever `userdata` points to.
+    Closed,
+}
+
+/// Packet handed to the application. `data` is only valid during the
+/// callback.
+#[repr(C)]
+pub struct MediaPacket {
+    pub kind: MediaPacketKind,
+    pub source_id: u32,
+    pub codec: u32,
+    pub is_config: bool,
+    pub is_key: bool,
+    pub pts: u64,
+    pub missing_samples: u32,
+    pub data: *const u8,
+    pub len: usize,
+}
+
+pub type MediaPacketCb = extern "C" fn(packet: *const MediaPacket, userdata: *mut std::ffi::c_void);
+
+/// Application callback receiving the packets of one stream.
+///
+/// KyberNow (KYB-25): it owns what `userdata` points to until its last
+/// call, `Closed`, made exactly once: by its stream when it ends, or when
+/// it is dropped without ever reaching a stream (a start refused, no
+/// endpoint for it, an error before its stream starts). So it is neither
+/// `Copy` nor `Clone`; a copy of a configuration has no sink. It is still
+/// built and read field by field, as before (apps/core, phase 2b).
+#[derive(Debug)]
+pub struct PacketSink {
+    pub cb: MediaPacketCb,
+    pub userdata: usize,
+}
+
+impl PacketSink {
+    /// Hands `packet` to the application.
+    pub(crate) fn send(&self, packet: &MediaPacket) {
+        (self.cb)(packet, self.userdata as *mut std::ffi::c_void);
+    }
+
+    /// The last call: `Closed` for `source_id`. The sink is gone after it.
+    pub(crate) fn close(self, source_id: u32) {
+        let this = std::mem::ManuallyDrop::new(self);
+        this.send_closed(source_id);
+    }
+
+    fn send_closed(&self, source_id: u32) {
+        self.send(&MediaPacket {
+            kind: MediaPacketKind::Closed,
+            source_id,
+            codec: 0,
+            is_config: false,
+            is_key: false,
+            pts: 0,
+            missing_samples: 0,
+            data: std::ptr::null(),
+            len: 0,
+        });
+    }
+}
+
+impl Drop for PacketSink {
+    /// Never given to a stream: its last call all the same (the stream it
+    /// was meant for is unknown here).
+    fn drop(&mut self) {
+        self.send_closed(u32::MAX);
+    }
+}
+
+/// KyberNow (KYB-25): the sinks of a session's streams, taken out of its
+/// configuration when it starts, each one given to its stream. Dropped
+/// with some left (a start refused, an endpoint missing), those send
+/// `Closed` there.
+#[derive(Debug, Default)]
+pub(crate) struct MediaSinks {
+    /// In the order of the session's video configurations.
+    pub(crate) video: Vec<Option<PacketSink>>,
+    pub(crate) audio: Option<PacketSink>,
+}
+
+impl MediaSinks {
+    pub(crate) fn take(config: &mut crate::StreamingSessionConfig) -> Self {
+        Self {
+            #[cfg(not(target_family = "wasm"))]
+            video: config.video.iter_mut().map(|v| v.player.packet_sink.take()).collect(),
+            #[cfg(target_family = "wasm")]
+            video: Vec::new(),
+            audio: config.audio.as_mut().and_then(|a| a.packet_sink.take()),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Mutex;
+
+    static CALLS: Mutex<Vec<(MediaPacketKind, u32, usize)>> = Mutex::new(Vec::new());
+
+    extern "C" fn record(packet: *const MediaPacket, userdata: *mut std::ffi::c_void) {
+        let p = unsafe { &*packet };
+        CALLS.lock().unwrap().push((p.kind, p.source_id, userdata as usize));
+    }
+
+    fn calls_for(userdata: usize) -> Vec<(MediaPacketKind, u32)> {
+        CALLS.lock().unwrap().iter().filter(|c| c.2 == userdata).map(|c| (c.0, c.1)).collect()
+    }
+
+    #[test]
+    fn a_sink_never_given_to_a_stream_is_closed_once() {
+        drop(PacketSink { cb: record, userdata: 101 });
+        assert_eq!(calls_for(101), [(MediaPacketKind::Closed, u32::MAX)]);
+    }
+
+    #[test]
+    fn a_sink_closed_by_its_stream_is_not_closed_again() {
+        let sink = PacketSink { cb: record, userdata: 102 };
+        sink.close(7);
+        assert_eq!(calls_for(102), [(MediaPacketKind::Closed, 7)]);
+    }
+
+    #[test]
+    fn the_sinks_left_in_a_refused_start_are_closed() {
+        let sinks = MediaSinks {
+            video: vec![Some(PacketSink { cb: record, userdata: 103 }), None],
+            audio: Some(PacketSink { cb: record, userdata: 104 }),
+        };
+        drop(sinks);
+        assert_eq!(calls_for(103), [(MediaPacketKind::Closed, u32::MAX)]);
+        assert_eq!(calls_for(104), [(MediaPacketKind::Closed, u32::MAX)]);
+    }
+}
