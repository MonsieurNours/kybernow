diff --git a/kyclient/src/media_sink.rs b/kyclient/src/media_sink.rs
new file mode 100644
index 0000000..3598f74
--- /dev/null
+++ b/kyclient/src/media_sink.rs
@@ -0,0 +1,40 @@
+// KyberNow: audio and video packets handed to the application for native
+// decoding (VideoToolbox + Metal, Opus + Core Audio on Apple platforms)
+// instead of VLC.
+
+/// Kind of a packet handed to a `PacketSink`.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MediaPacketKind {
+    /// Codec change: `codec` is set, no data.
+    Codec,
+    /// Encoded data. Video: Annex B, `is_config` marks parameter sets.
+    /// Audio: Opus packets, `is_config` marks the OpusHead.
+    Media,
+    /// Lost data (`missing_samples` for audio).
+    Hole,
+}
+
+/// Packet handed to the application. `data` is only valid during the
+/// callback.
+#[repr(C)]
+pub struct MediaPacket {
+    pub kind: MediaPacketKind,
+    pub source_id: u32,
+    pub codec: u32,
+    pub is_config: bool,
+    pub is_key: bool,
+    pub pts: u64,
+    pub missing_samples: u32,
+    pub data: *const u8,
+    pub len: usize,
+}
+
+pub type MediaPacketCb = extern "C" fn(packet: *const MediaPacket, userdata: *mut std::ffi::c_void);
+
+/// Application callback receiving the packets of one stream.
+#[derive(Clone, Copy, Debug)]
+pub struct PacketSink {
+    pub cb: MediaPacketCb,
+    pub userdata: usize,
+}
