+/// KyberNow: forward audio or video packets to the application (native
+/// decoding). Audio and video endpoints share the same packet type.
+async fn packet_sink_task(source_id: u32, endpoint: types::VideoClientEndpoint, sink: PacketSink) {
+    let mut recv = match endpoint.ready().await {
+        Ok(recv) => recv,
+        Err(err) => {
+            warn!("Endpoint not ready for packet sink: {err:?}");
+            return;
+        }
+    };
+    info!("Packets of stream {source_id} go to the application");
+    loop {
+        let packet = match recv.recv().await {
+            Ok(Some(packet)) => packet,
+            Ok(None) => break,
+            Err(err) => {
+                info!("Packet sink of stream {source_id} closed: {err:?}");
+                break;
+            }
+        };
+        let mut out = MediaPacket {
+            kind: MediaPacketKind::Hole,
+            source_id,
+            codec: 0,
+            is_config: false,
+            is_key: false,
+            pts: 0,
+            missing_samples: 0,
+            data: std::ptr::null(),
+            len: 0,
+        };
+        match &packet {
+            types::AVPacket::Codec(p) => {
+                out.kind = MediaPacketKind::Codec;
+                out.codec = p.header.codec;
+            }
+            types::AVPacket::Media(p) => {
+                out.kind = MediaPacketKind::Media;
+                out.is_config = p.header.is_config;
+                out.is_key = p.header.is_key;
+                out.pts = p.header.pts;
+                out.data = p.payload.as_ptr();
+                out.len = p.payload.len();
+            }
+            types::AVPacket::Hole(p) => out.missing_samples = p.header.missing_audio_samples,
+        }
+        (sink.cb)(&out, sink.userdata as *mut std::ffi::c_void);
+    }
+}
