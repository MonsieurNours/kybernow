+// KyberNow: pens (graphics tablet, Apple Pencil, stylus). A client sends them
+// only once the host sent `PenAvailable`; see `types/pen.rs`.
+
+pub type Pen = crate::types::Pen;
+
+#[unsafe(no_mangle)]
+pub extern "C" fn kynput_pen_to_packet(target: InputTarget, pen: Pen) -> Box<InputPacket> {
+    Box::new(crate::InputPacket::new(target, crate::Payload::Pen(pen)))
+}
+
+/// Copies the pen of a `Pen` packet into `out` (false for another packet).
+///
+/// # Safety
+/// `out` must point to a writable `kynput_Pen`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn kynput_pen_from_packet(packet: &InputPacket, out: *mut Pen) -> bool {
+    match &packet.payload {
+        crate::Payload::Pen(pen) if !out.is_null() => {
+            unsafe { *out = *pen };
+            true
+        }
+        _ => false,
+    }
+}
