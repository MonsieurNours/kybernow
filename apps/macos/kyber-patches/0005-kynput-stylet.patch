+/// KyberNow: a pen's whole state (graphics tablet, Apple Pencil, stylus);
+/// see kynput's `types/pen.rs`. Sent only to a host that announced
+/// [`ControlEvent::PenAvailable`].
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Pen {
+    /// Same display and coordinates as [`MousePosition`].
+    pub display_id: u32,
+    pub x: i16,
+    pub y: i16,
+    /// 0 to [`Pen::MAX_PRESSURE`] (0 while hovering).
+    pub pressure: u16,
+    /// Degrees, -90 to 90: X to the right, Y toward the user.
+    pub tilt_x: i8,
+    pub tilt_y: i8,
+    /// Degrees, 0 to 359, with [`Pen::ROTATION`].
+    pub rotation: u16,
+    pub flags: u8,
+}
+
+impl Pen {
+    pub const MAX_PRESSURE: u16 = 65535;
+    /// The tip (or the eraser) touches the surface.
+    pub const CONTACT: u8 = 1 << 0;
+    /// The pen is near the surface; without it, the pen left.
+    pub const IN_RANGE: u8 = 1 << 1;
+    /// The eraser end is in use.
+    pub const ERASER: u8 = 1 << 2;
+    /// The pen's button is held.
+    pub const BARREL: u8 = 1 << 3;
+    /// Tilt given by the device.
+    pub const TILT: u8 = 1 << 4;
+    /// Rotation given by the device.
+    pub const ROTATION: u8 = 1 << 5;
+
+    pub fn has(&self, flag: u8) -> bool {
+        self.flags & flag != 0
+    }
+
+    /// Pressure from a fraction (clamped to 0..=1).
+    pub fn pressure_from_fraction(fraction: f32) -> u16 {
+        (fraction.clamp(0.0, 1.0) * Self::MAX_PRESSURE as f32).round() as u16
+    }
+
+    pub fn from_packet(pkt: &Packet) -> Option<Self> {
+        let mut pen = sys::kynput_Pen {
+            display_id: 0,
+            x: 0,
+            y: 0,
+            pressure: 0,
+            tilt_x: 0,
+            tilt_y: 0,
+            rotation: 0,
+            flags: 0,
+        };
+        if !unsafe { sys::kynput_pen_from_packet(pkt.to_ptr(), &mut pen) } {
+            return None;
+        }
+        Some(Pen {
+            display_id: pen.display_id,
+            x: pen.x,
+            y: pen.y,
+            pressure: pen.pressure,
+            tilt_x: pen.tilt_x,
+            tilt_y: pen.tilt_y,
+            rotation: pen.rotation,
+            flags: pen.flags,
+        })
+    }
+
+    pub fn to_packet(self, target: InputTarget) -> Packet {
+        let pen = sys::kynput_Pen {
+            display_id: self.display_id,
+            x: self.x,
+            y: self.y,
+            pressure: self.pressure,
+            tilt_x: self.tilt_x,
+            tilt_y: self.tilt_y,
+            rotation: self.rotation,
+            flags: self.flags,
+        };
+        Packet::from_ptr_mut(unsafe { sys::kynput_pen_to_packet(target.to_u32(), pen) })
+    }
+}
