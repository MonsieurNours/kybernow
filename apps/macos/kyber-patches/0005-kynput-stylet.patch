+//! KyberNow: a pen (graphics tablet, Apple Pencil, stylus).
+//!
+//! A client only sends it once the host said it takes pens
+//! ([`crate::ControlEvent::PenAvailable`]); otherwise the pen stays an
+//! absolute mouse ([`crate::MousePosition`] and the left button).
+
+use bytes::{Buf, BufMut, BytesMut};
+
+use crate::types::InputEvent;
+use crate::{Error, Result};
+
+/// Size of a serialized [`Pen`].
+const SIZE: usize = 4 + 2 + 2 + 2 + 1 + 1 + 2 + 1;
+
+/// A pen's state: each event carries all of it (no delta), so that a lost or
+/// filtered packet is fixed by the next one.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(C)]
+pub struct Pen {
+    /// Same display and coordinates as [`crate::MousePosition`].
+    pub display_id: u32,
+    pub x: i16,
+    pub y: i16,
+    /// 0 to [`Pen::MAX_PRESSURE`] (0 while hovering).
+    pub pressure: u16,
+    /// Tilt in degrees, -90 to 90: positive X to the right, positive Y
+    /// toward the user (Windows' and Pointer Events' convention).
+    pub tilt_x: i8,
+    pub tilt_y: i8,
+    /// Rotation (twist) in degrees, 0 to 359, with [`Pen::ROTATION`].
+    pub rotation: u16,
+    /// [`Pen::CONTACT`], [`Pen::IN_RANGE`]…
+    pub flags: u8,
+}
+
+impl Pen {
+    pub const FILTERABLE: bool = true;
+
+    pub const MAX_PRESSURE: u16 = 65535;
+
+    /// The tip (or the eraser) touches the surface.
+    pub const CONTACT: u8 = 1 << 0;
+    /// The pen is near the surface (hovering or touching). Without it, the
+    /// pen left: the host lifts it and lets it go.
+    pub const IN_RANGE: u8 = 1 << 1;
+    /// The eraser end is the one in use.
+    pub const ERASER: u8 = 1 << 2;
+    /// The pen's (first) button is held.
+    pub const BARREL: u8 = 1 << 3;
+    /// `tilt_x` and `tilt_y` are given by the device.
+    pub const TILT: u8 = 1 << 4;
+    /// `rotation` is given by the device.
+    pub const ROTATION: u8 = 1 << 5;
+
+    pub fn new(display_id: u32, x: i16, y: i16) -> Self {
+        Self {
+            display_id,
+            x,
+            y,
+            pressure: 0,
+            tilt_x: 0,
+            tilt_y: 0,
+            rotation: 0,
+            flags: Self::IN_RANGE,
+        }
+    }
+
+    pub fn has(&self, flag: u8) -> bool {
+        self.flags & flag != 0
+    }
+
+    /// Pressure as a fraction, 0 to 1.
+    pub fn pressure_fraction(&self) -> f32 {
+        self.pressure as f32 / Self::MAX_PRESSURE as f32
+    }
+
+    /// Pressure from a fraction (clamped to 0..=1).
+    pub fn pressure_from_fraction(fraction: f32) -> u16 {
+        (fraction.clamp(0.0, 1.0) * Self::MAX_PRESSURE as f32).round() as u16
+    }
+
+    pub fn deserialize(data: &[u8]) -> Result<Self> {
+        if data.len() < SIZE {
+            return Err(Error::InvalidType);
+        }
+        let mut buf = BytesMut::from(data);
+
+        Ok(Pen {
+            display_id: buf.get_u32(),
+            x: buf.get_i16(),
+            y: buf.get_i16(),
+            pressure: buf.get_u16(),
+            tilt_x: buf.get_i8().clamp(-90, 90),
+            tilt_y: buf.get_i8().clamp(-90, 90),
+            rotation: buf.get_u16() % 360,
+            flags: buf.get_u8(),
+        })
+    }
+}
+
+impl InputEvent for Pen {
+    fn serialize(&self) -> Vec<u8> {
+        let mut buf = BytesMut::with_capacity(SIZE);
+        buf.put_u32(self.display_id);
+        buf.put_i16(self.x);
+        buf.put_i16(self.y);
+        buf.put_u16(self.pressure);
+        buf.put_i8(self.tilt_x);
+        buf.put_i8(self.tilt_y);
+        buf.put_u16(self.rotation);
+        buf.put_u8(self.flags);
+
+        buf.to_vec()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn serialize_deserialize() {
+        let pen = Pen {
+            display_id: 3,
+            x: 812,
+            y: -4,
+            pressure: 40000,
+            tilt_x: -35,
+            tilt_y: 60,
+            rotation: 271,
+            flags: Pen::CONTACT | Pen::IN_RANGE | Pen::BARREL | Pen::TILT | Pen::ROTATION,
+        };
+
+        let data = pen.serialize();
+        assert_eq!(data.len(), SIZE);
+        assert_eq!(Pen::deserialize(&data).unwrap(), pen);
+    }
+
+    #[test]
+    fn short_packet_is_refused() {
+        assert!(Pen::deserialize(&[0; SIZE - 1]).is_err());
+    }
+
+    #[test]
+    fn pressure_fraction() {
+        assert_eq!(Pen::pressure_from_fraction(1.5), Pen::MAX_PRESSURE);
+        assert_eq!(Pen::pressure_from_fraction(-1.0), 0);
+        let half = Pen::pressure_from_fraction(0.5);
+        assert!((Pen { pressure: half, ..Pen::new(0, 0, 0) }.pressure_fraction() - 0.5).abs() < 1e-4);
+    }
+}
