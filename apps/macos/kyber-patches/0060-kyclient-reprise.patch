+/// KyberNow (0060): `POST /recover` (kycontroller patched by KyberNow): the
+/// application decoded up to `last_pts` and lost what followed. `false`:
+/// a host without it (404), which only takes `/force_idr`.
+pub(crate) async fn recover(http_client: &HttpClient, last_pts: u64) -> Result<bool> {
+    let url = format!("{base_url}/recover", base_url = http_client.base_url());
+
+    let response = http_client
+        .post(&url)
+        .json(&serde_json::json!({ "last_pts": last_pts }))
+        .send()
+        .await?;
+    if response.status() == StatusCode::NOT_FOUND {
+        return Ok(false);
+    }
+    response.error_for_status()?;
+
+    Ok(true)
+}
