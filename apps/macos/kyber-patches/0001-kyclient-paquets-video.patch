new file mode 100644
index 0000000..3f66883
--- /dev/null
+++ b/kyclient/src/video_sink.rs
@@ -0,0 +1,31 @@
+// KyberNow: video packets handed to the application for native decoding
+// (VideoToolbox + Metal on Apple platforms) instead of VLC.
+
+/// Kind of a packet handed to a `PacketSink`.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum VideoPacketKind {
+    /// Codec change: `codec` is set, no data.
+    Codec,
+    /// Encoded data (Annex B). `is_config` marks parameter sets.
+    Media,
+    /// Lost data.
+    Hole,
+}
+
+/// Video packet handed to the application. `data` is only valid during the
+/// callback.
+#[repr(C)]
+pub struct VideoPacket {
+    pub kind: VideoPacketKind,
+    pub source_id: u32,
+    pub codec: u32,
+    pub is_config: bool,
+    pub is_key: bool,
+    pub pts: u64,
+    pub data: *const u8,
+    pub len: usize,
+}
+
+pub type VideoPacketCb = extern "C" fn(packet: *const VideoPacket, userdata: *mut std::ffi::c_void);
+
