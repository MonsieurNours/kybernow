+/// Client socket with a large receive buffer. A 4K frame arrives as one burst,
+/// faster than the socket is read; the default macOS buffer (768 KB) overflows
+/// and packets are dropped before reaching QUIC.
+fn client_endpoint(bind_addr: SocketAddr) -> std::io::Result<quinn::Endpoint> {
+    use socket2::{Domain, Protocol, Socket, Type};
+    let socket = Socket::new(Domain::for_address(bind_addr), Type::DGRAM, Some(Protocol::UDP))?;
+    if bind_addr.is_ipv6() {
+        let _ = socket.set_only_v6(false);
+    }
+    for size in [8 << 20, 6 << 20, 4 << 20, 2 << 20] {
+        if socket.set_recv_buffer_size(size).is_ok() {
+            break;
+        }
+    }
+    log::info!("UDP receive buffer: {:?} bytes", socket.recv_buffer_size());
+    socket.bind(&bind_addr.into())?;
+    quinn::Endpoint::new(
+        quinn::EndpointConfig::default(),
+        None,
+        socket.into(),
+        Arc::new(quinn::TokioRuntime),
+    )
+}
