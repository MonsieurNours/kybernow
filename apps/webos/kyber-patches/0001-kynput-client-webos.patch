From: KyberNow <kybernow@leslignesclaires.fr>
Subject: [PATCH] kynput: client seul sur webOS (cfg kybernow_webos)

Les téléviseurs LG (webOS) sont un Linux sans libinput, libevdev ni X11 :
l'injection d'entrées de Linux (côté serveur) ne s'y compile pas et ne sert
pas au client. Avec `--cfg kybernow_webos`, kynput s'y comporte comme sur
Android : configuration de client seule, conversion des codes de touche
Linux (evdev) en scancodes de Windows.

diff --git a/kynput/Cargo.toml b/kynput/Cargo.toml
index 6d36df3..ef170ef 100644
--- a/kynput/Cargo.toml
+++ b/kynput/Cargo.toml
@@ -28,7 +28,7 @@ sdl2 = ["dep:sdl2"]
 [target.'cfg(target_os = "android")'.dependencies]
 android_logger = "0.15"
 
-[target.'cfg(target_os = "linux")'.dependencies]
+[target.'cfg(all(target_os = "linux", not(kybernow_webos)))'.dependencies]
 evdev-rs = "0.6.1"
 input = "0.10.0"
 input-linux-sys = "0.9"
diff --git a/kynput/src/capi/mod.rs b/kynput/src/capi/mod.rs
index 2e3ea50..5e4431e 100644
--- a/kynput/src/capi/mod.rs
+++ b/kynput/src/capi/mod.rs
@@ -1670,9 +1670,9 @@ pub unsafe extern "C" fn kynput_keycode_evdev_to_kyber(
     keycode: u16,
     out_scancode: *mut u16,
 ) -> bool {
-    #[cfg(target_os = "android")]
+    #[cfg(any(target_os = "android", kybernow_webos))]
     let result = crate::android::keycode_convert::keycode_to_scancode(keycode);
-    #[cfg(target_os = "linux")]
+    #[cfg(all(target_os = "linux", not(kybernow_webos)))]
     let result = crate::linux::utils::keycode_convert::keycode_to_scancode(keycode);
     match result {
         Some(scancode) => {
@@ -1683,7 +1683,7 @@ pub unsafe extern "C" fn kynput_keycode_evdev_to_kyber(
     }
 }
 
-#[cfg(target_os = "linux")]
+#[cfg(all(target_os = "linux", not(kybernow_webos)))]
 #[unsafe(no_mangle)]
 pub unsafe extern "C" fn kynput_keycode_xkb_to_kyber(keycode: u16, out_scancode: *mut u16) -> bool {
     match crate::linux::utils::keycode_convert::xkb_keycode_to_scancode(keycode) {
@@ -1704,7 +1704,7 @@ pub unsafe extern "C" fn kynput_keycode_to_scancode(keycode: u16, out_scancode:
     unsafe { kynput_keycode_evdev_to_kyber(keycode, out_scancode) }
 }
 
-#[cfg(target_os = "linux")]
+#[cfg(all(target_os = "linux", not(kybernow_webos)))]
 #[deprecated(note = "Use kynput_keycode_xkb_to_kyber instead")]
 #[unsafe(no_mangle)]
 pub unsafe extern "C" fn kynput_xkb_keycode_to_scancode(
diff --git a/kynput/src/error.rs b/kynput/src/error.rs
index 4335e75..2a0ac0d 100644
--- a/kynput/src/error.rs
+++ b/kynput/src/error.rs
@@ -69,7 +69,7 @@ pub enum Error {
     #[error("protocol error: {0}")]
     ProtocolError(#[from] kycom::ProtocolError),
 
-    #[cfg(target_os = "linux")]
+    #[cfg(all(target_os = "linux", not(kybernow_webos)))]
     #[error("xcb error: {0}")]
     XcbFailure(String),
 
diff --git a/kynput/src/lib.rs b/kynput/src/lib.rs
index 2cd2a3e..91d475a 100644
--- a/kynput/src/lib.rs
+++ b/kynput/src/lib.rs
@@ -136,16 +136,16 @@ pub use types::{
 };
 pub use utils::blocking_queue::BlockingQueue;
 
-#[cfg(target_os = "android")]
+#[cfg(any(target_os = "android", kybernow_webos))]
 pub mod android;
 
-#[cfg(target_os = "android")]
+#[cfg(any(target_os = "android", kybernow_webos))]
 pub type PlatformPipelineConfigBuilder = android::PipelineConfigBuilder;
 
-#[cfg(target_os = "linux")]
+#[cfg(all(target_os = "linux", not(kybernow_webos)))]
 pub mod linux;
 
-#[cfg(target_os = "linux")]
+#[cfg(all(target_os = "linux", not(kybernow_webos)))]
 pub type PlatformPipelineConfigBuilder = linux::PipelineConfigBuilder;
 
 #[cfg(target_os = "windows")]
